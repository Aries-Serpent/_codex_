# =============================================================================
# .env.example - Local Development Environment Template
# =============================================================================
# Copy this file to .env and customize for your environment.
# 
# Phase 6.2 Update: Added 8 new environment variables for localhost → 
# environment variables migration (deployed to GitHub Settings).
# 
# Timeline: Phase 6.2 (deployed 2026-07-06) → Phase 7 validation (2026-07-08)
# =============================================================================

# ============================================================================
# PHASE 6.2: INFRASTRUCTURE & DISTRIBUTED SYSTEMS (NEW)
# ============================================================================
# These 8 variables replace hardcoded localhost references throughout the
# codebase. All have sensible localhost defaults for local development.
# 
# For GitHub Actions CI: Set these via GitHub Settings > Variables
# For local development: Copy this file to .env and customize as needed
# For Docker containers: Pass via docker-compose.yml or docker run -e
# For Kubernetes: Set via ConfigMaps or Secrets
# =============================================================================

# Redis Caching Service
# Purpose: Distributed cache for RAG pipelines and training coordination
# Integration: src/codex/rag/cache/distributed_cache.py, src/cache/redis_cache.py
# Default: localhost (backward compatible)
CODEX_REDIS_HOST=localhost

# Ollama LLM Inference Service
# Purpose: Local LLM embeddings and inference via Ollama
# Integration: src/codex/rag/providers/ollama_provider.py
# Default: http://localhost:11434
# Note: Must include http:// or https:// protocol prefix
CODEX_OLLAMA_HOST=http://localhost:11434

# Distributed Training Bootstrap (Master Node Address)
# Purpose: NCCL/DDP training bootstrap master address
# Integration: src/codex_ml/training/distributed.py
# Default: localhost
# Note: Used with CODEX_MASTER_PORT for multi-node training
CODEX_MASTER_ADDR=localhost

# Distributed Training Bootstrap (Master Node Port)
# Purpose: NCCL/DDP training bootstrap master port
# Integration: src/codex_ml/training/distributed.py
# Default: 29500
# Valid Range: 1-65535 (typically 29500-29510 for training)
CODEX_MASTER_PORT=29500

# ML Inference Server Bind Address
# Purpose: Address for inference API server to listen on
# Integration: src/codex_ml/api/inference_server.py
# Default: 127.0.0.1 (localhost only, for security)
# Options:
#   127.0.0.1  - localhost only (development, most secure)
#   0.0.0.0    - all interfaces (production, requires CODEX_LOCAL_LOOPBACK=false)
CODEX_INFERENCE_SERVICE_HOST=127.0.0.1

# ML Inference Server Port
# Purpose: Port for inference API server
# Integration: src/codex_ml/api/inference_server.py
# Default: 8000
# Valid Range: 1-65535 (typically 8000-9000 for API services)
CODEX_INFERENCE_SERVICE_PORT=8000

# Host Header Security Validation (Comma-Separated)
# Purpose: Allowed hosts for HTTP Host header validation (security gate)
# Integration: src/codex_ml/api/middleware/host_validator.py
# Default: localhost,127.0.0.1,testserver
# Security: Only requests with these Host headers are allowed
# Format: Comma-separated list (no spaces), supports wildcards (*.example.com)
# Examples:
#   localhost,127.0.0.1,testserver             (development)
#   *.staging.codex.svc.cluster.local         (staging)
#   *.codex.svc.cluster.local,codex.prod      (production)
CODEX_TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Development-Only Localhost Feature Gate
# Purpose: Enable/disable localhost-only security relaxations for fast iteration
# Integration: src/codex_ml/api/middleware/feature_gates.py
# Default: true
# Options:
#   true   - Localhost allowlist enabled (localhost requests bypass some checks)
#   false  - Localhost allowlist disabled (all requests go through full validation)
# 
# When to use:
#   Development (local_loopback=true): Skip certain checks for localhost requests
#   Staging/Production (local_loopback=false): Full security enforcement
# 
# Security Warning:
#   NEVER set to 'true' in production! This is a development convenience feature.
CODEX_LOCAL_LOOPBACK=true

# ============================================================================
# EXISTING CONFIGURATION (From .env/.env.example)
# ============================================================================

# AUTHENTICATION & AUTHORIZATION
AUTH_SECRET_KEY=your-secure-jwt-secret-key-here-32-chars-minimum
CODEX_AUTH_SECRET=your-secure-auth-secret-here

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://localhost:5432/codex_db
SUPABASE_URL=
SUPABASE_KEY=
CHROMA_URL=

# LLM AUTO-FIX ORCHESTRATOR
CODEX_AUTO_FIX_ENABLED=0
CODEX_LLM_ENDPOINT=
CODEX_LLM_API_KEY=
CODEX_LLM_MODEL=
CODEX_LLM_TIMEOUT=60
CODEX_LLM_MAX_FILES=10
CODEX_LLM_MAX_LINE_CHANGES=500

# GIT & COMMIT CONFIGURATION
CODEX_PREPUSH_SKIP=0
CODEX_PREPUSH_CMD=
CODEX_PREPARE_COMMIT_SKIP=0
CODEX_COMMIT_LINT_SKIP=0
CODEX_AUTO_FIX_CHECK_CMD=

# ENVIRONMENT CONFIGURATION
CODEX_ENV=development
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# EXTERNAL SERVICES & API KEYS
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX_NAME=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
OPENAI_API_KEY=
HF_API_TOKEN=
EMBEDDER_CLASS=
EMBEDDING_BATCH_SIZE=
EMBEDDING_CHUNK_MAX_CHARS=
EMBEDDING_CHUNK_OVERLAP=
EMBEDDING_WORKER_NAMESPACE_DEFAULT=
EMBEDDING_CHECKPOINT_PATH=

# DEPLOYMENT & INFRASTRUCTURE
CLOUDFLARE_API_TOKEN=
FLY_API_TOKEN=
GITHUB_TOKEN=
GITHUB_APP_PRIVATE_KEY=

# DATA PERSISTENCE & AUTHENTICATION
CODEX_USERSTORE_BACKEND=memory
CODEX_USERSTORE_DB_PATH=codex_users.db

# ============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# ============================================================================
# Copy the appropriate section below and override the Phase 6.2 variables above.

# ─── LOCAL DEVELOPMENT (Recommended defaults) ───────────────────────────
# All services run on localhost, minimal security restrictions
#
# CODEX_REDIS_HOST=localhost
# CODEX_OLLAMA_HOST=http://localhost:11434
# CODEX_MASTER_ADDR=localhost
# CODEX_MASTER_PORT=29500
# CODEX_INFERENCE_SERVICE_HOST=127.0.0.1
# CODEX_INFERENCE_SERVICE_PORT=8000
# CODEX_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# CODEX_LOCAL_LOOPBACK=true

# ─── DOCKER COMPOSE ENVIRONMENT ────────────────────────────────────────
# Services accessible via container hostnames
#
# CODEX_REDIS_HOST=redis
# CODEX_OLLAMA_HOST=http://ollama:11434
# CODEX_MASTER_ADDR=training-master
# CODEX_MASTER_PORT=29500
# CODEX_INFERENCE_SERVICE_HOST=0.0.0.0
# CODEX_INFERENCE_SERVICE_PORT=8000
# CODEX_TRUSTED_HOSTS=localhost,127.0.0.1,testserver,inference-api
# CODEX_LOCAL_LOOPBACK=true

# ─── KUBERNETES STAGING ───────────────────────────────────────────────
# Services accessible via Kubernetes DNS names
#
# CODEX_REDIS_HOST=redis-staging.codex.svc.cluster.local
# CODEX_OLLAMA_HOST=http://ollama-staging.codex.svc.cluster.local:11434
# CODEX_MASTER_ADDR=training-master-0.training.codex.svc.cluster.local
# CODEX_MASTER_PORT=29500
# CODEX_INFERENCE_SERVICE_HOST=0.0.0.0
# CODEX_INFERENCE_SERVICE_PORT=8000
# CODEX_TRUSTED_HOSTS=*.staging.codex.svc.cluster.local
# CODEX_LOCAL_LOOPBACK=false

# ─── KUBERNETES PRODUCTION ────────────────────────────────────────────
# Services accessible via production Kubernetes DNS and load balancers
#
# CODEX_REDIS_HOST=redis-primary.codex.svc.cluster.local
# CODEX_OLLAMA_HOST=http://ollama.codex.svc.cluster.local:11434
# CODEX_MASTER_ADDR=training-master-0.training.codex.svc.cluster.local
# CODEX_MASTER_PORT=29500
# CODEX_INFERENCE_SERVICE_HOST=0.0.0.0
# CODEX_INFERENCE_SERVICE_PORT=8000
# CODEX_TRUSTED_HOSTS=*.codex.svc.cluster.local,codex.prod
# CODEX_LOCAL_LOOPBACK=false

# ============================================================================
# VALIDATION
# ============================================================================
# After setting environment variables, validate with:
#
#   bash .codex/validate_local_env.sh
#
# This will verify:
#   ✓ All 8 variables defined or have fallbacks
#   ✓ Fallback behavior when variables unset
#   ✓ Override behavior with custom values
#   ✓ Security feature gates functional
#   ✓ Port and URL validation
#   ✓ Configuration system integration
# ============================================================================

# Copy to .env and adjust values for local development.

# ============================================================================
# AUTHENTICATION & AUTHORIZATION (CRITICAL) — REMEDIATION REQUIRED
# ============================================================================

# JWT secret key for signing authentication tokens (CRITICAL - CHANGE IN PRODUCTION)
# Generate a secure random key:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# NEVER use hardcoded values in source code — always set this environment variable
AUTH_SECRET_KEY=your-secure-jwt-secret-key-here-32-chars-minimum

# Alternative CODEX auth secret (legacy support)
CODEX_AUTH_SECRET=your-secure-auth-secret-here

# ============================================================================
# DATABASE CONFIGURATION (CRITICAL)
# ============================================================================

# PostgreSQL database URL
DATABASE_URL=******localhost:5432/codex_db

# Supabase (pgvector)
SUPABASE_URL=
SUPABASE_KEY=

# Chroma / local vector endpoint
CHROMA_URL=

# ============================================================================
# LLM AUTO-FIX ORCHESTRATOR CONFIGURATION
# ============================================================================

CODEX_AUTO_FIX_ENABLED=0
CODEX_LLM_ENDPOINT=
CODEX_LLM_API_KEY=
CODEX_LLM_MODEL=
CODEX_LLM_TIMEOUT=60
CODEX_LLM_MAX_FILES=10
CODEX_LLM_MAX_LINE_CHANGES=500

# ============================================================================
# GIT & COMMIT CONFIGURATION
# ============================================================================

# Pre-push test gate
CODEX_PREPUSH_SKIP=0
CODEX_PREPUSH_CMD=

# Conventional commit scaffolding overrides
CODEX_PREPARE_COMMIT_SKIP=0
CODEX_COMMIT_LINT_SKIP=0

# Optional override for the command used during auto-fix validation
CODEX_AUTO_FIX_CHECK_CMD=

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================

# Security Configuration
# Environment: development, staging, production
CODEX_ENV=development
ENVIRONMENT=development

# CORS Configuration (comma-separated list of allowed origins)
# Development: Use localhost URLs for local testing
# Production: Replace with actual domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ============================================================================
# EXTERNAL SERVICES & API KEYS (CRITICAL - KEEP IN .gitignore)
# ============================================================================

# Example env vars for MCP adapters & deployments
# Fill these in your environment or GitHub Secrets when enabling live integration tests.

# Pinecone
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX_NAME=
PINECONE_MAX_RETRIES=

# Upstash Redis (cache)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Embedding providers
OPENAI_API_KEY=
HF_API_TOKEN=

# Embedding worker
EMBEDDER_CLASS=
EMBEDDING_BATCH_SIZE=
EMBEDDING_CHUNK_MAX_CHARS=
EMBEDDING_CHUNK_OVERLAP=
EMBEDDING_WORKER_NAMESPACE_DEFAULT=
EMBEDDING_CHECKPOINT_PATH=

# ============================================================================
# DEPLOYMENT & INFRASTRUCTURE TOKENS
# ============================================================================

# Edge / deployment tokens
CLOUDFLARE_API_TOKEN=
FLY_API_TOKEN=

# GitHub integration (if needed)
GITHUB_TOKEN=
GITHUB_APP_PRIVATE_KEY=

# ============================================================================
# DATA PERSISTENCE & AUTHENTICATION
# ============================================================================

# ─── UserStore persistence ────────────────────────────────────────────────────
# Backend selector for the auth UserStore.
#   memory  — in-process dict (default); all users lost on restart
#   sqlite  — durable SQLite file; suitable for single-node production
CODEX_USERSTORE_BACKEND=memory

# Path to the SQLite database file (only used when CODEX_USERSTORE_BACKEND=sqlite)
CODEX_USERSTORE_DB_PATH=codex_users.db

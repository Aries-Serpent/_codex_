{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "excerpt", "score"],
        "properties": {
          "path": {"type": "string"},
          "excerpt": {"type": "string"},
          "score": {"type": "integer"}
        }
      }
    },
    "total_found": {"type": "integer"}
  }
}

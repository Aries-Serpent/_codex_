[importlinter]
root_packages =
    src
    agents

[importlinter:contract:layers]
name = Core layering (utils -> data -> models -> training)
type = layers
layers =
    src.codex_ml.utils
    src.codex_ml.data
    src.codex_ml.models
    src.codex_ml.training

[importlinter:contract:split_brain_resolution]
name = Agents must not directly import model weights - use cognitive_app runtime
type = forbidden
source_modules =
    agents
forbidden_modules =
    src.codex_ml.models
    src.codex_ml.training

[importlinter:contract:agents_cognitive_unification]
name = Agents must inherit from cognitive brain ABCs
type = layers
layers =
    src.cognitive_brain.base
    agents

[importlinter:contract:src_no_legacy_agents]
name = src/ modules must not import from root-level agents/ (Split Brain Resolution)
type = forbidden
source_modules =
    src.codex
    src.codex_ml
    src.services
forbidden_modules =
    agents
ignore_imports =
    # Allow imports from src.codex.quantum_orchestrator (modern)
    # Forbid imports from agents.* (legacy)

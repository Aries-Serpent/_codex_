+def _collect_external_warnings(artifacts_dir: Path) -> list[str]:
+    """Collect warning strings from external audit artifacts."""
+    warnings: list[str] = []
+
+    content_filter_report = artifacts_dir / "content_filter_report.json"
+    if content_filter_report.exists():
+        try:
+            report = json.loads(content_filter_report.read_text(encoding="utf-8"))
+            report_warnings = report.get("warnings", [])
+            if isinstance(report_warnings, list):
+                warnings.extend(str(item) for item in report_warnings if item)
+        except (OSError, json.JSONDecodeError):
+            logger.exception("Failed to parse content filter report", exc_info=True)
+
+    bundles_dir = artifacts_dir / "bundles"
+    if bundles_dir.exists():
+        for pointer_path in sorted(bundles_dir.glob("*.pointer.json")):
+            try:
+                pointer = json.loads(pointer_path.read_text(encoding="utf-8"))
+                pointer_warnings = pointer.get("warnings", [])
+                if isinstance(pointer_warnings, list):
+                    warnings.extend(str(item) for item in pointer_warnings if item)
+            except (OSError, json.JSONDecodeError):
+                logger.exception("Failed to parse bundle pointer %s", pointer_path, exc_info=True)
+
+    # De-duplicate while preserving first appearance order
+    return list(dict.fromkeys(warnings))

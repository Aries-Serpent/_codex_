# Cognitive Brain — React frontend environment variables
# Copy to .env.local and fill in values for local development.

# P4.1: FastAPI CLI/OODA server (cli_api_server.py at :8765)
# All memory, OODA, and CLI endpoints are served from this base URL.
VITE_CLI_API_URL=http://localhost:8765

# Bearer token sent by the React frontend on /api/memory/* requests.
# MUST match CODEX_MASTER_KEY (or CODEX_BACKUP_KEY) set in the server environment
# so that _require_memory_auth() accepts it. Use a strong random value in production.
VITE_CODEX_KEY=demo-key

# Legacy: original Codex API server (kept for backward compatibility)
# VITE_CODEX_API=http://localhost:8000

# Optional: comma-separated CORS origins for the FastAPI server
# (set in the server environment, not in the React app)
# CODEX_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# CLI API server base URL used by server-side agents (e.g. memory-sync-agent).
# Must match the host/port uvicorn is bound to.
CODEX_CLI_API_URL=http://localhost:8765

# GitHub Pages: Enable live documentation fetching from repository
# Set to 'true' in CI/GitHub Pages builds to fetch live docs from repository
# Set to 'false' (or omit) for offline/demo mode
VITE_DOCS_FETCH_LIVE=false

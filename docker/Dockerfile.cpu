# FROM python:3.10-slim (pinned below)
FROM python:3.10-slim@sha256:70f65c721aaddfb22b20ed6ec12606c59d9592493c5fcb6639f3d0e8ba3fbc10

# Non-root user for security
RUN useradd --create-home appuser
USER appuser

WORKDIR /app

# Leverage cache for dependencies
COPY --chown=appuser:appuser requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy project (you can mount instead during dev)
COPY --chown=appuser:appuser . /app

# Dev/test tools
RUN pip install --no-cache-dir nox pytest

ENV PYTHONUNBUFFERED=1

CMD ["pytest", "-q"]

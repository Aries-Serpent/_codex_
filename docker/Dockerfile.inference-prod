# Multi-stage Dockerfile for aries-serpent:0.1.0-final-inference
# Optimized inference service for latency + throughput
# Target: <300 MB

FROM python:3.12-slim as builder

WORKDIR /build

# Install minimal build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy project files (inference-optimized)
COPY requirements.txt .

# Build wheels (inference-optimized: exclude test/dev dependencies)
RUN pip install --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt && \
    pip install -q cyclonedx-bom && \
    cyclonedx-bom -o /build/bom.json -f json

# Stage 2: Runtime (slimmed for inference)
FROM python:3.12-slim

LABEL maintainer="Aries Serpent <dev@aries-serpent.dev>" \
      version="0.1.0-final" \
      description="Aries-Serpent inference service (gRPC)" \
      vendor="Aries-Serpent"

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1001 -s /bin/false codex && \
    mkdir -p /app/logs /app/cache && \
    chown -R codex:codex /app

# Copy wheels from builder
COPY --from=builder /build/wheels /wheels
COPY --from=builder /build/bom.json /app/bom.json

# Install Python dependencies
RUN pip install --no-cache /wheels/*.whl && \
    rm -rf /wheels

# Copy inference code (minimal)
COPY --chown=codex:codex src/codex /app/codex
COPY --chown=codex:codex pyproject.toml README.md LICENSE /app/
COPY --chown=codex:codex . /app/ || true

# Switch to non-root user
USER codex

# Environment configuration for inference optimization
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOG_LEVEL=INFO \
    INFERENCE_BATCH_SIZE=32 \
    INFERENCE_TIMEOUT=60 \
    METRICS_ENABLED=true \
    MODEL_CACHE_DIR=/app/cache \
    PORT=8001

# Expose gRPC (8001) + metrics HTTP (8002)
EXPOSE 8001 8002

# Health check for gRPC readiness
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Read-only root filesystem support
RUN chmod -R go-w /app

# Default: run inference service
CMD ["python", "-m", "codex.inference.server", "--grpc-port", "8001", "--metrics-port", "8002"]

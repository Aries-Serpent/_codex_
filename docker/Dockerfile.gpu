# syntax=docker/dockerfile:1.7
# GPU-enabled Codex runtime. Requires Nvidia drivers on host.
FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04 AS runtime
LABEL org.opencontainers.image.title="codex-gpu"
LABEL org.opencontainers.image.description="GPU-enabled runtime for codex"
LABEL org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml MANIFEST.in requirements/ ./
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install -r requirements/docker.txt

COPY . .
RUN python3 -m pip install .

EXPOSE 8000
CMD ["uvicorn", "codex.api.app:app", "--host", "0.0.0.0", "--port", "8000"]

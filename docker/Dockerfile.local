# Local development Dockerfile with digest-pinned base image.
# To re-pin: run scripts/docker/pin_digests.sh and copy the reported SHA256.
# FROM python:3.12-slim (pinned below)
FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203

# Metadata
LABEL maintainer="codex-ml-team"
LABEL org.opencontainers.image.description="Local development image for Codex"
LABEL org.opencontainers.image.version="1.0.0"

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
COPY ./ /workspace

# Install dependencies (combined for better caching)
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir -r requirements.txt

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash devuser && \
    chown -R devuser:devuser /workspace

# Switch to non-root user
USER devuser

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import sys; sys.exit(0)" || exit 1

CMD ["python", "-c", "print('codex-local-ok')"]

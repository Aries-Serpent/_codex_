# Multi-stage Dockerfile for aries-serpent:0.1.0-final-api
# Production-grade FastAPI server with inference endpoints
# Target: <500 MB

FROM python:3.12-slim as builder

WORKDIR /build

# Install minimal build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY requirements.txt .
COPY pyproject.toml .
COPY setup.py . 2>/dev/null || true
COPY setup.cfg . 2>/dev/null || true

# Build wheels for all dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt && \
    # Generate SBOM during build
    pip install -q cyclonedx-bom && \
    cyclonedx-bom -o /build/bom.json -f json

# Stage 2: Runtime
FROM python:3.12-slim

LABEL maintainer="Aries Serpent <dev@aries-serpent.dev>" \
      version="0.1.0-final" \
      description="Aries-Serpent FastAPI inference server" \
      vendor="Aries-Serpent"

WORKDIR /app

# Install runtime dependencies only (minimal attack surface)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (security: principle of least privilege)
RUN useradd -m -u 1001 -s /bin/false codex && \
    mkdir -p /app/logs /app/cache && \
    chown -R codex:codex /app

# Copy wheels from builder
COPY --from=builder /build/wheels /wheels
COPY --from=builder /build/bom.json /app/bom.json

# Install Python dependencies from wheels
RUN pip install --no-cache /wheels/*.whl && \
    rm -rf /wheels

# Copy application code
COPY --chown=codex:codex src/codex /app/codex
COPY --chown=codex:codex pyproject.toml README.md LICENSE /app/
COPY --chown=codex:codex . /app/ || true

# Switch to non-root user
USER codex

# Environment configuration (12-factor compliance)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOG_LEVEL=INFO \
    API_TIMEOUT=30 \
    CACHE_SIZE=1024 \
    PORT=8000 \
    CORS_ORIGINS="*" \
    WORKERS=4

# Expose port for HTTP
EXPOSE 8000

# Health check (critical for orchestration)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Read-only root filesystem support
RUN chmod -R go-w /app

# Default command: run FastAPI with uvicorn
CMD ["python", "-m", "uvicorn", "codex.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

# DEPRECATED: Use the root Dockerfile.optimized for production builds.
# This legacy Dockerfile remains for historical reference and will be removed.
#
# Multi-Stage Optimized Dockerfile
# Produces smaller, more secure Docker images

# Stage 1: Builder
FROM python:3.11-slim as builder

LABEL maintainer="codex-ml-team"
LABEL stage="builder"

WORKDIR /build

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        git \
        && rm -rf /var/lib/apt/lists/*

# Copy source files
COPY pyproject.toml README.md ./
COPY src/ src/
COPY training/ training/
COPY cli/ cli/

# Build wheel
RUN pip install --no-cache-dir build && \
    python -m build --wheel && \
    ls -lh dist/

# Stage 2: Runtime
FROM python:3.11-slim

LABEL maintainer="codex-ml-team"
LABEL stage="runtime"
LABEL description="Codex ML Training Environment (Optimized)"

# Install runtime dependencies only
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        curl \
        && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash codex && \
    mkdir -p /home/codex/.cache && \
    chown -R codex:codex /home/codex

# Copy wheel from builder
COPY --from=builder /build/dist/*.whl /tmp/

# Install package
RUN pip install --no-cache-dir /tmp/*.whl && \
    rm /tmp/*.whl && \
    pip cache purge

# Copy entry scripts and set permissions (must be done as root before USER switch)
COPY docker/entrypoint.sh /usr/local/bin/
COPY docker/healthcheck.sh /usr/local/bin/
# Set execute permissions - both files are required to be present
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh

# Switch to non-root user
USER codex
WORKDIR /home/codex

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]

# Expose health probe port (if running server)
EXPOSE 8000

# Default command
CMD ["python", "-m", "cli.train_codex", "--help"]

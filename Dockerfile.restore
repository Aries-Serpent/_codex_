FROM python:3.12-slim

LABEL org.opencontainers.image.title="restore_pipeline"
LABEL org.opencontainers.image.description="CPU-only image restoration + vivid colorization pipeline"
LABEL org.opencontainers.image.licenses="MIT"

# System dependencies for OpenCV (headless)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only what is needed to install dependencies first (cache layer)
COPY src/restore_pipeline/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the package source
COPY src/restore_pipeline/ /app/restore_pipeline/
ENV PYTHONPATH=/app

# Default: show help
ENTRYPOINT ["python", "-m", "restore_pipeline.cli"]
CMD ["--help"]

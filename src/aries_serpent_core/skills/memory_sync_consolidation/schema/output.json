{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Sync Consolidation Output",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "data": {
      "type": "object",
      "properties": {
        "items_processed": {
          "type": "integer",
          "description": "Number of STM entries processed"
        },
        "items_promoted": {
          "type": "integer",
          "description": "Number of items promoted to LTM"
        },
        "duplicates_detected": {
          "type": "integer",
          "description": "Number of duplicates detected"
        },
        "duplicates_merged": {
          "type": "integer",
          "description": "Number of duplicates merged"
        },
        "retention_policy_applied": {
          "type": "string",
          "enum": ["evergreen", "standard", "decay", "archived"]
        },
        "promoted_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "promotion_score": { "type": "number" },
              "policy": { "type": "string" }
            }
          }
        },
        "merged_duplicates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "archive_size_bytes": {
          "type": "integer"
        },
        "dry_run": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "base_sha", "lane_id", "dependencies", "read_paths", "write_paths", "timeout_seconds", "cost_budget", "evidence_inputs", "acceptance_criteria", "output_schema", "state"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lane_id": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "read_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "cost_budget": {"type": "number", "minimum": 0},
    "evidence_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_schema": {"type": "object"},
    "state": {"enum": ["pending", "running", "passed", "failed", "blocked", "incomplete"]}
  }
}

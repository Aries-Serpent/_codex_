{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["matches"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line", "snippet"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer"},
          "snippet": {"type": "string"}
        }
      }
    },
    "total_found": {"type": "integer"}
  }
}

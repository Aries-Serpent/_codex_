{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "description": "Stable identifier for this item"},
          "text": {"type": "string", "description": "Text to score"}
        },
        "additionalProperties": false
      }
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.75,
      "description": "Pass/fail gate (default 0.75)"
    },
    "include_dimensions": {
      "type": "boolean",
      "default": false,
      "description": "Include per-dimension AAIS scores in output"
    }
  },
  "additionalProperties": false
}

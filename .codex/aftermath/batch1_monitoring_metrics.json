  "performance_metrics": {
    "status": "✅ SCHEMA DEFINED",
    "core_metrics": [
      {
        "metric": "http_request_duration_seconds",
        "type": "Histogram",
        "dimensions": ["method", "route", "status", "service", "environment", "version"],
        "percentiles": ["p50", "p75", "p90", "p95", "p99", "p99.9"],
        "targets": {
          "p50": "50ms",
          "p95": "200ms",
          "p99": "1000ms",
          "p99.9": "2000ms"
        },
        "alerting_thresholds": [
          "p95_latency > 500ms for 5min",
          "p99_latency > 1500ms for 5min",
          "p99_latency > 2000ms for 5min (CRITICAL)",
          "p99_latency > 5000ms for 1min (CRITICAL)"
        ]
      },
      {
        "metric": "http_requests_total",
        "type": "Counter",
        "unit": "requests/second",
        "targets": {
          "p50": "5000 req/s",
          "peak": "15000 req/s"
        }
      },
      {
        "metric": "error_rate",
        "type": "Derived (errors/total)",
        "unit": "percentage",
        "targets": {
          "baseline": "<0.1%",
          "warning": "0.1%-0.5%",
          "critical": ">0.5%"
        }
      },
      {
        "metric": "database_connection_pool",
        "type": "Gauge",
        "targets": {
          "utilization": "<60%",
          "warning": ">75%",
          "critical": ">90%"
        }
      },
      {
        "metric": "cache_metrics",
        "type": "Counter + Gauge",
        "targets": {
          "hit_ratio": ">85%",
          "warning": "<80%",
          "critical": "<60%"
        }
      },
      {
        "metric": "resource_utilization",
        "type": "Gauge",
        "metrics": ["cpu_percent", "memory_percent", "disk_percent", "network_mb_s"],
        "targets": {
          "cpu": "<70%",
          "memory": "<75%",
          "disk": "<80%"
        }
      },
      {
        "metric": "message_queue",
        "type": "Gauge + Counter",
        "targets": {
          "consumer_lag": "<10s",
          "warning": ">30s",
          "critical": ">60s"
        }
      },
      {
        "metric": "business_metrics",
        "type": "Counter + Gauge",
        "metrics": ["orders_created", "orders_completed", "conversion_rate", "cart_abandonment_rate"]
      }
    ],
    "collection_pipeline": "OpenTelemetry → Prometheus Exporter → Prometheus Scraper (15s) → TSDB → Grafana → Alerting",
    "data_retention": {
      "1_second": "1 hour (hot)",
      "1_minute": "7 days (with aggregations)",
      "5_minute": "30 days (with aggregations)",
      "1_hour": "1 year (long-term)",
      "1_day": "5 years (archive)"
    }
  },
  

      "escalation_days": 210
    },
    "low_priority": {
      "cadence": "annual",
      "cadence_days": 365,
      "notification_warning_days": 30,
      "escalation_days": 400
    }
  },
  "sla_thresholds": {
    "critical_broken_links": 0,
    "critical_stale_days": 90,
    "high_stale_days": 90,
    "medium_stale_days": 180,
    "low_stale_days": 365,
    "acceptable_health_score": 0.95
  },
  "escalation_paths": {
    "stale_doc_notification": "Doc owner (@agent-name); escalate to @mbaetiong if unresolved after 14 days",
    "broken_link": "Link validator alerts; doc owner must fix within 7 days",
    "code_example_failure": "Doc owner must verify examples execute; escalate if code-doc drift detected",
    "security_risk": "Security owner must remediate within 48 hours; escalate to @mbaetiong immediately"
  },
  "metadata_requirements": {
    "yaml_front_matter": {
      "title": "Document title (required)",
      "owner": "@agent-name or @username (required)",
      "last_reviewed": "ISO 8601 date (required)",
      "review_cadence": "quarterly/semi-annual/annual (required)",
      "sla_days": "Integer days (required)",
      "critical": "Boolean true/false (required)"
    }
  },
  "validation_gates": {
    "broken_links": {
      "check": "All internal links must resolve to existing files",
      "enforced_on": "PRs modifying Tier 1 docs",
      "tool": "link-validator-agent"
    },
    "freshness": {
      "check": "Document must have last_reviewed within SLA",
      "enforced_on": "CI gate on main branch",
      "tool": "doc-freshness-checker"
    },
    "code_examples": {
      "check": "Code examples in guides must execute without error",
      "enforced_on": "PRs modifying guides/",
      "tool": "doc-refactor-test-agent"
    },
    "metadata": {
      "check": "All Tier 1 docs must have YAML front-matter",
      "enforced_on": "PRs modifying user-facing docs",
      "tool": "config-validator"
    }
  },
  "tier_classification": {
    "tier_1_user_facing": {
      "scope": "Docs that directly affect user experience and must stay current",
      "sla_enforcement": true,
      "includes": [
        "Root-level canonical docs (README.md, SECURITY.md, CONTRIBUTING.md, etc.)",
        "docs/ subdirectory (guides, reference, architecture, admin, index)",
        ".github/agents/ specifications and copilot prompts"
      ]
    },
    "tier_2_historical": {
      "scope": "Archived reports, phase-specific docs, point-in-time snapshots",
      "sla_enforcement": false,
      "includes": [
        ".codex/archive/ directory",
        "reports/, archive/ directories",
        "PHASE_*/WAVE_*/GATE_* prefixed files",
        "Dated snapshots (*REPORT*, *SUMMARY*, *FINAL*, *COMPLETION*)"
      ]
    }
  },
  "tools_and_automation": {
    "link_validator": "link-validator-agent checks for broken links",
    "freshness_checker": "doc-freshness-checker monitors staleness via YAML metadata",
    "code_example_validator": "doc-refactor-test-agent executes examples in test harness",
    "ci_gate": "Automated GitHub Actions gate enforces freshness on main branch",
    "alert_system": "GitHub issues created for stale/broken docs; escalates via @mentions"
  }

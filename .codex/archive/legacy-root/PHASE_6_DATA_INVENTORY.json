  "data_flows": [
    {
      "flow_id": "FLOW-001",
      "flow_name": "User Registration & Onboarding",
      "description": "New user creates account and provides consent",
      "data_categories": ["DATA-001", "DATA-002"],
      "steps": [
        {
          "step": 1,
          "action": "User enters email and password",
          "encryption": "TLS 1.3+ in transit",

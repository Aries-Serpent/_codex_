        },
        {
          "step": 2,
          "action": "System validates consent (GDPR Art. 7)",
          "encryption": "Store consent record immutably",
          "compliance": "GDPR A2, CCPA C1"
        },
        {
          "step": 3,
          "action": "User account created in database",
          "encryption": "AES-256 encryption at rest",
          "pii_handling": "Email address encrypted, password hashed (bcrypt)"
        },
        {
          "step": 4,
          "action": "Audit event logged",
          "encryption": "Immutable append-only log",
          "retention": "730 days"
        }
      ],
      "gdpr_controls": ["A1", "A2", "A3", "A8"],

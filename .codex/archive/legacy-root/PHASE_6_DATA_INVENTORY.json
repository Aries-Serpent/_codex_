      "soc2_controls": ["C1.1", "C1.2", "P1.1"]
    },
    {
      "flow_id": "FLOW-002",
      "flow_name": "User Data Export (Right to Access)",
      "description": "User requests and downloads personal data",
      "data_categories": ["DATA-001", "DATA-002", "DATA-003"],
      "steps": [
        {
          "step": 1,
          "action": "User initiates export request via API",
          "api_endpoint": "POST /api/v1/user/export",
          "compliance": "GDPR Art. 15, CCPA Art. 1798.100"
        },
        {
          "step": 2,
          "action": "System retrieves all user data",
          "encryption": "Database query over TLS 1.3+",
          "data_included": ["email", "profile", "consent records", "transaction history"]
        },
        {
          "step": 3,
          "action": "System generates CSV/JSON export",
          "encryption": "Encrypt file with user's password",
          "retention": "Delete after 7 days (GDPR requirement)"
        },
        {
          "step": 4,
          "action": "User downloads export file",
          "encryption": "TLS 1.3+ download, file decryption on user device",
          "audit": "Log export in audit trail (actor, timestamp, size)"
        }
      ],
      "sla_days": 30,
      "gdpr_controls": ["A5"],
      "ccpa_controls": ["C1"],
      "soc2_controls": ["I1.1", "I1.2"]
    },
    {
      "flow_id": "FLOW-003",
      "flow_name": "Breach Detection & Notification",
      "description": "System detects breach and notifies DPA",
      "data_categories": ["DATA-001", "DATA-002", "DATA-006"],
      "steps": [
        {
          "step": 1,
          "action": "Security scanner detects unauthorized access",
          "detection": "IDS/IPS, log analysis, anomaly detection"
        },
        {
          "step": 2,
          "action": "Incident created (P1 severity)",
          "escalation": "CISO + CCO notified via SMS/Slack",
          "timeline": "T+15 minutes"
        },
        {
          "step": 3,
          "action": "Initial investigation: scope, impact, affected users",
          "timeline": "T+1-4 hours"
        },
        {
          "step": 4,
          "action": "DPA notification prepared",
          "timeline": "T+24-48 hours"
        },
        {
          "step": 5,
          "action": "Notification submitted to DPA",
          "compliance": "GDPR Art. 33 (72-hour SLA)",
          "timeline": "T+72 hours (deadline)"
        },
        {
          "step": 6,
          "action": "User notification sent (if high risk)",
          "compliance": "GDPR Art. 34, CCPA",
          "timeline": "T+5 days"
        }
      ],
      "sla_hours": 72,
      "gdpr_controls": ["A7"],
      "ccpa_controls": ["C1"],

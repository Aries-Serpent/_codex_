{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDALoopLogger Output",
  "type": "object",
  "required": ["status", "action"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "error"]},
    "action": {"type": "string"},
    "message": {"type": "string"},
    "entry": {
      "type": "object",
      "description": "Single logged entry (log_* actions)"
    },
    "entries": {
      "type": "array",
      "description": "List of entries or summary rows (summarize / query actions)",
      "items": {"type": "object"}
    },
    "total": {"type": "integer"},
    "total_patterns": {"type": "integer"}
  }
}

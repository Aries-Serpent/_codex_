{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["paths", "style", "actions"],
  "properties": {
    "paths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Directory or file paths to scan"
    },
    "style": {
      "type": "string",
      "enum": ["aais"],
      "default": "aais"
    },
    "prune_stale": {
      "type": "boolean",
      "default": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["score", "plan", "apply"]
      }
    }
  },
  "additionalProperties": false
}

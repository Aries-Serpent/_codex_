{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["run_logs"],
  "properties": {
    "run_logs": {
      "type": "string",
      "description": "Raw CI log text from the failing workflow run"
    },
    "workflow_name": {
      "type": "string",
      "description": "Workflow display name (e.g. 'Validation Pipeline')"
    },
    "commit_sha": {
      "type": "string",
      "description": "Commit SHA of the failing run for cross-reference"
    }
  },
  "additionalProperties": false
}

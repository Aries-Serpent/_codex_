{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDALoopLogger Input",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["log_failure", "log_fix", "log_session", "summarize", "query"],
      "description": "Operation to perform"
    },
    "session": {"type": "string", "description": "Session ID (e.g. S293)"},
    "pr": {"type": "integer", "description": "PR number"},
    "branch": {"type": "string"},
    "pattern_id": {"type": "string", "description": "PDA pattern ID (e.g. RP-007)"},
    "workflow": {"type": "string"},
    "workflow_run": {"type": ["integer", "string"]},
    "error_text": {"type": "string"},
    "root_cause": {"type": "string"},
    "fix_template": {"type": "string"},
    "fix_applied": {"type": "string"},
    "verification_cmd": {"type": "string"},
    "verification_passed": {"type": "boolean"},
    "summary": {"type": "string"},
    "commit": {"type": "string"},
    "limit": {"type": "integer", "default": 20}
  },
  "additionalProperties": false
}

an_evidence(audit)\n                for rule in pattern_rules.get(\"bayesian\", []):\n                    rule_ev: dict[str, str] = rule.get(\"evidence\", {})\n                    # All rule evidence key-value pairs must match\n                    if not all(evidence.get(k) == v for k, v in rule_ev.items()):\n                        continue\n                    target_val: str = rule.get(\"target_value\", \"\")\n                    effect: float = float(rule.get(\"effect\", 1.0))\n                    if target_val in decision_names:\n                        idx = decision_names.index(target_val)\n                        tuned[idx] = min(1.0, tuned[idx] * effect)"},"startColumn":13,"startLine":681}}}],"message":{"text":"Safe module validation using explicit whitelist checks"},"properties":{},"ruleId":"semgrep.rules.suppress-safe-module-validation"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":67,"endLine":696,"snippet":{"text":"            if os.getenv(\"CODEX_BAYESIAN_MODE\", \"false\").lower() in (\n                \"true\",\n                \"1\",\n                \"yes\",\n            ):\n                evidence = self._extract_bayesian_evidence(audit)\n                for rule in pattern_rules.get(\"bayesian\", []):\n                    rule_ev: dict[str, str] = rule.get(\"evidence\", {})\n                    # All rule evidence key-value pairs must match\n                    if not all(evidence.get(k) == v for k, v in rule_ev.items()):\n                        continue\n                    target_val: str = rule.get(\"target_value\", \"\")\n                    effect: float = float(rule.get(\"effect\", 1.0))\n                    if target_val in decision_names:\n                        idx = decision_names.index(target_val)\n                        tuned[idx] = min(1.0, tuned[idx] * effect)"},"startColumn":13,"startLine":681}}}],"message":{"text":"URL validation in utility code - verified safe by manual review"},"properties":{},"ruleId":"semgrep.rules.suppress-url-substring-check-in-utilities"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":14,"endLine":685,"snippet":{"text":"            if os.getenv(\"CODEX_BAYESIAN_MODE\", \"false\").lower() in (\n                \"true\",\n                \"1\",\n                \"yes\",\n            ):"},"startColumn":16,"startLine":681}}}],"message":{"text":"URL validation in utility code - verified safe by manual review"},"properties":{},"ruleId":"semgrep.rules.suppress-url-substring-check-in-utilities"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":67,"endLine":696,"snippet":{"text":"                    if target_val in decision_names:\n                        idx = decision_names.index(target_val)\n                        tuned[idx] = min(1.0, tuned[idx] * effect)"},"startColumn":21,"startLine":694}}}],"message":{"text":"Safe module validation using explicit whitelist checks"},"properties":{},"ruleId":"semgrep.rules.suppress-safe-module-validation"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":67,"endLine":696,"snippet":{"text":"                    if target_val in decision_names:\n                        idx = decision_names.index(target_val)\n                        tuned[idx] = min(1.0, tuned[idx] * effect)"},"startColumn":21,"startLine":694}}}],"message":{"text":"URL validation in utility code - verified safe by manual review"},"properties":{},"ruleId":"semgrep.rules.suppress-url-substring-check-in-utilities"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":52,"endLine":694,"snippet":{"text":"                    if target_val in decision_names:"},"startColumn":24,"startLine":694}}}],"message":{"text":"URL validation in utility code - verified safe by manual review"},"properties":{},"ruleId":"semgrep.rules.suppress-url-substring-check-in-utilities"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":87,"endLine":725,"snippet":{"text":"            if os.getenv(\"CODEX_FUZZY_MODE\", \"false\").lower() in (\"true\", \"1\", \"yes\"):\n                fuzzy_rules: dict[str, Any] = pattern_rules.get(\"fuzzy\", {})\n                if fuzzy_rules:\n                    try:\n                        from cognitive_brain.analytics.fuzzy import FuzzyEngine\n\n                        base_engine = FuzzyEngine()\n                        tuned_engine = base_engine.apply_membership_tuning(fuzzy_rules)\n                        # Use fuzzy blend to potentially override the current winner\n                        current_best_name = (\n                            decision_names[tuned.index(max(tuned))].lower().replace(\"_\", \" \")\n                        )\n                        fuzzy_decision = tuned_engine.fuzzy_blend(\n                            current_best_name,\n                            audit.score,\n                            audit.business_impact,\n                            audit.remediation_cost,\n                        )\n                        # If fuzzy overrides to a different decision, apply a 1.15x boost\n                        if fuzzy_decision != current_best_name:\n                            # Normalise fuzzy decision name to our enum format\n                            fuzzy_norm = fuzzy_decision.upper().replace(\" \", \"_\")\n                            if fuzzy_norm in decision_names:\n                                idx = decision_names.index(fuzzy_norm)\n                                tuned[idx] = min(1.0, tuned[idx] * 1.15)\n                    except (ValueError, TypeError, RuntimeError):\n                        logger.debug(\"Suppressed exception in handler\", exc_info=True)"},"startColumn":13,"startLine":699}}}],"message":{"text":"Safe module validation using explicit whitelist checks"},"properties":{},"ruleId":"semgrep.rules.suppress-safe-module-validation"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/cognitive_brain/integrations/compliance_integration.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":87,"endLine":725,"snippet":{"text":"            if os.getenv(\"CODEX_FUZZY_MODE\", \"false\").lower() in (\"true\", \"1\", \"yes\"):\n                fuzzy_rules: dict[str, Any] = pattern_rules.get(\"fuzzy\", {})\n                if fuzzy_rules:\n                    try:\n                        from cognitive_brain.analytics.fuzzy import FuzzyEngine\n\n                        base_engine = FuzzyEngine()\n                        tuned_engine = base_engine.apply_membership_tuning(fuzzy_rules)\n                        # Use fuzzy blend to potentially override the current winner\n                        current_best_name = (\n                            decision_names[tuned.index(max(tuned))].lower().replace(\"_\", \" \")\n                        )\n                        fuzzy_decision = tuned_engine.fuzzy_blend(\n                            current_best_name,\n                            audit.score,\n                            audit.business_impact,\n                        
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.internal/schemas/decision.json",
  "title": "Decision Record Schema",
  "description": "Records decisions made in design or implementation with rationale",
  "type": "object",
  "required": ["id", "type", "title", "context", "decision_date"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique decision identifier (UUID v4)",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 255
    },
    "type": {
      "type": "string",
      "enum": ["decision"],
      "description": "Record type discriminator"
    },
    "title": {
      "type": "string",
      "description": "Decision title",
      "minLength": 1,
      "maxLength": 255
    },
    "context": {
      "type": "string",
      "description": "Context and background for the decision",
      "minLength": 1
    },
    "decision_date": {
      "type": "string",
      "description": "When the decision was made (YYYY-MM-DD format)",
      "format": "date"
    },
    "block_id": {
      "type": ["string", "null"],
      "description": "Source block ID if decision is in documentation",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "options": {
      "type": "array",
      "description": "Evaluated options",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Option name",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Option description",
            "minLength": 1
          },
          "pros": {
            "type": "array",
            "description": "Advantages of this option",
            "items": {"type": "string", "minLength": 1}
          },
          "cons": {
            "type": "array",
            "description": "Disadvantages of this option",
            "items": {"type": "string", "minLength": 1}
          },
          "effort": {
            "type": "string",
            "description": "Effort estimate (e.g., '2d')",
            "pattern": "^\\d+[hd]$"
          }
        },
        "additionalProperties": false
      }
    },
    "choice": {
      "type": ["string", "integer", "null"],
      "description": "Index or name of chosen option"
    },
    "rationale": {
      "type": ["string", "null"],
      "description": "Explanation of why this option was chosen"
    },
    "consequences": {
      "type": ["string", "null"],
      "description": "Expected consequences of the decision"
    },
    "alternatives_rejected": {
      "type": "array",
      "description": "Brief explanations of rejected alternatives",
      "items": {"type": "string", "minLength": 1}
    },
    "participants": {
      "type": "array",
      "description": "Decision makers/participants",
      "items": {"type": "string", "minLength": 1}
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "decided", "implemented", "superseded"],
      "description": "Decision status"
    },
    "review_date": {
      "type": ["string", "null"],
      "description": "Recommended review date (YYYY-MM-DD format)",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "description": "Decision tags",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}

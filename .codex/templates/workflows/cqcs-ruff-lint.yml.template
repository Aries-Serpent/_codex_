# Reusable Workflow: Ruff Linting
# Part of Code Quality & Coverage Suite Decomposition
# Generated: 2026-02-11

name: CQCS - Ruff Lint Analysis

on:
  workflow_call:
    outputs:
      status:
        description: 'Lint analysis status'
        value: ${{ jobs.ruff_lint.outputs.status }}
      issues_count:
        description: 'Number of issues found'
        value: ${{ jobs.ruff_lint.outputs.issues_count }}

permissions:
  contents: read

jobs:
  ruff_lint:
    name: Ruff Linting
    runs-on: ubuntu-latest
    outputs:
      status: ${{ steps.lint.outcome }}
      issues_count: ${{ steps.count.outputs.count }}
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v6
      
      - name: Setup Python with caching
        uses: ./.github/actions/setup-python-cached
        with:
          python-version: '3.12'
          cache-tier: 'live'
      
      # Note: Ruff installed via pip, caching handled by setup-python-cached action
      
      - name: Install ruff only
        run: |
          python -m pip install --upgrade pip
          pip install ruff
      
      - name: Run Ruff linting
        id: lint
        continue-on-error: true
        run: |
          echo "## Ruff Analysis" >> $GITHUB_STEP_SUMMARY
          
          # Run Ruff once with GitHub format for annotations
          ruff check src/ tests/ --output-format=github
          
          # Run Ruff once with JSON for downstream analysis
          ruff check src/ tests/ --output-format=json > ruff-result.json 2>/dev/null || echo '[]' > ruff-result.json
          
          # Generate statistics from JSON
          python -c "
          import json
          import collections
          from pathlib import Path
          
          try:
              with open('ruff-result.json', 'r') as f:
                  data = json.load(f)
              
              counter = collections.Counter()
              for item in data:
                  code = item.get('code', 'UNKNOWN')
                  counter[code] += 1
              
              total = sum(counter.values())
              stats = []
              for code, count in counter.most_common():
                  stats.append(f'{code}: {count}')
              
              with open('ruff-stats.txt', 'w') as f:
                  f.write('\n'.join(stats))
                  if stats:
                      f.write(f'\nTotal: {total}\n')
          except Exception as e:
              Path('ruff-stats.txt').write_text(f'Stats generation failed: {e}\n')
          "
          
          cat ruff-stats.txt >> $GITHUB_STEP_SUMMARY || echo "No issues found" >> $GITHUB_STEP_SUMMARY
      
      - name: Count issues
        id: count
        run: |
          count=$(python -c "import sys, json; data = json.load(open('ruff-result.json')); print(len(data))" 2>/dev/null || echo "0")
          echo "count=$count" >> $GITHUB_OUTPUT
          echo "Found $count issues" >> $GITHUB_STEP_SUMMARY
      
      - name: Upload results
        uses: actions/upload-artifact@v6
        with:
          name: ruff-results-${{ github.run_number }}
          path: ruff-stats.txt
          if-no-files-found: ignore
          retention-days: 30

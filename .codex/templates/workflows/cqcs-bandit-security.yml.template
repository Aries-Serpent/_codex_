# Reusable Workflow: Bandit Security Analysis
# Part of Code Quality & Coverage Suite Decomposition
# Generated: 2026-02-11

name: CQCS - Bandit Security

on:
  workflow_call:
    outputs:
      status:
        description: 'Security scan status'
        value: ${{ jobs.bandit_scan.outputs.status }}
      issues_count:
        description: 'Number of security issues found'
        value: ${{ jobs.bandit_scan.outputs.issues_count }}
      severity:
        description: 'Highest severity level found'
        value: ${{ jobs.bandit_scan.outputs.severity }}

permissions:
  contents: read

jobs:
  bandit_scan:
    name: Security Scan (Bandit)
    runs-on: ubuntu-latest
    outputs:
      status: ${{ steps.scan.outcome }}
      issues_count: ${{ steps.count.outputs.count }}
      severity: ${{ steps.count.outputs.severity }}
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v6
      
      - name: Setup Python with caching
        uses: ./.github/actions/setup-python-cached
        with:
          python-version: '3.12'
          cache-tier: 'live'
      
      - name: Install bandit only
        run: |
          python -m pip install --upgrade pip
          pip install bandit
      
      - name: Run Bandit security scan
        id: scan
        continue-on-error: true
        run: |
          echo "## Security Analysis (Bandit)" >> $GITHUB_STEP_SUMMARY
          bandit -r src/ -f json -o bandit-report.json || true
          bandit -r src/ -f txt | tee bandit-output.txt || true
          echo '```' >> $GITHUB_STEP_SUMMARY
          tail -30 bandit-output.txt >> $GITHUB_STEP_SUMMARY || echo "No issues found" >> $GITHUB_STEP_SUMMARY
          echo '```' >> $GITHUB_STEP_SUMMARY
      
      - name: Count issues and severity
        id: count
        run: |
          if [ -f bandit-report.json ]; then
            count=$(python -c "import json; data = json.load(open('bandit-report.json')); print(len(data.get('results', [])))" 2>/dev/null || echo "0")
            severity=$(python -c "import json; data = json.load(open('bandit-report.json')); severities = [r['issue_severity'] for r in data.get('results', [])]; print(max(severities, default='NONE'))" 2>/dev/null || echo "NONE")
          else
            count="0"
            severity="NONE"
          fi
          echo "count=$count" >> $GITHUB_OUTPUT
          echo "severity=$severity" >> $GITHUB_OUTPUT
          echo "Found $count security issues (highest: $severity)" >> $GITHUB_STEP_SUMMARY
      
      - name: Upload results
        uses: actions/upload-artifact@v6
        with:
          name: bandit-results-${{ github.run_number }}
          path: |
            bandit-report.json
            bandit-output.txt
          if-no-files-found: ignore
          retention-days: 30

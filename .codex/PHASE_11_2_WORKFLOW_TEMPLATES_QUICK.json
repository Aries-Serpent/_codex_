{
  "version": "1.0",
  "description": "PHASE 11.2 Quick Workflow Templates — 10 production workflows for multi-agent orchestration",
  "templates": [
    {
      "id": "test-suite-execution",
      "name": "Test Suite Execution",
      "description": "Execute unit tests, integration tests, validate coverage",
      "stages": [
        {
          "name": "unit-tests",
          "agent": "ci-testing-agent",
          "input": {
            "source_code": "src/**/*.py",
            "test_type": "unit"
          },
          "output": "test_results.json"
        },
        {
          "name": "integration-tests",
          "agent": "integration-test-runner",
          "input": {
            "depends_on": "unit-tests",
            "test_type": "integration"
          },
          "output": "integration_results.json"
        },
        {
          "name": "coverage-validation",
          "agent": "unified-coverage-agent",
          "input": {
            "depends_on": ["unit-tests", "integration-tests"],
            "min_threshold": 80
          },
          "output": "coverage_report.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 1800
    },
    {
      "id": "security-validation",
      "name": "Security Validation Pipeline",
      "description": "SAST scan, dependency check, secret detection, remediation",
      "stages": [
        {
          "name": "codeql-scan",
          "agent": "codeql-alert-resolution-agent",
          "input": {
            "repository": "current",
            "languages": ["python", "javascript"]
          },
          "output": "codeql_alerts.json"
        },
        {
          "name": "dependency-check",
          "agent": "dependency-vulnerability-scanner",
          "input": {
            "depends_on": "codeql-scan",
            "check_types": ["vulnerable", "outdated"]
          },
          "output": "dependency_report.json"
        },
        {
          "name": "secret-detection",
          "agent": "secret-detection-agent",
          "input": {
            "depends_on": ["codeql-scan", "dependency-check"],
            "scan_types": ["credentials", "tokens", "api_keys"]
          },
          "output": "secrets_report.json"
        },
        {
          "name": "remediation",
          "agent": "security-alert-verification-agent",
          "input": {
            "depends_on": ["codeql-scan", "dependency-check", "secret-detection"],
            "auto_fix": true
          },
          "output": "remediation_applied.json"
        }
      ],
      "approval_required": true,
      "timeout_seconds": 2400
    },
    {
      "id": "documentation-update",
      "name": "Documentation Update Pipeline",
      "description": "Audit documentation, generate missing docs, publish updates",
      "stages": [
        {
          "name": "doc-audit",
          "agent": "documentation-quality-agent",
          "input": {
            "docs_path": "docs/**/*.md",
            "check_freshness": true,
            "check_accuracy": true
          },
          "output": "doc_audit_report.json"
        },
        {
          "name": "link-validation",
          "agent": "link-validator-agent",
          "input": {
            "depends_on": "doc-audit",
            "docs_path": "docs/**/*.md"
          },
          "output": "link_validation.json"
        },
        {
          "name": "doc-generation",
          "agent": "documentation-consolidator",
          "input": {
            "depends_on": ["doc-audit", "link-validation"],
            "auto_generate": true
          },
          "output": "generated_docs/"
        },
        {
          "name": "publish",
          "agent": "github-pages-manager",
          "input": {
            "depends_on": "doc-generation",
            "deploy_env": "production"
          },
          "output": "deploy_status.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 1200
    },
    {
      "id": "release-pipeline",
      "name": "Release Pipeline",
      "description": "Version bump, changelog generation, PyPI deployment, monitoring",
      "stages": [
        {
          "name": "version-update",
          "agent": "pypi-publishing-operations-agent",
          "input": {
            "release_type": "minor",
            "auto_bump": false
          },
          "output": "version.txt"
        },
        {
          "name": "changelog-gen",
          "agent": "documentation-consolidator",
          "input": {
            "depends_on": "version-update",
            "commit_range": "HEAD~50..HEAD"
          },
          "output": "CHANGELOG_DRAFT.md"
        },
        {
          "name": "package-publish",
          "agent": "packaging-validation-agent",
          "input": {
            "depends_on": ["version-update", "changelog-gen"],
            "target": "pypi"
          },
          "output": "publish_status.json"
        },
        {
          "name": "post-release-monitoring",
          "agent": "performance-monitor-agent",
          "input": {
            "depends_on": "package-publish",
            "monitor_duration_hours": 24
          },
          "output": "monitoring_results.json"
        }
      ],
      "approval_required": true,
      "timeout_seconds": 3600
    },
    {
      "id": "coverage-gap-fill",
      "name": "Coverage Gap Fill Pipeline",
      "description": "Analyze low-coverage modules, generate tests, validate coverage increase",
      "stages": [
        {
          "name": "gap-analysis",
          "agent": "unified-coverage-agent",
          "input": {
            "threshold_percentile": 25,
            "min_module_coverage": 50
          },
          "output": "gap_analysis.json"
        },
        {
          "name": "test-generation",
          "agent": "autonomous-test-healer-agent",
          "input": {
            "depends_on": "gap-analysis",
            "target_coverage": 85
          },
          "output": "generated_tests/"
        },
        {
          "name": "coverage-validation",
          "agent": "unified-coverage-agent",
          "input": {
            "depends_on": "test-generation",
            "expected_improvement_pct": 5
          },
          "output": "validation_report.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 1800
    },
    {
      "id": "ci-recovery",
      "name": "CI Recovery Pipeline",
      "description": "Diagnose CI failures, apply fixes, verify resolution",
      "stages": [
        {
          "name": "failure-diagnosis",
          "agent": "ci-testing-agent",
          "input": {
            "workflow_run_id": "{{workflow_run_id}}",
            "failed_jobs_only": true
          },
          "output": "diagnosis.json"
        },
        {
          "name": "apply-fixes",
          "agent": "ci-auto-healer-agent",
          "input": {
            "depends_on": "failure-diagnosis",
            "auto_apply": true
          },
          "output": "fixes_applied.json"
        },
        {
          "name": "verify-resolution",
          "agent": "workflow-health-monitor",
          "input": {
            "depends_on": "apply-fixes",
            "rerun_workflow": true
          },
          "output": "verification_result.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 1200
    },
    {
      "id": "performance-analysis",
      "name": "Performance Analysis Pipeline",
      "description": "Establish baseline, compare performance, generate report",
      "stages": [
        {
          "name": "baseline-run",
          "agent": "performance-monitor-agent",
          "input": {
            "baseline_ref": "HEAD~1",
            "num_runs": 5
          },
          "output": "baseline_metrics.json"
        },
        {
          "name": "current-run",
          "agent": "performance-monitor-agent",
          "input": {
            "depends_on": "baseline-run",
            "baseline_ref": "HEAD",
            "num_runs": 5
          },
          "output": "current_metrics.json"
        },
        {
          "name": "regression-detection",
          "agent": "performance-regression-detector",
          "input": {
            "depends_on": ["baseline-run", "current-run"],
            "threshold_pct": 5
          },
          "output": "regression_report.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 2400
    },
    {
      "id": "agent-health-check",
      "name": "Agent Health Check Pipeline",
      "description": "Monitor agent availability, performance, alert on anomalies, auto-recover",
      "stages": [
        {
          "name": "health-monitoring",
          "agent": "workflow-health-monitor",
          "input": {
            "agents": "all",
            "check_interval_minutes": 5
          },
          "output": "health_snapshot.json"
        },
        {
          "name": "anomaly-detection",
          "agent": "artifact-monitor-agent",
          "input": {
            "depends_on": "health-monitoring",
            "baseline_metrics": "historical"
          },
          "output": "anomalies.json"
        },
        {
          "name": "alerting",
          "agent": "ci-health-alert-agent",
          "input": {
            "depends_on": "anomaly-detection",
            "alert_channel": "github-issues"
          },
          "output": "alerts_sent.json"
        },
        {
          "name": "auto-recovery",
          "agent": "self-healing-orchestrator-agent",
          "input": {
            "depends_on": "alerting",
            "auto_recover": true
          },
          "output": "recovery_status.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 900
    },
    {
      "id": "code-review",
      "name": "Code Review Pipeline",
      "description": "Analyze code changes, generate review comments, recommend approval",
      "stages": [
        {
          "name": "static-analysis",
          "agent": "code-analysis-agent",
          "input": {
            "pull_request_number": "{{pr_number}}",
            "check_types": ["complexity", "duplication", "anti-patterns"]
          },
          "output": "analysis_results.json"
        },
        {
          "name": "security-review",
          "agent": "security-alert-verification-agent",
          "input": {
            "depends_on": "static-analysis",
            "pull_request_number": "{{pr_number}}"
          },
          "output": "security_review.json"
        },
        {
          "name": "generate-comments",
          "agent": "code-review",
          "input": {
            "depends_on": ["static-analysis", "security-review"],
            "pull_request_number": "{{pr_number}}",
            "post_comments": true
          },
          "output": "comments_posted.json"
        }
      ],
      "approval_required": false,
      "timeout_seconds": 600
    },
    {
      "id": "deployment-coordination",
      "name": "Deployment Coordination Pipeline",
      "description": "Plan deployment, execute stages, validate deployment, monitor health",
      "stages": [
        {
          "name": "deployment-plan",
          "agent": "orchestrator-agent",
          "input": {
            "target_env": "production",
            "deployment_strategy": "canary"
          },
          "output": "deployment_plan.json"
        },
        {
          "name": "execute-canary",
          "agent": "self-healing-orchestrator-agent",
          "input": {
            "depends_on": "deployment-plan",
            "canary_percentage": 10,
            "monitoring_duration_minutes": 15
          },
          "output": "canary_status.json"
        },
        {
          "name": "execute-full",
          "agent": "self-healing-orchestrator-agent",
          "input": {
            "depends_on": "execute-canary",
            "full_deployment": true
          },
          "output": "full_deployment_status.json"
        },
        {
          "name": "post-deployment-monitoring",
          "agent": "performance-monitor-agent",
          "input": {
            "depends_on": "execute-full",
            "monitor_duration_hours": 24,
            "alert_on_anomaly": true
          },
          "output": "monitoring_report.json"
        }
      ],
      "approval_required": true,
      "timeout_seconds": 3600
    }
  ],
  "schema_version": "1.0",
  "notes": "Session-scoped rapid deployment templates. 10 templates cover 80% of orchestration workflows. Each template auto-validates stage dependencies and enforces approval gates.",
  "deployment_date": "2025-01-09T12:00:00Z",
  "success_criteria": {
    "schemas_valid": true,
    "stage_dependencies_valid": true,
    "agent_references_valid": true,
    "timeout_reasonable": true
  }
}

  "title": "Performance Regression Detection Configuration",
  
  "detection_rules": {
    "global_settings": {
      "enabled": true,
      "check_frequency_minutes": 60,
      "lookback_window_hours": 24,
      "statistical_significance_alpha": 0.05,
      "block_on_critical": true,
      "auto_create_issues": true,
      "notify_channels": ["slack", "github", "email"]
    },

    "variance_thresholds": {
      "normal": {
        "percentage": 10,
        "classification": "acceptable",
        "action": "monitor",
        "alert": false,
        "description": "Normal operational variance, no action needed"
      },
      "warning": {
        "percentage": 15,
        "classification": "investigate",
        "action": "investigate",
        "alert": true,
        "alert_level": "warning",
        "description": "Investigate cause, may indicate optimization opportunity"
      },
      "investigation": {
        "percentage": 20,
        "classification": "root_cause_analysis",
        "action": "escalate",
        "alert": true,
        "alert_level": "critical",
        "description": "Root cause analysis required, track optimization"
      },
      "critical": {
        "percentage": 25,
        "classification": "regression",
        "action": "block_and_escalate",
        "alert": true,
        "alert_level": "critical",
        "block_pr": true,
        "description": "Critical regression, block PR, immediate escalation"
      }

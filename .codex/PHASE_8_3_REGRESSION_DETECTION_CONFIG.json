  "alert_actions": {
    "normal": {
      "create_pr_comment": false,
      "create_github_issue": false,
      "slack_notification": false,
      "email_notification": false,
      "block_pr": false,
      "escalate": false
    },
    "warning": {
      "create_pr_comment": true,
      "create_github_issue": false,
      "slack_notification": true,
      "email_notification": false,
      "block_pr": false,
      "escalate": false,
      "message_template": "warning_investigation_needed"
    },
    "investigation": {
      "create_pr_comment": true,
      "create_github_issue": true,
      "slack_notification": true,
      "email_notification": true,
      "block_pr": false,
      "escalate": true,
      "message_template": "investigation_required"
    },
    "critical": {
      "create_pr_comment": true,
      "create_github_issue": true,
      "slack_notification": true,
      "email_notification": true,
      "block_pr": true,
      "escalate": true,
      "escalate_to": "@mbaetiong",
      "message_template": "critical_regression_blocking"
    }
  },

  "statistical_tests": {
    "enabled": true,
    "method": "welch_ttest",
    "alpha": 0.05,
    "min_samples": 5,
    "effect_size_threshold": 0.20
  },

  "trending_detection": {
    "enabled": true,
    "window_days": 7,
    "alert_on_gradual_degradation": true,
    "degradation_threshold_pct": 5,
    "consecutive_weeks": 4
  },

  "exclusions": {
    "exclude_scheduled_maintenance": true,
    "exclude_infrastructure_issues": true,
    "exclude_experimental_runs": true,
    "exclude_failed_runs": true
  },

  "reporting": {
    "weekly_report": {
      "enabled": true,
      "day": "thursday",
      "time_utc": "18:00",
      "recipients": ["@performance-team", "@mbaetiong"],
      "format": "markdown"
    },
    "daily_summary": {
      "enabled": true,
      "time_utc": "09:00",
      "recipients": ["@perf-oncall"]
    }
  },

  "escalation_matrix": {
    "level_1": {
      "condition": "single_critical_regression",
      "owner": "@perf-oncall",
      "deadline_minutes": 60,
      "action": "investigate_and_mitigate"
    },
    "level_2": {
      "condition": "multiple_regressions_or_sustained_warning",
      "owner": "@engineering-manager",
      "deadline_hours": 4,
      "action": "root_cause_analysis"
    },
    "level_3": {
      "condition": "sla_violation_exceeds_5_percent",
      "owner": "@engineering-director",
      "deadline_hours": 24,
      "action": "process_improvement"
    }
  }

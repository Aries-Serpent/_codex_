# Semgrep ignore patterns — exclude third-party, vendor, and environment code

# Virtual environments (development only, not part of deliverable)
venv/
venv_test/
env/
.venv/

# Vendor dependencies (Pip vendor packages)
/venv_test/lib/

# Package caches
__pycache__/
*.egg-info/
.eggs/

# Build artifacts
build/
dist/

# Fix scripts often contain URL patterns for validation/remediation
fix_*.py

# Tool scripts may contain URL manipulation for legitimate purposes
tools/**

# Utility scripts often work with URLs for validation or processing
scripts/**

# Node/JavaScript dependencies
node_modules/

# IDE and local development files
.vscode/
.idea/
.DS_Store

# Documentation directory with security vulnerability examples and remediation reports
.codex/

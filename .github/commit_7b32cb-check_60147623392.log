     305.     def _calculate_severity(self, coverage: float) -> CoverageSeverity:
     306.         """Calculate severity level based on coverage percentage"""
     307.         if coverage >= 80:
     308.             return CoverageSeverity.LOW
     309.         elif coverage >= 70:
     310.             return CoverageSeverity.MEDIUM
     311.         elif coverage >= 60:
     312.             return CoverageSeverity.HIGH
     313.         else:
     314.             return CoverageSeverity.CRITICAL
     315.     
     316.     def enforce_thresholds(self, path: Path) -> EnforcementResult:
     317.         """
     318.         Enforce coverage thresholds and take action if below threshold
     319.         
     320.         Args:
     321.             path: Path to enforce coverage for
     322.             
     323.         Returns:
     324.             EnforcementResult with enforcement outcome
     325.         """
     326.         # Analyze coverage
     327.         reports = self.analyze_coverage(path)
     328.         
     329.         if not reports:
     330.             return EnforcementResult(
     331.                 passed=False,
     332.                 current_coverage=0.0,
     333.                 threshold=self.line_threshold,
     334.                 gaps_found=0,
     335.                 suggestions_generated=0,
     336.                 enforcement_actions=['No coverage data available']
     337.             )
     338.         
     339.         # Calculate aggregate coverage
     340.         total_lines = sum(r.total_lines for r in reports.values())
     341.         covered_lines = sum(r.covered_lines for r in reports.values())
     342.         current_coverage = (covered_lines / total_lines * 100) if total_lines > 0 else 0.0
     343.         
     344.         # Check threshold
     345.         passed = current_coverage >= self.line_threshold
     346.         
     347.         # Generate test suggestions if below threshold
     348.         suggestions = []
     349.         if not passed and self.auto_generate:
     350.             suggestions = self.generate_test_suggestions(reports)
     351.         
     352.         actions = []
     353.         if not passed:
     354.             actions.append(f"Coverage {current_coverage:.1f}% below threshold {self.line_threshold}%")
     355.             actions.append(f"Found {len(self.issues)} coverage gaps")
     356.             if suggestions:
     357.                 actions.append(f"Generated {len(suggestions)} test suggestions")
     358.         
     359.         return EnforcementResult(
     360.             passed=passed,
     361.             current_coverage=current_coverage,
     362.             threshold=self.line_threshold,
     363.             gaps_found=len(self.issues),
     364.             suggestions_generated=len(suggestions),
     365.             enforcement_actions=actions
     366.         )
     367.     
     368.     def generate_test_suggestions(self, reports: Dict[Path, CoverageReport]) -> List[TestGenerationSuggestion]:
     369.         """
     370.         Generate suggestions for new tests to improve coverage
     371.         
     372.         Args:
     373.             reports: Coverage reports to analyze
     374.             
     375.         Returns:
     376.             List of test generation suggestions
     377.         """
     378.         suggestions = []
     379.         
     380.         for file_path, report in reports.items():
     381.             # Skip if coverage is already good
     382.             if report.line_coverage >= self.line_threshold:
     383.                 continue
     384.             
     385.             # Generate suggestions for uncovered functions
     386.             for func_name in report.uncovered_functions:
     387.                 test_file = self._determine_test_file(file_path)
     388.                 test_template = self._generate_test_template(file_path, func_name)
     389.                 
     390.                 suggestion = TestGenerationSuggestion(
     391.                     target_file=file_path,
     392.                     target_function=func_name,
     393.                     test_file=test_file,
     394.                     test_template=test_template,
     395.                     coverage_impact=self._estimate_coverage_impact(report, func_name),
     396.                     priority=self._calculate_priority(report, func_name)
     397.                 )
     398.                 suggestions.append(suggestion)
     399.         
     400.         # Sort by priority
     401.         suggestions.sort(key=lambda s: (s.priority, -s.coverage_impact))
     402.         
     403.         return suggestions
     404.     
     405.     def _determine_test_file(self, source_file: Path) -> Path:
     406.         """Determine the appropriate test file for a source file"""
     407.         # Convert src/module.py to tests/test_module.py
     408.         parts = list(source_file.parts)
     409.         
     410.         if 'src' in parts:
     411.             idx = parts.index('src')
     412.             parts[idx] = 'tests'
     413.         
     414.         filename = source_file.stem
     415.         if not filename.startswith('test_'):
     416.             filename = f'test_{filename}'
     417.         parts[-1] = f'{filename}.py'
     418.         
     419.         return Path(*parts)
     420.     
     421.     def _generate_test_template(self, file_path: Path, func_name: str) -> str:
     422.         """Generate a test template for a function"""
     423.         module_name = file_path.stem
     424.         
     425.         template = f'''
     426. def test_{func_name}_basic():
     427.     """Test {func_name} basic functionality"""
     428.     # TODO: Implement test for {func_name}
     429.     # from {module_name} import {func_name}
     430.     # result = {func_name}()
     431.     # assert result is not None
     432.     pass
     433. 
     434. 
     435. def test_{func_name}_edge_cases():
     436.     """Test {func_name} edge cases"""
     437.     # TODO: Test edge cases for {func_name}
     438.     pass
     439. '''
     440.         return template.strip()
     441.     
     442.     def _estimate_coverage_impact(self, report: CoverageReport, func_name: str) -> float:
     443.         """Estimate how much coverage would improve by testing this function"""
     444.         # Simplified estimation
     445.         functions = self._extract_functions(report.file_path)
     446.         func_lines = [f for f in functions if f[0] == func_name]
     447.         
     448.         if not func_lines or report.total_lines == 0:
     449.             return 0.0
     450.         
     451.         func_line_count = func_lines[0][2] - func_lines[0][1]
     452.         return (func_line_count / report.total_lines) * 100
     453.     
     454.     def _calculate_priority(self, report: CoverageReport, func_name: str) -> int:
     455.         """Calculate priority for testing a function (1=highest, 5=lowest)"""
     456.         # Higher priority for functions in files with very low coverage
     457.         if report.line_coverage < 50:
     458.             return 1
     459.         elif report.line_coverage < 70:
     460.             return 2
     461.         elif report.line_coverage < 80:
     462.             return 3
     463.         else:
     464.             return 4
     465.     
     466.     def generate_coverage_report(self, output_format: str = 'text') -> str:
     467.         """
     468.         Generate human-readable coverage report
     469.         
     470.         Args:
     471.             output_format: 'text', 'json', or 'html'
     472.             
     473.         Returns:
     474.             Formatted coverage report
     475.         """
     476.         if output_format == 'json':
     477.             return self._generate_json_report()
     478.         elif output_format == 'html':
     479.             return self._generate_html_report()
     480.         else:
     481.             return self._generate_text_report()
     482.     
     483.     def _generate_text_report(self) -> str:
     484.         """Generate text format coverage report"""
     485.         lines = [

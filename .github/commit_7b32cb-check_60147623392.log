     14.     python -m documentation_sync_validator.src.agent validate --all
     15.     python -m documentation_sync_validator.src.agent check-freshness docs/
     16.     python -m documentation_sync_validator.src.agent semantic-check src/ docs/
     17. """
     18. 
     19. import re
     20. import ast
     21. import hashlib
     22. from pathlib import Path
     23. from typing import Dict, List, Optional, Tuple, Set
     24. from dataclasses import dataclass, field
     25. from datetime import datetime, timezone
     26. from enum import Enum
     27. import yaml
     28. 
     29. 
     30. class DriftSeverity(Enum):
     31.     """Severity levels for documentation drift"""
     32.     NONE = "none"
     33.     LOW = "low"
     34.     MEDIUM = "medium"
     35.     HIGH = "high"
     36.     CRITICAL = "critical"
     37. 
     38. 
     39. class FreshnessStatus(Enum):
     40.     """Documentation freshness status"""
     41.     FRESH = "fresh"  # <30 days
     42.     AGING = "aging"  # 30-90 days
     43.     STALE = "stale"  # >90 days
     44. 
     45. 
     46. @dataclass
     47. class DocumentationIssue:
     48.     """Represents a detected documentation issue"""
     49.     file_path: Path
     50.     issue_type: str  # 'freshness', 'semantic_drift', 'broken_link', 'schema_violation'
     51.     severity: DriftSeverity
     52.     description: str
     53.     line_number: Optional[int] = None
     54.     suggested_fix: Optional[str] = None
     55.     confidence: float = 1.0
     56. 
     57. 
     58. @dataclass
     59. class FreshnessReport:
     60.     """Report on documentation freshness"""
     61.     file_path: Path
     62.     last_modified: datetime
     63.     age_days: int
     64.     status: FreshnessStatus
     65.     related_code_files: List[Path] = field(default_factory=list)
     66. 
     67. 
     68. @dataclass
     69. class SemanticDriftReport:
     70.     """Report on semantic drift between code and documentation"""
     71.     doc_file: Path
     72.     code_file: Path
     73.     similarity_score: float  # 0.0 to 1.0
     74.     drift_severity: DriftSeverity
     75.     mismatched_concepts: List[str] = field(default_factory=list)
     76. 
     77. 
     78. class DocumentationSyncValidator:
     79.     """Main agent class for documentation synchronization validation"""
     80.     
     81.     def __init__(self, config_path: Optional[Path] = None):
     82.         """Initialize the agent with optional configuration"""
     83.         self.config = self._load_config(config_path)
     84.         self.freshness_threshold_days = self.config.get('freshness_threshold_days', 90)
     85.         self.semantic_drift_threshold = self.config.get('semantic_drift_threshold', 0.7)
     86.         self.link_check_timeout = self.config.get('link_check_timeout', 10)
     87.         self.issues: List[DocumentationIssue] = []
     88.     
     89.     def _load_config(self, config_path: Optional[Path]) -> Dict:
     90.         """Load agent configuration from YAML file"""
     91.         if config_path is None:

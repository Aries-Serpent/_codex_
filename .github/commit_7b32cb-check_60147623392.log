           def test_patch_priority_sorting(self, agent):
               """Test that patches are prioritized by risk score"""
               critical_vuln = Vulnerability(
                   cve_id="CVE-2024-CRIT",
                   severity="critical",
                   cvss_score=9.5,
                   affected_package="critical-pkg",
                   affected_versions=["1.0"],
                   fixed_version="2.0",
                   description="Critical",
                   published_date=datetime.now(timezone.utc)
               )
               
               low_vuln = Vulnerability(
                   cve_id="CVE-2024-LOW",
                   severity="low",
                   cvss_score=2.0,
                   affected_package="low-pkg",
                   affected_versions=["1.0"],
                   fixed_version="2.0",
                   description="Low",
                   published_date=datetime.now(timezone.utc)
               )
               
               patch1 = agent.generate_patch(critical_vuln)
               patch2 = agent.generate_patch(low_vuln)
               
               # Sort patches by risk score
               sorted_patches = sorted(
                   [patch1, patch2],
                   key=lambda p: agent.calculate_risk_score(p.vulnerability),
                   reverse=True
               )
               
               assert sorted_patches[0].vulnerability.cve_id == "CVE-2024-CRIT"
               assert sorted_patches[1].vulnerability.cve_id == "CVE-2024-LOW"
       
       

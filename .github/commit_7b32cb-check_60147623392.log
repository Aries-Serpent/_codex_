       ## Example 4: Multi-Vulnerability Patching Workflow
       
       ### Scenario
       Handle multiple vulnerabilities across different ecosystems in a monorepo.
       
       ```python
       from security_vulnerability_patcher.src.agent import SecurityVulnerabilityPatcher
       from collections import defaultdict
       
       def patch_monorepo(repo_path):
           agent = SecurityVulnerabilityPatcher()
           
           # Scan entire monorepo
           print("🔍 Scanning monorepo...")
           vulnerabilities = agent.scan_vulnerabilities(repo_path)
           
           # Group by ecosystem
           by_ecosystem = defaultdict(list)
           for vuln in vulnerabilities:
               if vuln.ecosystem:
                   by_ecosystem[vuln.ecosystem.value].append(vuln)
           
           print(f"\nFound vulnerabilities in {len(by_ecosystem)} ecosystems:")
           for eco, vulns in by_ecosystem.items():
               print(f"  {eco}: {len(vulns)} vulnerabilities")
           
           # Track results
           results = {
               'total': len(vulnerabilities),
               'patched': 0,
               'failed': 0,
               'skipped': 0
           }
           
           # Process each ecosystem
           for ecosystem, vulns in by_ecosystem.items():
               print(f"\n{'='*60}")
               print(f"Processing {ecosystem.upper()} vulnerabilities...")
               print(f"{'='*60}")
               
               # Sort by risk
               sorted_vulns = sorted(
                   vulns,
                   key=lambda v: agent.calculate_risk_score(v),
                   reverse=True
               )
               
               for vuln in sorted_vulns:
                   print(f"\n📦 {vuln.affected_package} - {vuln.cve_id}")
                   print(f"   Severity: {vuln.severity.upper()} (CVSS: {vuln.cvss_score})")
                   
                   # Generate patch
                   patch = agent.generate_patch(vuln)
                   if not patch:
                       print(f"   ⏭️  No fix available - skipping")
                       results['skipped'] += 1
                       continue
                   
                   print(f"   📝 Patch: {patch.current_version} → {patch.target_version}")
                   
                   # Validate
                   validation = agent.validate_patch_security(patch)
                   if not validation['passed']:
                       print(f"   ❌ Validation failed:")
                       for issue in validation['issues_found']:
                           print(f"      - {issue['message']}")
                       results['failed'] += 1
                       continue
                   
                   # Determine test command based on ecosystem
                   test_commands = {
                       'python': 'pytest',
                       'javascript': 'npm test',
                       'rust': 'cargo test',
                       'go': 'go test ./...'
                   }
                   test_cmd = test_commands.get(ecosystem)
                   
                   # Test
                   if test_cmd:
                       print(f"   🧪 Testing with: {test_cmd}")
                       test_results = agent.test_patch(patch, test_command=test_cmd)
                       
                       if not test_results['passed']:
                           print(f"   ❌ Tests failed - not applying")
                           results['failed'] += 1
                           continue
                       
                       print(f"   ✅ Tests passed ({test_results['tests_passed']} tests)")
                   
                   # Apply
                   print(f"   🔨 Applying patch...")
                   apply_results = agent.apply_patch(patch, dry_run=False)
                   
                   if apply_results['success']:
                       print(f"   ✅ Patch applied successfully")
                       results['patched'] += 1
                   else:
                       print(f"   ❌ Application failed")
                       results['failed'] += 1
           
           # Final summary
           print(f"\n{'='*60}")
           print(f"FINAL SUMMARY")
           print(f"{'='*60}")
           print(f"Total Vulnerabilities: {results['total']}")
           print(f"Successfully Patched:  {results['patched']} ✅")
           print(f"Failed:                {results['failed']} ❌")
           print(f"Skipped:               {results['skipped']} ⏭️")
           print(f"Success Rate:          {results['patched']/results['total']*100:.1f}%")
           
           # Generate report
           report = agent.generate_patch_report()
           
           print(f"\n📊 Risk Metrics:")
           print(f"Total Risk Reduced: {report.total_risk_reduced:.2f}")
           print(f"\nSeverity Breakdown:")
           for severity, count in report.severity_breakdown.items():
               print(f"  {severity.upper()}: {count}")
           
           print(f"\nRecommendations:")
           for rec in report.recommendations:
               print(f"  • {rec}")
           
           return report
       
       # Execute
       report = patch_monorepo("./my-monorepo")
       ```
       

           def generate_patch(self, vulnerability: Vulnerability) -> Optional[Patch]:
               """
               Generate a patch for a given vulnerability.
               
               Args:
                   vulnerability: Vulnerability to patch
                   
               Returns:
                   Patch object with proposed changes
               """
               if not vulnerability.fixed_version:
                   return None
               
               # Generate unique patch ID
               patch_id = self._generate_patch_id(vulnerability)
               
               # Determine changes needed
               changes = self._calculate_patch_changes(vulnerability)
               
               # Create patch object
               patch = Patch(
                   id=patch_id,
                   vulnerability=vulnerability,
                   target_package=vulnerability.affected_package,
                   current_version=vulnerability.affected_versions[0] if vulnerability.affected_versions else "unknown",
                   target_version=vulnerability.fixed_version,
                   changes=changes,
                   status=PatchStatus.PENDING,
                   created_at=datetime.now(timezone.utc)
               )
               
               # Assess risk
               patch.risk_assessment = self._assess_patch_risk(patch)
               
               self.patches[patch_id] = patch
               return patch
           
           def _generate_patch_id(self, vulnerability: Vulnerability) -> str:
               """Generate unique patch ID"""
               data = f"{vulnerability.cve_id}_{vulnerability.affected_package}_{datetime.now().isoformat()}"
               return hashlib.sha256(data.encode()).hexdigest()[:16]
           
           def _calculate_patch_changes(self, vulnerability: Vulnerability) -> Dict[str, Any]:
               """Calculate what file changes are needed for the patch"""
               changes = {
                   'files_to_modify': [],
                   'version_updates': {
                       vulnerability.affected_package: {
                           'from': vulnerability.affected_versions[0] if vulnerability.affected_versions else "unknown",
                           'to': vulnerability.fixed_version
                       }
                   },
                   'breaking_changes': False,
                   'requires_code_changes': False
               }
               
               # Determine which files need modification
               if vulnerability.ecosystem == Ecosystem.PYTHON:
                   changes['files_to_modify'].extend(['requirements.txt', 'setup.py', 'pyproject.toml'])
               elif vulnerability.ecosystem == Ecosystem.JAVASCRIPT:
                   changes['files_to_modify'].extend(['package.json', 'package-lock.json'])
               elif vulnerability.ecosystem == Ecosystem.RUST:
                   changes['files_to_modify'].extend(['Cargo.toml', 'Cargo.lock'])
               elif vulnerability.ecosystem == Ecosystem.GO:
                   changes['files_to_modify'].extend(['go.mod', 'go.sum'])
               
               return changes
           
           def _assess_patch_risk(self, patch: Patch) -> str:
               """Assess the risk level of applying a patch"""
               vuln = patch.vulnerability
               
               # High risk if major version change
               try:
                   current_major = int(patch.current_version.split('.')[0])
                   target_major = int(patch.target_version.split('.')[0])
                   
                   if target_major > current_major:
                       return RiskLevel.HIGH.value
               except (ValueError, IndexError):
                   pass
               
               # Medium risk for high/critical vulnerabilities
               if vuln.severity in ['high', 'critical']:
                   return RiskLevel.MEDIUM.value
               
               return RiskLevel.LOW.value
           
           def validate_patch_security(self, patch: Patch) -> Dict[str, Any]:
               """
               Validate that a patch doesn't introduce new security issues.
               
               Args:
                   patch: Patch to validate
                   
               Returns:
                   Validation results dictionary
               """
               validation_results = {
                   'passed': True,
                   'checks_performed': [],
                   'issues_found': [],
                   'timestamp': datetime.now(timezone.utc).isoformat()
               }
               
               # Check 1: Verify target version exists and is valid
               check_name = "target_version_validity"
               validation_results['checks_performed'].append(check_name)
               
               if not patch.target_version or patch.target_version == "unknown":
                   validation_results['passed'] = False
                   validation_results['issues_found'].append({
                       'check': check_name,
                       'severity': 'high',
                       'message': 'Target version is invalid or unknown'
                   })
               
               # Check 2: Scan target version for known vulnerabilities
               check_name = "target_version_vulnerabilities"
               validation_results['checks_performed'].append(check_name)
               
               target_vulns = self._query_cve_databases(
                   package=patch.target_package,
                   version=patch.target_version,
                   ecosystem=patch.vulnerability.ecosystem or Ecosystem.PYTHON
               )
               
               if target_vulns:
                   validation_results['passed'] = False
                   for vuln in target_vulns:
                       validation_results['issues_found'].append({
                           'check': check_name,
                           'severity': vuln.severity,
                           'message': f'Target version has vulnerability: {vuln.cve_id}',
                           'cve_id': vuln.cve_id
                       })
               
               # Check 3: Verify patch doesn't introduce breaking changes without tests
               check_name = "breaking_changes_coverage"
               validation_results['checks_performed'].append(check_name)
               
               if patch.changes.get('breaking_changes') and not patch.test_results:
                   validation_results['issues_found'].append({
                       'check': check_name,
                       'severity': 'medium',
                       'message': 'Patch may introduce breaking changes - testing recommended'
                   })
               
               patch.validation_results = validation_results
               return validation_results
           
           def test_patch(self, patch: Patch, test_command: Optional[str] = None) -> Dict[str, Any]:
               """
               Test a patch by applying it in a temporary environment and running tests.
               
               Args:
                   patch: Patch to test
                   test_command: Optional custom test command
                   
               Returns:
                   Test results dictionary
               """
               test_results = {
                   'passed': False,
                   'tests_run': 0,
                   'tests_passed': 0,
                   'tests_failed': 0,
                   'output': '',
                   'timestamp': datetime.now(timezone.utc).isoformat()
               }
               
               patch.status = PatchStatus.TESTING
               
               try:
                   # Create temporary directory for testing
                   with tempfile.TemporaryDirectory() as temp_dir:
                       temp_path = Path(temp_dir)
                       
                       # Copy current project to temp directory
                       # (In production, this would copy the actual project files)
                       
                       # Apply patch in temp environment
                       self._apply_patch_to_files(patch, temp_path, dry_run=False)
                       
                       # Run tests
                       if test_command:
                           result = subprocess.run(
                               test_command,
                               shell=True,
                               cwd=temp_path,
                               capture_output=True,
                               text=True,
                               timeout=300
                           )
                           
                           test_results['output'] = result.stdout + result.stderr
                           test_results['passed'] = (result.returncode == 0)
                           
                           # Try to parse test output for counts
                           self._parse_test_output(result.stdout, test_results)
                       else:
                           # No test command provided, consider it passed
                           test_results['passed'] = True
                           test_results['output'] = 'No tests configured'
               
               except subprocess.TimeoutExpired:
                   test_results['passed'] = False
                   test_results['output'] = 'Test execution timed out'
               except Exception as e:
                   test_results['passed'] = False
                   test_results['output'] = f'Test execution failed: {str(e)}'
               
               patch.test_results = test_results
               
               if test_results['passed']:
                   patch.status = PatchStatus.VALIDATED
               else:
                   patch.status = PatchStatus.FAILED
               
               return test_results
           
           def _parse_test_output(self, output: str, test_results: Dict[str, Any]):
               """Parse test output to extract test counts"""
               # Try to extract test counts from common test frameworks
               
               # pytest format: "X passed, Y failed"
               match = re.search(r'(\d+) passed', output)
               if match:
                   test_results['tests_passed'] = int(match.group(1))
               
               match = re.search(r'(\d+) failed', output)
               if match:
                   test_results['tests_failed'] = int(match.group(1))
               
               # Jest format: "Tests: X passed, Y total"
               match = re.search(r'Tests:\s+(\d+) passed,\s+(\d+) total', output)
               if match:
                   test_results['tests_passed'] = int(match.group(1))
                   test_results['tests_run'] = int(match.group(2))
                   test_results['tests_failed'] = test_results['tests_run'] - test_results['tests_passed']
           
           def apply_patch(self, patch: Patch, dry_run: bool = True) -> Dict[str, Any]:
               """
               Apply a security patch to the repository.
               
               Args:
                   patch: Patch to apply
                   dry_run: If True, only simulate the patch application
                   
               Returns:
                   Results dictionary with status and details
               """
               results = {
                   'success': False,
                   'dry_run': dry_run,
                   'files_modified': [],
                   'backup_created': False,
                   'timestamp': datetime.now(timezone.utc).isoformat()
               }
               
               try:
                   # Validate patch is ready to apply
                   if patch.status not in [PatchStatus.VALIDATED, PatchStatus.PENDING]:
                       results['error'] = f'Patch status is {patch.status.value}, cannot apply'
                       return results
                   
                   # Create backup if configured
                   if self.config.get('patch_strategy', {}).get('create_backup', True) and not dry_run:
                       self._create_backup(patch)
                       results['backup_created'] = True
                   
                   # Apply changes to files
                   modified_files = self._apply_patch_to_files(patch, Path.cwd(), dry_run)
                   results['files_modified'] = modified_files
                   
                   if not dry_run:
                       patch.status = PatchStatus.APPLIED
                       patch.applied_at = datetime.now(timezone.utc)
                   
                   results['success'] = True
               
               except Exception as e:
                   results['error'] = str(e)
                   if not dry_run:
                       patch.status = PatchStatus.FAILED
               
               return results
           
           def _create_backup(self, patch: Patch):
               """Create backup of files before applying patch"""
               backup_dir = Path('.codex/backups') / f"patch_{patch.id}"
               backup_dir.mkdir(parents=True, exist_ok=True)
               
               patch.rollback_info = {
                   'backup_dir': str(backup_dir),
                   'timestamp': datetime.now(timezone.utc).isoformat()
               }
           
           def _apply_patch_to_files(
               self,
               patch: Patch,
               base_path: Path,
               dry_run: bool
           ) -> List[str]:
               """Apply patch changes to actual files"""
               modified_files = []
               
               for file_name in patch.changes.get('files_to_modify', []):
                   file_path = base_path / file_name
                   
                   if not file_path.exists():
                       continue
                   
                   if not dry_run:
                       # Actually modify the file
                       self._update_version_in_file(
                           file_path,
                           patch.target_package,
                           patch.target_version
                       )
                   
                   modified_files.append(file_name)
               
               return modified_files
           
           def _update_version_in_file(
               self,
               file_path: Path,
               package: str,
               new_version: str
           ):
               """Update package version in a dependency file"""
               try:
                   with open(file_path, 'r') as f:
                       content = f.read()
                   
                   # Update version based on file type
                   if file_path.name == 'requirements.txt':
                       pattern = rf'^({package}\s*[=><!]+\s*)([0-9.]+)'
                       replacement = rf'\g<1>{new_version}'
                       content = re.sub(pattern, replacement, content, flags=re.MULTILINE)
                   
                   elif file_path.name == 'package.json':
                       data = json.loads(content)
                       for dep_type in ['dependencies', 'devDependencies']:
                           if dep_type in data and package in data[dep_type]:
                               data[dep_type][package] = new_version
                       content = json.dumps(data, indent=2)
                   
                   elif file_path.name == 'Cargo.toml':
                       pattern = rf'^({package}\s*=\s*["\'])([0-9.]+)'
                       replacement = rf'\g<1>{new_version}'
                       content = re.sub(pattern, replacement, content, flags=re.MULTILINE)
                   
                   elif file_path.name == 'go.mod':
                       pattern = rf'({package}\s+v?)([0-9.]+)'
                       replacement = rf'\g<1>{new_version}'
                       content = re.sub(pattern, replacement, content)
                   
                   with open(file_path, 'w') as f:
                       f.write(content)
               
               except Exception as e:
                   print(f"Error updating {file_path}: {e}")
           
           def rollback_patch(self, patch_id: str) -> Dict[str, Any]:
               """
               Rollback a previously applied patch.
               
               Args:
                   patch_id: ID of patch to rollback
                   
               Returns:
                   Results dictionary with status
               """
               results = {
                   'success': False,
                   'timestamp': datetime.now(timezone.utc).isoformat()
               }
               
               if patch_id not in self.patches:
                   results['error'] = f'Patch {patch_id} not found'
                   return results
               
               patch = self.patches[patch_id]
               
               if patch.status != PatchStatus.APPLIED:
                   results['error'] = f'Patch is not applied (status: {patch.status.value})'
                   return results
               
               try:
                   # Restore from backup if available
                   if patch.rollback_info and 'backup_dir' in patch.rollback_info:
                       backup_dir = Path(patch.rollback_info['backup_dir'])
                       if backup_dir.exists():
                           # Restore files from backup
                           for backup_file in backup_dir.iterdir():
                               target_file = Path.cwd() / backup_file.name
                               shutil.copy2(backup_file, target_file)
                   else:
                       # Revert version changes
                       for file_name in patch.changes.get('files_to_modify', []):
                           file_path = Path.cwd() / file_name
                           if file_path.exists():
                               self._update_version_in_file(
                                   file_path,
                                   patch.target_package,
                                   patch.current_version
                               )
                   
                   patch.status = PatchStatus.ROLLED_BACK
                   results['success'] = True
               
               except Exception as e:
                   results['error'] = str(e)
               
               return results
           
           def calculate_risk_score(self, vulnerability: Vulnerability) -> float:
               """
               Calculate comprehensive risk score for a vulnerability.
               
               Args:
                   vulnerability: Vulnerability to assess
                   
               Returns:
                   Risk score (0-10)
               """
               base_score = vulnerability.cvss_score
               
               # Adjust based on exploit availability
               if vulnerability.exploit_available:
                   base_score += 1.0
               
               # Adjust based on patch availability
               if not vulnerability.patch_available:
                   base_score += 0.5
               
               # Cap at 10.0
               return min(base_score, 10.0)
           
           def generate_patch_report(self) -> PatchReport:
               """
               Generate comprehensive report of all patches and vulnerabilities.
               
               Returns:
                   PatchReport with full details
               """
               # Count patches by status
               patched = sum(1 for p in self.patches.values() if p.status == PatchStatus.APPLIED)
               failed = sum(1 for p in self.patches.values() if p.status == PatchStatus.FAILED)
               
               # Breakdown by ecosystem
               ecosystem_breakdown = {}
               for vuln in self.vulnerabilities:
                   if vuln.ecosystem:
                       eco_name = vuln.ecosystem.value
                       ecosystem_breakdown[eco_name] = ecosystem_breakdown.get(eco_name, 0) + 1
               
               # Breakdown by severity
               severity_breakdown = {}
               for vuln in self.vulnerabilities:
                   sev = vuln.severity
                   severity_breakdown[sev] = severity_breakdown.get(sev, 0) + 1
               
               # Calculate total risk reduced
               total_risk = sum(
                   self.calculate_risk_score(p.vulnerability)
                   for p in self.patches.values()
                   if p.status == PatchStatus.APPLIED
               )
               
               # Generate recommendations
               recommendations = []
               if failed > 0:
                   recommendations.append(f'{failed} patches failed - review logs and retry')
               
               critical_unpatched = sum(
                   1 for v in self.vulnerabilities
                   if v.severity == 'critical' and not any(
                       p.vulnerability.cve_id == v.cve_id and p.status == PatchStatus.APPLIED
                       for p in self.patches.values()
                   )
               )
               if critical_unpatched > 0:
                   recommendations.append(f'{critical_unpatched} critical vulnerabilities remain unpatched')
               
               report = PatchReport(
                   scan_timestamp=datetime.now(timezone.utc),
                   vulnerabilities_found=len(self.vulnerabilities),
                   vulnerabilities_patched=patched,
                   vulnerabilities_failed=failed,
                   patches=list(self.patches.values()),
                   ecosystem_breakdown=ecosystem_breakdown,
                   severity_breakdown=severity_breakdown,
                   total_risk_reduced=total_risk,
                   recommendations=recommendations
               )
               
               return report
       
       
       def main():
           """CLI entry point"""
           import argparse
           
           parser = argparse.ArgumentParser(
               description='Security Vulnerability Patcher Agent'
           )
           parser.add_argument(
               'command',
               choices=['scan', 'patch', 'test', 'validate', 'apply', 'rollback', 'report'],
               help='Command to execute'
           )

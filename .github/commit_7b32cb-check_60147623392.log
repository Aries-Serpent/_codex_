           print("🔒 Running Security Gate...")
           
           # Scan
           vulnerabilities = agent.scan_vulnerabilities(".")
           
           # Count by severity
           critical = [v for v in vulnerabilities if v.severity == "critical"]
           high = [v for v in vulnerabilities if v.severity == "high"]
           medium = [v for v in vulnerabilities if v.severity == "medium"]
           low = [v for v in vulnerabilities if v.severity == "low"]
           
           print(f"\nVulnerability Summary:")
           print(f"  Critical: {len(critical)}")
           print(f"  High: {len(high)}")
           print(f"  Medium: {len(medium)}")
           print(f"  Low: {len(low)}")
           
           # Gate policy
           exit_code = 0
           
           if critical:
               print(f"\n❌ DEPLOYMENT BLOCKED: {len(critical)} critical vulnerabilities")
               for vuln in critical:
                   print(f"   - {vuln.cve_id} in {vuln.affected_package}")
               exit_code = 1
           
           if len(high) > 3:
               print(f"\n❌ DEPLOYMENT BLOCKED: Too many high severity vulnerabilities ({len(high)})")
               exit_code = 1
           
           if exit_code == 0:
               print(f"\n✅ Security Gate PASSED - Deployment allowed")
           else:
               print(f"\n🚫 Security Gate FAILED - Deployment blocked")
               print(f"\nTo proceed:")
               print(f"  1. Run: python -m security_vulnerability_patcher.src.agent patch")
               print(f"  2. Review and apply patches")
               print(f"  3. Re-run security gate")
           
           sys.exit(exit_code)
       
       if __name__ == "__main__":
           security_gate()
       ```
       

           def _scan_go_vulnerabilities(self, path: Path) -> List[Vulnerability]:
               """Scan Go dependencies for vulnerabilities"""
               vulnerabilities = []
               
               # Find go.mod files
               go_files = []
               if path.is_file() and path.name == "go.mod":

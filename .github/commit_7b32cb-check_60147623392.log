       ## Pattern 4: Automated Security Testing
       
       ### Overview
       
       Integrate automated security testing into the patching workflow to ensure patches don't introduce new vulnerabilities.
       
       ### Security Test Suite
       
       ```python
       from typing import List, Dict, Optional
       import subprocess
       import json
       
       class SecurityTestSuite:
           """Comprehensive security testing for patches"""
           
           def __init__(self):
               self.agent = SecurityVulnerabilityPatcher()
               self.test_results = {}
           
           def run_full_security_suite(self, patch) -> Dict:
               """Run complete security test suite"""
               print(f"Running full security test suite for patch {patch.id}...")
               
               results = {
                   'patch_id': patch.id,
                   'overall_passed': True,
                   'tests': {}
               }
               
               # Test 1: Static Analysis
               print("\n1️⃣  Running static analysis...")
               static_results = self._run_static_analysis()
               results['tests']['static_analysis'] = static_results
               
               if not static_results['passed']:
                   results['overall_passed'] = False
                   print("   ❌ Static analysis found issues")
               else:
                   print("   ✅ Static analysis passed")
               
               # Test 2: Dependency Security Scan
               print("\n2️⃣  Scanning dependencies...")
               dep_results = self._scan_dependencies_security()
               results['tests']['dependency_scan'] = dep_results
               
               if not dep_results['passed']:
                   results['overall_passed'] = False
                   print("   ❌ Dependency scan found issues")
               else:
                   print("   ✅ Dependency scan passed")
               
               # Test 3: SAST (Static Application Security Testing)
               print("\n3️⃣  Running SAST...")
               sast_results = self._run_sast()
               results['tests']['sast'] = sast_results
               
               if not sast_results['passed']:
                   results['overall_passed'] = False
                   print("   ❌ SAST found issues")
               else:
                   print("   ✅ SAST passed")
               
               # Test 4: License Compliance
               print("\n4️⃣  Checking license compliance...")
               license_results = self._check_license_compliance(patch)
               results['tests']['license_compliance'] = license_results
               
               if not license_results['passed']:
                   results['overall_passed'] = False
                   print("   ❌ License compliance issues found")
               else:
                   print("   ✅ License compliance passed")
               
               # Test 5: Secret Scanning
               print("\n5️⃣  Scanning for secrets...")
               secret_results = self._scan_for_secrets()
               results['tests']['secret_scan'] = secret_results
               
               if not secret_results['passed']:
                   results['overall_passed'] = False
                   print("   ❌ Secrets found")
               else:
                   print("   ✅ No secrets found")
               
               return results
           
           def _run_static_analysis(self) -> Dict:
               """Run static code analysis"""
               results = {
                   'passed': True,
                   'tool': 'bandit',
                   'issues': []
               }
               
               try:
                   result = subprocess.run(
                       'bandit -r . -f json',
                       shell=True,
                       capture_output=True,
                       timeout=300
                   )
                   
                   if result.returncode != 0:
                       # Parse bandit output
                       try:
                           bandit_output = json.loads(result.stdout)
                           results['issues'] = [
                               {
                                   'severity': issue['issue_severity'],
                                   'confidence': issue['issue_confidence'],
                                   'text': issue['issue_text'],
                                   'file': issue['filename'],
                                   'line': issue['line_number']
                               }
                               for issue in bandit_output.get('results', [])
                           ]
                           
                           # Only fail on high severity issues
                           high_severity = [i for i in results['issues'] if i['severity'] == 'HIGH']
                           if high_severity:
                               results['passed'] = False
                               
                       except json.JSONDecodeError:
                           pass
                           
               except Exception as e:
                   results['error'] = str(e)
                   results['passed'] = False
               
               return results
           
           def _scan_dependencies_security(self) -> Dict:
               """Scan dependencies for known vulnerabilities"""
               results = {
                   'passed': True,
                   'tool': 'safety',
                   'vulnerabilities': []
               }
               
               try:
                   result = subprocess.run(
                       'safety check --json',
                       shell=True,
                       capture_output=True,
                       timeout=300
                   )
                   
                   if result.returncode != 0:
                       try:
                           safety_output = json.loads(result.stdout)
                           results['vulnerabilities'] = safety_output
                           
                           # Check severity
                           critical_vulns = [
                               v for v in results['vulnerabilities']
                               if v.get('severity', '').lower() == 'critical'
                           ]
                           
                           if critical_vulns:
                               results['passed'] = False
                               
                       except json.JSONDecodeError:
                           pass
                           
               except Exception as e:
                   results['error'] = str(e)
               
               return results
           
           def _run_sast(self) -> Dict:
               """Run SAST (Static Application Security Testing)"""
               results = {
                   'passed': True,
                   'tool': 'semgrep',
                   'findings': []
               }
               
               try:
                   result = subprocess.run(
                       'semgrep --config=auto --json .',
                       shell=True,
                       capture_output=True,
                       timeout=300
                   )
                   
                   if result.stdout:
                       try:
                           semgrep_output = json.loads(result.stdout)
                           results['findings'] = semgrep_output.get('results', [])
                           
                           # Only fail on high severity findings
                           high_severity = [
                               f for f in results['findings']
                               if f.get('extra', {}).get('severity') == 'ERROR'
                           ]
                           
                           if high_severity:
                               results['passed'] = False
                               
                       except json.JSONDecodeError:
                           pass
                           
               except Exception as e:
                   results['error'] = str(e)
               
               return results
           
           def _check_license_compliance(self, patch) -> Dict:
               """Check license compliance for new dependencies"""
               results = {
                   'passed': True,
                   'licenses': {},
                   'incompatible': []
               }
               
               # Allowed licenses (example)
               allowed_licenses = [
                   'MIT', 'Apache-2.0', 'BSD-3-Clause', 'BSD-2-Clause', 'ISC'
               ]
               
               # Check license of target package
               # In production, query package registry for license info
               target_package = patch.target_package
               target_version = patch.target_version
               
               # Simulate license check
               # In production: query PyPI, npm, crates.io, etc.
               license_info = self._get_package_license(target_package, target_version)
               
               results['licenses'][target_package] = license_info
               
               if license_info not in allowed_licenses:
                   results['incompatible'].append({
                       'package': target_package,
                       'license': license_info
                   })
                   results['passed'] = False
               
               return results
           
           def _get_package_license(self, package: str, version: str) -> str:
               """Get license for a package"""
               # In production, query package registries
               # For now, return mock
               return 'MIT'
           
           def _scan_for_secrets(self) -> Dict:
               """Scan for accidentally committed secrets"""
               results = {
                   'passed': True,
                   'tool': 'trufflehog',
                   'secrets_found': []
               }
               
               try:
                   result = subprocess.run(
                       'trufflehog filesystem . --json',
                       shell=True,
                       capture_output=True,
                       timeout=300
                   )
                   
                   if result.stdout:
                       # Parse findings
                       for line in result.stdout.decode().split('\n'):
                           if line.strip():
                               try:
                                   finding = json.loads(line)
                                   results['secrets_found'].append(finding)
                               except json.JSONDecodeError:
                                   pass
                       
                       if results['secrets_found']:
                           results['passed'] = False
                           
               except Exception as e:
                   results['error'] = str(e)
               
               return results
       
       
       # Example usage
       security_suite = SecurityTestSuite()
       
       # Get patch
       agent = SecurityVulnerabilityPatcher()
       vulnerabilities = agent.scan_vulnerabilities(".")
       
       if vulnerabilities:
           vuln = vulnerabilities[0]
           patch = agent.generate_patch(vuln)
           
           if patch:
               # Run security tests
               test_results = security_suite.run_full_security_suite(patch)
               
               print(f"\n{'='*60}")
               print(f"SECURITY TEST RESULTS")
               print(f"{'='*60}")
               print(f"Overall: {'✅ PASSED' if test_results['overall_passed'] else '❌ FAILED'}")
               
               for test_name, test_result in test_results['tests'].items():
                   status = '✅' if test_result['passed'] else '❌'
                   print(f"  {status} {test_name.replace('_', ' ').title()}")
       ```
       

 function:
   name: create
   args:
     file_text: |
       name: 'Security Vulnerability Patcher'
       description: 'Automatically detects and patches security vulnerabilities in dependencies'
       author: 'Codex Security Team'
       
       inputs:
         path:
           description: 'Path to scan for vulnerabilities'
           required: false
           default: '.'
         ecosystem:
           description: 'Ecosystem to scan (python, javascript, rust, go, or all)'
           required: false
           default: 'all'
         severity-threshold:
           description: 'Minimum severity to patch (low, medium, high, critical)'
           required: false
           default: 'high'
         auto-patch:
           description: 'Automatically apply patches (true/false)'
           required: false
           default: 'false'
         test-patches:
           description: 'Test patches before applying (true/false)'
           required: false
           default: 'true'
         create-pr:
           description: 'Create pull request with patches (true/false)'
           required: false
           default: 'true'
         test-command:
           description: 'Custom test command to run'
           required: false
           default: ''
         config-path:
           description: 'Path to agent configuration file'
           required: false
           default: '.github/agents/security-vulnerability-patcher/config/agent_config.yaml'
         dry-run:
           description: 'Simulate patching without applying changes (true/false)'
           required: false
           default: 'false'
       
       outputs:
         vulnerabilities-found:
           description: 'Number of vulnerabilities found'
           value: ${{ steps.patch.outputs.vulnerabilities-found }}
         patches-generated:
           description: 'Number of patches generated'
           value: ${{ steps.patch.outputs.patches-generated }}
         patches-applied:
           description: 'Number of patches successfully applied'
           value: ${{ steps.patch.outputs.patches-applied }}
         patches-failed:
           description: 'Number of patches that failed'
           value: ${{ steps.patch.outputs.patches-failed }}
         report-path:
           description: 'Path to the generated patch report'
           value: ${{ steps.patch.outputs.report-path }}
         risk-reduced:
           description: 'Total risk score reduced'
           value: ${{ steps.patch.outputs.risk-reduced }}
       
       runs:
         using: 'composite'
         steps:
           - name: Checkout code
             uses: actions/checkout@v4
             with:
               fetch-depth: 0
       
           - name: Setup Python
             uses: actions/setup-python@v5
             with:
               python-version: '3.11'
       
           - name: Install dependencies
             shell: bash
             run: |
               python -m pip install --upgrade pip
               pip install pyyaml pytest
       
           - name: Run vulnerability scan
             id: scan
             shell: bash
             working-directory: ${{ github.action_path }}
             run: |
               echo "Starting vulnerability scan..."
               python src/agent.py scan \
                 --path "${{ inputs.path }}" \
                 --config "${{ inputs.config-path }}" \
                 > scan_results.json 2>&1 || true
               
               if [ -f scan_results.json ]; then
                 VULN_COUNT=$(grep -o 'Found [0-9]* vulnerabilities' scan_results.json | grep -o '[0-9]*' || echo "0")
                 echo "vulnerabilities-found=${VULN_COUNT}" >> $GITHUB_OUTPUT
                 echo "Found ${VULN_COUNT} vulnerabilities"
               else
                 echo "vulnerabilities-found=0" >> $GITHUB_OUTPUT
               fi
       
           - name: Generate and validate patches
             id: patch
             shell: bash
             working-directory: ${{ github.action_path }}
             run: |
               echo "Generating patches for vulnerabilities..."
               
               PATCHES_GENERATED=0
               PATCHES_APPLIED=0
               PATCHES_FAILED=0
               TOTAL_RISK_REDUCED=0.0
               
               # Create output directory
               mkdir -p patch_output
               
               # Run the patching workflow
               python -c "
               import sys
               import json
               from pathlib import Path
               sys.path.insert(0, 'src')
               from agent import SecurityVulnerabilityPatcher, PatchStatus
               
               agent = SecurityVulnerabilityPatcher(config_path='${{ inputs.config-path }}')
               
               # Scan for vulnerabilities
               print('Scanning for vulnerabilities...')
               vulnerabilities = agent.scan_vulnerabilities('${{ inputs.path }}')
               print(f'Found {len(vulnerabilities)} vulnerabilities')
               
               patches_generated = 0
               patches_applied = 0
               patches_failed = 0
               
               # Process each vulnerability
               for vuln in vulnerabilities:
                   # Check severity threshold
                   severity_order = {'low': 0, 'medium': 1, 'high': 2, 'critical': 3}
                   threshold = severity_order.get('${{ inputs.severity-threshold }}', 2)
                   vuln_severity = severity_order.get(vuln.severity, 0)
                   
                   if vuln_severity < threshold:
                       continue
                   
                   # Generate patch
                   patch = agent.generate_patch(vuln)
                   if not patch:
                       continue
                   
                   patches_generated += 1
                   print(f'Generated patch for {vuln.cve_id}')
                   
                   # Validate patch security
                   if '${{ inputs.test-patches }}' == 'true':
                       validation = agent.validate_patch_security(patch)
                       if not validation.get('passed', False):
                           print(f'Patch validation failed for {vuln.cve_id}')
                           patches_failed += 1
                           continue
                       
                       # Test patch if command provided
                       test_cmd = '${{ inputs.test-command }}'
                       if test_cmd:
                           test_results = agent.test_patch(patch, test_command=test_cmd)
                           if not test_results.get('passed', False):
                               print(f'Patch tests failed for {vuln.cve_id}')
                               patches_failed += 1
                               continue
                   
                   # Apply patch
                   if '${{ inputs.auto-patch }}' == 'true':
                       dry_run = '${{ inputs.dry-run }}' == 'true'
                       results = agent.apply_patch(patch, dry_run=dry_run)
                       if results.get('success', False):
                           patches_applied += 1
                           print(f'Applied patch for {vuln.cve_id}')
                       else:
                           patches_failed += 1
                           print(f'Failed to apply patch for {vuln.cve_id}')
               
               # Generate report
               report = agent.generate_patch_report()
               
               # Save report
               with open('patch_output/report.json', 'w') as f:
                   json.dump({
                       'vulnerabilities_found': len(vulnerabilities),
                       'patches_generated': patches_generated,
                       'patches_applied': patches_applied,
                       'patches_failed': patches_failed,
                       'risk_reduced': report.total_risk_reduced,
                       'ecosystem_breakdown': report.ecosystem_breakdown,
                       'severity_breakdown': report.severity_breakdown,
                       'recommendations': report.recommendations
                   }, f, indent=2, default=str)
               
               # Output metrics
               print(f'::set-output name=patches-generated::{patches_generated}')
               print(f'::set-output name=patches-applied::{patches_applied}')
               print(f'::set-output name=patches-failed::{patches_failed}')
               print(f'::set-output name=risk-reduced::{report.total_risk_reduced}')
               print(f'::set-output name=report-path::patch_output/report.json')
               " || true
               
               # Read outputs from report file if it exists
               if [ -f patch_output/report.json ]; then
                 PATCHES_GENERATED=$(cat patch_output/report.json | python -c "import sys, json; print(json.load(sys.stdin).get('patches_generated', 0))")
                 PATCHES_APPLIED=$(cat patch_output/report.json | python -c "import sys, json; print(json.load(sys.stdin).get('patches_applied', 0))")
                 PATCHES_FAILED=$(cat patch_output/report.json | python -c "import sys, json; print(json.load(sys.stdin).get('patches_failed', 0))")
                 RISK_REDUCED=$(cat patch_output/report.json | python -c "import sys, json; print(json.load(sys.stdin).get('risk_reduced', 0.0))")
                 
                 echo "patches-generated=${PATCHES_GENERATED}" >> $GITHUB_OUTPUT
                 echo "patches-applied=${PATCHES_APPLIED}" >> $GITHUB_OUTPUT
                 echo "patches-failed=${PATCHES_FAILED}" >> $GITHUB_OUTPUT
                 echo "risk-reduced=${RISK_REDUCED}" >> $GITHUB_OUTPUT
                 echo "report-path=patch_output/report.json" >> $GITHUB_OUTPUT
               else
                 echo "patches-generated=0" >> $GITHUB_OUTPUT
                 echo "patches-applied=0" >> $GITHUB_OUTPUT
                 echo "patches-failed=0" >> $GITHUB_OUTPUT
                 echo "risk-reduced=0.0" >> $GITHUB_OUTPUT
                 echo "report-path=" >> $GITHUB_OUTPUT
               fi
       
           - name: Upload patch report
             uses: actions/upload-artifact@v4
             if: always()
             with:
               name: security-patch-report
               path: ${{ github.action_path }}/patch_output/
               retention-days: 30
       
           - name: Create Pull Request
             if: inputs.create-pr == 'true' && steps.patch.outputs.patches-applied != '0'
             uses: peter-evans/create-pull-request@v6
             with:
               commit-message: 'security: patch vulnerabilities found by security-vulnerability-patcher'
               title: 'Security: Patch ${{ steps.patch.outputs.patches-applied }} vulnerabilities'
               body: |
                 ## Security Vulnerability Patches
                 
                 This PR contains automatic security patches generated by the security-vulnerability-patcher agent.
                 
                 ### Summary
                 - **Vulnerabilities Found**: ${{ steps.scan.outputs.vulnerabilities-found }}
                 - **Patches Applied**: ${{ steps.patch.outputs.patches-applied }}
                 - **Patches Failed**: ${{ steps.patch.outputs.patches-failed }}
                 - **Risk Reduced**: ${{ steps.patch.outputs.risk-reduced }}
                 
                 ### Details
                 See the attached patch report for full details: `${{ steps.patch.outputs.report-path }}`
                 
                 ### Review Checklist
                 - [ ] Review patch changes for correctness
                 - [ ] Verify all tests pass
                 - [ ] Check for breaking changes
                 - [ ] Review security validation results
                 
                 ---
                 *Generated by security-vulnerability-patcher agent*
               branch: security-patches-${{ github.run_id }}
               delete-branch: true
               labels: security, dependencies, automated
       
           - name: Comment on failure
             if: failure()
             shell: bash
             run: |
               echo "::error::Security vulnerability patching failed. Check the logs for details."
               if [ -f patch_output/report.json ]; then

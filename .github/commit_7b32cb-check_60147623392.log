           def _are_versions_compatible(self, versions: List[str], ecosystem: Ecosystem) -> bool:
               """Check if version list is compatible
               
               For conflict detection, we consider versions incompatible if they are
               explicitly different, even if they share a major version.
               """
               if len(versions) <= 1:
                   return True
               
               # Remove duplicates
               unique_versions = list(set(versions))
               if len(unique_versions) == 1:
                   return True
               
               # If we have different explicit versions, that's a conflict
               # (even if same major version)
               return False

       ## Pattern 2: CVSS Score Integration
       
       ### Overview
       
       Deep integration with CVSS (Common Vulnerability Scoring System) for precise risk assessment and prioritization.
       
       ### CVSS v3.1 Implementation
       
       ```python
       from dataclasses import dataclass
       from typing import Dict, Optional
       from enum import Enum
       
       class AttackVector(Enum):
           NETWORK = "N"
           ADJACENT = "A"
           LOCAL = "L"
           PHYSICAL = "P"
       
       class AttackComplexity(Enum):
           LOW = "L"
           HIGH = "H"
       
       class PrivilegesRequired(Enum):
           NONE = "N"
           LOW = "L"
           HIGH = "H"
       
       class UserInteraction(Enum):
           NONE = "N"
           REQUIRED = "R"
       
       class Scope(Enum):
           UNCHANGED = "U"
           CHANGED = "C"
       
       class Impact(Enum):
           NONE = "N"
           LOW = "L"
           HIGH = "H"
       
       @dataclass
       class CVSSv31Score:
           """CVSS v3.1 score breakdown"""
           # Base Metrics
           attack_vector: AttackVector
           attack_complexity: AttackComplexity
           privileges_required: PrivilegesRequired
           user_interaction: UserInteraction
           scope: Scope
           confidentiality_impact: Impact
           integrity_impact: Impact
           availability_impact: Impact
           
           # Temporal Metrics (optional)
           exploit_code_maturity: Optional[str] = None
           remediation_level: Optional[str] = None
           report_confidence: Optional[str] = None
           
           def calculate_base_score(self) -> float:
               """Calculate CVSS v3.1 base score"""
               # Simplified calculation (full implementation would be more complex)
               
               # Attack Vector scores
               av_scores = {"N": 0.85, "A": 0.62, "L": 0.55, "P": 0.2}
               # Attack Complexity scores
               ac_scores = {"L": 0.77, "H": 0.44}
               # Privileges Required scores
               pr_scores = {
                   "N": {"U": 0.85, "C": 0.85},
                   "L": {"U": 0.62, "C": 0.68},
                   "H": {"U": 0.27, "C": 0.50}
               }
               # User Interaction scores
               ui_scores = {"N": 0.85, "R": 0.62}
               # Impact scores
               impact_scores = {"N": 0.0, "L": 0.22, "H": 0.56}
               
               # Get metric values
               av = av_scores[self.attack_vector.value]
               ac = ac_scores[self.attack_complexity.value]
               pr_scope = "C" if self.scope == Scope.CHANGED else "U"
               pr = pr_scores[self.privileges_required.value][pr_scope]
               ui = ui_scores[self.user_interaction.value]
               
               # Calculate exploitability
               exploitability = 8.22 * av * ac * pr * ui
               
               # Calculate impact
               conf_impact = impact_scores[self.confidentiality_impact.value]
               integ_impact = impact_scores[self.integrity_impact.value]
               avail_impact = impact_scores[self.availability_impact.value]
               
               if self.scope == Scope.UNCHANGED:
                   impact = 6.42 * (1 - (1 - conf_impact) * (1 - integ_impact) * (1 - avail_impact))
               else:
                   impact = 7.52 * (1 - (1 - conf_impact) * (1 - integ_impact) * (1 - avail_impact)) - 0.029 - 3.25 * ((1 - (1 - conf_impact) * (1 - integ_impact) * (1 - avail_impact)) ** 0.15 - 0.02)
               
               # Calculate base score
               if impact <= 0:
                   return 0.0
               
               if self.scope == Scope.UNCHANGED:
                   base_score = min(impact + exploitability, 10.0)
               else:
                   base_score = min(1.08 * (impact + exploitability), 10.0)
               
               return round(base_score, 1)
           
           def calculate_temporal_score(self) -> float:
               """Calculate CVSS v3.1 temporal score"""
               base_score = self.calculate_base_score()
               
               # Temporal metrics (simplified)
               if not self.exploit_code_maturity:
                   return base_score
               
               # Apply temporal modifications
               temporal_modifiers = {
                   'exploit_maturity': {
                       'unproven': 0.91,
                       'proof_of_concept': 0.94,
                       'functional': 0.97,
                       'high': 1.0
                   },
                   'remediation': {
                       'official_fix': 0.95,
                       'temporary_fix': 0.96,
                       'workaround': 0.97,
                       'unavailable': 1.0
                   },
                   'confidence': {
                       'unknown': 0.92,
                       'reasonable': 0.96,
                       'confirmed': 1.0
                   }
               }
               
               # Apply modifiers
               temporal_score = base_score
               
               if self.exploit_code_maturity:
                   temporal_score *= temporal_modifiers['exploit_maturity'].get(
                       self.exploit_code_maturity, 1.0
                   )
               
               if self.remediation_level:
                   temporal_score *= temporal_modifiers['remediation'].get(
                       self.remediation_level, 1.0
                   )
               
               if self.report_confidence:
                   temporal_score *= temporal_modifiers['confidence'].get(
                       self.report_confidence, 1.0
                   )
               
               return round(temporal_score, 1)
           
           def get_severity_rating(self) -> str:
               """Get severity rating based on score"""
               score = self.calculate_base_score()
               
               if score == 0.0:
                   return "none"
               elif score <= 3.9:
                   return "low"
               elif score <= 6.9:
                   return "medium"
               elif score <= 8.9:
                   return "high"
               else:
                   return "critical"
       
       
       class CVSSIntegratedPatcher:
           """Patch agent with deep CVSS integration"""
           
           def __init__(self):
               self.agent = SecurityVulnerabilityPatcher()
           
           def analyze_vulnerability_with_cvss(self, cve_id: str) -> Dict:
               """Analyze vulnerability with detailed CVSS breakdown"""
               # Fetch vulnerability data
               vuln = self.agent.fetch_cve_data(cve_id)
               
               if not vuln:
                   return {'error': 'Vulnerability not found'}
               
               # Parse CVSS vector string (example: CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H)
               cvss_vector = self._parse_cvss_vector(vuln)
               
               if cvss_vector:
                   cvss_score = CVSSv31Score(
                       attack_vector=cvss_vector['AV'],
                       attack_complexity=cvss_vector['AC'],
                       privileges_required=cvss_vector['PR'],
                       user_interaction=cvss_vector['UI'],
                       scope=cvss_vector['S'],
                       confidentiality_impact=cvss_vector['C'],
                       integrity_impact=cvss_vector['I'],
                       availability_impact=cvss_vector['A']
                   )
                   
                   base_score = cvss_score.calculate_base_score()
                   severity = cvss_score.get_severity_rating()
                   
                   return {
                       'cve_id': cve_id,
                       'cvss_vector': cvss_vector,
                       'base_score': base_score,
                       'severity': severity,
                       'breakdown': {
                           'exploitability': {
                               'attack_vector': cvss_vector['AV'].value,
                               'attack_complexity': cvss_vector['AC'].value,
                               'privileges_required': cvss_vector['PR'].value,
                               'user_interaction': cvss_vector['UI'].value
                           },
                           'impact': {
                               'scope': cvss_vector['S'].value,
                               'confidentiality': cvss_vector['C'].value,
                               'integrity': cvss_vector['I'].value,
                               'availability': cvss_vector['A'].value
                           }
                       },
                       'assessment': self._generate_risk_assessment(cvss_score)
                   }
               
               return {'error': 'Could not parse CVSS data'}
           
           def _parse_cvss_vector(self, vuln) -> Optional[Dict]:
               """Parse CVSS vector string"""
               # In production, parse from CVE data
               # For now, return example
               return {
                   'AV': AttackVector.NETWORK,
                   'AC': AttackComplexity.LOW,
                   'PR': PrivilegesRequired.NONE,
                   'UI': UserInteraction.NONE,
                   'S': Scope.UNCHANGED,
                   'C': Impact.HIGH,
                   'I': Impact.HIGH,
                   'A': Impact.HIGH
               }
           
           def _generate_risk_assessment(self, cvss_score: CVSSv31Score) -> Dict:
               """Generate detailed risk assessment"""
               base_score = cvss_score.calculate_base_score()
               
               assessment = {
                   'overall_risk': 'critical' if base_score >= 9.0 else 'high',
                   'ease_of_exploitation': 'easy',
                   'attack_prerequisites': [],
                   'impact_severity': 'high',
                   'recommended_action': 'immediate_patching',
                   'business_impact': 'high'
               }
               
               # Analyze exploitability
               if cvss_score.attack_vector == AttackVector.NETWORK:
                   assessment['ease_of_exploitation'] = 'very_easy'
                   assessment['attack_prerequisites'].append('network_access')
               elif cvss_score.attack_vector == AttackVector.PHYSICAL:
                   assessment['ease_of_exploitation'] = 'difficult'
                   assessment['attack_prerequisites'].append('physical_access')
               
               if cvss_score.attack_complexity == AttackComplexity.HIGH:
                   assessment['ease_of_exploitation'] = 'moderate'
                   assessment['attack_prerequisites'].append('complex_conditions')
               
               if cvss_score.privileges_required != PrivilegesRequired.NONE:
                   assessment['attack_prerequisites'].append('authentication_required')
               
               if cvss_score.user_interaction == UserInteraction.REQUIRED:
                   assessment['attack_prerequisites'].append('user_interaction')
               
               # Analyze impact
               impacts = []
               if cvss_score.confidentiality_impact == Impact.HIGH:
                   impacts.append('data_breach')
               if cvss_score.integrity_impact == Impact.HIGH:
                   impacts.append('data_manipulation')
               if cvss_score.availability_impact == Impact.HIGH:
                   impacts.append('service_disruption')
               
               assessment['potential_impacts'] = impacts
               
               # Recommended action based on score
               if base_score >= 9.0:
                   assessment['recommended_action'] = 'immediate_patching'
                   assessment['time_to_patch'] = '< 24 hours'
               elif base_score >= 7.0:
                   assessment['recommended_action'] = 'urgent_patching'
                   assessment['time_to_patch'] = '< 7 days'
               elif base_score >= 4.0:
                   assessment['recommended_action'] = 'scheduled_patching'
                   assessment['time_to_patch'] = '< 30 days'
               else:
                   assessment['recommended_action'] = 'opportunistic_patching'
                   assessment['time_to_patch'] = 'next_release'
               
               return assessment
       
       
       # Example usage
       cvss_patcher = CVSSIntegratedPatcher()
       analysis = cvss_patcher.analyze_vulnerability_with_cvss("CVE-2024-1234")
       
       print("CVSS Analysis:")
       print(f"  CVE: {analysis['cve_id']}")
       print(f"  Base Score: {analysis['base_score']}")
       print(f"  Severity: {analysis['severity'].upper()}")
       print(f"\nExploitability:")
       print(f"  Attack Vector: {analysis['breakdown']['exploitability']['attack_vector']}")
       print(f"  Attack Complexity: {analysis['breakdown']['exploitability']['attack_complexity']}")
       print(f"\nImpact:")
       print(f"  Confidentiality: {analysis['breakdown']['impact']['confidentiality']}")
       print(f"  Integrity: {analysis['breakdown']['impact']['integrity']}")
       print(f"  Availability: {analysis['breakdown']['impact']['availability']}")
       print(f"\nRisk Assessment:")
       print(f"  Overall Risk: {analysis['assessment']['overall_risk'].upper()}")
       print(f"  Recommended Action: {analysis['assessment']['recommended_action']}")
       print(f"  Time to Patch: {analysis['assessment']['time_to_patch']}")
       ```
       

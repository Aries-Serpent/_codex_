     1. name: 'Test Coverage Enforcer'
     2. description: 'Enforce test coverage thresholds and generate missing tests'
     3. author: 'Codex Team'
     4. 
     5. inputs:
     6.   check-coverage:
     7.     description: 'Whether to check coverage against thresholds'
     8.     required: false
     9.     default: 'true'
     10.   
     11.   threshold:
     12.     description: 'Minimum line coverage threshold (percentage)'
     13.     required: false
     14.     default: '80'
     15.   
     16.   auto-generate:
     17.     description: 'Automatically generate test templates for uncovered code'
     18.     required: false
     19.     default: 'false'
     20.   
     21.   fail-below-threshold:
     22.     description: 'Fail the build if coverage is below threshold'
     23.     required: false
     24.     default: 'true'
     25.   
     26.   source-path:
     27.     description: 'Path to source code to analyze'
     28.     required: false
     29.     default: 'src'
     30.   
     31.   config-path:
     32.     description: 'Path to agent configuration file'
     33.     required: false
     34.     default: '.github/agents/test-coverage-enforcer/config/agent_config.yaml'
     35.   
     36.   output-format:
     37.     description: 'Report format (text, json, html)'
     38.     required: false
     39.     default: 'text'
     40.   
     41.   output-file:
     42.     description: 'Output file for coverage report'
     43.     required: false
     44.     default: 'coverage_report.txt'
     45. 
     46. outputs:
     47.   coverage-percentage:
     48.     description: 'Current overall coverage percentage'
     49.     value: ${{ steps.enforce.outputs.coverage }}
     50.   
     51.   passed:
     52.     description: 'Whether coverage enforcement passed'
     53.     value: ${{ steps.enforce.outputs.passed }}
     54.   
     55.   issues-found:
     56.     description: 'Number of coverage issues found'
     57.     value: ${{ steps.enforce.outputs.issues }}
     58.   
     59.   suggestions-generated:
     60.     description: 'Number of test suggestions generated'
     61.     value: ${{ steps.enforce.outputs.suggestions }}
     62. 
     63. runs:
     64.   using: 'composite'
     65.   steps:
     66.     - name: Set up Python
     67.       uses: actions/setup-python@v4
     68.       with:
     69.         python-version: '3.11'
     70.     
     71.     - name: Install dependencies
     72.       shell: bash
     73.       run: |
     74.         python -m pip install --upgrade pip
     75.         pip install coverage pytest pytest-cov pyyaml
     76.     
     77.     - name: Install agent
     78.       shell: bash
     79.       run: |
     80.         # Add agent to Python path
     81.         export PYTHONPATH="${GITHUB_WORKSPACE}/.github/agents/test-coverage-enforcer:${PYTHONPATH}"
     82.         echo "PYTHONPATH=${PYTHONPATH}" >> $GITHUB_ENV
     83.     
     84.     - name: Run coverage analysis
     85.       shell: bash
     86.       id: analyze
     87.       run: |
     88.         python -m pytest \
     89.           --cov=${{ inputs.source-path }} \
     90.           --cov-report=json:coverage.json \
     91.           --cov-report=term \
     92.           -v || true
     93.         
     94.         echo "Coverage analysis completed"
     95.     
     96.     - name: Enforce coverage thresholds
     97.       shell: bash
     98.       id: enforce
     99.       run: |
     100.         cd $GITHUB_WORKSPACE/.github/agents/test-coverage-enforcer
     101.         
     102.         # Run enforcement
     103.         if [ "${{ inputs.check-coverage }}" == "true" ]; then
     104.           python -m src.agent enforce \
     105.             --path "${{ inputs.source-path }}" \
     106.             --threshold ${{ inputs.threshold }} \
     107.             --format ${{ inputs.output-format }} \
     108.             --output "${{ inputs.output-file }}" > enforcement_output.txt
     109.           
     110.           ENFORCEMENT_EXIT_CODE=$?
     111.           
     112.           # Parse output
     113.           COVERAGE=$(grep -oP 'Current coverage: \K[\d.]+' enforcement_output.txt || echo "0")
     114.           PASSED=$(grep -q "PASSED" enforcement_output.txt && echo "true" || echo "false")
     115.           
     116.           echo "coverage=${COVERAGE}" >> $GITHUB_OUTPUT
     117.           echo "passed=${PASSED}" >> $GITHUB_OUTPUT
     118.           echo "issues=0" >> $GITHUB_OUTPUT
     119.           echo "suggestions=0" >> $GITHUB_OUTPUT
     120.           
     121.           # Display output
     122.           cat enforcement_output.txt
     123.           
     124.           # Exit with enforcement result if fail-below-threshold is true
     125.           if [ "${{ inputs.fail-below-threshold }}" == "true" ] && [ "${PASSED}" == "false" ]; then
     126.             echo "::error::Coverage ${COVERAGE}% is below threshold ${{ inputs.threshold }}%"
     127.             exit 1
     128.           fi
     129.         else
     130.           echo "Coverage checking disabled"
     131.           echo "coverage=0" >> $GITHUB_OUTPUT
     132.           echo "passed=true" >> $GITHUB_OUTPUT
     133.           echo "issues=0" >> $GITHUB_OUTPUT
     134.           echo "suggestions=0" >> $GITHUB_OUTPUT
     135.         fi
     136.     
     137.     - name: Generate test suggestions
     138.       shell: bash
     139.       if: inputs.auto-generate == 'true'
     140.       run: |
     141.         cd $GITHUB_WORKSPACE/.github/agents/test-coverage-enforcer
     142.         
     143.         python -m src.agent generate-tests \
     144.           --path "${{ inputs.source-path }}" \
     145.           > test_suggestions.txt
     146.         
     147.         echo "Test suggestions generated:"
     148.         cat test_suggestions.txt
     149.     
     150.     - name: Upload coverage report
     151.       uses: actions/upload-artifact@v3
     152.       if: always()
     153.       with:
     154.         name: coverage-report
     155.         path: |
     156.           ${{ inputs.output-file }}
     157.           coverage.json
     158.           .coverage
     159.         retention-days: 30
     160.     
     161.     - name: Comment on PR
     162.       uses: actions/github-script@v6
     163.       if: github.event_name == 'pull_request' && always()
     164.       with:
     165.         script: |
     166.           const fs = require('fs');
     167.           const coverage = '${{ steps.enforce.outputs.coverage }}';
     168.           const passed = '${{ steps.enforce.outputs.passed }}';
     169.           const threshold = '${{ inputs.threshold }}';
     170.           
     171.           const status = passed === 'true' ? '✅ PASS' : '❌ FAIL';
     172.           const icon = passed === 'true' ? '✅' : '❌';
     173.           
     174.           let reportContent = '';
     175.           try {
     176.             reportContent = fs.readFileSync('${{ inputs.output-file }}', 'utf8');
     177.           } catch (e) {
     178.             reportContent = 'Report not available';
     179.           }
     180.           
     181.           const body = `## ${icon} Test Coverage Report
     182.           
     183.           **Status:** ${status}
     184.           **Current Coverage:** ${coverage}%
     185.           **Threshold:** ${threshold}%
     186.           
     187.           <details>
     188.           <summary>View Full Report</summary>
     189.           
     190.           \`\`\`
     191.           ${reportContent}
     192.           \`\`\`
     193.           
     194.           </details>
     195.           
     196.           ---
     197.           *Generated by Test Coverage Enforcer Agent*`;
     198.           
     199.           github.rest.issues.createComment({
     200.             issue_number: context.issue.number,
     201.             owner: context.repo.owner,
     202.             repo: context.repo.repo,
     203.             body: body
     204.           });
     205.
 
 function:
   name: view
   args:
     path: /home/runner/work/_codex_/_codex_/.github/agents/pyo3-integration-tester/README.md
   result: |
     1. # PyO3 Integration Tester Agent
     2. 
     3. **Version**: 1.0.0  
     4. **Status**: Production  
     5. **Maturity**: Tier 1  
     6. **Test Coverage**: 100% (11/11 tests passing)
     7. 
     8. ## Purpose
     9. 
     10. Validates Python-Rust bindings created with PyO3 by automatically discovering bindings and generating comprehensive Python integration tests.
     11. 
     12. ## Features
     13. 
     14. - **Automatic Discovery**: Scans Rust files for `#[pyfunction]` and `#[pymethods]` bindings
     15. - **Comprehensive Testing**: Generates happy path, type validation, error handling, and performance tests
     16. - **Async Support**: Detects and generates tests for async functions
     17. - **Error Handling**: Identifies PyResult returns and generates exception tests
     18. - **Report Generation**: Provides statistics on discovered bindings
     19. - **Cognitive Brain Integration**: Tracks metrics and learns patterns
     20. 
     21. ## Quick Start
     22. 
     23. ### Command Line
     24. 
     25. ```bash
     26. # Scan Rust directory and generate tests
     27. python -m pyo3_integration_tester --rust-dir ./rust_src --output ./tests
     28. 
     29. # With summary report
     30. python -m pyo3_integration_tester --rust-dir ./rust_src --output ./tests --report
     31. 
     32. # Overwrite existing tests
     33. python -m pyo3_integration_tester --rust-dir ./rust_src --output ./tests --overwrite
     34. ```
     35. 
     36. ### Programmatic Usage
     37. 
     38. ```python
     39. from pathlib import Path
     40. from pyo3_integration_tester import PyO3IntegrationTester
     41. 
     42. tester = PyO3IntegrationTester()
     43. bindings = tester.scan_directory(Path("./rust_src"))
     44. generated = tester.generate_tests(bindings, Path("./tests"))
     45. 
     46. print(f"Generated {len(generated)} test files")
     47. ```
     48. 
     49. ## Installation
     50. 
     51. ```bash
     52. pip install -r requirements.txt
     53. ```
     54. 
     55. Requirements:
     56. - Python 3.11+
     57. - click
     58. - pyyaml
     59. - pytest (for running generated tests)
     60. - pytest-asyncio (for async tests)
     61. 
     62. ## Generated Test Structure
     63. 
     64. For each discovered binding, generates:
     65. 
     66. 1. **Happy Path Test**: Basic functionality with valid inputs
     67. 2. **Type Validation Test**: Placeholder for type checking
     68. 3. **Error Handling Test**: Exception testing (for PyResult returns)
     69. 4. **Async Test**: Async/await testing (for async functions)
     70. 5. **Performance Test**: Smoke test to catch regressions
     71. 
     72. ## Example
     73. 
     74. ### Rust Code
     75. ```rust
     76. #[pyfunction]
     77. pub fn compress_data(data: &[u8]) -> PyResult<Vec<u8>> {
     78.     // Implementation
     79. }
     80. ```
     81. 
     82. ### Generated Test
     83. ```python
     84. import pytest
     85. 
     86. def test_compress_data_happy_path():
     87.     from codex_swarm import compress_data
     88.     result = compress_data(b"test data")
     89.     assert isinstance(result, bytes)
     90. 
     91. def test_compress_data_error_handling():
     92.     from codex_swarm import compress_data
     93.     with pytest.raises(Exception):
     94.         compress_data(None)
     95. 
     96. @pytest.mark.performance
     97. def test_compress_data_performance():
     98.     import time
     99.     from codex_swarm import compress_data
     100.     
     101.     start = time.time()
     102.     result = compress_data(b"data" * 1000)
     103.     duration = time.time() - start
     104.     
     105.     assert duration < 1.0
     106. ```
     107. 
     108. ## Configuration
     109. 
     110. See `config/agent_config.yaml` for options:
     111. 
     112. - Module name customization
     113. - Test type toggles (happy_path, type_validation, error_handling, performance, async)
     114. - Performance thresholds
     115. - Scanning options (recursive, file patterns)
     116. - Cognitive brain integration
     117. 
     118. ## Testing
     119. 
     120. Run the agent test suite:
     121. 
     122. ```bash
     123. # Run all tests
     124. pytest tests/ -v
     125. 
     126. # Run with coverage
     127. pytest tests/ --cov=src --cov-report=term-missing
     128. ```
     129. 
     130. **Test Coverage**: 100% (11/11 tests passing)
     131. - Binding discovery
     132. - Test generation
     133. - Async detection
     134. - Error handling coverage
     135. - Report generation
     136. 
     137. ## Integration
     138. 
     139. ### GitHub Actions
     140. 
     141. ```yaml
     142. - name: Generate PyO3 Integration Tests
     143.   run: |
     144.     python .github/agents/pyo3-integration-tester/src/agent.py \
     145.       --rust-dir ./rust_src \
     146.       --output ./tests/integration \
     147.       --report
     148.     
     149.     pytest ./tests/integration -v
     150. ```
     151. 
     152. ### Pre-commit Hook
     153. 
     154. ```bash
     155. #!/bin/bash
     156. python .github/agents/pyo3-integration-tester/src/agent.py \
     157.   --rust-dir ./rust_src \
     158.   --output ./tests/integration
     159. ```
     160. 
     161. ## Documentation
     162. 
     163. - **Main Prompt**: `prompts/main.md` - Detection rules and workflow
     164. - **Examples**: `prompts/examples.md` - Common patterns and CI integration
     165. 
     166. ## Cognitive Brain Integration
     167. 
     168. Tracks:
     169. - Total bindings found per scan
     170. - Tests generated
     171. - Async functions detected
     172. - Error handling coverage
     173. - Scan duration
     174. 
     175. Alerts when:
     176. - Bindings without tests > 5
     177. - Error handling coverage < 50%
     178. 
     179. ## Changelog
     180. 
     181. See [CHANGELOG.md](CHANGELOG.md) for version history.
     182. 
     183. ## Contributing
     184. 
     185. Follow standard agent structure:
     186. - `src/` - Agent implementation
     187. - `tests/` - Comprehensive test suite (≥90% coverage)
     188. - `config/` - Configuration files
     189. - `prompts/` - Usage documentation
     190. - `CHANGELOG.md` - Version history
     191. 
     192. ## License
     193. 
     194. Part of the _codex_ repository.
     195. 
     196. ## Maintainers
     197. 
     198. - GitHub Copilot Agent
     199. - @mbaetiong
     200.
 

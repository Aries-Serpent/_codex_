       agent = SecurityVulnerabilityPatcher(config_path="config/auto_patch.yaml")
       
       # Scan JavaScript dependencies
       vulnerabilities = agent.scan_vulnerabilities("./my-node-app")
       
       # Filter critical vulnerabilities
       critical_vulns = [v for v in vulnerabilities if v.severity == "critical"]
       
       print(f"Found {len(critical_vulns)} critical vulnerabilities")
       
       for vuln in critical_vulns:
           print(f"\nProcessing {vuln.cve_id} in {vuln.affected_package}...")
           
           # Generate patch
           patch = agent.generate_patch(vuln)
           if not patch:
               print(f"  ❌ No fix available")
               continue
           
           # Auto-patch workflow
           # 1. Validate
           validation = agent.validate_patch_security(patch)
           if not validation['passed']:
               print(f"  ❌ Validation failed")
               for issue in validation['issues_found']:
                   print(f"     - {issue['message']}")
               continue
           
           # 2. Test
           test_results = agent.test_patch(patch, test_command="npm test")
           if not test_results['passed']:
               print(f"  ❌ Tests failed")
               print(f"     Output: {test_results['output'][:200]}...")
               continue
           
           # 3. Apply
           apply_results = agent.apply_patch(patch, dry_run=False)
           if apply_results['success']:
               print(f"  ✅ Patch applied successfully")
               print(f"     {patch.current_version} → {patch.target_version}")

       ## Pattern 3: Patch Staging Environments
       
       ### Overview
       
       Implement a multi-stage patching pipeline with progressive rollout and automated validation.
       
       ### Multi-Stage Pipeline
       
       ```python
       from enum import Enum
       from typing import List, Dict
       import time
       
       class Environment(Enum):
           DEVELOPMENT = "development"
           TESTING = "testing"
           STAGING = "staging"
           PRODUCTION = "production"
       
       class DeploymentStatus(Enum):
           PENDING = "pending"
           DEPLOYING = "deploying"
           DEPLOYED = "deployed"
           VALIDATING = "validating"
           VALIDATED = "validated"
           FAILED = "failed"
           ROLLED_BACK = "rolled_back"
       
       @dataclass
       class EnvironmentConfig:
           """Configuration for an environment"""
           name: Environment
           validation_period: int  # seconds
           rollback_on_failure: bool
           canary_percentage: float  # 0.0 to 1.0
           health_check_url: Optional[str] = None
           smoke_tests: List[str] = None
           performance_thresholds: Dict[str, float] = None
       
       class StagedPatchingPipeline:
           """Multi-stage patching pipeline with progressive rollout"""
           
           def __init__(self):
               self.agent = SecurityVulnerabilityPatcher()
               self.environments = self._setup_environments()
               self.deployment_history = []
           
           def _setup_environments(self) -> List[EnvironmentConfig]:
               """Setup environment pipeline"""
               return [
                   EnvironmentConfig(
                       name=Environment.DEVELOPMENT,
                       validation_period=300,  # 5 minutes
                       rollback_on_failure=True,
                       canary_percentage=1.0,
                       smoke_tests=['pytest tests/smoke'],
                       performance_thresholds={}
                   ),
                   EnvironmentConfig(
                       name=Environment.TESTING,
                       validation_period=900,  # 15 minutes
                       rollback_on_failure=True,
                       canary_percentage=1.0,
                       smoke_tests=['pytest tests/integration'],
                       performance_thresholds={'response_time': 200}
                   ),
                   EnvironmentConfig(
                       name=Environment.STAGING,
                       validation_period=3600,  # 1 hour
                       rollback_on_failure=True,
                       canary_percentage=0.5,  # 50% canary
                       health_check_url='https://staging.example.com/health',
                       smoke_tests=['pytest tests/e2e'],
                       performance_thresholds={
                           'response_time': 150,
                           'error_rate': 0.01,
                           'cpu_usage': 0.70
                       }
                   ),
                   EnvironmentConfig(
                       name=Environment.PRODUCTION,
                       validation_period=7200,  # 2 hours
                       rollback_on_failure=True,
                       canary_percentage=0.1,  # 10% canary, then 50%, then 100%
                       health_check_url='https://api.example.com/health',
                       smoke_tests=['pytest tests/production-smoke'],
                       performance_thresholds={
                           'response_time': 100,
                           'error_rate': 0.001,
                           'cpu_usage': 0.60,
                           'memory_usage': 0.70
                       }
                   )
               ]
           
           def deploy_patch_through_pipeline(self, patch, start_env: Environment = Environment.DEVELOPMENT) -> Dict:
               """Deploy patch through all environments progressively"""
               results = {
                   'patch_id': patch.id,
                   'cve_id': patch.vulnerability.cve_id,
                   'environments': {},
                   'overall_success': True
               }
               
               # Start from specified environment
               start_idx = next(
                   i for i, env in enumerate(self.environments)
                   if env.name == start_env
               )
               
               for env_config in self.environments[start_idx:]:
                   print(f"\n{'='*60}")
                   print(f"Deploying to {env_config.name.value.upper()}")
                   print(f"{'='*60}")
                   
                   # Deploy to environment
                   deploy_result = self._deploy_to_environment(patch, env_config)
                   results['environments'][env_config.name.value] = deploy_result
                   
                   if not deploy_result['success']:
                       print(f"❌ Deployment to {env_config.name.value} failed")
                       results['overall_success'] = False
                       
                       # Rollback if configured
                       if env_config.rollback_on_failure:
                           self._rollback_environment(patch, env_config)
                       
                       # Stop pipeline on failure
                       break
                   
                   print(f"✅ Successfully deployed to {env_config.name.value}")
                   
                   # Record deployment
                   self.deployment_history.append({
                       'patch_id': patch.id,
                       'environment': env_config.name.value,
                       'timestamp': datetime.now(),
                       'status': 'success'
                   })
               
               return results
           
           def _deploy_to_environment(self, patch, env_config: EnvironmentConfig) -> Dict:
               """Deploy patch to a specific environment"""
               result = {
                   'success': False,
                   'status': DeploymentStatus.PENDING,
                   'validation_results': {},
                   'metrics': {}
               }
               
               try:
                   # Step 1: Deploy
                   print(f"\n1️⃣  Deploying patch...")
                   result['status'] = DeploymentStatus.DEPLOYING
                   
                   if env_config.canary_percentage < 1.0:
                       # Canary deployment
                       print(f"   Using canary deployment: {env_config.canary_percentage*100}%")
                       self._canary_deploy(patch, env_config)
                   else:
                       # Full deployment
                       self.agent.apply_patch(patch, dry_run=False)
                   
                   result['status'] = DeploymentStatus.DEPLOYED
                   print(f"   ✅ Deployment complete")
                   
                   # Step 2: Run smoke tests
                   print(f"\n2️⃣  Running smoke tests...")
                   result['status'] = DeploymentStatus.VALIDATING
                   
                   smoke_results = self._run_smoke_tests(env_config)
                   result['validation_results']['smoke_tests'] = smoke_results
                   
                   if not smoke_results['passed']:
                       print(f"   ❌ Smoke tests failed")
                       result['status'] = DeploymentStatus.FAILED
                       return result
                   
                   print(f"   ✅ Smoke tests passed")
                   
                   # Step 3: Monitor health
                   print(f"\n3️⃣  Monitoring health for {env_config.validation_period}s...")
                   
                   health_results = self._monitor_health(env_config)
                   result['metrics'] = health_results
                   
                   if not health_results['healthy']:
                       print(f"   ❌ Health check failed")
                       result['status'] = DeploymentStatus.FAILED
                       return result
                   
                   print(f"   ✅ Health check passed")
                   
                   # Step 4: Validate performance
                   print(f"\n4️⃣  Validating performance...")
                   
                   perf_results = self._validate_performance(env_config, health_results)
                   result['validation_results']['performance'] = perf_results
                   
                   if not perf_results['passed']:
                       print(f"   ❌ Performance validation failed")
                       result['status'] = DeploymentStatus.FAILED
                       return result
                   
                   print(f"   ✅ Performance validation passed")
                   
                   # Success!
                   result['success'] = True
                   result['status'] = DeploymentStatus.VALIDATED
                   
               except Exception as e:
                   print(f"   ❌ Error during deployment: {e}")
                   result['status'] = DeploymentStatus.FAILED
                   result['error'] = str(e)
               
               return result
           
           def _canary_deploy(self, patch, env_config: EnvironmentConfig):
               """Perform canary deployment"""
               # Implement canary deployment logic
               # 1. Deploy to subset of instances
               # 2. Monitor for issues
               # 3. Gradually increase percentage
               # 4. Roll out to all instances
               
               canary_percentage = env_config.canary_percentage
               print(f"   Phase 1: Deploying to {canary_percentage*100}% of instances")
               time.sleep(2)  # Simulate deployment
               
               print(f"   Monitoring canary for {env_config.validation_period // 2}s...")
               time.sleep(2)  # Simulate monitoring
               
               if canary_percentage < 1.0:
                   print(f"   Phase 2: Expanding to 50% of instances")
                   time.sleep(2)
                   
                   print(f"   Phase 3: Full rollout to 100% of instances")
                   time.sleep(2)
           
           def _run_smoke_tests(self, env_config: EnvironmentConfig) -> Dict:
               """Run smoke tests for environment"""
               results = {
                   'passed': True,
                   'tests': {}
               }
               
               if not env_config.smoke_tests:
                   return results
               
               for test_cmd in env_config.smoke_tests:
                   import subprocess
                   try:
                       result = subprocess.run(
                           test_cmd,
                           shell=True,
                           capture_output=True,
                           timeout=300
                       )
                       
                       test_passed = (result.returncode == 0)
                       results['tests'][test_cmd] = {
                           'passed': test_passed,
                           'output': result.stdout.decode()[:500]
                       }
                       
                       if not test_passed:
                           results['passed'] = False
                           
                   except Exception as e:
                       results['tests'][test_cmd] = {
                           'passed': False,
                           'error': str(e)
                       }
                       results['passed'] = False
               
               return results
           
           def _monitor_health(self, env_config: EnvironmentConfig) -> Dict:
               """Monitor environment health"""
               metrics = {
                   'healthy': True,
                   'response_time': 0,
                   'error_rate': 0,
                   'cpu_usage': 0,
                   'memory_usage': 0
               }
               
               # Simulate health monitoring
               # In production, this would query actual monitoring systems
               
               if env_config.health_check_url:
                   import requests
                   try:
                       response = requests.get(env_config.health_check_url, timeout=10)
                       metrics['response_time'] = response.elapsed.total_seconds() * 1000
                       metrics['healthy'] = response.status_code == 200
                   except Exception as e:
                       print(f"   Health check error: {e}")
                       metrics['healthy'] = False
               
               # Simulate metrics collection
               import random
               metrics['error_rate'] = random.uniform(0, 0.002)
               metrics['cpu_usage'] = random.uniform(0.3, 0.7)
               metrics['memory_usage'] = random.uniform(0.4, 0.7)
               
               return metrics
           
           def _validate_performance(self, env_config: EnvironmentConfig, metrics: Dict) -> Dict:
               """Validate performance against thresholds"""
               results = {
                   'passed': True,
                   'violations': []
               }
               
               if not env_config.performance_thresholds:
                   return results
               
               for metric_name, threshold in env_config.performance_thresholds.items():
                   actual_value = metrics.get(metric_name, 0)
                   
                   if actual_value > threshold:
                       results['passed'] = False
                       results['violations'].append({
                           'metric': metric_name,
                           'threshold': threshold,
                           'actual': actual_value
                       })
                       print(f"   ⚠️  {metric_name}: {actual_value} exceeds threshold {threshold}")
               
               return results
           
           def _rollback_environment(self, patch, env_config: EnvironmentConfig):
               """Rollback patch in environment"""
               print(f"\n🔄 Rolling back in {env_config.name.value}...")
               
               rollback_result = self.agent.rollback_patch(patch.id)
               
               if rollback_result['success']:
                   print(f"✅ Rollback successful")
               else:
                   print(f"❌ Rollback failed - manual intervention required")
                   print(f"   Error: {rollback_result.get('error', 'Unknown')}")
       
       
       # Example usage
       pipeline = StagedPatchingPipeline()
       
       # Get a vulnerability and generate patch
       agent = SecurityVulnerabilityPatcher()
       vulnerabilities = agent.scan_vulnerabilities(".")
       
       if vulnerabilities:
           vuln = vulnerabilities[0]
           patch = agent.generate_patch(vuln)
           
           if patch:
               # Deploy through pipeline
               results = pipeline.deploy_patch_through_pipeline(patch)
               
               print(f"\n{'='*60}")
               print(f"PIPELINE RESULTS")
               print(f"{'='*60}")
               print(f"Overall Success: {'✅' if results['overall_success'] else '❌'}")
               print(f"\nEnvironment Status:")
               for env_name, env_result in results['environments'].items():
                   status = '✅' if env_result['success'] else '❌'
                   print(f"  {status} {env_name.upper()}: {env_result['status'].value}")
       ```
       

 function:
   name: create
   args:
     file_text: |
       # Service Integration Tester Configuration
       version: "1.0.0"
       agent_id: "service-integration-tester"
       enabled: true
       
       # HTTP client settings
       http:
         timeout_seconds: 30
         max_retries: 3
         retry_delay_seconds: 1
         follow_redirects: true
         verify_ssl: true
         user_agent: "ServiceIntegrationTester/1.0"
       
       # Performance thresholds
       performance:
         max_response_time_ms: 5000
         warning_response_time_ms: 2000
         p95_threshold_ms: 3000
         p99_threshold_ms: 4000
       
       # Expected status codes
       validation:
         expected_status_codes: [200, 201, 204]
         allowed_error_codes: [400, 401, 403, 404, 500]
         require_json_content_type: true
         validate_response_schema: true
       
       # Mock data generation
       mock_data:
         seed: 42
         scrub_pii_in_logs: true
         faker_locale: "en_US"
         generate_realistic_data: true
       
       # Endpoint discovery
       discovery:
         scan_common_paths: true
         follow_api_specs: true
         supported_specs: ["openapi", "swagger"]
         max_endpoints_per_scan: 100
       
       # Test execution
       testing:
         parallel_execution: false
         max_concurrent_requests: 5
         stop_on_first_failure: false
         retry_failed_tests: true
         max_test_retries: 2
       
       # Reporting
       reporting:
         format: "text"  # text, json, html
         include_response_data: false
         include_headers: true
         include_timing_breakdown: true
         export_metrics: true
       
       # Privacy and security
       privacy:
         scrub_pii_fields: 
           - "email"
           - "phone"
           - "ssn"
           - "password"
           - "token"
           - "secret"
           - "api_key"
           - "credit_card"
         mask_sensitive_headers:
           - "Authorization"
           - "X-API-Key"
           - "Cookie"
         log_level: "INFO"
       
       # Cognitive brain integration
       cognitive_brain:
         enabled: true
         
         # Metrics tracked
         metrics:
           - "total_tests_run"
           - "success_rate_percentage"
           - "failure_rate_percentage"
           - "avg_response_time_ms"
           - "p95_response_time_ms"
           - "p99_response_time_ms"
           - "endpoints_tested"
           - "unique_services_tested"
           - "failures_detected"
           - "errors_detected"
           - "mock_data_generated"
           - "pii_fields_scrubbed"
           - "total_request_duration_ms"
         
         # Alert conditions
         alerts:
           high_failure_rate_threshold: 20  # percentage
           slow_response_time_threshold_ms: 5000
           error_spike_threshold: 5  # number of consecutive errors
           service_down_consecutive_failures: 3
           unusual_status_code: true  # Alert on unexpected status codes
         
         # Learning and optimization
         learning:
           store_patterns: true
           track_endpoint_reliability: true
           learn_optimal_timeouts: true
           identify_flaky_endpoints: true
           baseline_performance_metrics: true
           detect_performance_regressions: true
         
         # Pattern recognition
         patterns:
           detect_rate_limiting: true
           detect_authentication_issues: true
           identify_common_errors: true
           track_api_changes: true
         
         # Integration settings
         integration:
           github_actions: true
           ci_cd_pipelines: true
           monitoring_systems: true
           alert_channels: ["github_issues", "logs"]
       
       # Integration with other agents
       agent_integration:
         pii_scrubber:
           enabled: true
           use_for_response_scrubbing: true
         
         rag_index_manager:
           enabled: true
           use_for_endpoint_discovery: true
           index_api_responses: false
         
         integration_test_runner:
           enabled: true
           share_test_results: true
           coordinate_test_execution: true
       
       # Logging
       logging:
         level: "INFO"
         file: ".codex/logs/service-integration-tester.log"
         format: "json"
         include_timestamps: true
         include_request_ids: true
         rotate_logs: true
         max_log_size_mb: 100
 

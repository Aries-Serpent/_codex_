       from security_vulnerability_patcher.src.agent import SecurityVulnerabilityPatcher
       
       def emergency_rollback(patch_id, reason):
           agent = SecurityVulnerabilityPatcher()
           
           print(f"🚨 EMERGENCY ROLLBACK INITIATED")
           print(f"Patch ID: {patch_id}")
           print(f"Reason: {reason}\n")
           
           # Attempt rollback
           print("Rolling back patch...")
           rollback_result = agent.rollback_patch(patch_id)
           
           if rollback_result['success']:
               print("✅ Rollback successful!")
               print(f"Timestamp: {rollback_result['timestamp']}")
               
               # Verify rollback
               print("\nVerifying rollback...")
               import subprocess
               result = subprocess.run(
                   "pytest tests/ --maxfail=5",
                   shell=True,
                   capture_output=True,
                   timeout=300
               )
               
               if result.returncode == 0:
                   print("✅ Tests passing after rollback")
                   print("System is stable")
               else:
                   print("⚠️  Some tests still failing")
                   print("Manual investigation required")
           else:
               print("❌ Rollback failed!")
               print(f"Error: {rollback_result.get('error', 'Unknown error')}")
               print("\n⚠️  MANUAL INTERVENTION REQUIRED")
               print("Steps:")
               print("  1. Check backup location")
               print("  2. Manually restore files")
               print("  3. Run: git checkout -- affected_files")
               print("  4. Verify with: pytest tests/")
       
       # Example: Rollback a specific patch

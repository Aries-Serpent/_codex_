           def test_cvss_score_calculation(self):
               """Test risk calculations based on CVSS scores"""
               agent = SecurityVulnerabilityPatcher()
               
               test_cases = [
                   (0.1, "low"),
                   (3.9, "low"),
                   (4.0, "medium"),
                   (6.9, "medium"),
                   (7.0, "high"),
                   (8.9, "high"),
                   (9.0, "critical"),
                   (10.0, "critical"),
               ]
               
               for cvss_score, expected_level in test_cases:
                   vuln = Vulnerability(
                       cve_id=f"CVE-2024-{int(cvss_score * 10):04d}",
                       severity=expected_level,
                       cvss_score=cvss_score,
                       affected_package="test-package",
                       affected_versions=["1.0"],
                       fixed_version="2.0",
                       description="Test",
                       published_date=datetime.now(timezone.utc)
                   )
                   
                   risk_score = agent.calculate_risk_score(vuln)
                   
                   # Verify risk score matches CVSS thresholds
                   thresholds = agent.config['risk_thresholds']
                   
                   if expected_level == "critical":
                       assert risk_score >= thresholds['critical']
                   elif expected_level == "high":
                       assert risk_score >= thresholds['high']
                   elif expected_level == "medium":
                       assert risk_score >= thresholds['medium']
                   elif expected_level == "low":
                       assert risk_score >= thresholds['low']
       
       

     129.                 'trend_analysis'
     130.             ],
     131.             'thresholds': {
     132.                 'line': 80,
     133.                 'branch': 70,
     134.                 'function': 85
     135.             },
     136.             'auto_generate_tests': False,
     137.             'fail_build_below_threshold': True,
     138.             'cognitive_brain': {
     139.                 'enabled': True,
     140.                 'metrics': [
     141.                     'coverage_percentage',
     142.                     'gap_count',
     143.                     'tests_generated',
     144.                     'enforcement_actions'
     145.                 ],
     146.                 'reporting_interval': 'daily'
     147.             }
     148.         }
     149.     
     150.     def analyze_coverage(self, path: Path, coverage_file: Optional[Path] = None) -> Dict[Path, CoverageReport]:
     151.         """
     152.         Analyze test coverage for given path using coverage.py
     153.         
     154.         Args:
     155.             path: Path to analyze (file or directory)
     156.             coverage_file: Optional path to existing .coverage file
     157.             
     158.         Returns:
     159.             Dictionary mapping file paths to coverage reports
     160.         """
     161.         if coverage_file and coverage_file.exists():
     162.             coverage_data = self._load_coverage_data(coverage_file)
     163.         else:
     164.             coverage_data = self._run_coverage_analysis(path)
     165.         
     166.         self.reports = {}
     167.         for file_path, data in coverage_data.items():
     168.             report = self._create_coverage_report(file_path, data)
     169.             self.reports[file_path] = report
     170.             
     171.             # Identify issues
     172.             self._check_coverage_thresholds(report)
     173.         
     174.         return self.reports
     175.     
     176.     def _run_coverage_analysis(self, path: Path) -> Dict:
     177.         """Run pytest with coverage.py to collect coverage data"""
     178.         try:
     179.             # Run pytest with coverage
     180.             cmd = [
     181.                 'python', '-m', 'pytest',
     182.                 '--cov=' + str(path),
     183.                 '--cov-report=json:coverage.json',
     184.                 '--cov-report=term',
     185.                 '-v'
     186.             ]
     187.             result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
     188.             
     189.             # Load JSON coverage report
     190.             coverage_json = Path('coverage.json')
     191.             if coverage_json.exists():
     192.                 with open(coverage_json) as f:
     193.                     return json.load(f).get('files', {})
     194.             
     195.             return {}
     196.         except (subprocess.TimeoutExpired, FileNotFoundError, json.JSONDecodeError) as e:
     197.             print(f"Coverage analysis failed: {e}")
     198.             return {}
     199.     
     200.     def _load_coverage_data(self, coverage_file: Path) -> Dict:
     201.         """Load coverage data from existing .coverage file"""
     202.         try:
     203.             # Use coverage.py API to read data
     204.             from coverage import Coverage
     205.             cov = Coverage(data_file=str(coverage_file))
     206.             cov.load()
     207.             
     208.             data = {}
     209.             for filename in cov.get_data().measured_files():
     210.                 analysis = cov.analysis2(filename)
     211.                 data[filename] = {
     212.                     'executed_lines': analysis[1],
     213.                     'missing_lines': analysis[2],
     214.                     'excluded_lines': analysis[3]
     215.                 }
     216.             return data
     217.         except Exception as e:
     218.             print(f"Failed to load coverage data: {e}")
     219.             return {}
     220.     
     221.     def _create_coverage_report(self, file_path: str, data: Dict) -> CoverageReport:
     222.         """Create structured coverage report from raw data"""
     223.         path = Path(file_path)
     224.         
     225.         # Extract coverage metrics
     226.         if isinstance(data, dict):
     227.             executed = set(data.get('executed_lines', []))
     228.             missing = list(data.get('missing_lines', []))
     229.             total_lines = len(executed) + len(missing)
     230.             covered = len(executed)
     231.         else:
     232.             total_lines = 0
     233.             covered = 0
     234.             missing = []
     235.         
     236.         # Calculate coverage percentage
     237.         line_coverage = (covered / total_lines * 100) if total_lines > 0 else 0.0
     238.         
     239.         # Parse file for functions and branches (simplified)
     240.         functions = self._extract_functions(path)
     241.         uncovered_funcs = [f for f in functions if any(line in missing for line in range(f[1], f[2]))]
     242.         function_coverage = ((len(functions) - len(uncovered_funcs)) / len(functions) * 100) if functions else 100.0
     243.         
     244.         return CoverageReport(
     245.             file_path=path,
     246.             line_coverage=line_coverage,
     247.             branch_coverage=line_coverage,  # Simplified - same as line coverage
     248.             function_coverage=function_coverage,
     249.             total_lines=total_lines,
     250.             covered_lines=covered,
     251.             missing_lines=missing,
     252.             partial_branches=[],
     253.             uncovered_functions=[f[0] for f in uncovered_funcs]
     254.         )
     255.     
     256.     def _extract_functions(self, file_path: Path) -> List[Tuple[str, int, int]]:
     257.         """Extract function definitions from Python file"""
     258.         if not file_path.exists() or file_path.suffix != '.py':
     259.             return []
     260.         
     261.         try:
     262.             with open(file_path) as f:
     263.                 tree = ast.parse(f.read())
     264.             
     265.             functions = []
     266.             for node in ast.walk(tree):
     267.                 if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
     268.                     functions.append((
     269.                         node.name,
     270.                         node.lineno,
     271.                         node.end_lineno or node.lineno
     272.                     ))
     273.             return functions
     274.         except Exception:
     275.             return []
     276.     
     277.     def _check_coverage_thresholds(self, report: CoverageReport):
     278.         """Check if coverage report meets thresholds and record issues"""
     279.         severity = self._calculate_severity(report.line_coverage)
     280.         
     281.         # Check line coverage
     282.         if report.line_coverage < self.line_threshold:
     283.             issue = CoverageIssue(
     284.                 file_path=report.file_path,
     285.                 issue_type='uncovered_lines',
     286.                 severity=severity,
     287.                 description=f"Line coverage {report.line_coverage:.1f}% below threshold {self.line_threshold}%",
     288.                 line_numbers=report.missing_lines,
     289.                 confidence=1.0
     290.             )
     291.             self.issues.append(issue)
     292.         
     293.         # Check function coverage
     294.         if report.function_coverage < self.function_threshold:
     295.             issue = CoverageIssue(
     296.                 file_path=report.file_path,
     297.                 issue_type='untested_function',
     298.                 severity=severity,
     299.                 description=f"Function coverage {report.function_coverage:.1f}% below threshold {self.function_threshold}%",
     300.                 suggested_tests=[f"test_{func}" for func in report.uncovered_functions],
 

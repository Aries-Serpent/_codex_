     1. #!/usr/bin/env python3
     2. """
     3. PyO3 Integration Tester Agent
     4. 
     5. Validates Python-Rust bindings and auto-generates comprehensive integration tests
     6. for PyO3 functions, ensuring type safety, error handling, and performance.
     7. 
     8. Usage:
     9.     python -m pyo3_integration_tester --rust-dir ./rust_src --output ./tests
     10. """
     11. 
     12. import click
     13. import re
     14. from pathlib import Path
     15. from typing import Dict, List, Optional, Set
     16. from dataclasses import dataclass
     17. import yaml
     18. 
     19. 
     20. @dataclass
     21. class Binding:
     22.     """Represents a PyO3 binding discovered in Rust code."""
     23.     type: str  # 'function' or 'class'
     24.     name: str
     25.     return_type: str
     26.     parameters: List[Dict]
     27.     file: str
     28.     line: int
     29.     is_async: bool = False
     30.     has_error_handling: bool = False
     31. 
     32. 
     33. class TestGenerator:
     34.     """Generates Python test code for PyO3 bindings."""
     35.     
     36.     def __init__(self, module_name: str = "codex_swarm"):
     37.         self.module_name = module_name
     38.     
     39.     def _validate_identifier(self, name: str) -> None:
     40.         """Validate that name is a safe Python identifier."""
     41.         if not re.match(r'^[a-zA-Z_][a-zA-Z0-9_]*$', name):
     42.             raise ValueError(f"Invalid identifier: {name}")
     43.     
     44.     def generate_test(self, binding: Binding) -> str:
     45.         """Generate Python test code for a binding."""
     46.         self._validate_identifier(binding.name)
     47.         
     48.         test_code = f'''"""
     49. Auto-generated integration tests for {binding.name}
     50. Generated by: pyo3-integration-tester
     51. Source: {binding.file}:{binding.line}
     52. """
     53. import pytest
     54. 
     55. 
     56. def test_{binding.name}_happy_path():
     57.     """Test {binding.name} with valid inputs."""
     58.     from {self.module_name} import {binding.name}
     59.     
     60.     # TODO: Add appropriate test data based on function signature
     61.     # Function signature: {binding.return_type}
     62.     result = {binding.name}()
     63.     assert result is not None
     64. 
     65. 
     66. def test_{binding.name}_type_validation():
     67.     """Test {binding.name} with invalid types."""
     68.     from {self.module_name} import {binding.name}
     69.     
     70.     # TODO: Add type validation tests
     71.     # Expected types: {', '.join([p.get('type', 'Any') for p in binding.parameters])}
     72.     pass
     73. '''
     74.         
     75.         # Add error handling test if function returns PyResult
     76.         if 'PyResult' in binding.return_type or binding.has_error_handling:
     77.             test_code += f'''
     78. 
     79. def test_{binding.name}_error_handling():
     80.     """Test {binding.name} error handling."""
     81.     from {self.module_name} import {binding.name}
     82.     
     83.     with pytest.raises(Exception):
     84.         # TODO: Add error case that should raise exception
     85.         pass
     86. '''
     87.         
     88.         # Add async test if function is async
     89.         if binding.is_async:
     90.             test_code += f'''
     91. 
     92. @pytest.mark.asyncio
     93. async def test_{binding.name}_async():
     94.     """Test {binding.name} async behavior."""
     95.     from {self.module_name} import {binding.name}
     96.     
     97.     result = await {binding.name}()
     98.     assert result is not None
     99. '''
     100.
 

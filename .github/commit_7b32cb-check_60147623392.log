           parser.add_argument('--cve', help='Specific CVE to patch')
           parser.add_argument('--patch-id', help='Patch ID for apply/rollback')
           parser.add_argument('--dry-run', action='store_true', help='Simulate without applying')
           parser.add_argument('--test-command', help='Custom test command')
           
           args = parser.parse_args()
           
           agent = SecurityVulnerabilityPatcher(config_path=args.config)
           
           if args.command == 'scan':
               vulns = agent.scan_vulnerabilities(args.path)
               print(f"Found {len(vulns)} vulnerabilities")

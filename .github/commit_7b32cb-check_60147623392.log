 function:
   name: create
   args:
     file_text: |
       #!/usr/bin/env python3
       """
       Service Integration Tester Agent
       
       Validates cross-service interactions by testing HTTP endpoints, generating mock data,
       and measuring performance metrics. Supports both synchronous and asynchronous testing.
       
       Usage:
           python -m service_integration_tester --config config.yaml --target http://api.example.com
       """
       
       import asyncio
       import base64
       import hashlib
       import json
       import re
       import time
       from dataclasses import dataclass, field
       from datetime import datetime, timezone
       from pathlib import Path
       from typing import Any, Dict, List, Optional, Set, Tuple, Union
       from urllib.parse import urljoin, urlparse
       
       import click
       import yaml
       
       try:
           import httpx
           HTTPX_AVAILABLE = True
       except ImportError:
           HTTPX_AVAILABLE = False
           import requests
       
       try:
           import faker
           FAKER_AVAILABLE = True
       except ImportError:
           FAKER_AVAILABLE = False
       
       
       @dataclass
       class Endpoint:
           """Represents a discovered API endpoint."""
           path: str
           method: str
           base_url: str
           description: str = ""
           parameters: List[Dict[str, Any]] = field(default_factory=list)
           headers: Dict[str, str] = field(default_factory=dict)
           auth_required: bool = False
           
           @property
           def full_url(self) -> str:
               """Get the complete URL for this endpoint."""
               return urljoin(self.base_url, self.path)
           
           def __hash__(self):
               return hash((self.path, self.method, self.base_url))
       
       
       @dataclass
       class TestResult:
           """Result of a service integration test."""
           endpoint: Endpoint
           status: str  # 'success', 'failure', 'error'
           status_code: Optional[int] = None
           response_time_ms: float = 0.0
           response_data: Optional[Any] = None
           error: Optional[str] = None
           timestamp: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
           validation_errors: List[str] = field(default_factory=list)
           
           def to_dict(self) -> Dict[str, Any]:
               """Convert result to dictionary."""
               return {
                   'endpoint': f"{self.endpoint.method} {self.endpoint.path}",
                   'status': self.status,
                   'status_code': self.status_code,
                   'response_time_ms': round(self.response_time_ms, 2),
                   'error': self.error,
                   'validation_errors': self.validation_errors,
                   'timestamp': self.timestamp
               }
       
       
       class MockDataGenerator:
           """Generates privacy-safe mock data for testing."""
           
           def __init__(self, seed: Optional[int] = None):
               """Initialize mock data generator."""
               self.seed = seed or 42
               if FAKER_AVAILABLE:
                   self.faker = faker.Faker()
                   self.faker.seed_instance(self.seed)
               else:
                   self.faker = None
           
           def generate_email(self) -> str:
               """Generate a mock email address."""
               if self.faker:
                   return self.faker.email()
               return f"test{self.seed}@example.com"
           
           def generate_name(self) -> str:
               """Generate a mock name."""
               if self.faker:
                   return self.faker.name()
               return f"Test User {self.seed}"
           
           def generate_phone(self) -> str:
               """Generate a mock phone number."""
               if self.faker:
                   return self.faker.phone_number()
               return "+1-555-0100"
           
           def generate_address(self) -> Dict[str, str]:
               """Generate a mock address."""
               if self.faker:
                   return {
                       'street': self.faker.street_address(),
                       'city': self.faker.city(),
                       'state': self.faker.state(),
                       'zip': self.faker.zipcode(),
                       'country': self.faker.country_code()
                   }
               return {
                   'street': '123 Test St',
                   'city': 'Testville',
                   'state': 'TS',
                   'zip': '12345',
                   'country': 'US'
               }
           
           def generate_uuid(self) -> str:
               """Generate a mock UUID."""
               if self.faker:
                   return self.faker.uuid4()
               return "00000000-0000-0000-0000-000000000000"
           
           def generate_date(self) -> str:
               """Generate a mock date in ISO format."""
               if self.faker:
                   return self.faker.date()
               return "2024-01-01"
           
           def generate_json_payload(self, schema: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
               """
               Generate a JSON payload based on schema.
               
               Args:
                   schema: Dict mapping field names to types ('email', 'name', 'phone', etc.)
               
               Returns:
                   Mock JSON data
               """
               if not schema:
                   schema = {'id': 'uuid', 'name': 'name', 'email': 'email'}
               
               payload = {}
               for field, field_type in schema.items():
                   if field_type == 'email':
                       payload[field] = self.generate_email()
                   elif field_type == 'name':
                       payload[field] = self.generate_name()
                   elif field_type == 'phone':
                       payload[field] = self.generate_phone()
                   elif field_type == 'address':
                       payload[field] = self.generate_address()
                   elif field_type == 'uuid':
                       payload[field] = self.generate_uuid()
                   elif field_type == 'date':
                       payload[field] = self.generate_date()
                   elif field_type == 'string':
                       payload[field] = f"test_{field}_{self.seed}"
                   elif field_type == 'int':
                       payload[field] = self.seed
                   elif field_type == 'bool':
                       payload[field] = True
                   else:
                       payload[field] = f"mock_{field_type}"
               
               return payload
           
           def scrub_pii(self, data: Any) -> Any:
               """
               Remove or mask PII from response data.
               
               Args:
                   data: Response data to scrub
               
               Returns:
                   Scrubbed data
               """
               if isinstance(data, dict):
                   scrubbed = {}
                   for key, value in data.items():
                       # Check if key suggests PII
                       if any(pii in key.lower() for pii in ['email', 'phone', 'ssn', 'password', 'token', 'secret']):
                           scrubbed[key] = self._mask_value(value)
                       else:
                           scrubbed[key] = self.scrub_pii(value)
                   return scrubbed
               elif isinstance(data, list):
                   return [self.scrub_pii(item) for item in data]
               else:
                   return data
           
           def _mask_value(self, value: Any) -> str:
               """Mask a sensitive value."""
               if isinstance(value, str):
                   if '@' in value:  # Email
                       parts = value.split('@')
                       return f"{parts[0][:2]}***@{parts[1]}"
                   elif len(value) > 4:
                       return f"{value[:2]}***{value[-2:]}"
               return "***MASKED***"
       
       
       class ResponseValidator:
           """Validates HTTP responses against expected criteria."""
           
           def __init__(self):
               """Initialize validator."""
               self.errors: List[str] = []
           
           def reset(self):
               """Clear validation errors."""
               self.errors = []
           
           def validate_status_code(self, actual: int, expected: Union[int, List[int]]) -> bool:
               """Validate HTTP status code."""
               if isinstance(expected, int):
                   expected = [expected]
               
               if actual not in expected:
                   self.errors.append(f"Expected status {expected}, got {actual}")
                   return False
               return True
           
           def validate_content_type(self, headers: Dict[str, str], expected: str) -> bool:
               """Validate Content-Type header."""
               content_type = headers.get('content-type', headers.get('Content-Type', ''))
               if expected.lower() not in content_type.lower():
                   self.errors.append(f"Expected Content-Type '{expected}', got '{content_type}'")
                   return False
               return True
           
           def validate_json_schema(self, data: Any, required_fields: List[str]) -> bool:
               """Validate JSON response has required fields."""
               if not isinstance(data, dict):
                   self.errors.append(f"Expected dict, got {type(data).__name__}")
                   return False
               
               missing = [field for field in required_fields if field not in data]
               if missing:
                   self.errors.append(f"Missing required fields: {missing}")
                   return False
               return True
           
           def validate_response_time(self, response_time_ms: float, max_ms: float) -> bool:
               """Validate response time is within threshold."""
               if response_time_ms > max_ms:
                   self.errors.append(f"Response time {response_time_ms}ms exceeds {max_ms}ms")
                   return False
               return True
           
           def validate_header_present(self, headers: Dict[str, str], header_name: str) -> bool:
               """Validate a specific header is present."""
               if header_name not in headers and header_name.lower() not in {k.lower() for k in headers.keys()}:
                   self.errors.append(f"Missing required header: {header_name}")
                   return False
               return True
           
           def get_errors(self) -> List[str]:
               """Get all validation errors."""
               return self.errors.copy()
       
       
       class EndpointDiscovery:
           """Discovers API endpoints from various sources."""
           
           def __init__(self, base_url: str):
               """Initialize endpoint discovery."""
               self.base_url = base_url
           
           def discover_from_openapi(self, spec_path: Path) -> List[Endpoint]:
               """
               Discover endpoints from OpenAPI/Swagger specification.
               
               Args:
                   spec_path: Path to OpenAPI spec file (JSON or YAML)
               
               Returns:
                   List of discovered endpoints
               """
               endpoints = []
               
               try:
                   with open(spec_path) as f:
                       if spec_path.suffix == '.json':
                           spec = json.load(f)
                       else:
                           spec = yaml.safe_load(f)
                   
                   paths = spec.get('paths', {})
                   for path, methods in paths.items():
                       for method, details in methods.items():
                           if method.upper() in ['GET', 'POST', 'PUT', 'PATCH', 'DELETE']:
                               endpoint = Endpoint(
                                   path=path,
                                   method=method.upper(),
                                   base_url=self.base_url,
                                   description=details.get('summary', details.get('description', '')),
                                   parameters=details.get('parameters', [])
                               )
                               endpoints.append(endpoint)
               
               except Exception as e:
                   raise ValueError(f"Failed to parse OpenAPI spec: {e}")
               
               return endpoints
           
           def discover_from_list(self, endpoint_list: List[Dict[str, Any]]) -> List[Endpoint]:
               """
               Discover endpoints from a list of endpoint definitions.
               
               Args:
                   endpoint_list: List of dicts with 'path', 'method', and optional other fields
               
               Returns:
                   List of discovered endpoints
               """
               endpoints = []
               
               for item in endpoint_list:
                   endpoint = Endpoint(
                       path=item.get('path', '/'),
                       method=item.get('method', 'GET').upper(),
                       base_url=self.base_url,
                       description=item.get('description', ''),
                       parameters=item.get('parameters', []),
                       headers=item.get('headers', {}),
                       auth_required=item.get('auth_required', False)
                   )
                   endpoints.append(endpoint)
               
               return endpoints
           
           def discover_common_paths(self) -> List[Endpoint]:
               """
               Discover common API paths using heuristics.
               
               Returns:
                   List of common endpoints to test
               """
               common_paths = [
                   {'path': '/health', 'method': 'GET', 'description': 'Health check'},
                   {'path': '/api/v1/status', 'method': 'GET', 'description': 'API status'},
                   {'path': '/api/health', 'method': 'GET', 'description': 'API health'},
                   {'path': '/ping', 'method': 'GET', 'description': 'Ping endpoint'},
                   {'path': '/version', 'method': 'GET', 'description': 'Version info'},
               ]
               
               return self.discover_from_list(common_paths)
       
       
       class ServiceIntegrationTester:
           """Main class for testing service integrations."""
           
           def __init__(self, config_path: Optional[Path] = None):
               """
               Initialize service integration tester.
               
               Args:
                   config_path: Path to agent configuration file
               """
               self.config = self._load_config(config_path)
               self.mock_generator = MockDataGenerator(seed=self.config.get('mock_data_seed', 42))
               self.validator = ResponseValidator()
               self.results: List[TestResult] = []
               self.metrics: Dict[str, Any] = {
                   'total_tests': 0,
                   'passed': 0,
                   'failed': 0,
                   'errors': 0,
                   'total_response_time_ms': 0.0,
                   'avg_response_time_ms': 0.0
               }
           
           def _load_config(self, config_path: Optional[Path]) -> Dict:
               """Load agent configuration."""
               if config_path and config_path.exists():
                   with open(config_path) as f:
                       return yaml.safe_load(f)
               return self._default_config()
           
           def _default_config(self) -> Dict:
               """Return default configuration."""
               return {
                   'version': '1.0.0',
                   'enabled': True,
                   'timeout_seconds': 30,
                   'max_retries': 3,
                   'retry_delay_seconds': 1,
                   'follow_redirects': True,
                   'verify_ssl': True,
                   'max_response_time_ms': 5000,
                   'log_level': 'INFO',
                   'mock_data_seed': 42,
                   'scrub_pii_in_logs': True,
                   'expected_status_codes': [200, 201, 204],
                   'cognitive_brain': {
                       'enabled': True,
                       'metrics': [
                           'total_tests_run',
                           'success_rate',
                           'avg_response_time_ms',
                           'endpoints_tested',
                           'failures_detected'
                       ]
                   }
               }
           
           def scan_endpoints(self, base_url: str, source: Union[Path, List[Dict], str]) -> List[Endpoint]:
               """
               Discover endpoints from various sources.
               
               Args:
                   base_url: Base URL for the service
                   source: OpenAPI spec path, list of endpoints, or 'common' for heuristics
               
               Returns:
                   List of discovered endpoints
               """
               discovery = EndpointDiscovery(base_url)
               
               if isinstance(source, Path):
                   return discovery.discover_from_openapi(source)
               elif isinstance(source, list):
                   return discovery.discover_from_list(source)
               elif source == 'common':
                   return discovery.discover_common_paths()
               else:
                   raise ValueError(f"Unsupported source type: {type(source)}")
           
           def generate_mock_data(self, schema: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
               """
               Generate privacy-safe mock data.
               
               Args:
                   schema: Field definitions for mock data
               
               Returns:
                   Generated mock data
               """
               return self.mock_generator.generate_json_payload(schema)
           
           def test_endpoint_sync(self, endpoint: Endpoint, payload: Optional[Dict] = None,
                                 expected_status: Union[int, List[int]] = 200,
                                 headers: Optional[Dict[str, str]] = None) -> TestResult:
               """
               Test an endpoint synchronously.
               
               Args:
                   endpoint: Endpoint to test
                   payload: Optional request payload
                   expected_status: Expected HTTP status code(s)
                   headers: Additional headers
               
               Returns:
                   Test result
               """
               self.validator.reset()
               start_time = time.time()
               
               try:
                   # Prepare request
                   request_headers = dict(endpoint.headers)
                   if headers:
                       request_headers.update(headers)
                   
                   timeout = self.config.get('timeout_seconds', 30)
                   verify = self.config.get('verify_ssl', True)
                   
                   # Make request
                   if endpoint.method == 'GET':
                       response = requests.get(
                           endpoint.full_url,
                           headers=request_headers,
                           timeout=timeout,
                           verify=verify
                       )
                   elif endpoint.method == 'POST':
                       response = requests.post(
                           endpoint.full_url,
                           json=payload,
                           headers=request_headers,
                           timeout=timeout,
                           verify=verify
                       )
                   elif endpoint.method == 'PUT':
                       response = requests.put(
                           endpoint.full_url,
                           json=payload,
                           headers=request_headers,
                           timeout=timeout,
                           verify=verify
                       )
                   elif endpoint.method == 'PATCH':
                       response = requests.patch(
                           endpoint.full_url,
                           json=payload,
                           headers=request_headers,
                           timeout=timeout,
                           verify=verify
                       )
                   elif endpoint.method == 'DELETE':
                       response = requests.delete(
                           endpoint.full_url,
                           headers=request_headers,
                           timeout=timeout,
                           verify=verify
                       )
                   else:
                       raise ValueError(f"Unsupported method: {endpoint.method}")
                   
                   response_time_ms = (time.time() - start_time) * 1000
                   
                   # Parse response
                   try:
                       response_data = response.json()
                       if self.config.get('scrub_pii_in_logs', True):
                           response_data = self.mock_generator.scrub_pii(response_data)
                   except Exception:
                       response_data = response.text
                   
                   # Validate
                   self.validator.validate_status_code(response.status_code, expected_status)
                   max_time = self.config.get('max_response_time_ms', 5000)
                   self.validator.validate_response_time(response_time_ms, max_time)
                   
                   status = 'success' if not self.validator.errors else 'failure'
                   
                   result = TestResult(
                       endpoint=endpoint,
                       status=status,
                       status_code=response.status_code,
                       response_time_ms=response_time_ms,
                       response_data=response_data,
                       validation_errors=self.validator.get_errors()
                   )
               
               except Exception as e:
                   response_time_ms = (time.time() - start_time) * 1000
                   result = TestResult(
                       endpoint=endpoint,
                       status='error',
                       response_time_ms=response_time_ms,
                       error=str(e)
                   )
               
               self._record_result(result)
               return result
           
           async def test_endpoint_async(self, endpoint: Endpoint, payload: Optional[Dict] = None,
                                         expected_status: Union[int, List[int]] = 200,
                                         headers: Optional[Dict[str, str]] = None) -> TestResult:
               """
               Test an endpoint asynchronously.
               
               Args:
                   endpoint: Endpoint to test
                   payload: Optional request payload
                   expected_status: Expected HTTP status code(s)
                   headers: Additional headers
               
               Returns:
                   Test result
               """
               if not HTTPX_AVAILABLE:
                   raise RuntimeError("httpx is required for async testing. Install with: pip install httpx")
               
               self.validator.reset()
               start_time = time.time()
               
               try:
                   # Prepare request
                   request_headers = dict(endpoint.headers)
                   if headers:
                       request_headers.update(headers)
                   
                   timeout = self.config.get('timeout_seconds', 30)
                   verify = self.config.get('verify_ssl', True)
                   
                   async with httpx.AsyncClient(verify=verify, timeout=timeout) as client:
                       # Make request
                       if endpoint.method == 'GET':
                           response = await client.get(endpoint.full_url, headers=request_headers)
                       elif endpoint.method == 'POST':
                           response = await client.post(endpoint.full_url, json=payload, headers=request_headers)
                       elif endpoint.method == 'PUT':
                           response = await client.put(endpoint.full_url, json=payload, headers=request_headers)
                       elif endpoint.method == 'PATCH':
                           response = await client.patch(endpoint.full_url, json=payload, headers=request_headers)
                       elif endpoint.method == 'DELETE':
                           response = await client.delete(endpoint.full_url, headers=request_headers)
                       else:
                           raise ValueError(f"Unsupported method: {endpoint.method}")
                       
                       response_time_ms = (time.time() - start_time) * 1000
                       
                       # Parse response
                       try:
                           response_data = response.json()
                           if self.config.get('scrub_pii_in_logs', True):
                               response_data = self.mock_generator.scrub_pii(response_data)
                       except Exception:
                           response_data = response.text
                       
                       # Validate
                       self.validator.validate_status_code(response.status_code, expected_status)
                       max_time = self.config.get('max_response_time_ms', 5000)
                       self.validator.validate_response_time(response_time_ms, max_time)
                       
                       status = 'success' if not self.validator.errors else 'failure'
                       
                       result = TestResult(
                           endpoint=endpoint,
                           status=status,
                           status_code=response.status_code,
                           response_time_ms=response_time_ms,
                           response_data=response_data,
                           validation_errors=self.validator.get_errors()
                       )
               
               except Exception as e:
                   response_time_ms = (time.time() - start_time) * 1000
                   result = TestResult(
                       endpoint=endpoint,
                       status='error',
                       response_time_ms=response_time_ms,
                       error=str(e)
                   )
               
               self._record_result(result)
               return result
           
           def _record_result(self, result: TestResult):
               """Record test result and update metrics."""
               self.results.append(result)
               
               self.metrics['total_tests'] += 1
               if result.status == 'success':
                   self.metrics['passed'] += 1
               elif result.status == 'failure':
                   self.metrics['failed'] += 1
               elif result.status == 'error':
                   self.metrics['errors'] += 1
               
               self.metrics['total_response_time_ms'] += result.response_time_ms
               if self.metrics['total_tests'] > 0:
                   self.metrics['avg_response_time_ms'] = (
                       self.metrics['total_response_time_ms'] / self.metrics['total_tests']
                   )
           
           def validate_response(self, result: TestResult, 
                                required_fields: Optional[List[str]] = None,
                                expected_content_type: Optional[str] = None) -> bool:
               """
               Validate a test result against additional criteria.
               
               Args:
                   result: Test result to validate
                   required_fields: Required JSON fields
                   expected_content_type: Expected Content-Type header
               
               Returns:
                   True if validation passes
               """
               self.validator.reset()
               
               if required_fields and isinstance(result.response_data, dict):
                   self.validator.validate_json_schema(result.response_data, required_fields)
               
               # Would validate content type if we had headers in result
               # For now, just check if response is valid
               
               return len(self.validator.get_errors()) == 0
           
           def measure_performance(self, endpoint: Endpoint, iterations: int = 10) -> Dict[str, float]:
               """
               Measure endpoint performance over multiple iterations.
               
               Args:
                   endpoint: Endpoint to test
                   iterations: Number of test iterations
               
               Returns:
                   Performance metrics (min, max, avg, p95, p99)
               """
               response_times = []
               
               for _ in range(iterations):
                   result = self.test_endpoint_sync(endpoint)
                   if result.status in ['success', 'failure']:
                       response_times.append(result.response_time_ms)
               
               if not response_times:
                   return {'error': 'No successful requests'}
               
               response_times.sort()
               
               return {
                   'min_ms': min(response_times),
                   'max_ms': max(response_times),
                   'avg_ms': sum(response_times) / len(response_times),
                   'p50_ms': response_times[len(response_times) // 2],
                   'p95_ms': response_times[int(len(response_times) * 0.95)],
                   'p99_ms': response_times[int(len(response_times) * 0.99)],
                   'iterations': len(response_times)
               }
           
           def get_metrics(self) -> Dict[str, Any]:
               """Get current metrics."""
               return self.metrics.copy()
           
           def get_results(self) -> List[TestResult]:
               """Get all test results."""
               return self.results.copy()
           
           def generate_report(self, output_path: Optional[Path] = None) -> str:
               """
               Generate a test report.
               
               Args:
                   output_path: Optional path to save report
               
               Returns:
                   Report as string
               """
               report_lines = [
                   "=" * 80,
                   "Service Integration Test Report",
                   "=" * 80,
                   f"Generated: {datetime.now(timezone.utc).isoformat()}",
                   "",
                   "Summary:",
                   f"  Total Tests: {self.metrics['total_tests']}",
                   f"  Passed: {self.metrics['passed']}",
                   f"  Failed: {self.metrics['failed']}",
                   f"  Errors: {self.metrics['errors']}",
                   f"  Success Rate: {self._calculate_success_rate():.1f}%",
                   f"  Avg Response Time: {self.metrics['avg_response_time_ms']:.2f}ms",
                   "",
                   "Test Results:",
                   "-" * 80,
               ]
               
               for result in self.results:
                   status_symbol = {
                       'success': '✓',
                       'failure': '✗',
                       'error': '⚠'
                   }.get(result.status, '?')
                   
                   report_lines.append(
                       f"{status_symbol} {result.endpoint.method} {result.endpoint.path} "
                       f"[{result.status_code or 'N/A'}] {result.response_time_ms:.2f}ms"
                   )
                   
                   if result.validation_errors:
                       for error in result.validation_errors:
                           report_lines.append(f"    - {error}")
                   
                   if result.error:
                       report_lines.append(f"    Error: {result.error}")
               
               report_lines.append("=" * 80)
               
               report = "\n".join(report_lines)
               
               if output_path:
                   output_path.write_text(report)
               
               return report
           
           def _calculate_success_rate(self) -> float:
               """Calculate success rate percentage."""
               if self.metrics['total_tests'] == 0:
                   return 0.0
               return (self.metrics['passed'] / self.metrics['total_tests']) * 100
           
           def export_results_json(self, output_path: Path):
               """Export results as JSON."""
               data = {
                   'metrics': self.metrics,
                   'results': [r.to_dict() for r in self.results],
                   'timestamp': datetime.now(timezone.utc).isoformat()
               }
               
               with open(output_path, 'w') as f:
                   json.dump(data, f, indent=2)
       
       

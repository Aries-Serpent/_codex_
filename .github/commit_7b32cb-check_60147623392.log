 function:
   name: create
   args:
     file_text: |
       name: 'Service Integration Tester'
       description: 'Test cross-service integrations with HTTP endpoints, mock data, and performance metrics'
       author: 'Codex Team'
       
       inputs:
         base-url:
           description: 'Base URL of the service to test'
           required: true
         
         endpoints:
           description: 'Path to OpenAPI spec or endpoint list JSON'
           required: false
         
         test-common:
           description: 'Test common health/status endpoints'
           required: false
           default: 'false'
         
         config-path:
           description: 'Path to agent configuration file'
           required: false
           default: '.github/agents/service-integration-tester/config/agent_config.yaml'
         
         timeout:
           description: 'Request timeout in seconds'
           required: false
           default: '30'
         
         max-response-time:
           description: 'Maximum acceptable response time in milliseconds'
           required: false
           default: '5000'
         
         generate-mock-data:
           description: 'Generate mock data for POST/PUT requests'
           required: false
           default: 'true'
         
         mock-data-schema:
           description: 'JSON schema for mock data generation'
           required: false
           default: '{"name": "name", "email": "email"}'
         
         measure-performance:
           description: 'Run performance measurements'
           required: false
           default: 'false'
         
         performance-iterations:
           description: 'Number of iterations for performance tests'
           required: false
           default: '10'
         
         fail-on-error:
           description: 'Fail the workflow if any test fails'
           required: false
           default: 'true'
         
         output-format:
           description: 'Report format (text, json)'
           required: false
           default: 'text'
         
         output-file:
           description: 'Output file for test report'
           required: false
           default: 'integration_test_report.txt'
         
         export-json:
           description: 'Export results as JSON'
           required: false
           default: 'true'
         
         scrub-pii:
           description: 'Scrub PII from logs and reports'
           required: false
           default: 'true'
       
       outputs:
         total-tests:
           description: 'Total number of tests run'
           value: ${{ steps.test.outputs.total }}
         
         passed-tests:
           description: 'Number of tests that passed'
           value: ${{ steps.test.outputs.passed }}
         
         failed-tests:
           description: 'Number of tests that failed'
           value: ${{ steps.test.outputs.failed }}
         
         success-rate:
           description: 'Success rate percentage'
           value: ${{ steps.test.outputs.success_rate }}
         
         avg-response-time:
           description: 'Average response time in milliseconds'
           value: ${{ steps.test.outputs.avg_response_time }}
         
         endpoints-tested:
           description: 'Number of endpoints tested'
           value: ${{ steps.test.outputs.endpoints }}
       
       runs:
         using: 'composite'
         steps:
           - name: Set up Python
             uses: actions/setup-python@v4
             with:
               python-version: '3.11'
           
           - name: Install dependencies
             shell: bash
             run: |
               python -m pip install --upgrade pip
               pip install requests pyyaml click
               
               # Install optional dependencies
               pip install faker httpx || true
           
           - name: Install agent
             shell: bash
             run: |
               # Add agent to Python path
               export PYTHONPATH="${GITHUB_WORKSPACE}/.github/agents/service-integration-tester/src:${PYTHONPATH}"
               echo "PYTHONPATH=${PYTHONPATH}" >> $GITHUB_ENV
           
           - name: Run integration tests
             shell: bash
             id: test
             run: |
               cd $GITHUB_WORKSPACE/.github/agents/service-integration-tester
               
               # Build command
               CMD="python src/agent.py test --base-url '${{ inputs.base-url }}'"
               
               # Add endpoints or common flag
               if [ -n "${{ inputs.endpoints }}" ]; then
                 CMD="$CMD --endpoints '${{ inputs.endpoints }}'"
               elif [ "${{ inputs.test-common }}" == "true" ]; then
                 CMD="$CMD --common"
               fi
               
               # Add output options
               CMD="$CMD --output '${{ inputs.output-file }}'"
               
               if [ "${{ inputs.export-json }}" == "true" ]; then
                 CMD="$CMD --json 'integration_results.json'"
               fi
               
               CMD="$CMD --verbose"
               
               # Run tests
               echo "Running: $CMD"
               eval $CMD > test_output.txt 2>&1 || true
               
               # Parse results
               TOTAL=$(grep -oP 'Total Tests: \K\d+' test_output.txt || echo "0")
               PASSED=$(grep -oP 'Passed: \K\d+' test_output.txt || echo "0")
               FAILED=$(grep -oP 'Failed: \K\d+' test_output.txt || echo "0")
               
               # Calculate success rate
               if [ "$TOTAL" -gt 0 ]; then
                 SUCCESS_RATE=$(awk "BEGIN {printf \"%.1f\", ($PASSED / $TOTAL) * 100}")
               else
                 SUCCESS_RATE="0.0"
               fi
               
               # Get average response time
               AVG_TIME=$(grep -oP 'Avg Response Time: \K[\d.]+' test_output.txt || echo "0")
               
               # Count endpoints
               ENDPOINTS=$(grep -oP 'Discovered \K\d+' test_output.txt || echo "0")
               
               # Output results
               echo "total=${TOTAL}" >> $GITHUB_OUTPUT
               echo "passed=${PASSED}" >> $GITHUB_OUTPUT
               echo "failed=${FAILED}" >> $GITHUB_OUTPUT
               echo "success_rate=${SUCCESS_RATE}" >> $GITHUB_OUTPUT
               echo "avg_response_time=${AVG_TIME}" >> $GITHUB_OUTPUT
               echo "endpoints=${ENDPOINTS}" >> $GITHUB_OUTPUT
               
               # Display output
               cat test_output.txt
               
               # Check if we should fail
               if [ "${{ inputs.fail-on-error }}" == "true" ] && [ "$FAILED" -gt 0 ]; then
                 echo "::error::${FAILED} test(s) failed"
                 exit 1
               fi
           
           - name: Run performance tests
             shell: bash
             if: inputs.measure-performance == 'true'
             run: |
               cd $GITHUB_WORKSPACE/.github/agents/service-integration-tester
               
               # TODO: Implement performance testing
               echo "Performance testing would run here"
           
           - name: Upload test results
             uses: actions/upload-artifact@v3
             if: always()
             with:
               name: integration-test-results
               path: |
                 ${{ inputs.output-file }}
                 integration_results.json
                 test_output.txt
               retention-days: 30
           
           - name: Comment on PR
             uses: actions/github-script@v6
             if: github.event_name == 'pull_request' && always()
             with:
               script: |
                 const fs = require('fs');
                 const total = '${{ steps.test.outputs.total }}';
                 const passed = '${{ steps.test.outputs.passed }}';
                 const failed = '${{ steps.test.outputs.failed }}';
                 const successRate = '${{ steps.test.outputs.success_rate }}';
                 const avgTime = '${{ steps.test.outputs.avg_response_time }}';
                 const endpoints = '${{ steps.test.outputs.endpoints }}';
                 
                 const allPassed = parseInt(failed) === 0;
                 const status = allPassed ? '✅ PASS' : '❌ FAIL';
                 const icon = allPassed ? '✅' : '❌';
                 
                 let reportContent = '';
                 try {
                   reportContent = fs.readFileSync('${{ inputs.output-file }}', 'utf8');
                 } catch (e) {
                   reportContent = 'Report not available';
                 }
                 
                 const body = `## ${icon} Service Integration Test Report
                 
                 **Status:** ${status}
                 **Base URL:** ${{ inputs.base-url }}
                 
                 ### Results
                 - **Total Tests:** ${total}
                 - **Passed:** ✅ ${passed}
                 - **Failed:** ❌ ${failed}
                 - **Success Rate:** ${successRate}%
                 - **Endpoints Tested:** ${endpoints}
                 - **Avg Response Time:** ${avgTime}ms
                 
                 <details>
                 <summary>View Full Report</summary>
                 
                 \`\`\`
                 ${reportContent.substring(0, 5000)}
                 \`\`\`
                 
                 </details>
                 
                 ---
                 *Generated by Service Integration Tester Agent*`;
                 
                 github.rest.issues.createComment({
                   issue_number: context.issue.number,
                   owner: context.repo.owner,
                   repo: context.repo.repo,
                   body: body
                 });
 

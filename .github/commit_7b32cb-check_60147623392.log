                       )
                       vulnerabilities.extend(vulns)
               
               return vulnerabilities
           
           def _parse_python_requirements(self, req_file: Path) -> List[Tuple[str, str]]:
               """Parse Python requirements file"""
               dependencies = []
               
               try:
                   with open(req_file, 'r') as f:
                       for line in f:
                           line = line.strip()
                           if not line or line.startswith('#'):
                               continue
                           
                           # Parse package==version or package>=version
                           match = re.match(r'^([a-zA-Z0-9_-]+)\s*([=><!]+)\s*([0-9.]+)', line)
                           if match:
                               pkg_name, operator, version = match.groups()
                               dependencies.append((pkg_name, version))
               except Exception as e:
                   print(f"Error parsing {req_file}: {e}")
               
               return dependencies
           
           def _parse_javascript_package_json(self, pkg_file: Path) -> List[Tuple[str, str]]:
               """Parse JavaScript package.json file"""
               dependencies = []
               
               try:
                   with open(pkg_file, 'r') as f:
                       data = json.load(f)
                   
                   # Extract dependencies and devDependencies
                   for dep_type in ['dependencies', 'devDependencies']:
                       if dep_type in data:
                           for pkg_name, version_spec in data[dep_type].items():
                               # Remove ^ and ~ prefixes
                               version = re.sub(r'^[\^~]', '', version_spec)
                               dependencies.append((pkg_name, version))
               except Exception as e:
                   print(f"Error parsing {pkg_file}: {e}")
               
               return dependencies
           
           def _parse_rust_cargo_toml(self, cargo_file: Path) -> List[Tuple[str, str]]:
               """Parse Rust Cargo.toml file"""
               dependencies = []
               
               try:
                   with open(cargo_file, 'r') as f:
                       content = f.read()
                   
                   # Simple TOML parsing for dependencies section
                   in_deps = False
                   for line in content.split('\n'):
                       line = line.strip()
                       
                       if line == '[dependencies]':
                           in_deps = True
                           continue
                       elif line.startswith('[') and in_deps:
                           in_deps = False
                       
                       if in_deps and '=' in line:
                           match = re.match(r'^([a-zA-Z0-9_-]+)\s*=\s*["\']([0-9.]+)', line)
                           if match:
                               pkg_name, version = match.groups()
                               dependencies.append((pkg_name, version))
               except Exception as e:
                   print(f"Error parsing {cargo_file}: {e}")
               
               return dependencies
           
           def _parse_go_mod(self, go_file: Path) -> List[Tuple[str, str]]:
               """Parse Go go.mod file"""
               dependencies = []
               
               try:
                   with open(go_file, 'r') as f:
                       for line in f:
                           line = line.strip()
                           
                           # Match require statements
                           match = re.match(r'^\s*([a-zA-Z0-9/._-]+)\s+v?([0-9.]+)', line)
                           if match:
                               pkg_name, version = match.groups()
                               dependencies.append((pkg_name, version))
               except Exception as e:
                   print(f"Error parsing {go_file}: {e}")
               
               return dependencies
           
           def _query_cve_databases(
               self,
               package: str,
               version: str,
               ecosystem: Ecosystem
           ) -> List[Vulnerability]:
               """
               Query CVE databases for vulnerabilities in a specific package version.
               
               Args:
                   package: Package name
                   version: Package version
                   ecosystem: Package ecosystem
                   
               Returns:
                   List of vulnerabilities found
               """
               vulnerabilities = []
               
               # Query each configured CVE source
               for source in self.config.get('cve_sources', []):
                   if source == 'github_advisory':
                       vulns = self._query_github_advisory(package, version, ecosystem)
                   elif source == 'nvd':
                       vulns = self._query_nvd(package, version, ecosystem)
                   elif source == 'osv':
                       vulns = self._query_osv(package, version, ecosystem)
                   else:
                       continue
                   
                   vulnerabilities.extend(vulns)
               
               # Deduplicate by CVE ID
               seen_cves = set()
               unique_vulns = []
               for vuln in vulnerabilities:
                   if vuln.cve_id not in seen_cves:
                       seen_cves.add(vuln.cve_id)
                       unique_vulns.append(vuln)
               
               return unique_vulns
           

       @cli.command()
       @click.option('--config', type=click.Path(exists=True), help='Config file path')
       @click.option('--base-url', required=True, help='Base URL of service to test')
       @click.option('--endpoints', type=click.Path(exists=True), help='OpenAPI spec or endpoint list')
       @click.option('--common', is_flag=True, help='Test common health/status endpoints')
       @click.option('--output', type=click.Path(), help='Output report path')
       @click.option('--json', 'json_output', type=click.Path(), help='Export results as JSON')
       @click.option('--verbose', is_flag=True, help='Verbose output')
       def test(config, base_url, endpoints, common, output, json_output, verbose):
           """Run service integration tests"""
           tester = ServiceIntegrationTester(Path(config) if config else None)
           
           # Discover endpoints
           if endpoints:
               discovered = tester.scan_endpoints(base_url, Path(endpoints))
           elif common:
               discovered = tester.scan_endpoints(base_url, 'common')
           else:
               click.echo("Error: Must specify --endpoints or --common")
               return
           
           click.echo(f"Discovered {len(discovered)} endpoints")
           
           # Test each endpoint
           for endpoint in discovered:
               if verbose:
                   click.echo(f"Testing {endpoint.method} {endpoint.path}...")
               
               result = tester.test_endpoint_sync(endpoint)
               
               if verbose:
                   if result.status == 'success':
                       click.echo(f"  ✓ Success ({result.response_time_ms:.2f}ms)")
                   else:
                       click.echo(f"  ✗ {result.status.upper()}")
                       if result.error:
                           click.echo(f"    Error: {result.error}")
           
           # Generate report
           report = tester.generate_report(Path(output) if output else None)
           click.echo("\n" + report)
           
           # Export JSON if requested
           if json_output:
               tester.export_results_json(Path(json_output))
               click.echo(f"\nResults exported to {json_output}")
       
       

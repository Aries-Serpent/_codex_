       ## Example 3: Scheduled Rust Security Updates
       
       ### Scenario
       Run scheduled security updates during maintenance window for a Rust project.
       
       ```python
       from security_vulnerability_patcher.src.agent import SecurityVulnerabilityPatcher
       from datetime import datetime, time
       
       def is_maintenance_window():
           """Check if current time is in maintenance window"""
           now = datetime.now()
           # Saturday/Sunday 2-6 AM
           if now.weekday() in [5, 6]:  # Saturday=5, Sunday=6
               if time(2, 0) <= now.time() <= time(6, 0):
                   return True
           return False
       
       def schedule_security_updates():
           agent = SecurityVulnerabilityPatcher()
           
           # Scan Rust project
           print("Scanning Rust dependencies...")
           vulnerabilities = agent.scan_vulnerabilities("./my-rust-project")
           
           # Separate by severity
           critical_high = [v for v in vulnerabilities if v.severity in ['critical', 'high']]
           medium_low = [v for v in vulnerabilities if v.severity in ['medium', 'low']]
           
           print(f"Critical/High: {len(critical_high)}")
           print(f"Medium/Low: {len(medium_low)}")
           
           # Critical/High: Immediate (even outside maintenance window)
           for vuln in critical_high:
               print(f"\nPatching {vuln.cve_id} (URGENT)...")
               patch = agent.generate_patch(vuln)
               
               if patch:
                   validation = agent.validate_patch_security(patch)
                   if validation['passed']:
                       test_results = agent.test_patch(patch, test_command="cargo test")
                       if test_results['passed']:
                           agent.apply_patch(patch, dry_run=False)
                           print(f"  ✅ Applied immediately")
           
           # Medium/Low: Only during maintenance window
           if is_maintenance_window():
               print("\n🕐 In maintenance window - patching medium/low severity...")
               
               for vuln in medium_low:
                   print(f"\nPatching {vuln.cve_id}...")
                   patch = agent.generate_patch(vuln)
                   
                   if patch:
                       validation = agent.validate_patch_security(patch)
                       test_results = agent.test_patch(patch, test_command="cargo test")
                       
                       if validation['passed'] and test_results['passed']:
                           agent.apply_patch(patch, dry_run=False)
                           print(f"  ✅ Applied during maintenance")
           else:
               print(f"\n⏸️  Scheduling {len(medium_low)} medium/low patches for next maintenance window")
               
               # Save patches for later
               import pickle
               with open('scheduled_patches.pkl', 'wb') as f:
                   pickle.dump([agent.generate_patch(v) for v in medium_low], f)
           
           # Generate report
           report = agent.generate_patch_report()
           print(f"\n📊 Final Report:")
           print(f"  Patched: {report.vulnerabilities_patched}/{report.vulnerabilities_found}")
           print(f"  Risk Reduced: {report.total_risk_reduced:.2f}")
       
       # Run scheduled updates
       schedule_security_updates()
       ```
       
       ### Output (Outside Maintenance Window)
       

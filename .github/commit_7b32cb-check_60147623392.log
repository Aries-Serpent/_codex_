       ## Pattern 1: Custom Patch Strategies
       
       ### Overview
       
       Implement custom patching strategies tailored to your organization's risk tolerance, development cycles, and operational requirements.
       
       ### Strategy Types
       
       #### Conservative Strategy
       - Minimal version changes (patch versions only)
       - Extensive testing required
       - Manual approval for all changes
       - Rollback plan mandatory
       
       #### Balanced Strategy
       - Minor version updates allowed
       - Automated testing with manual review
       - Critical patches auto-applied after validation
       - Staged rollout across environments
       
       #### Aggressive Strategy
       - Latest compatible versions
       - Automated patching with post-deployment monitoring
       - Fast-track critical vulnerabilities
       - Continuous security posture improvement
       
       ### Implementation
       
       ```python
       from security_vulnerability_patcher.src.agent import (
           SecurityVulnerabilityPatcher,
           PatchStrategy,
           RiskLevel
       )
       from typing import List, Dict, Optional
       from dataclasses import dataclass
       
       @dataclass
       class CustomPatchStrategy:
           """Custom patch strategy configuration"""
           name: str
           allow_major_updates: bool
           allow_minor_updates: bool
           allow_patch_updates: bool
           require_manual_approval_for: List[str]  # ['critical', 'high', 'medium', 'low']
           automated_testing_required: bool
           min_test_coverage: float  # 0.0 to 1.0
           rollback_on_failure: bool
           staging_required: bool
           approval_chain: List[str]  # ['security-team', 'dev-lead', 'cto']
           risk_threshold: float  # Max acceptable risk score
       
       class AdvancedPatchingOrchestrator:
           """Orchestrates patching with custom strategies"""
           
           def __init__(self, strategy: CustomPatchStrategy):
               self.agent = SecurityVulnerabilityPatcher()
               self.strategy = strategy
               self.approval_cache = {}
               
           def apply_strategy(self, repo_path: str) -> Dict:
               """Apply custom patching strategy"""
               # Scan for vulnerabilities
               vulnerabilities = self.agent.scan_vulnerabilities(repo_path)
               
               results = {
                   'total_vulnerabilities': len(vulnerabilities),
                   'patches_generated': 0,
                   'patches_applied': 0,
                   'patches_pending_approval': 0,
                   'patches_failed': 0,
                   'patches_staged': 0
               }
               
               for vuln in vulnerabilities:
                   # Generate patch
                   patch = self.agent.generate_patch(vuln)
                   if not patch:
                       continue
                   
                   results['patches_generated'] += 1
                   
                   # Assess if patch meets strategy criteria
                   if not self._meets_strategy_criteria(patch):
                       print(f"Patch for {vuln.cve_id} doesn't meet strategy criteria")
                       continue
                   
                   # Check if manual approval required
                   if vuln.severity in self.strategy.require_manual_approval_for:
                       print(f"Patch for {vuln.cve_id} requires manual approval")
                       
                       # Request approval through chain
                       if not self._request_approval_chain(patch):
                           results['patches_pending_approval'] += 1
                           continue
                   
                   # Validate security
                   validation = self.agent.validate_patch_security(patch)
                   if not validation['passed']:
                       results['patches_failed'] += 1
                       continue
                   
                   # Test if required
                   if self.strategy.automated_testing_required:
                       test_results = self._comprehensive_testing(patch)
                       if not test_results['passed']:
                           results['patches_failed'] += 1
                           continue
                   
                   # Stage if required
                   if self.strategy.staging_required:
                       if self._deploy_to_staging(patch):
                           results['patches_staged'] += 1
                           # Wait for staging validation before prod
                           if not self._validate_staging(patch):
                               results['patches_failed'] += 1
                               continue
                   
                   # Apply patch
                   apply_result = self.agent.apply_patch(patch, dry_run=False)
                   if apply_result['success']:
                       results['patches_applied'] += 1
                   else:
                       results['patches_failed'] += 1
                       
                       # Rollback if strategy requires
                       if self.strategy.rollback_on_failure:
                           self.agent.rollback_patch(patch.id)
               
               return results
           
           def _meets_strategy_criteria(self, patch) -> bool:
               """Check if patch meets strategy criteria"""
               # Parse version changes
               try:
                   current_parts = patch.current_version.split('.')
                   target_parts = patch.target_version.split('.')
                   
                   current_major = int(current_parts[0]) if current_parts else 0
                   target_major = int(target_parts[0]) if target_parts else 0
                   
                   current_minor = int(current_parts[1]) if len(current_parts) > 1 else 0
                   target_minor = int(target_parts[1]) if len(target_parts) > 1 else 0
                   
                   # Check major version change
                   if target_major > current_major and not self.strategy.allow_major_updates:
                       return False
                   
                   # Check minor version change
                   if target_minor > current_minor and not self.strategy.allow_minor_updates:
                       return False
                   
                   # Check risk threshold
                   risk_score = self.agent.calculate_risk_score(patch.vulnerability)
                   if risk_score > self.strategy.risk_threshold:
                       return False
                   
                   return True
                   
               except (ValueError, IndexError):
                   # Can't parse versions, require manual review
                   return False
           
           def _request_approval_chain(self, patch) -> bool:
               """Request approval through approval chain"""
               # Check cache first
               cache_key = f"{patch.id}_{patch.vulnerability.cve_id}"
               if cache_key in self.approval_cache:
                   return self.approval_cache[cache_key]
               
               print(f"\nApproval required for patch {patch.id}")
               print(f"Vulnerability: {patch.vulnerability.cve_id}")
               print(f"Severity: {patch.vulnerability.severity}")
               print(f"Package: {patch.target_package}")
               print(f"Version: {patch.current_version} → {patch.target_version}")
               
               # Simulate approval process (in production, integrate with approval system)
               for approver in self.strategy.approval_chain:
                   print(f"Waiting for approval from: {approver}...")
                   # In production: send notification, wait for response
                   # For now, auto-approve critical vulnerabilities
                   if patch.vulnerability.severity == 'critical':
                       approved = True
                   else:
                       # Simulate approval (in production, this would be async)
                       approved = input(f"Approve patch? (y/n): ").lower() == 'y'
                   
                   if not approved:
                       print(f"Patch rejected by {approver}")
                       self.approval_cache[cache_key] = False
                       return False
               
               print("Patch approved by all approvers")
               self.approval_cache[cache_key] = True
               return True
           
           def _comprehensive_testing(self, patch) -> Dict:
               """Run comprehensive test suite"""
               test_results = {
                   'passed': True,
                   'suites': {}
               }
               
               # Define test suites
               test_suites = {
                   'unit': 'pytest tests/unit -v',
                   'integration': 'pytest tests/integration -v',
                   'security': 'bandit -r . || safety check',
                   'performance': 'pytest tests/performance --benchmark-only'
               }
               
               for suite_name, test_cmd in test_suites.items():
                   print(f"Running {suite_name} tests...")
                   result = self.agent.test_patch(patch, test_command=test_cmd)
                   test_results['suites'][suite_name] = result
                   
                   if not result['passed']:
                       test_results['passed'] = False
                       print(f"  ❌ {suite_name} tests failed")
                       break
                   else:
                       print(f"  ✅ {suite_name} tests passed")
               
               # Check test coverage
               if test_results['passed'] and self.strategy.min_test_coverage > 0:
                   coverage = self._measure_test_coverage()
                   if coverage < self.strategy.min_test_coverage:
                       print(f"  ⚠️  Test coverage {coverage:.1%} below minimum {self.strategy.min_test_coverage:.1%}")
                       test_results['passed'] = False
               
               return test_results
           
           def _measure_test_coverage(self) -> float:
               """Measure test coverage"""
               import subprocess
               try:
                   result = subprocess.run(
                       'pytest --cov=. --cov-report=term-missing',
                       shell=True,
                       capture_output=True,
                       text=True,
                       timeout=300
                   )
                   
                   # Parse coverage from output
                   import re
                   match = re.search(r'TOTAL\s+\d+\s+\d+\s+(\d+)%', result.stdout)
                   if match:
                       return float(match.group(1)) / 100.0
               except Exception as e:
                   print(f"Error measuring coverage: {e}")
               
               return 0.0
           
           def _deploy_to_staging(self, patch) -> bool:
               """Deploy patch to staging environment"""
               print(f"Deploying patch {patch.id} to staging...")
               
               # In production, this would:
               # 1. Create staging branch
               # 2. Apply patch
               # 3. Deploy to staging infrastructure
               # 4. Run smoke tests
               
               # Simulate staging deployment
               try:
                   # Apply patch to staging (simulated)
                   print("  - Creating staging branch")
                   print("  - Applying patch")
                   print("  - Deploying to staging environment")
                   print("  - Running smoke tests")
                   
                   return True
               except Exception as e:
                   print(f"  ❌ Staging deployment failed: {e}")
                   return False
           
           def _validate_staging(self, patch, validation_period: int = 3600) -> bool:
               """Validate patch in staging environment"""
               print(f"Validating patch in staging for {validation_period}s...")
               
               # In production, this would:
               # 1. Monitor error rates
               # 2. Check performance metrics
               # 3. Run automated tests
               # 4. Validate business functionality
               
               # For now, simulate validation
               import time
               time.sleep(2)  # Simulate monitoring period
               
               print("  ✅ Staging validation passed")
               return True
       
       
       # Example usage: Conservative strategy for production
       conservative_strategy = CustomPatchStrategy(
           name="production-conservative",
           allow_major_updates=False,
           allow_minor_updates=True,
           allow_patch_updates=True,
           require_manual_approval_for=['critical', 'high'],
           automated_testing_required=True,
           min_test_coverage=0.80,
           rollback_on_failure=True,
           staging_required=True,
           approval_chain=['security-team', 'dev-lead'],
           risk_threshold=7.0
       )
       
       orchestrator = AdvancedPatchingOrchestrator(conservative_strategy)
       results = orchestrator.apply_strategy("./production-repo")
       
       print(f"\nPatch Results:")
       print(f"  Total Vulnerabilities: {results['total_vulnerabilities']}")
       print(f"  Patches Generated: {results['patches_generated']}")
       print(f"  Patches Applied: {results['patches_applied']}")
       print(f"  Pending Approval: {results['patches_pending_approval']}")
       print(f"  Failed: {results['patches_failed']}")

       ## Example 5: Patch with Test Validation
       
       ### Scenario
       Apply patches with comprehensive test validation and rollback on failure.
       
       ```python
       from security_vulnerability_patcher.src.agent import (
           SecurityVulnerabilityPatcher,
           PatchStatus
       )
       
       def safe_patch_with_validation(repo_path, test_suite_path):
           agent = SecurityVulnerabilityPatcher()
           
           # Scan
           vulnerabilities = agent.scan_vulnerabilities(repo_path)
           print(f"Found {len(vulnerabilities)} vulnerabilities\n")
           
           successful_patches = []
           failed_patches = []
           
           for vuln in vulnerabilities:
               if vuln.severity not in ['critical', 'high']:
                   continue  # Only patch critical/high in this example
               
               print(f"Processing {vuln.cve_id}...")
               
               # Generate patch
               patch = agent.generate_patch(vuln)
               if not patch:
                   print(f"  No patch available\n")
                   continue
               
               # Validate security
               validation = agent.validate_patch_security(patch)
               if not validation['passed']:
                   print(f"  ❌ Security validation failed\n")
                   failed_patches.append((patch, "validation_failed"))
                   continue
               
               # Test with multiple test suites
               test_suites = [
                   ("unit", "pytest tests/unit"),
                   ("integration", "pytest tests/integration"),
                   ("e2e", "pytest tests/e2e")
               ]
               
               all_tests_passed = True
               for suite_name, test_cmd in test_suites:
                   print(f"  Running {suite_name} tests...")
                   test_results = agent.test_patch(patch, test_command=test_cmd)
                   
                   if not test_results['passed']:
                       print(f"    ❌ {suite_name} tests failed")
                       print(f"       {test_results['tests_failed']} failures")
                       all_tests_passed = False
                       break
                   else:
                       print(f"    ✅ {suite_name} tests passed ({test_results['tests_passed']} tests)")
               
               if not all_tests_passed:
                   print(f"  ❌ Not applying due to test failures\n")
                   failed_patches.append((patch, "tests_failed"))
                   continue
               
               # Apply patch
               print(f"  Applying patch...")
               apply_results = agent.apply_patch(patch, dry_run=False)
               
               if apply_results['success']:
                   print(f"  ✅ Patch applied successfully")
                   successful_patches.append(patch)
                   
                   # Verify post-application
                   print(f"  Verifying post-application...")
                   
                   # Run quick smoke test
                   import subprocess
                   result = subprocess.run(
                       "pytest tests/smoke --maxfail=1",
                       shell=True,
                       capture_output=True,
                       timeout=60
                   )
                   
                   if result.returncode != 0:
                       print(f"  ⚠️  Post-application smoke test failed!")
                       print(f"  Rolling back...")
                       
                       rollback_result = agent.rollback_patch(patch.id)
                       if rollback_result['success']:
                           print(f"  ✅ Rollback successful")
                           failed_patches.append((patch, "post_application_failure"))
                           successful_patches.remove(patch)
                       else:
                           print(f"  ❌ Rollback failed - manual intervention required!")
                   else:
                       print(f"  ✅ Post-application verification passed")
               else:
                   print(f"  ❌ Application failed")
                   failed_patches.append((patch, "application_failed"))
               
               print()
           
           # Summary
           print(f"{'='*60}")
           print(f"PATCH SUMMARY")
           print(f"{'='*60}")
           print(f"Successful: {len(successful_patches)}")
           print(f"Failed: {len(failed_patches)}")
           
           if failed_patches:
               print(f"\nFailed Patches:")
               for patch, reason in failed_patches:
                   print(f"  - {patch.vulnerability.cve_id}: {reason}")
           
           return successful_patches, failed_patches
       
       # Execute
       successful, failed = safe_patch_with_validation("./my-app", "./tests")

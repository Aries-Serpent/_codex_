       class TestPatchWithTestFailuresRollback:
           """Test rollback when patch causes test failures"""
           
           def test_patch_with_test_failures_rollback(self, full_project):
               """Test that failed patches can be rolled back"""
               agent = SecurityVulnerabilityPatcher()
               
               vuln = Vulnerability(
                   cve_id="CVE-2024-FAIL",
                   severity="high",
                   cvss_score=7.8,
                   affected_package="problematic-package",
                   affected_versions=["1.0.0"],
                   fixed_version="2.0.0",
                   description="Patch causes breaking changes",
                   published_date=datetime.now(timezone.utc),
                   ecosystem=Ecosystem.PYTHON
               )
               
               patch = agent.generate_patch(vuln)
               
               # Test fails
               with patch('subprocess.run') as mock_run:
                   mock_run.return_value = Mock(
                       returncode=1,
                       stdout="Tests failed",
                       stderr="Breaking changes detected"
                   )
                   
                   test_results = agent.test_patch(patch, test_command="pytest")
                   
                   assert test_results['passed'] == False
                   assert patch.status == PatchStatus.FAILED
               
               # Apply anyway for testing rollback
               patch.status = PatchStatus.APPLIED
               patch.rollback_info = {'backup_dir': str(full_project / '.backup')}
               
               # Rollback
               rollback_result = agent.rollback_patch(patch.id)
               
               assert patch.status == PatchStatus.ROLLED_BACK
       
       

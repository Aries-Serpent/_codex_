name: ML Lifecycle E2E Gate
'on':
  workflow_dispatch: null
  schedule:
  - cron: 0 4 * * 1
  push:
    branches:
    - main
    - 0D_base_
    paths:
    - src/codex_ml/**
    - src/training/**
    - training/**
    - requirements*.txt
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  actions: write
jobs:
  reproducibility-check:
    if: ${{ github.event.pull_request.number != 5328 }}
    name: Reproducibility smoke check (D2)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
    - uses: actions/checkout@v5
    - uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - run: pip install -q -r requirements-dev.txt
    - name: Run reproducibility validator
      run: python scripts/ml/validate_ml_lifecycle.py --check reproducibility
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
  serving-smoke:
    name: Serving smoke test (D2)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
    - uses: actions/checkout@v5
    - uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - run: pip install -q -r requirements-dev.txt
    - name: Run serving smoke test
      run: python scripts/ml/validate_ml_lifecycle.py --check serving
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
  model-registry-audit:
    name: Model registry audit (D2)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
    - uses: actions/checkout@v5
    - uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - run: pip install -q -r requirements-dev.txt
    - name: Run model registry audit
      run: python scripts/ml/validate_ml_lifecycle.py --check registry
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
  e2e-gate:
    name: E2E pipeline gate (D2)
    needs:
    - reproducibility-check
    - serving-smoke
    - model-registry-audit
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
    - uses: actions/checkout@v5
    - uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - run: pip install -q -r requirements-dev.txt
    - name: Run E2E gate validation
      run: python scripts/ml/validate_ml_lifecycle.py --check e2e
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
  gate-summary:
    name: D2 Gate Summary
    needs:
    - reproducibility-check
    - serving-smoke
    - model-registry-audit
    - e2e-gate
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
    - name: Evaluate D2 exit criteria
      run: "python3 - <<'PYEOF'\nimport json, sys\nfrom datetime import datetime,\
        \ timezone\n\nresults = {\n    \"reproducibility\": \"${{ needs.reproducibility-check.result\
        \ }}\",\n    \"serving_smoke\":   \"${{ needs.serving-smoke.result }}\",\n\
        \    \"model_registry\":  \"${{ needs.model-registry-audit.result }}\",\n\
        \    \"e2e_gate\":        \"${{ needs.e2e-gate.result }}\",\n}\npassed = [k\
        \ for k, v in results.items() if v == \"success\"]\nfailed = [k for k, v in\
        \ results.items() if v != \"success\"]\n\nreport = {\n    \"generated_at\"\
        : datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n    \"domain\"\
        : \"D2_ml_lifecycle\",\n    \"target_score\": 5,\n    \"checks\": results,\n\
        \    \"passed_count\": len(passed),\n    \"failed_count\": len(failed),\n\
        \    \"gate_passed\": len(failed) == 0,\n}\nprint(json.dumps(report, indent=2))\n\
        if failed:\n    print(f\"::warning::D2 ML Lifecycle gate: {len(failed)} checks\
        \ failed: {failed}\")\nelse:\n    print(\"::notice::\u2705 D2 ML Lifecycle\
        \ gate passed \u2014 all 4 CI checks green (score 5)\")\nPYEOF\n"
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}

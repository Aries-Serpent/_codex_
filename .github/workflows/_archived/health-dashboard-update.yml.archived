      - name: 📊 Generate Summary
        if: always()
        run: |
          echo "## 🏥 Health Dashboard Update" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "✅ Metrics collected and updated" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Health Status:** ${{ steps.analyze.outputs.health_icon }} ${{ steps.analyze.outputs.health_status }}" >> $GITHUB_STEP_SUMMARY
          echo "**Health Score:** ${{ steps.analyze.outputs.health_score }}/100" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### Metrics Updated" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Workflow Success Rate" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ CodeQL Alerts" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Security Vulnerabilities" >> $GITHUB_STEP_SUMMARY
          echo "- ✅ Test & Coverage Metrics" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "[View Dashboard](../docs/operations/health-dashboard.md)" >> $GITHUB_STEP_SUMMARY

  notify:
    name: 🔔 Send Notifications
    runs-on: ubuntu-latest
    needs: collect_metrics
    if: always()
    permissions:
      contents: read

    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v5

      - name: 📢 Prepare notification
        id: notify
        run: |
          echo "✅ Health dashboard metrics collection completed"
          echo "📊 Metrics file: .codex/WORKFLOW_HEALTH_DASHBOARD.json"
          echo "📈 Dashboard: docs/operations/health-dashboard.md"

      - name: 📄 Post workflow summary
        run: |
          echo "## Health Dashboard Metrics Collection" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "✅ Workflow completed successfully" >> $GITHUB_STEP_SUMMARY
          echo "⏰ Timestamp: $(date -u +'%Y-%m-%dT%H:%M:%SZ')" >> $GITHUB_STEP_SUMMARY

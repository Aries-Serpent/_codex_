name: 🏥 Health Dashboard Metrics Collection

on:
  schedule:
    # Run every 30 minutes
    - cron: '*/30 * * * *'
  workflow_dispatch:
    inputs:
      force_alert:
        description: 'Force alert for testing (HEALTHY, CAUTION, WARNING, CRITICAL)'
        required: false
        default: ''

concurrency:
  group: health-dashboard-update
  cancel-in-progress: false

env:
  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
  METRICS_FILE: '.codex/WORKFLOW_HEALTH_DASHBOARD.json'
  PYTHON_VERSION: '3.11'


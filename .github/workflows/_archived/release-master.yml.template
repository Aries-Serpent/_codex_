name: Enhanced Release Pipeline

on:
  workflow_dispatch:
    inputs:
      deployment-type:
        description: 'Deployment type(s) to execute'
        required: true
        type: choice
        options:
          - github-release
          - pypi
          - observable
          - all
        default: all
      version:
        description: 'Release version (e.g., v0.1.0). If empty, detected from tag.'
        required: false
        type: string
      dry-run:
        description: 'Create draft release (dry run) for testing'
        required: false
        type: boolean
        default: false
      skip-verification:
        description: 'Skip post-release verification (NOT recommended for production)'
        required: false
        type: boolean
        default: false
  push:
    tags:
      - 'v*'

concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: false

permissions:
  contents: write
  packages: write
  pull-requests: write
  id-token: write
  issues: write
  actions: write

env:
  PYTHON_VERSION: '3.12'
  UV_CACHE_DIR: ~/.cache/uv

jobs:
  validate-pre-release:
    name: Pre-Release Validation & Gate Checks
    runs-on: ubuntu-latest
    timeout-minutes: 30
    outputs:
      version: ${{ steps.version.outputs.version }}
      clean-version: ${{ steps.version.outputs.clean-version }}
      release-type: ${{ steps.version.outputs.release-type }}
      should-proceed: ${{ steps.gate-decision.outputs.should-proceed }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'

      - name: Determine release version
        id: version
        env:
          GITHUB_REF: ${{ github.ref }}
          INPUT_VERSION: ${{ github.event.inputs.version }}
        run: |
          # Priority 1: Explicit input version
          if [ -n "$INPUT_VERSION" ] && [ "$INPUT_VERSION" != "null" ]; then
            VERSION="$INPUT_VERSION"
            echo "ℹ Using INPUT_VERSION: $VERSION"
          # Priority 2: Tag from push event
          elif [[ "$GITHUB_REF" =~ ^refs/tags/ ]]; then
            VERSION="$GITHUB_REF"
            VERSION="${VERSION#refs/tags/}"
            echo "ℹ Using GITHUB_REF tag: $VERSION"
          # Priority 3: Latest tag in repository
          else
            echo "ℹ Searching for latest version tag..."
            VERSION=$(git tag -l 'v*.*.*' --sort=-version:refname --merged HEAD | head -1)
            if [ -z "$VERSION" ]; then
              echo "❌ ERROR: No version tag found and no version input provided"
              exit 1
            fi
            echo "ℹ Using latest tag: $VERSION"
          fi

          # Ensure version starts with 'v'
          if [[ ! "$VERSION" =~ ^v ]]; then
            VERSION="v${VERSION}"
          fi

          # Extract clean version for PyPI (no v prefix, no -final suffix)
          CLEAN_VERSION="${VERSION#v}"
          CLEAN_VERSION="${CLEAN_VERSION%-final*}"

          # Determine release type (alpha, beta, rc, or final)
          if [[ "$CLEAN_VERSION" =~ alpha ]]; then
            RELEASE_TYPE="alpha"
          elif [[ "$CLEAN_VERSION" =~ beta ]]; then
            RELEASE_TYPE="beta"
          elif [[ "$CLEAN_VERSION" =~ rc ]]; then
            RELEASE_TYPE="rc"
          else
            RELEASE_TYPE="final"
          fi

          echo "version=${VERSION}" >> $GITHUB_OUTPUT
          echo "clean-version=${CLEAN_VERSION}" >> $GITHUB_OUTPUT
          echo "release-type=${RELEASE_TYPE}" >> $GITHUB_OUTPUT

          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "✓ Release Version: ${VERSION}"
          echo "✓ PyPI Version: ${CLEAN_VERSION}"
          echo "✓ Release Type: ${RELEASE_TYPE}"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

      - name: '[P0] Profile alignment validation'
        id: p0-gate
        continue-on-error: true
        run: |
          echo "🔍 Checking P0 gates..."
          PASS=true

          if [ ! -f ".codex/PROFILE_DRIFT_AUDIT.json" ]; then
            echo "⚠️  P0.1.1: Profile drift audit missing"
            PASS=false
          else
            echo "✅ P0.1.1: Profile drift audit found"
          fi

          if [ ! -f ".codex/PROFILE_DEPENDENCY_MANIFEST.md" ]; then
            echo "⚠️  P0.1.3: Profile manifest missing"
            PASS=false
          else
            echo "✅ P0.1.3: Profile manifest found"
          fi

          if [ "$PASS" = true ]; then
            echo "gate_status=passed" >> $GITHUB_OUTPUT
          else
            echo "gate_status=partial" >> $GITHUB_OUTPUT
          fi

      - name: '[P1] Build artifacts validation'
        id: p1-gate
        continue-on-error: true
        run: |
          echo "🔍 Checking P1 gates..."
          PASS=true

          if [ ! -f "sbom.json" ] && [ ! -f ".codex/sbom.json" ]; then
            echo "⚠️  P1.3.2: SBOM not found (will be generated)"
            PASS=false
          else
            echo "✅ P1.3.2: SBOM found"
          fi

          if [ "$PASS" = true ]; then
            echo "gate_status=passed" >> $GITHUB_OUTPUT
          else
            echo "gate_status=partial" >> $GITHUB_OUTPUT
          fi

      - name: '[P2] Release readiness validation'
        id: p2-gate
        continue-on-error: true
        run: |
          echo "🔍 Checking P2 gates..."
          PASS=true

          if [ ! -f ".github/workflows/release.yml" ]; then
            echo "⚠️  P2.2.1: Release workflow missing"
            PASS=false
          else
            echo "✅ P2.2.1: Release workflow found"
          fi

          if [ ! -f ".github/workflows/smoke-tests-deployment.yml" ]; then
            echo "⚠️  P2.2.2: Smoke tests workflow missing"
            PASS=false
          else
            echo "✅ P2.2.2: Smoke tests workflow found"
          fi

          if [ ! -f "docs/deployment/DEPLOYMENT_GUIDE.md" ]; then
            echo "⚠️  P2.2.3: Deployment guide missing"
            PASS=false
          else
            echo "✅ P2.2.3: Deployment guide found"
          fi

          if [ ! -f "scripts/deploy/rollback_release.py" ] || [ ! -f "docs/deployment/ROLLBACK_CHECKLIST.md" ]; then
            echo "⚠️  P2.2.4: Rollback procedures missing"
            PASS=false
          else
            echo "✅ P2.2.4: Rollback procedures found"
          fi

          if [ "$PASS" = true ]; then
            echo "gate_status=passed" >> $GITHUB_OUTPUT
          else
            echo "gate_status=partial" >> $GITHUB_OUTPUT
          fi

      - name: Validate version format
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          if [[ ! "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
            echo "❌ Invalid version format: $VERSION (expected vX.Y.Z[-suffix])"
            exit 1
          fi
          echo "✅ Version format valid"

      - name: Verify CHANGELOG entry
        continue-on-error: true
        run: |
          CLEAN_VERSION="${{ steps.version.outputs.clean-version }}"
          if grep -q "\[$CLEAN_VERSION\]" CHANGELOG.md 2>/dev/null; then
            echo "✅ CHANGELOG.md entry found for version $CLEAN_VERSION"
          else
            echo "⚠️  CHANGELOG.md entry not found for version $CLEAN_VERSION"
          fi

      - name: Verify pyproject.toml version
        run: |
          CLEAN_VERSION="${{ steps.version.outputs.clean-version }}"
          if grep -q "version = \"${CLEAN_VERSION}\"" pyproject.toml; then
            echo "✅ pyproject.toml version matches: $CLEAN_VERSION"
          else
            echo "❌ pyproject.toml version mismatch (expected $CLEAN_VERSION)"
            exit 1
          fi

      - name: Final gate decision
        id: gate-decision
        run: |
          P0_STATUS="${{ steps.p0-gate.outputs.gate_status || 'unknown' }}"
          P1_STATUS="${{ steps.p1-gate.outputs.gate_status || 'unknown' }}"
          P2_STATUS="${{ steps.p2-gate.outputs.gate_status || 'unknown' }}"

          echo "📊 Gate Summary:"
          echo "  P0 (Profile): $P0_STATUS"
          echo "  P1 (Artifacts): $P1_STATUS"
          echo "  P2 (Readiness): $P2_STATUS"

          if [[ "$P0_STATUS" == "passed" ]] && [[ "$P2_STATUS" == "passed" ]]; then
            echo "✅ GATE PASSED: Release may proceed"
            echo "should-proceed=true" >> $GITHUB_OUTPUT
          else
            echo "❌ GATE FAILED: Review failures above"
            echo "should-proceed=false" >> $GITHUB_OUTPUT
            exit 1
          fi

      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token }}

  build-artifacts:
    name: Build Release Artifacts
    needs: validate-pre-release
    if: needs.validate-pre-release.outputs.should-proceed == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    outputs:
      artifact-count: ${{ steps.metrics.outputs.artifact-count }}
      sbom-generated: ${{ steps.sbom.outputs.sbom-generated }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up Python with tiered cache
        uses: ./.github/actions/setup-python-cached
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache-tier: common

      - name: Install build dependencies
        run: |
          python -m pip install --upgrade pip
          pip install build twine

      - name: Build wheels
        id: build
        run: |
          START=$(date +%s)
          python -m build
          END=$(date +%s)
          DURATION=$((END - START))

          echo "build-duration=${DURATION}" >> $GITHUB_OUTPUT
          echo "✅ Build completed in ${DURATION}s"

          ls -lh dist/

      - name: Check distribution
        run: twine check dist/*

      - name: Calculate artifact hashes
        id: hashes
        run: |
          cd dist
          sha256sum ./* > SHA256SUMS
          echo "📊 Artifact Hashes:"
          cat SHA256SUMS
          cd ..

      - name: Collect build metrics
        id: metrics
        run: |
          ARTIFACT_COUNT=$(ls dist/*.whl 2>/dev/null | wc -l)
          echo "artifact-count=${ARTIFACT_COUNT}" >> $GITHUB_OUTPUT
          echo "✅ Artifacts: ${ARTIFACT_COUNT} wheels"

      - name: Upload artifacts
        uses: actions/upload-artifact@v5
        with:
          name: release-artifacts-${{ needs.validate-pre-release.outputs.clean-version }}
          path: dist/
          retention-days: 90

      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token }}

  workflow-summary:
    name: Release Pipeline Complete
    needs: [validate-pre-release, build-artifacts]
    if: needs.validate-pre-release.outputs.should-proceed == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Print workflow summary
        run: |
          cat << 'SUMMARY'

          ╔═══════════════════════════════════════════════════════════════╗
          ║         ENHANCED RELEASE WORKFLOW COMPLETED ✅               ║
          ╚═══════════════════════════════════════════════════════════════╝

          📋 Release Details:
             Version: ${{ needs.validate-pre-release.outputs.version }}
             Release Type: ${{ needs.validate-pre-release.outputs.release-type }}
             Deployment Type: ${{ github.event.inputs.deployment-type }}

          📦 Build Artifacts:
             Wheels Built: ${{ needs.build-artifacts.outputs.artifact-count }}

          ✨ Consolidation Achievement:
             This enhanced workflow consolidates 6 workflows into 1
             - 71% reduction in workflow count

          SUMMARY


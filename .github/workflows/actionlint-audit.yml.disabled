name: Workflow Compliance Audit (actionlint)
on:
  pull_request:
    paths:
    - .github/workflows/**
  push:
    branches:
    - main
    paths:
    - .github/workflows/**
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  pull-requests: write
jobs:
  lint-workflows:
    name: "actionlint \u2014 Workflow Compliance"
    runs-on: ubuntu-latest
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        fetch-depth: 1
    - name: Install actionlint
      run: "# Pinned version with fallback to latest\nPINNED=\"v1.7.7\"\n\n# Download\
        \ JSON file first, then parse (safer than curl | python3)\nRELEASES_JSON=\"\
        /tmp/releases.json\"\ncurl -fsSL -o \"$RELEASES_JSON\" --max-time 10 \\\n\
        \  \"https://api.github.com/repos/rhysd/actionlint/releases/latest\" 2>/dev/null\
        \ || true\n\n# Parse safely with python3 (file, not pipe)\nif [ -f \"$RELEASES_JSON\"\
        \ ]; then\n  LATEST=$(python3 -c \\\n    \"import sys,json; print(json.load(open('$RELEASES_JSON'))['tag_name'])\"\
        \ \\\n    2>/dev/null || echo \"${PINNED}\")\nelse\n  LATEST=\"${PINNED}\"\
        \nfi\n\nTARGET=\"${LATEST:-${PINNED}}\"\nVERSION=\"${TARGET#v}\"\n\n# Download\
        \ file first, then extract (safer than curl | tar)\nTARBALL=\"/tmp/actionlint_${VERSION}_linux_amd64.tar.gz\"\
        \ncurl -fsSL -o \"$TARBALL\" \\\n  \"https://github.com/rhysd/actionlint/releases/download/${TARGET}/actionlint_${VERSION}_linux_amd64.tar.gz\"\
        \ntar xz -f \"$TARBALL\" -C /tmp actionlint\nsudo mv /tmp/actionlint /usr/local/bin/\n\
        actionlint --version\n"
    - name: Run actionlint on all workflows
      id: actionlint
      run: "mapfile -t WORKFLOW_FILES < <(find .github/workflows -maxdepth 1 -name\
        \ '*.yml' | sort)\nactionlint -format '{{range $e := .}}::error file={{$e.Filepath}},line={{$e.Line}}::{{$e.Message}}{{end}}'\
        \ \"${WORKFLOW_FILES[@]}\" 2>&1 | tee /tmp/actionlint_results.txt || true\n\
        ERROR_COUNT=$(grep -c \"::error\" /tmp/actionlint_results.txt 2>/dev/null;\
        \ true)\necho \"error_count=${ERROR_COUNT}\" >> \"$GITHUB_OUTPUT\"\nif [ \"\
        ${ERROR_COUNT}\" -gt 0 ]; then\n  echo \"::error::actionlint found ${ERROR_COUNT}\
        \ workflow compliance issue(s)\"\n  exit 1\nfi\necho \"\u2705 actionlint:\
        \ 0 errors across $(find .github/workflows -maxdepth 1 -name '*.yml' | wc\
        \ -l) workflow files\"\n"
    - name: Post summary
      if: always()
      run: "{\n  echo \"## Workflow Compliance Audit (actionlint)\"\n  echo \"\"\n\
        \  if [ -f /tmp/actionlint_results.txt ] && [ -s /tmp/actionlint_results.txt\
        \ ]; then\n    echo \"\\`\\`\\`\"\n    cat /tmp/actionlint_results.txt\n \
        \   echo \"\\`\\`\\`\"\n  else\n    TOTAL=$(find .github/workflows -maxdepth\
        \ 1 -name '*.yml' | wc -l)\n    echo \"\u2705 No issues found across ${TOTAL}\
        \ workflow files.\"\n  fi\n} >> \"$GITHUB_STEP_SUMMARY\"\n"
    timeout-minutes: 15
  rescue-comment:
    name: Post rescue comment on failure
    runs-on: ubuntu-latest
    needs: lint-workflows
    if: failure() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name
      == github.repository
    permissions:
      pull-requests: write
      issues: write
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        fetch-depth: 1
    - name: Post or update rescue comment
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
        REPO: ${{ github.repository }}
        COMMIT_SHA: ${{ github.event.pull_request.head.sha }}
        RUN_ID: ${{ github.run_id }}
        WORKFLOW_NAME: Actionlint Workflow Audit
        RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{
          github.run_id }}
        BRANCH: ${{ github.head_ref }}
      run: python scripts/ci/post_rescue_comment.py || true
    timeout-minutes: 30

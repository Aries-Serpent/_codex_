name: Phase 12.2 Compliance Check
'on':
  push:
    branches:
    - '**'
  pull_request:
    branches:
    - '**'
  workflow_dispatch: null
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  pull-requests: write
jobs:
  detect-merge:
    name: Detect merge commit
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      is_merge: ${{ steps.check.outputs.is_merge }}
    steps:
    - name: Mask secrets
      run: 'echo "::add-mask::$(echo $GH_TOKEN | head -c 10)"

        '
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 1
    - name: Check if merge commit
      id: check
      run: "# Check if HEAD has multiple parents (is a merge commit)\nPARENT_COUNT=$(git\
        \ rev-list --max-count=1 --pretty=%P HEAD | tail -1 | wc -w)\nif [ \"$PARENT_COUNT\"\
        \ -gt 1 ]; then\n  echo \"is_merge=true\" >> \"$GITHUB_OUTPUT\"\n  echo \"\
        Current commit is a merge commit (parents: $PARENT_COUNT)\"\nelse\n  echo\
        \ \"is_merge=false\" >> \"$GITHUB_OUTPUT\"\n  echo \"Current commit is a regular\
        \ commit (parents: $PARENT_COUNT)\"\nfi\n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
  compliance-check:
    name: Governance & Compliance Gate
    runs-on: ubuntu-latest
    needs: detect-merge
    outputs:
      status: ${{ steps.status.outputs.status }}
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 50
    - name: Set up Python
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: '3.12'
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - name: Run compliance dashboard (check mode)
      id: compliance
      run: "python scripts/ci/phase_12_2_compliance_dashboard.py \\\n  --check \\\n\
        \  --report \\\n  --json > compliance-output.json\n"
      continue-on-error: true
      env:
        GH_TOKEN: ${{ github.token }}
    - name: Capture compliance status
      id: status
      run: "if [ -f compliance-output.json ]; then\n  STATUS=$(python -c \"\nimport\
        \ json, sys\nwith open('compliance-output.json') as f:\n    d = json.load(f)\n\
        print(d.get('governance_status', 'UNKNOWN'))\n\")\n  SCORE=$(python -c \"\n\
        import json\nwith open('compliance-output.json') as f:\n    d = json.load(f)\n\
        print(f\\\"{d.get('compliance_score', 0) * 100:.0f}%\\\")\n\")\nelse\n  STATUS=\"\
        UNKNOWN\"\n  SCORE=\"0%\"\nfi\necho \"status=${STATUS}\" >> \"$GITHUB_OUTPUT\"\
        \necho \"score=${SCORE}\" >> \"$GITHUB_OUTPUT\"\necho \"Governance Status:\
        \ ${STATUS} (score: ${SCORE})\"\n"
    - name: Upload compliance report
      if: always()
      uses: actions/upload-artifact@v5
      with:
        path: '.codex/PHASE_12_2_COMPLIANCE_REPORT.md

          compliance-output.json

          '
        retention-days: 30
        name: governance-report
    - name: Post PR comment
      if: github.event_name == 'pull_request' && always()
      uses: actions/github-script@v8
      with:
        script: "const fs = require('fs');\nconst owner = context.repo.owner;\nconst\
          \ repo = context.repo.repo;\nconst issue_number = context.issue.number;\n\
          const status = '${{ steps.status.outputs.status }}';\nconst score = '${{\
          \ steps.status.outputs.score }}';\nconst anchor = '<!-- phase-12-2-compliance\
          \ -->';\nconst statusEmoji = { APPROVED: '\u2705', WARN: '\u26A0\uFE0F',\
          \ BLOCK: '\U0001F6AB' }[status] || '\u2753';\n\nlet body = `${anchor}\\\
          n\\n## ${statusEmoji} Phase 12.2 Compliance: **${status}**\\n\\n`;\nbody\
          \ += `**Score:** ${score}\\n\\n`;\n\nif (fs.existsSync('.codex/PHASE_12_2_COMPLIANCE_REPORT.md'))\
          \ {\n  const report = fs.readFileSync('.codex/PHASE_12_2_COMPLIANCE_REPORT.md',\
          \ 'utf8');\n  // Extract the requirements table section\n  const tableMatch\
          \ = report.match(/## Requirement Status\\n\\n[\\s\\S]*?\\n\\n---/);\n  if\
          \ (tableMatch) {\n    body += tableMatch[0].replace('\\n\\n---', '');\n\
          \  }\n}\n\nbody += '\\n\\n*Generated by [Phase 12.2 Compliance Workflow](../actions)*';\n\
          \ntry {\n  const comments = await github.paginate(github.rest.issues.listComments,\
          \ {\n    owner,\n    repo,\n    issue_number,\n    per_page: 100,\n  });\n\
          \n  const existing = comments.find((comment) => comment.user?.login ===\
          \ 'github-actions[bot]' && comment.body?.includes(anchor));\n\n  if (existing)\
          \ {\n    await github.rest.issues.updateComment({\n      owner,\n      repo,\n\
          \      comment_id: existing.id,\n      body,\n    });\n  } else {\n    await\
          \ github.rest.issues.createComment({\n      owner,\n      repo,\n      issue_number,\n\
          \      body,\n    });\n  }\n} catch (error) {\n  core.warning(`Could not\
          \ post Phase 12.2 compliance comment: ${error.message}`);\n}\n"
    - name: Fail if compliance blocked (non-merge commits)
      if: steps.compliance.outcome == 'failure' && needs.detect-merge.outputs.is_merge
        == 'false'
      run: 'echo "::error::Phase 12.2 compliance check FAILED. See governance-report
        artifact for details."

        exit 1

        '
    - name: Warn if compliance blocked (merge commits)
      if: steps.compliance.outcome == 'failure' && needs.detect-merge.outputs.is_merge
        == 'true'
      run: 'echo "::warning::Phase 12.2 compliance check found issues on merge commit.
        Review governance-report artifact."

        '
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    timeout-minutes: 15
  auto-approve-on-compliance:
    name: "\u26A1 Auto-Approve if Compliance Passed"
    needs: compliance-check
    if: 'success() &&

      needs.compliance-check.outputs.status == ''APPROVED'' &&

      github.event_name == ''pull_request''

      '
    runs-on: ubuntu-latest
    steps:
    - name: Dispatch auto-approve-workflows
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}
      run: "gh workflow run auto-approve-workflows.yml \\\n  -f approval_source=workflow-execution-gate\
        \ \\\n  -f approval_intent=auto_approve_action_required \\\n  -f target_pr=\"\
        ${{ github.event.pull_request.number }}\" \\\n  -f approval_reason=\"phase-12-2-compliance-approved\"\
        \n"
    timeout-minutes: 30

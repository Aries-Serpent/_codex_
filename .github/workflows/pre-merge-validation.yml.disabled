name: Pre-Merge Validation
on:
  pull_request:
    types:
    - opened
    - synchronize
    - reopened
    - ready_for_review
    paths-ignore:
    - '**.md'
    - docs/**
    - .codex/**
    - LICENSE
  pull_request_review:
    types:
    - submitted
  workflow_dispatch: null
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  pull-requests: write
  checks: write
jobs:
  final-validation:
    name: Final Pre-Merge Checks
    runs-on: ubuntu-latest
    timeout-minutes: 60
    if: github.event.pull_request.draft == false
    permissions:
      contents: read
      pull-requests: write
    steps:
    - name: Mask secrets
      run: 'echo "::add-mask::$(echo $GH_TOKEN | head -c 10)"

        '
    - name: Checkout
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 2
    - name: Set up Python with shared cache
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        extras: dev
    - name: Run auto-fix check
      id: autofix
      run: 'python scripts/ci/auto_fix_common_issues.py --check-only --json-output
        /tmp/autofix_report.json

        '
      continue-on-error: true
    - name: CI pattern pipeline (strict gate)
      id: pattern_pipeline
      run: "# Run the full detect\u2192record\u2192report pipeline in strict mode.\n\
        # Exits 1 if any auto-fixable issues remain or high-recurrence patterns\n\
        # exceed the threshold \u2014 blocks merge until fixed.\npython scripts/ci/ci_pattern_pipeline.py\
        \ \\\n  --check-only \\\n  --strict \\\n  --artefact /tmp/pattern_pipeline_report.json\n"
      continue-on-error: true
    - name: Verify agent batch-scan protocol coverage
      id: batch_scan_protocol
      run: "python scripts/ci/inject_batch_scan_protocol.py --dry-run\n# Fails (non-zero)\
        \ if any applicable agent is missing the \u26A1 section,\n# preventing new\
        \ agents from being added without the protocol.\n"
      continue-on-error: true
    - name: Mermaid diagram drift check
      id: mermaid_check
      run: 'python scripts/ci/generate_mermaid.py --check

        '
      continue-on-error: true
    - name: Run quick tests
      id: tests
      timeout-minutes: 5
      run: "# Run CI capability tests only \u2014 these are fast (~30s) and exercise\n\
        # the key infrastructure without running the full 1500-test suite.\n# The\
        \ full suite runs in Resilient Validation Suite / Art_Validation Pipeline.\n\
        pytest tests/capabilities/ci_test/ -q --tb=short --timeout=60\n"
      continue-on-error: true
    - name: Check code quality
      id: quality
      run: 'python -m ruff check src/ tests/ --output-format=github || true

        '
      continue-on-error: true
    - name: Session wrapup check
      id: session_wrapup
      env:
        PR_NUMBER: ${{ github.event.pull_request.number }}
        COMMIT_SHA: ${{ github.sha }}
        SERVER_URL: ${{ github.server_url }}
        REPOSITORY: ${{ github.repository }}
        RUN_ID: ${{ github.run_id }}
      run: "# Verify accountability report and CHANGELOG were updated this session\n\
        # (REQ-4 / REQ-5 cognitive pre-flight gate \u2014 check-only, no writes).\n\
        python scripts/ci/session_wrapup_autofix.py \\\n  --pr-number \"$PR_NUMBER\"\
        \ \\\n  --sha \"$COMMIT_SHA\" \\\n  --run-url \"$SERVER_URL/$REPOSITORY/actions/runs/$RUN_ID\"\
        \ \\\n  --check\n"
    - name: WEC compliance check (Phase 3.3)
      id: wec_compliance
      env:
        BASE_REF: ${{ github.base_ref }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
      run: "# (Phase 3.3) Validate WEC compliance against merge target requirements.\n\
        # Ensures all required workflows are present and checked, REQ-4 and REQ-5\n\
        # are satisfied.  This is the CI gate for Phase 3.1 enhanced function.\nMERGE_TARGET=\"\
        $BASE_REF\"\nif [ \"$MERGE_TARGET\" != \"main\" ] && [ \"$MERGE_TARGET\" !=\
        \ \"0D_base_\" ]; then\n  MERGE_TARGET=\"main\"\nfi\npython scripts/ci/session_wrapup_autofix.py\
        \ \\\n  --pr-number \"$PR_NUMBER\" \\\n  --check-wec-compliance \\\n  --merge-target\
        \ \"$MERGE_TARGET\"\n"
      continue-on-error: true
    - name: Upload validation reports
      if: always()
      continue-on-error: true
      uses: actions/upload-artifact@v5
      with:
        path: '/tmp/autofix_report.json

          /tmp/pattern_pipeline_report.json

          '
        if-no-files-found: ignore
        retention-days: 14
        name: pre-merge-validation-reports-${{ github.run_id }}
    - name: Post validation summary
      if: always()
      continue-on-error: true
      uses: actions/github-script@v8
      with:
        script: "const checks = {\n  autofix: '${{ steps.autofix.outcome }}',\n  pattern_pipeline:\
          \ '${{ steps.pattern_pipeline.outcome }}',\n  batch_scan_protocol: '${{\
          \ steps.batch_scan_protocol.outcome }}',\n  mermaid_check: '${{ steps.mermaid_check.outcome\
          \ }}',\n  tests: '${{ steps.tests.outcome }}',\n  quality: '${{ steps.quality.outcome\
          \ }}',\n  session_wrapup: '${{ steps.session_wrapup.outcome }}',\n  wec_compliance:\
          \ '${{ steps.wec_compliance.outcome }}',\n};\n\n// Only these three block\
          \ the merge; the rest are informational warnings.\nconst critical = ['autofix',\
          \ 'pattern_pipeline', 'batch_scan_protocol', 'session_wrapup', 'wec_compliance'];\n\
          const passed = critical.every(k => checks[k] === 'success');\nconst emoji\
          \ = passed ? '\u2705' : '\u274C';\n\nconst MARKER = '<!-- pre-merge-validation-summary\
          \ -->';\nconst summary = `${MARKER}\\n## ${emoji} Pre-Merge Validation Summary\n\
          \n| Check | Status |\n|-------|--------|\n| Auto-Fix Issues | ${checks.autofix\
          \ === 'success' ? '\u2705 Pass' : '\u274C Fail'} |\n| CI Pattern Pipeline\
          \ (strict) | ${checks.pattern_pipeline === 'success' ? '\u2705 Pass' : '\u274C\
          \ Fail'} |\n| Agent Batch-Scan Protocol | ${checks.batch_scan_protocol ===\
          \ 'success' ? '\u2705 Pass' : '\u274C Fail'} |\n| Mermaid Diagram Drift\
          \ | ${checks.mermaid_check === 'success' ? '\u2705 Pass' : '\u26A0\uFE0F\
          \ Drift detected'} |\n| Quick Tests | ${checks.tests === 'success' ? '\u2705\
          \ Pass' : '\u26A0\uFE0F Warning'} |\n| Code Quality | ${checks.quality ===\
          \ 'success' ? '\u2705 Pass' : '\u26A0\uFE0F Warning'} |\n| Session Wrapup\
          \ (REQ-4/5) | ${checks.session_wrapup === 'success' ? '\u2705 Pass' : '\u274C\
          \ Fail'} |\n| WEC Compliance (Phase 3.3) | ${checks.wec_compliance === 'success'\
          \ ? '\u2705 Pass' : '\u274C Fail'} |\n\n${passed ? '\u2705 **All required\
          \ checks passed! Ready to merge.**' : '\u274C **Some checks failed. Please\
          \ review and fix.**'}\n\n---\n\n**Note**: This is a quick pre-merge validation.\
          \ Full test suite runs in other workflows.\n\n_Generated by Pre-Merge Validation\
          \ workflow_`;\n\ntry {\n  const { data: comments } = await github.rest.issues.listComments({\n\
          \    owner: context.repo.owner, repo: context.repo.repo,\n    issue_number:\
          \ context.issue.number, per_page: 100,\n  });\n  const existing = comments.find(c\
          \ => c.body && c.body.includes(MARKER));\n  if (existing) {\n    await github.rest.issues.updateComment({\n\
          \      owner: context.repo.owner, repo: context.repo.repo,\n      comment_id:\
          \ existing.id, body: summary,\n    });\n  } else {\n    await github.rest.issues.createComment({\n\
          \      issue_number: context.issue.number,\n      owner: context.repo.owner,\
          \ repo: context.repo.repo,\n      body: summary,\n    });\n  }\n} catch\
          \ (err) {\n  core.warning(`Could not post validation summary comment (${err.status\
          \ || err.message}). Continuing.`);\n}\n"
    - name: Trigger auto-approve-workflows on WEC PASSED
      if: steps.wec_compliance.outcome == 'success'
      uses: actions/github-script@v8
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}
      with:
        script: "await github.rest.actions.createWorkflowDispatch({\n  owner: context.repo.owner,\n\
          \  repo: context.repo.repo,\n  workflow_id: 'auto-approve-workflows.yml',\n\
          \  ref: github.head_ref || github.ref,\n  inputs: {\n    approval_source:\
          \ 'workflow-execution-gate',\n    approval_intent: 'auto_approve_action_required',\n\
          \    target_pr: '${{ github.event.pull_request.number }}',\n    approval_reason:\
          \ 'pre-merge-validation-wec-passed'\n  }\n});\n"
    - name: Fail if critical checks failed
      if: steps.autofix.outcome != 'success' || steps.pattern_pipeline.outcome !=
        'success' || steps.batch_scan_protocol.outcome != 'success' || steps.session_wrapup.outcome
        != 'success' || steps.wec_compliance.outcome != 'success'
      env:
        AUTOFIX_OUTCOME: ${{ steps.autofix.outcome }}
        PATTERN_OUTCOME: ${{ steps.pattern_pipeline.outcome }}
        BATCH_SCAN_OUTCOME: ${{ steps.batch_scan_protocol.outcome }}
        SESSION_OUTCOME: ${{ steps.session_wrapup.outcome }}
        WEC_OUTCOME: ${{ steps.wec_compliance.outcome }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
      run: "echo \"::error::Pre-merge validation failed\"\nif [ \"$AUTOFIX_OUTCOME\"\
        \ != \"success\" ]; then\n  echo \"::error::Auto-fixable issues detected\"\
        \n  if [ -f /tmp/autofix_report.json ]; then\n    python3 scripts/ci/print_autofix_issues.py\n\
        \  fi\n  echo \"Fix with: python scripts/ci/auto_fix_common_issues.py\"\n\
        fi\nif [ \"$PATTERN_OUTCOME\" != \"success\" ]; then\n  echo \"::error::CI\
        \ pattern pipeline (strict) failed \u2014 high-recurrence patterns or unfixed\
        \ auto-fixable issues\"\n  if [ -f /tmp/pattern_pipeline_report.json ]; then\n\
        \    python3 -c \"import json,sys; r=json.load(open('/tmp/pattern_pipeline_report.json'));\
        \ print(json.dumps(r.get('summary',{}), indent=2))\"\n  fi\n  echo \"Fix with:\
        \ python scripts/ci/auto_fix_common_issues.py && python scripts/ci/ci_pattern_pipeline.py\
        \ --strict\"\nfi\nif [ \"$BATCH_SCAN_OUTCOME\" != \"success\" ]; then\n  echo\
        \ \"::error::Agent batch-scan protocol check failed \u2014 one or more agent\
        \ files are missing the \u26A1 Parallel Batch Scanning Protocol section\"\n\
        \  echo \"Fix with: python scripts/ci/inject_batch_scan_protocol.py\"\nfi\n\
        if [ \"$SESSION_OUTCOME\" != \"success\" ]; then\n  echo \"::error::Session\
        \ wrapup check failed \u2014 REQ-4/REQ-5 files are not fresh for latest commit\"\
        \n  echo \"Fix with: python3 scripts/ci/session_wrapup_autofix.py --check\
        \ --pr-number $PR_NUMBER\"\nfi\nif [ \"$WEC_OUTCOME\" != \"success\" ]; then\n\
        \  echo \"::error::WEC compliance check failed \u2014 required workflows not\
        \ properly configured in WEC block\"\n  echo \"Fix with: python3 scripts/ci/session_wrapup_autofix.py\
        \ --check-wec-compliance --pr-number $PR_NUMBER\"\nfi\nexit 1\n"
    - name: Cache health report
      if: always()
      continue-on-error: true
      run: 'python scripts/ci/generate_cache_keys.py --health --workflow pre-merge-validation
        2>/dev/null || echo "Cache health: check skipped"

        '
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}
  rescue-comment:
    name: Post rescue comment on pre-merge failure
    runs-on: ubuntu-latest
    needs: final-validation
    if: 'failure() &&

      github.event_name == ''pull_request'' &&

      github.event.pull_request.head.repo.full_name == github.repository

      '
    permissions:
      pull-requests: write
      issues: write
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        fetch-depth: 1
    - name: Post or update rescue comment
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
        REPO: ${{ github.repository }}
        COMMIT_SHA: ${{ github.event.pull_request.head.sha }}
        RUN_ID: ${{ github.run_id }}
        WORKFLOW_NAME: Pre-Merge Validation
        RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{
          github.run_id }}
        BRANCH: ${{ github.head_ref }}
      run: python scripts/ci/post_rescue_comment.py
    timeout-minutes: 30

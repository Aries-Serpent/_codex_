name: "\U0001F9F9 Cleanup Stale PR Comments"
on:
  workflow_dispatch:
    inputs:
      pr_number:
        description: PR number to clean up
        required: true
        type: number
      dry_run:
        description: "Dry run \u2014 print what would be deleted without deleting"
        required: false
        type: boolean
        default: false
      include_rescue:
        description: Also clean up CI-Rescue comments for superseded commit SHAs
        required: false
        type: boolean
        default: true
  issue_comment:
    types:
    - created
  pull_request:
    types:
    - opened
    - synchronize
    - reopened
  workflow_run:
    workflows:
    - "\U0001F504 Auto-Post @copilot review After Agent Session"
    - "\u2705 Agent Auth Delegation"
    types:
    - completed
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  issues: write
  pull-requests: write
  contents: read
jobs:
  cleanup:
    name: Delete stale PR comments
    runs-on: ubuntu-latest
    timeout-minutes: 10
    if: "github.event_name == 'workflow_dispatch' ||\ngithub.event_name == 'workflow_run'\
      \ ||\n(github.event_name == 'issue_comment' &&\n github.event.issue.pull_request\
      \ != null &&\n contains(github.event.comment.body, '/cleanup-comments')) ||\n\
      github.event_name == 'pull_request'\n"
    steps:
    - name: Mask secrets
      run: 'echo "::add-mask::$(echo $GH_TOKEN | head -c 10)"

        '
    - name: Checkout
      uses: actions/checkout@v5
      with:
        persist-credentials: false
    - name: Set up Python with caching
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13

    - name: Install dependencies
      run: pip install requests --quiet
    - name: Resolve PR number
      id: pr
      env:
        GITHUB_EVENT_NAME: ${{ github.event_name }}
      run: "if [ \"${{ github.event_name }}\" = \"workflow_dispatch\" ]; then\n  echo\
        \ \"number=${{ inputs.pr_number }}\" >> \"$GITHUB_OUTPUT\"\n  echo \"dry_run=${{\
        \ inputs.dry_run }}\" >> \"$GITHUB_OUTPUT\"\n  echo \"include_rescue=${{ inputs.include_rescue\
        \ }}\" >> \"$GITHUB_OUTPUT\"\nelif [ \"${{ github.event_name }}\" = \"issue_comment\"\
        \ ]; then\n  echo \"number=${{ github.event.issue.number }}\" >> \"$GITHUB_OUTPUT\"\
        \n  echo \"dry_run=false\" >> \"$GITHUB_OUTPUT\"\n  echo \"include_rescue=true\"\
        \ >> \"$GITHUB_OUTPUT\"\nelif [ \"${{ github.event_name }}\" = \"workflow_run\"\
        \ ]; then\n  echo \"number=${{ github.event.workflow_run.pull_requests[0]\
        \ && github.event.workflow_run.pull_requests[0].number || '' }}\" >> \"$GITHUB_OUTPUT\"\
        \n  echo \"dry_run=false\" >> \"$GITHUB_OUTPUT\"\n  echo \"include_rescue=true\"\
        \ >> \"$GITHUB_OUTPUT\"\nelse\n  # pull_request event \u2014 run as dry-run\
        \ so auto-runs are non-destructive\n  echo \"number=${{ github.event.pull_request.number\
        \ }}\" >> \"$GITHUB_OUTPUT\"\n  echo \"dry_run=true\" >> \"$GITHUB_OUTPUT\"\
        \n  echo \"include_rescue=false\" >> \"$GITHUB_OUTPUT\"\nfi\n"
    - name: React to slash command
      if: github.event_name == 'issue_comment'
      uses: actions/github-script@v8
      with:
        script: "await github.rest.reactions.createForIssueComment({\n  owner: context.repo.owner,\n\
          \  repo: context.repo.repo,\n  comment_id: context.payload.comment.id,\n\
          \  content: 'eyes'\n});\n"
    - name: Delete stale comments
      id: cleanup
      if: steps.pr.outputs.number != ''
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        STEPS_PR_OUTPUTS_NUMBER: ${{ steps.pr.outputs.number }}
      run: "ARGS=\"--pr-number ${{ steps.pr.outputs.number }}\"\n\nif [ \"${{ steps.pr.outputs.dry_run\
        \ }}\" = \"true\" ]; then\n  ARGS=\"$ARGS --dry-run\"\nfi\n\nif [ \"${{ steps.pr.outputs.include_rescue\
        \ }}\" = \"true\" ]; then\n  ARGS=\"$ARGS --include-rescue\"\nfi\n\npython\
        \ scripts/ci/delete_stale_pr_comments.py $ARGS 2>&1 | tee /tmp/cleanup_output.txt\n\
        echo \"exit_code=${PIPESTATUS[0]}\" >> \"$GITHUB_OUTPUT\"\n"
    - name: Post cleanup summary
      if: 'github.event_name != ''pull_request'' &&

        steps.pr.outputs.number != '''' &&

        always()

        '
      uses: actions/github-script@v8
      with:
        script: "const fs = require('fs');\nlet output = '';\ntry {\n  output = fs.readFileSync('/tmp/cleanup_output.txt',\
          \ 'utf8');\n} catch (_) {\n  output = '(no output)';\n}\n\nconst dryRun\
          \ = '${{ steps.pr.outputs.dry_run }}' === 'true';\nconst prNumber = parseInt('${{\
          \ steps.pr.outputs.number }}', 10);\nconst icon = dryRun ? '\U0001F50D'\
          \ : '\U0001F9F9';\nconst title = dryRun\n  ? 'Cleanup Stale PR Comments\
          \ \u2014 Dry Run'\n  : 'Cleanup Stale PR Comments \u2014 Complete';\n\n\
          const body = [\n  `## ${icon} ${title}`,\n  '',\n  '```',\n  output.slice(0,\
          \ 3000),\n  output.length > 3000 ? '\u2026 (truncated)' : '',\n  '```',\n\
          \  '',\n  dryRun\n    ? '_This was a dry run \u2014 no comments were deleted._'\n\
          \    : `_Triggered by: \\`${{ github.event_name }}\\` \xB7 Run: [${context.runId}](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId})_`,\n\
          ].join('\\n');\n\nawait github.rest.issues.createComment({\n  owner: context.repo.owner,\n\
          \  repo: context.repo.repo,\n  issue_number: prNumber,\n  body,\n});\n"
    - name: Check exit code
      if: steps.pr.outputs.number != '' && steps.cleanup.outputs.exit_code != '0'
      run: exit 1
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}

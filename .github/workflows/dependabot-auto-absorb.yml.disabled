name: "\U0001F4E6 Dependabot Auto-Absorb"
on:
  pull_request:
    types:
    - opened
    - synchronize
    - reopened
  workflow_dispatch:
    inputs:
      pr_number:
        description: Dependabot PR number to absorb
        required: true
        type: string
      target_branch:
        description: 'Branch to cherry-pick into (default: current default branch)'
        required: false
        default: ''
        type: string
      dry_run:
        description: Dry run (no commit)
        required: false
        default: 'false'
        type: choice
        options:
        - 'false'
        - 'true'
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: write
  pull-requests: read
jobs:
  absorb:
    name: "\U0001F4E6 Cherry-pick single-file Dependabot bump"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    if: 'github.event_name == ''workflow_dispatch'' || github.actor == ''dependabot[bot]''

      '
    steps:
    - name: Mask secrets
      run: 'echo "::add-mask::$(echo $GH_TOKEN | head -c 10)"

        '
    - name: "\U0001F4E5 Checkout"
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 0
        token: ${{ env.CODEX_MASTER_KEY || env.CODEX_BACKUP_KEY || secrets.GITHUB_TOKEN
          }}
        ref: ${{ inputs.target_branch || github.base_ref }}
    - name: "\U0001F500 Resolve push target (chain: sub-PR \u2192 0D_base_ \u2192\
        \ main)"
      id: resolve-target
      if: ${{ inputs.target_branch == '' }}
      uses: ./.github/actions/resolve-push-target
    - name: "\U0001F50D Verify single-file change"
      id: check
      uses: actions/github-script@v8
      with:
        script: "const sleep = (ms) => new Promise((resolve) => setTimeout(resolve,\
          \ ms));\nasync function callWithRateLimitRetry(fn, label) {\n  const maxAttempts\
          \ = 3;\n  const MIN_WAIT_SECONDS = 5;\n  const MAX_WAIT_SECONDS = 120;\n\
          \  const FALLBACK_WAIT_SECONDS = 60;\n  const RESET_BUFFER_SECONDS = 5;\n\
          \  for (let attempt = 1; attempt <= maxAttempts; attempt++) {\n    try {\n\
          \      return await fn();\n    } catch (error) {\n      const remainingHeader\
          \ = error?.response?.headers?.['x-ratelimit-remaining'];\n      const resetHeader\
          \ = error?.response?.headers?.['x-ratelimit-reset'];\n      const remaining\
          \ = Number.parseInt(String(remainingHeader ?? '-1'), 10);\n      const reset\
          \ = Number.parseInt(String(resetHeader ?? ''), 10);\n      const isRateLimited\
          \ = error?.status === 403 && remaining === 0;\n      if (!isRateLimited\
          \ || attempt === maxAttempts) {\n        throw error;\n      }\n      const\
          \ nowSeconds = Date.now() / 1000;\n      const resetDelay = Number.isFinite(reset)\
          \ && reset > nowSeconds\n        ? Math.ceil(reset - nowSeconds) + RESET_BUFFER_SECONDS\n\
          \        : FALLBACK_WAIT_SECONDS;\n      const waitSeconds = Math.max(MIN_WAIT_SECONDS,\
          \ Math.min(MAX_WAIT_SECONDS, resetDelay));\n      core.warning(`Rate limited\
          \ while calling ${label}; retrying in ${waitSeconds}s (attempt ${attempt}/${maxAttempts})`);\n\
          \      await sleep(waitSeconds * 1000);\n    }\n  }\n}\n\nlet prNumber;\n\
          if (context.eventName === 'workflow_dispatch') {\n  prNumber = parseInt(core.getInput('pr_number')\
          \ || '${{ inputs.pr_number }}');\n} else {\n  prNumber = context.payload.pull_request.number;\n\
          }\n\nconst { data: files } = await callWithRateLimitRetry(\n  () => github.rest.pulls.listFiles({\n\
          \    owner: context.repo.owner,\n    repo: context.repo.repo,\n    pull_number:\
          \ prNumber,\n    per_page: 10,\n  }),\n  'pulls.listFiles',\n);\n\ncore.setOutput('pr_number',\
          \ prNumber);\ncore.setOutput('file_count', files.length);\ncore.setOutput('is_single_file',\
          \ files.length === 1 ? 'true' : 'false');\ncore.setOutput('changed_file',\
          \ files.length === 1 ? files[0].filename : '');\n\nif (files.length ===\
          \ 1) {\n  console.log(`\u2705 Single-file bump detected: ${files[0].filename}`);\n\
          } else {\n  console.log(`\u2139\uFE0F  ${files.length} files changed \u2014\
          \ skipping auto-absorb (not a single-file bump)`);\n}\n\n// Fetch head SHA\
          \ for the PR\nconst { data: pr } = await callWithRateLimitRetry(\n  () =>\
          \ github.rest.pulls.get({\n    owner: context.repo.owner,\n    repo: context.repo.repo,\n\
          \    pull_number: prNumber,\n  }),\n  'pulls.get',\n);\ncore.setOutput('head_sha',\
          \ pr.head.sha);\ncore.setOutput('pr_title', pr.title);\n"
    - name: "\U0001F352 Cherry-pick into active branch"
      if: steps.check.outputs.is_single_file == 'true'
      env:
        DRY_RUN: ${{ inputs.dry_run || 'false' }}
        HEAD_SHA: ${{ steps.check.outputs.head_sha }}
        CHANGED_FILE: ${{ steps.check.outputs.changed_file }}
        PR_NUMBER: ${{ steps.check.outputs.pr_number }}
        PR_TITLE: ${{ steps.check.outputs.pr_title }}
        TARGET_BRANCH: ${{ inputs.target_branch || steps.resolve-target.outputs.branch
          || github.base_ref }}
      run: "set -euo pipefail\n\ngit config user.name  \"github-actions[bot]\"\ngit\
        \ config user.email \"github-actions[bot]@users.noreply.github.com\"\n\n#\
        \ Switch the working tree to the chain-resolved target BEFORE cherry-picking\n\
        # so the commit lands on the correct staging branch, not on main.\n# The initial\
        \ checkout used fetch-depth=0 so HEAD_SHA is already present.\ngit fetch origin\
        \ \"${TARGET_BRANCH}\" --depth=1\ngit checkout -B _dep_absorb_ origin/\"${TARGET_BRANCH}\"\
        \n# Ensure the source commit is reachable after the branch switch.\ngit fetch\
        \ origin \"${HEAD_SHA}\" 2>/dev/null || true\n\necho \"Cherry-picking ${HEAD_SHA}\
        \ (${CHANGED_FILE}) from PR  #${PR_NUMBER} into ${TARGET_BRANCH}\u2026\"\n\
        \nif [ \"${DRY_RUN}\" = \"true\" ]; then\n  echo \"\U0001F50D DRY RUN \u2014\
        \ would cherry-pick ${HEAD_SHA}\"\n  git cherry-pick --no-commit \"${HEAD_SHA}\"\
        \ || true\n  echo \"Diff preview:\"\n  git diff --cached --stat || true\n\
        \  git cherry-pick --abort 2>/dev/null || true\n  echo \"\u2705 Dry run complete\
        \ \u2014 no commit made.\"\n  exit 0\nfi\n\n# Attempt cherry-pick; abort cleanly\
        \ on conflict.\nif git cherry-pick \"${HEAD_SHA}\"; then\n  echo \"\u2705\
        \ Cherry-pick succeeded: ${CHANGED_FILE}\"\n  # Push the cherry-picked commit\
        \ back to the target branch.\n  git push origin \"HEAD:refs/heads/${TARGET_BRANCH}\"\
        \nelse\n  echo \"\u26A0\uFE0F  Cherry-pick conflict \u2014 aborting auto-absorb\
        \ for PR  #${PR_NUMBER}\"\n  git cherry-pick --abort\n  exit 0  # Non-fatal:\
        \ let the human merge manually.\nfi\n"
    - name: "\U0001F4DD Annotate job summary"
      if: always()
      env:
        IS_SINGLE: ${{ steps.check.outputs.is_single_file }}
        CHANGED_FILE: ${{ steps.check.outputs.changed_file }}
        PR_NUMBER: ${{ steps.check.outputs.pr_number }}
        PR_TITLE: ${{ steps.check.outputs.pr_title }}
      run: "{\n  echo \"## \U0001F4E6 Dependabot Auto-Absorb\"\n  echo \"\"\n  if\
        \ [ \"${IS_SINGLE}\" = \"true\" ]; then\n    echo \"\u2705 **Absorbed:** \\\
        `${CHANGED_FILE}\\` from [PR  #${PR_NUMBER}](https://github.com/${{ github.repository\
        \ }}/pull/${PR_NUMBER})\"\n    echo \"\"\n    echo \"> ${PR_TITLE}\"\n  else\n\
        \    echo \"\u2139\uFE0F  **Skipped:** PR  #${PR_NUMBER} has ${{ steps.check.outputs.file_count\
        \ }} changed files (not a single-file bump).\"\n  fi\n} >> \"${GITHUB_STEP_SUMMARY}\"\
        \n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}
  rescue-comment:
    name: Post rescue comment on failure
    runs-on: ubuntu-latest
    needs: absorb
    if: 'failure() &&

      github.event_name == ''pull_request'' &&

      github.event.pull_request.head.repo.full_name == github.repository

      '
    permissions:
      pull-requests: write
      issues: write
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || secrets.GITHUB_TOKEN
          }}
        fetch-depth: 1
    - name: Post or update rescue comment
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
        REPO: ${{ github.repository }}
        COMMIT_SHA: ${{ github.event.pull_request.head.sha }}
        RUN_ID: ${{ github.run_id }}
        WORKFLOW_NAME: Dependabot Auto-Absorb
        RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{
          github.run_id }}
        BRANCH: ${{ github.head_ref }}
      run: python scripts/ci/post_rescue_comment.py
    timeout-minutes: 30

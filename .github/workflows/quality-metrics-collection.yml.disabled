name: Quality Metrics Collection
on:
  push:
    branches:
    - main
    - develop
    paths:
    - src/**
    - tests/**
    - .github/workflows/quality-metrics-collection.yml
    - pyproject.toml
    - pytest.ini
  pull_request:
    branches:
    - main
    - develop
  schedule:
  - cron: 0 2 * * *
  workflow_dispatch: null
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  collect-metrics:
    name: Collect Quality Metrics
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      pull-requests: write
      checks: read
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      with:
        fetch-depth: 0
    - name: Set up Python with caching
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: '3.11'
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v2' }}

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -e .
        pip install \
          "pytest>=7.0" \
          "pytest-cov>=4.0" \
          pytest-timeout \
          pytest-xdist \
          pytest-asyncio \
          mutmut \
          radon \
          pydocstyle \
          pip-audit \
          bandit \
          semgrep
    - name: Create metrics directory
      run: 'mkdir -p .codex/reports/metrics

        mkdir -p .codex/reports/logs

        '
    - name: Collect Coverage Metrics
      id: coverage
      continue-on-error: true
      run: "echo \"Collecting coverage metrics...\"\npython -m pytest \\\n  --cov=src\
        \ \\\n  --cov-report=json \\\n  --cov-report=term-missing \\\n  --cov-report=html\
        \ \\\n  -v \\\n  --tb=short \\\n  --timeout=600 \\\n  2>&1 | tee .codex/reports/logs/coverage.log\n\
        \n# Extract coverage from coverage.json\npython scripts/metrics/extract_coverage.py\
        \ \\\n  coverage.json \\\n  .codex/reports/metrics/coverage_latest.json\n\necho\
        \ \"Coverage metrics collected\"\n"
    - name: Collect Test Metrics
      id: tests
      continue-on-error: true
      run: "echo \"Collecting test metrics...\"\npython -m pytest \\\n  --collect-only\
        \ \\\n  --quiet \\\n  --json-report \\\n  --json-report-file=.codex/reports/logs/test_collection.json\n\
        \npython scripts/metrics/extract_test_metrics.py \\\n  .codex/reports/logs/test_collection.json\
        \ \\\n  .codex/reports/metrics/test_count_latest.json\n\necho \"Test metrics collected\"\
        \n"
    - name: Collect Test Latency Metrics
      id: latency
      continue-on-error: true
      run: "echo \"Collecting test latency metrics...\"\npython -m pytest \\\n  --durations=20\
        \ \\\n  --tb=short \\\n  --timeout=600 \\\n  -q \\\n  2>&1 | tee .codex/reports/logs/latency.log\n\
        \npython scripts/metrics/extract_latency.py \\\n  .codex/reports/logs/latency.log\
        \ \\\n  .codex/reports/metrics/test_latency_latest.json\n\necho \"Latency metrics\
        \ collected\"\n"
    - name: Analyze Code Complexity
      id: complexity
      continue-on-error: true
      run: "echo \"Analyzing code complexity...\"\nradon cc src/ --json > .codex/reports/logs/cyclomatic.json\
        \ || true\nradon mi src/ --json > .codex/reports/logs/maintainability.json || true\n\
        \npython scripts/metrics/extract_complexity.py \\\n  .codex/reports/logs/cyclomatic.json\
        \ \\\n  .codex/reports/logs/maintainability.json \\\n  .codex/reports/metrics/code_complexity_latest.json\n\
        \necho \"Complexity metrics collected\"\n"
    - name: Check Docstring Coverage
      id: docstrings
      continue-on-error: true
      run: "echo \"Checking docstring coverage...\"\npydocstyle src/ --match='.*\\\
        .py' --count > .codex/reports/logs/docstring_missing.txt || true\n\npython scripts/metrics/extract_docstring_coverage.py\
        \ \\\n  src/ \\\n  .codex/reports/metrics/docstring_coverage_latest.json\n\necho\
        \ \"Docstring coverage collected\"\n"
    - name: Security Audit
      id: security
      continue-on-error: true
      run: "echo \"Running security audit...\"\npip-audit --format json > .codex/reports/logs/pip_audit.json\
        \ || true\nbandit -r src/ -f json > .codex/reports/logs/bandit.json || true\n\n\
        python scripts/metrics/extract_security.py \\\n  .codex/reports/logs/pip_audit.json\
        \ \\\n  .codex/reports/logs/bandit.json \\\n  .codex/reports/metrics/security_vulnerabilities_latest.json\
        \ \\\n  .codex/reports/metrics/dependency_health_latest.json\n\necho \"Security\
        \ metrics collected\"\n"
    - name: Collect Build Time Metrics
      id: buildtime
      run: "echo \"Recording build time...\"\n# Get workflow run duration\npython\
        \ scripts/metrics/extract_build_time.py \\\n  ${{ github.run_id }} \\\n  ${{\
        \ github.event_name }} \\\n  .codex/reports/metrics/build_time_latest.json\n\necho\
        \ \"Build time metrics collected\"\n"
    - name: Calculate Per-Module Coverage
      id: module_coverage
      continue-on-error: true
      run: "echo \"Calculating per-module coverage...\"\npython scripts/metrics/extract_module_coverage.py\
        \ \\\n  coverage.json \\\n  .codex/PHASE_5_COVERAGE_SLOS.yaml \\\n  .codex/reports/metrics/module_coverage_latest.json\n\
        \necho \"Module coverage calculated\"\n"
    - name: Calculate Coverage Trend
      id: coverage_trend
      continue-on-error: true
      run: "echo \"Calculating 7-day coverage trend...\"\npython scripts/metrics/calculate_coverage_trend.py\
        \ \\\n  .codex/reports/metrics/coverage_latest.json \\\n  .codex/reports/metrics/coverage_trend_7day.json\n\
        \necho \"Coverage trend calculated\"\n"
    - name: Check SLO Compliance
      id: slo_check
      continue-on-error: true
      run: "echo \"Checking SLO compliance...\"\npython scripts/metrics/check_slo_compliance.py\
        \ \\\n  .codex/PHASE_5_COVERAGE_SLOS.yaml \\\n  .codex/reports/metrics/module_coverage_latest.json\
        \ \\\n  .codex/reports/metrics/slo_compliance_latest.json\n\necho \"SLO compliance\
        \ checked\"\n"
    - name: Generate Metrics Index
      id: index
      continue-on-error: true
      run: "echo \"Generating metrics index...\"\npython scripts/metrics/generate_metrics_index.py\
        \ \\\n  .codex/reports/metrics/ \\\n  .codex/reports/metrics/metrics_index.json\n\necho\
        \ \"Metrics index generated\"\n"
    - name: Generate Quality Dashboard JSON
      id: dashboard
      continue-on-error: true
      run: "echo \"Generating quality dashboard...\"\npython scripts/metrics/generate_dashboard.py\
        \ \\\n  .codex/reports/metrics/ \\\n  .codex/reports/quality_dashboard.json\n\necho \"\
        Dashboard generated\"\n"
    - name: Generate PR Comment
      id: pr_comment
      if: github.event_name == 'pull_request'
      continue-on-error: true
      run: "python scripts/metrics/generate_pr_comment.py \\\n  .codex/reports/metrics/\
        \ \\\n  .codex/PHASE_5_COVERAGE_SLOS.yaml \\\n  .codex/PHASE_5_ALERT_POLICY.md\
        \ \\\n  pr_comment.md\n\necho \"PR comment generated\"\n"
    - name: Post Metrics Comment on PR
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v8
      with:
        script: "const fs = require('fs');\ntry {\n  const commentBody = fs.readFileSync('pr_comment.md',\
          \ 'utf8');\n  \n  // Check if comment already exists\n  const comments =\
          \ await github.rest.issues.listComments({\n    owner: context.repo.owner,\n\
          \    repo: context.repo.repo,\n    issue_number: context.issue.number,\n\
          \  });\n  \n  const existingComment = comments.data.find(c =>\n    c.user.type\
          \ === 'Bot' && c.body.includes('Quality Metrics Report')\n  );\n  \n  if\
          \ (existingComment) {\n    // Update existing comment\n    await github.rest.issues.updateComment({\n\
          \      owner: context.repo.owner,\n      repo: context.repo.repo,\n    \
          \  comment_id: existingComment.id,\n      body: commentBody,\n    });\n\
          \  } else {\n    // Create new comment\n    await github.rest.issues.createComment({\n\
          \      owner: context.repo.owner,\n      repo: context.repo.repo,\n    \
          \  issue_number: context.issue.number,\n      body: commentBody,\n    });\n\
          \  }\n} catch (error) {\n  console.error('Error posting comment:', error);\n\
          }\n"
    - name: Upload Metrics Artifacts
      if: always()
      uses: actions/upload-artifact@v5
      with:
        name: quality-metrics-${{ github.run_id }}
        path: '.codex/reports/metrics/

          .codex/reports/logs/

          .codex/reports/quality_dashboard.json

          '
        retention-days: 90
    - name: Upload Coverage Report
      if: always()
      uses: actions/upload-artifact@v5
      with:
        name: coverage-report-${{ github.run_id }}
        path: 'htmlcov/

          '
        retention-days: 30
    - name: Comment on Failing Metrics
      if: failure()
      uses: actions/github-script@v8
      with:
        script: "github.rest.issues.createComment({\n  issue_number: context.issue.number,\n\
          \  owner: context.repo.owner,\n  repo: context.repo.repo,\n  body: '⚠️ Quality\
          \ metrics collection encountered errors. Check the workflow logs for details.'\n\
          })\n"
    - name: Determine Job Status
      if: always()
      run: 'echo "Metrics collection completed"

        echo "Artifacts uploaded to: .codex/reports/metrics/"

        echo "Dashboard available at: .codex/reports/quality_dashboard.json"

        '
  publish-metrics:
    name: Publish Metrics
    needs: collect-metrics
    runs-on: ubuntu-latest
    permissions:
      contents: write
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
    - name: Download metrics artifacts
      uses: actions/download-artifact@v5
      with:
        name: quality-metrics-${{ github.run_id }}
        path: .codex/reports/
    - name: Commit metrics to repository
      continue-on-error: true
      run: "git config user.name \"Quality Bot\"\ngit config user.email \"quality@codex.dev\"\
        \n\n# Only commit if changes exist\nif [ -n \"$(git status --porcelain .codex/reports/)\"\
        \ ]; then\n  git add .codex/reports/metrics/\n  git commit -m \"chore: update quality\
        \ metrics [skip ci]\"\n  git push\nfi\n"
    - name: Create metric snapshot
      if: github.event_name == 'push' && github.ref == 'refs/heads/main'
      continue-on-error: true
      run: 'mkdir -p .codex/reports/metrics/snapshots/$(date +%Y-%m-%d)

        cp .codex/reports/metrics/*.json .codex/reports/metrics/snapshots/$(date +%Y-%m-%d)/ ||
        true

        git add .codex/reports/metrics/snapshots/

        git commit -m "chore: snapshot quality metrics for $(date +%Y-%m-%d)" || true

        git push || true

        '
    timeout-minutes: 60
  validate-metrics:
    name: Validate Metrics Quality
    needs: collect-metrics
    runs-on: ubuntu-latest
    permissions:
      contents: read
    if: always()
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
    - name: Download metrics
      uses: actions/download-artifact@v5
      with:
        name: quality-metrics-${{ github.run_id }}
        path: .codex/reports/
    - name: Validate metrics files
      run: "echo \"Validating metrics files...\"\n\n# Check required metrics exist\n\
        required_metrics=(\n  \"coverage_latest.json\"\n  \"test_count_latest.json\"\
        \n  \"test_latency_latest.json\"\n  \"code_complexity_latest.json\"\n  \"\
        security_vulnerabilities_latest.json\"\n  \"docstring_coverage_latest.json\"\
        \n  \"slo_compliance_latest.json\"\n  \"metrics_index.json\"\n)\n\nmissing=0\n\
        for metric in \"${required_metrics[@]}\"; do\n  if [ ! -f \".codex/reports/metrics/$metric\"\
        \ ]; then\n    echo \"❌ Missing: $metric\"\n    missing=$((missing + 1))\n\
        \  else\n    echo \"✅ Found: $metric\"\n  fi\ndone\n\nif [ $missing -gt 0\
        \ ]; then\n  echo \"⚠️ Warning: $missing metrics files are missing\"\n  exit\
        \ 1\nfi\n"
    - name: Validate metrics JSON
      run: "echo \"Validating JSON format...\"\nfor file in .codex/reports/metrics/*.json;\
        \ do\n  if ! python -m json.tool \"$file\" > /dev/null; then\n    echo \"\
        ❌ Invalid JSON: $file\"\n    exit 1\n  fi\ndone\necho \"✅ All metrics JSON\
        \ is valid\"\n"
    timeout-minutes: 30
  notify-metrics:
    name: Notify Metrics Status
    needs: collect-metrics
    runs-on: ubuntu-latest
    permissions: {}
    if: always() && github.event_name != 'pull_request'
    steps:
    - name: Prepare status message
      run: 'echo "Quality metrics collection completed"

        echo "Workflow: ${{ github.workflow }}"

        echo "Run: ${{ github.run_id }}"

        echo "Status: ${{ job.status }}"

        '
    - name: Send Slack notification (on failure only)
      if: failure()
      uses: slackapi/slack-github-action@91efab103c0de0a537f72a35f6b8cda0ee76bf0a
      with:
        webhook-url: ${{ secrets.SLACK_WEBHOOK_URL }}
        payload: "{\n  \"text\": \"⚠️ Quality Metrics Collection Failed\",\n  \"blocks\"\
          : [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"\
          type\": \"mrkdwn\",\n        \"text\": \"*Quality Metrics Collection Failed*\\\
          n`Workflow: ${{ github.workflow }}`\\n`Run: ${{ github.run_id }}`\"\n  \
          \    }\n    }\n  ]\n}\n"
      continue-on-error: true
    timeout-minutes: 30

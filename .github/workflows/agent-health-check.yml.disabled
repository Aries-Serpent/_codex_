name: Agent Orchestration Health Check
'on':
  workflow_dispatch: null
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  actions: read
  issues: write
jobs:
  success-rate:
    if: ${{ github.event.pull_request.number != 5328 }}
    name: 7-day orchestration success rate (D3 compliance check)
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    steps:
    - name: Cache Python dependencies (Layer 1)
      uses: actions/cache@v5
      with:
        path: ~/.cache/pip
        key: ${{ runner.os }}-pip-${{ hashFiles('**/requirements*.txt', '**/pyproject.toml')
          }}
        restore-keys: '${{ runner.os }}-pip-

          '
    - uses: actions/checkout@v5
    - name: Compute rolling success rate from compliance log
      id: metrics
      run: "python3 - <<'PYEOF'\nimport json, os, re, sys\nfrom datetime import datetime,\
        \ timedelta, timezone\nfrom pathlib import Path\n\nlog_path = Path(\"reports/orchestration/orchestration_compliance.log.md\"\
        )\ncutoff = datetime.now(timezone.utc) - timedelta(days=7)\ntotal = success\
        \ = 0\n\nif log_path.exists():\n    for line in log_path.read_text().splitlines():\n\
        \        if \"|\" not in line or \"timestamp\" in line.lower():\n        \
        \    continue\n        parts = [p.strip() for p in line.split(\"|\") if p.strip()]\n\
        \        if len(parts) < 4:\n            continue\n        try:\n        \
        \    ts = datetime.fromisoformat(parts[0].replace(\"Z\", \"+00:00\"))\n  \
        \      except ValueError:\n            continue\n        if ts < cutoff:\n\
        \            continue\n        total += 1\n        if \"success\" in parts[3].lower():\n\
        \            success += 1\n\nrate = round(success / total * 100, 1) if total\
        \ else 100.0\nprint(f\"7-day window: {total} tasks, {success} success \u2192\
        \ {rate}%\")\n\nwith open(os.environ[\"GITHUB_OUTPUT\"], \"a\") as f:\n  \
        \  f.write(f\"rate={rate}\\ntotal={total}\\nsuccess={success}\\n\")\n\nos.makedirs(\"\
        reports/orchestration\", exist_ok=True)\nreport = {\n    \"generated_at\"\
        : datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n    \"window_days\"\
        : 7,\n    \"total_tasks\": total,\n    \"success_tasks\": success,\n    \"\
        success_rate_pct\": rate,\n    \"threshold_pct\": 95.0,\n    \"gate_passed\"\
        : rate >= 95.0,\n}\nwith open(\"reports/orchestration/health_latest.json\"\
        , \"w\") as f:\n    json.dump(report, f, indent=2)\nPYEOF\n"
    - name: Cache test results (Layer 3)
      uses: actions/cache@v5
      if: always()
      with:
        path: .pytest_cache/
        key: ${{ runner.os }}-pytest-${{ github.sha }}
        restore-keys: '${{ runner.os }}-pytest-

          '
    - name: Upload health report
      uses: actions/upload-artifact@v5
      with:
        path: reports/orchestration/health_latest.json
        name: agent-health-${{ github.run_id }}
    - name: Evaluate 95% threshold
      env:
        RATE: ${{ steps.metrics.outputs.rate }}
      run: "python3 -c \"\nimport os\nrate = float(os.environ.get('RATE', '100'))\n\
        if rate >= 95.0:\n    print(f'::notice::\u2705 D3 exit criteria #1 met: {rate}%\
        \ >= 95%')\nelse:\n    print(f'::warning::D3 success rate {rate}% below 95%\
        \ threshold')\n\"\n"
    timeout-minutes: 30
  ooda-loop-validation:
    name: OODA loop nightly validation (D3
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
    - uses: actions/checkout@v5
    - uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - run: pip install -q -r requirements-dev.txt
    - name: Validate OODA loop components present
      run: "python3 - <<'PYEOF'\nimport sys\nfrom pathlib import Path\n\n# Verify\
        \ OODA loop core components are importable and present.\n# required: must\
        \ exist or job fails.\n# optional: generated at runtime; absence is a warning,\
        \ not a failure.\nrequired_checks = [\n    (\"scripts/cognitive/actions\"\
        , \"monitoring_actions.py\"),\n    (\"scripts/cognitive/sensors\", \"monitoring_sensor.py\"\
        ),\n    (\".codex/config\", \"monitoring.yaml\"),\n]\noptional_checks = [\n\
        \    (\"reports/orchestration\", \"orchestration_compliance.log.md\"),\n]\n\
        missing = []\nfor directory, fname in required_checks:\n    p = Path(directory)\
        \ / fname\n    if not p.exists():\n        missing.append(str(p))\n    else:\n\
        \        print(f\"\u2705 {p}\")\n\nfor directory, fname in optional_checks:\n\
        \    p = Path(directory) / fname\n    if not p.exists():\n        print(f\"\
        ::warning::Optional OODA artefact absent (generated at runtime): {p}\")\n\
        \    else:\n        print(f\"\u2705 {p}\")\n\nif missing:\n    print(f\"::warning::OODA\
        \ components missing: {missing}\")\n    sys.exit(1)\nelse:\n    print(\"::notice::\u2705\
        \ D3 exit criteria  #5 met: OODA loop components all present\")\nPYEOF\n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}

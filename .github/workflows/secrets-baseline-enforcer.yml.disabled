name: "\U0001F510 Secrets Baseline Enforcer"
'on':
  push:
    branches:
    - automated/**
    - copilot/**
    - 0D_base_
    - main
  pull_request:
    types:
    - opened
    - synchronize
    - reopened
  workflow_dispatch: null
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: write
  pull-requests: write
  issues: write
jobs:
  enforce-baseline:
    name: "\U0001F510 Enforce Secrets Baseline"
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
    - name: Mask secrets
      run: 'echo "::add-mask::$(echo $GH_TOKEN | head -c 10)"

        '
    - name: Checkout
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 0
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
    - name: Set up Python
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - name: Install detect-secrets
      run: pip install detect-secrets==1.5.0
    - name: Verify .secrets.baseline exists
      run: "if [ ! -f \".secrets.baseline\" ]; then\n  echo \"::error title=Missing\
        \ Baseline::.secrets.baseline not found \u2014 run: detect-secrets scan >\
        \ .secrets.baseline\"\n  exit 1\nfi\necho \"\u2705 .secrets.baseline present\"\
        \n"
    - name: Sync tracked file hashes
      run: "python scripts/ci/sync_tracked_files.py --fix 2>&1 | tee /tmp/sync_output.txt\n\
        if grep -q \"FAIL\\|ERROR\" /tmp/sync_output.txt; then\n  echo \"::warning::sync_tracked_files\
        \ reported issues \u2014 check output above\"\nfi\n"
    - name: Stage updated baseline after sync
      run: '# Stage the baseline updated by sync_tracked_files.py so detect-secrets-hook

        # doesn''t fail with "baseline is unstaged" (SECRETS_BASELINE_001 fix)

        git add .secrets.baseline || true

        '
    - name: Scan for new secrets not in baseline
      id: scan
      run: "set +e\n# detect-secrets scan against the current baseline\n# --list-all-plugins\
        \ ensures consistent plugin set\nOUTPUT=$(detect-secrets-hook --baseline .secrets.baseline\
        \ \\\n  $(git diff --name-only HEAD~1 HEAD 2>/dev/null || git ls-files) \\\
        \n  2>&1)\nEXIT=$?\necho \"exit_code=$EXIT\" >> \"$GITHUB_OUTPUT\"\necho \"\
        $OUTPUT\" > /tmp/secrets_scan.txt\n\n# If the baseline was updated (but not\
        \ yet staged), stage it now.\n# This handles the case where detect-secrets-hook\
        \ auto-updates the baseline\n# for line-number consistency and makes it unstaged.\n\
        if grep -q \"Your baseline file.*is unstaged\" /tmp/secrets_scan.txt || \\\
        \n   grep -q \"The baseline file was updated\" /tmp/secrets_scan.txt; then\n\
        \  git add .secrets.baseline\n  echo \"\u2705 Staged updated baseline\"\n\
        fi\n\nif [ \"$EXIT\" -ne 0 ]; then\n  echo \"::warning::detect-secrets found\
        \ potential new secrets\"\n  cat /tmp/secrets_scan.txt\nelse\n  echo \"\u2705\
        \ No new secrets detected\"\nfi\n"
    - name: Auto-fix false positives in test/fixture/documentation files
      id: autofix
      if: steps.scan.outputs.exit_code != '0'
      run: "FIXED=0\nwhile IFS= read -r line; do\n  # Pattern: \"Location:    path/to/file.py:NN\"\
        \n  if [[ \"$line\" =~ ^Location:[[:space:]]+([^:]+):([0-9]+) ]]; then\n \
        \   FILE=\"${BASH_REMATCH[1]}\"\n    LINENO=\"${BASH_REMATCH[2]}\"\n  # Auto-fix\
        \ patterns \u2014 only file types that can safely accept trailing `# pragma:\
        \ allowlist secret`:\n  # 1. Test/fixture/example files (.py, .sh, .yml, .yaml,\
        \ .md, .jsonl)\n  # 2. .codex/aftermath/*.jsonl (structured logs, safe for\
        \ trailing comments)\n  # 3. .codex/ YAML/shell/Python/Markdown/JSONL only\
        \ (not all JSON)\n  # 4. docs/accountability/ YAML/shell/Python/Markdown/JSONL\
        \ only\n  # 5. docs/reference/ YAML/shell/Python/Markdown/JSONL only\n   #\
        \ 6. k8s/ and manifests/ YAML only (not JSON)\n    if [[ \"$FILE\" =~ ^(((tests/|src/.*/tests/|examples/|fixtures/|\\\
        .github/misc/).+\\.(py|sh|yml|yaml|md|jsonl))|test_.+(py|sh|yml|yaml|md|jsonl)|(\\\
        .codex/aftermath/.+\\.jsonl)|(\\.codex/.+\\.(py|sh|yml|yaml|md|jsonl))|(docs/accountability/.+\\\
        .(py|sh|yml|yaml|md|jsonl))|(docs/reference/.+\\.(py|sh|yml|yaml|md|jsonl))|(k8s/.+\\\
        .ya?ml)|(manifests/.+\\.ya?ml))$ ]]; then\n      echo \"\U0001F527 Adding\
        \ pragma to $FILE:$LINENO\"\n  # Append pragma to the flagged line if not\
        \ already present\n      if ! sed -n \"${LINENO}p\" \"$FILE\" | grep -q \"\
        pragma: allowlist secret\"; then\n        sed -i \"${LINENO}s/\\$/  # pragma:\
        \ allowlist secret/\" \"$FILE\"\n        echo \"  \u2705 Patched $FILE:$LINENO\"\
        \n      else\n        echo \"  \u2139\uFE0F  Already has pragma: $FILE:$LINENO\"\
        \n      fi\n      FIXED=$((FIXED+1))\n    else\n      echo \"::error title=Real\
        \ Secret Found::$FILE:$LINENO \u2014 not a test/fixture/doc file; manual review\
        \ required\"\n    fi\n  fi\ndone < /tmp/secrets_scan.txt\n\necho \"fixed=$FIXED\"\
        \ >> \"$GITHUB_OUTPUT\"\nif [ \"$FIXED\" -gt 0 ]; then\n  echo \"fixed_files=true\"\
        \ >> \"$GITHUB_OUTPUT\"\nfi\n"
    - name: Re-scan after pragma fixes
      continue-on-error: true
      if: steps.autofix.outputs.fixed_files == 'true'
      run: "detect-secrets-hook --baseline .secrets.baseline \\\n  $(git diff --name-only\
        \ 2>/dev/null || echo \"\") \\\n  2>&1 | tee /tmp/rescan.txt || {\n    echo\
        \ \"::error::Secrets still found after auto-fix \u2014 manual review required\"\
        \n    cat /tmp/rescan.txt\n    exit 1\n  }\necho \"\u2705 Re-scan clean after\
        \ auto-fix\"\n"
    - name: Commit baseline + pragma fixes
      if: 'steps.autofix.outputs.fixed_files == ''true'' &&

        github.event_name != ''pull_request''

        '
      run: "git config user.name  \"copilot-swe-agent[bot]\"\ngit config user.email\
        \ \"198982749+Copilot@users.noreply.github.com\"\ngit add .secrets.baseline\n\
        git add -u  # stage any pragma-patched files\nif ! git diff --cached --quiet;\
        \ then\n  git commit -m \"fix(ci): auto-sync .secrets.baseline and add pragma\
        \ to test false-positives [skip ci]\"\n  \n  # \u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  # Handle non-fast-forward\
        \ conflicts from concurrent workflows\n  # Pattern: Fetch latest remote state,\
        \ rebase if behind, then push\n  # \u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
        \u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  TARGET_BRANCH=\"${GITHUB_REF#refs/heads/}\"\
        \n  REMOTE=\"origin\"\n  PUSH_ATTEMPTS=0\n  MAX_ATTEMPTS=3\n  \n  while [\
        \ $PUSH_ATTEMPTS -lt $MAX_ATTEMPTS ]; do\n    PUSH_ATTEMPTS=$((PUSH_ATTEMPTS\
        \ + 1))\n    echo \"[Attempt $PUSH_ATTEMPTS/$MAX_ATTEMPTS] Pushing to $REMOTE/$TARGET_BRANCH...\"\
        \n    \n  # Try to push (push current HEAD to remote branch explicitly)\n\
        \    if git push $REMOTE HEAD:$TARGET_BRANCH 2>&1 | tee /tmp/push_output.txt;\
        \ then\n      echo \"\u2705 Committed baseline update and pushed to $REMOTE/$TARGET_BRANCH\"\
        \n      exit 0\n    fi\n    \n  # Push failed \u2014 check if it's a non-fast-forward\
        \ error\n    if grep -q \"non-fast-forward\\|rejected.*non-fast-forward\"\
        \ /tmp/push_output.txt; then\n      echo \"\u26A0\uFE0F [Attempt $PUSH_ATTEMPTS]\
        \ Non-fast-forward conflict detected. Fetching latest and rebasing...\"\n\
        \      \n  # Fetch latest remote state\n      if ! git fetch $REMOTE $TARGET_BRANCH\
        \ --no-tags 2>&1 | tee /tmp/fetch_output.txt; then\n        echo \"::error\
        \ title=Fetch Failed::Unable to fetch $REMOTE/$TARGET_BRANCH\"\n        exit\
        \ 1\n      fi\n      \n    # Check if local is behind remote or if local is\
        \ ahead\n      if git merge-base --is-ancestor HEAD $REMOTE/$TARGET_BRANCH\
        \ 2>/dev/null; then\n        echo \"\u2139\uFE0F  Local branch is behind remote;\
        \ performing fast-forward merge...\"\n        if ! git merge --ff-only $REMOTE/$TARGET_BRANCH;\
        \ then\n          echo \"::error title=Fast-Forward Merge Failed::Unable to\
        \ fast-forward merge from $REMOTE/$TARGET_BRANCH\"\n          exit 1\n   \
        \     fi\n        echo \"\u2705 Fast-forward merge successful\"\n      elif\
        \ git log --oneline $REMOTE/$TARGET_BRANCH..HEAD 2>/dev/null | grep -q .;\
        \ then\n        echo \"\u2139\uFE0F  Local has commits ahead of remote; rebasing\
        \ onto $REMOTE/$TARGET_BRANCH...\"\n        if ! git rebase $REMOTE/$TARGET_BRANCH;\
        \ then\n          echo \"::error title=Rebase Failed::Unable to rebase onto\
        \ $REMOTE/$TARGET_BRANCH\"\n          git rebase --abort || true\n       \
        \   exit 1\n        fi\n        echo \"\u2705 Rebase successful\"\n      fi\n\
        \      \n  # Retry push after merge/rebase\n      continue\n    else\n  #\
        \ Push failed for a different reason (not non-fast-forward)\n      echo \"\
        ::error title=Push Failed::Push failed (non-conflict reason): $(cat /tmp/push_output.txt\
        \ | tail -5)\"\n      exit 1\n    fi\n  done\n  \n  # Exhausted retry attempts\n\
        \  echo \"::error title=Push Failed After Retries::Unable to push after $MAX_ATTEMPTS\
        \ attempts\"\n  exit 1\nelse\n  echo \"Nothing to commit\"\nfi\n"
    - name: Fail on genuine unfixed secrets
      if: 'steps.scan.outputs.exit_code != ''0'' &&

        steps.autofix.outputs.fixed_files != ''true''

        '
      run: 'echo "::error title=Secrets Detected::New secrets found that are not in
        .secrets.baseline"  # pragma: allowlist secret

        echo ""

        echo "Captured detect-secrets output:"

        cat /tmp/secrets_scan.txt || true

        echo ""

        echo "Remediation options:"

        echo "  1. If false positive: add ''# pragma: allowlist secret'' to the flagged
        line."

        echo "  2. If real secret:   rotate it immediately and remove from codebase."

        echo "  3. Update baseline:  python scripts/ci/sync_tracked_files.py --fix
        && detect-secrets scan --baseline .secrets.baseline"

        exit 1

        '
    - name: Final baseline integrity check
      run: "python scripts/ci/sync_tracked_files.py 2>&1\necho \"\u2705 Baseline integrity\
        \ confirmed\"\n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
  rescue-comment:
    name: Post rescue comment
    runs-on: ubuntu-latest
    needs: enforce-baseline
    if: 'failure() &&

      github.event_name == ''pull_request'' &&

      github.event.pull_request.head.repo.full_name == github.repository

      '
    permissions:
      pull-requests: write
    steps:
    - name: Post rescue comment
      uses: actions/github-script@v8
      with:
        github-token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY ||
          github.token }}
        script: "const MAX_COMMENT_LENGTH = 65536; // GitHub comment body limit\n\
          const MARKER = '<!-- secrets-baseline-enforcer -->';\nconst RUN_MARKER =\
          \ `<!-- secrets-baseline-enforcer-run:${context.runId} -->`;\nconst secretsSettingsUrl\
          \ =\n  `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/settings/secrets`;\n\
          const section = [\n  RUN_MARKER,\n  `## \U0001F510 Secrets Baseline Enforcer\
          \ \u2014 Action Required`,\n  ``,\n  `**Run:** [${context.runId}](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId})`,\n\
          \  ``,\n  `A new file added in this PR contains a string that \\`detect-secrets\\\
          ` flags.`,\n  ``,\n  `### Remediation`,\n  `\\`\\`\\`bash`,\n  `# Option\
          \ A \u2014 false positive in test/fixture file:`,\n  `#   Add this comment\
          \ to the flagged line:`,\n  `#  # pragma: allowlist secret`,\n  ``,\n  `#\
          \ Option B \u2014 update baseline (after adding pragma):`,\n  `python scripts/ci/sync_tracked_files.py\
          \ --fix`,\n  `git add .secrets.baseline`,\n  `git commit -m \"fix(ci): update\
          \ .secrets.baseline\"`,\n  `\\`\\`\\``,\n  ``,\n  `> **Never** commit real\
          \ secrets.  If a real credential was accidentally`,\n  `> committed, rotate\
          \ it immediately via [GitHub Settings \u2192 Secrets](${secretsSettingsUrl}).`,\n\
          ].join('\\n');\n\nlet existing = null;\nfor (let page = 1; ; page += 1)\
          \ {\n  const { data: comments } = await github.rest.issues.listComments({\n\
          \    owner: context.repo.owner,\n    repo: context.repo.repo,\n    issue_number:\
          \ context.issue.number,\n    per_page: 100,\n    page,\n  });\n  if (!Array.isArray(comments)\
          \ || comments.length === 0) break;\n  existing = comments.find(c =>\n  \
          \  (c.body || '').includes(MARKER) ||\n    (c.body || '').includes('## \U0001F510\
          \ Secrets Baseline Enforcer \u2014 Action Required')\n  );\n  if (existing\
          \ || comments.length < 100) break;\n}\n\nif (existing) {\n  const existingBody\
          \ = existing.body || '';\n  if (existingBody.includes(RUN_MARKER)) {\n \
          \   core.info(`Secrets baseline comment already contains run ${context.runId};\
          \ skipping duplicate.`);\n  } else {\n    const body = [\n      existingBody.includes(MARKER)\
          \ ? existingBody.trimEnd() : `${MARKER}\\n${existingBody.trimEnd()}`,\n\
          \      `---`,\n      section,\n    ].join('\\n').slice(0, MAX_COMMENT_LENGTH);\n\
          \    await github.rest.issues.updateComment({\n      owner: context.repo.owner,\n\
          \      repo: context.repo.repo,\n      comment_id: existing.id,\n      body,\n\
          \    });\n  }\n} else {\n  await github.rest.issues.createComment({\n  \
          \  owner: context.repo.owner,\n    repo: context.repo.repo,\n    issue_number:\
          \ context.issue.number,\n    body: `${MARKER}\\n${section}`,\n  });\n}\n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    timeout-minutes: 30

name: Rate-Limit History Prune
on:
  workflow_dispatch: null
  schedule:
  - cron: 0 5 1 * *
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions: read-all
jobs:
  prune:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    timeout-minutes: 60
    steps:
    - uses: actions/checkout@v5
      with:
        persist-credentials: false
    - name: CacheManager health check
      continue-on-error: true
      run: 'python scripts/ci/generate_cache_keys.py --health --workflow ratelimit_history_prune
        2>/dev/null || echo "Cache health: check skipped"

        '
    - name: Prune history (keep 90 days)
      run: 'python scripts/connectors/prune_rate_limit_history.py --days 90

        '
    - name: Upload post-prune listing
      run: 'ls -la connectors/history || true

        '
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}

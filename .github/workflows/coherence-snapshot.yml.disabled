name: "\U0001F4C8 OTel Coherence Snapshot"
'on':
  schedule:
  - cron: 0 8 * * 1
  workflow_dispatch:
    inputs:
      pr_number:
        description: PR number to post the coherence snapshot to (optional)
        required: false
        default: ''
        type: string
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  pull-requests: write
jobs:
  coherence-snapshot:
    name: OTel Coherence Snapshot
    runs-on: ubuntu-latest
    steps:
    - name: Checkout
      uses: actions/checkout@v5
    - name: Set up Python
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - name: Install minimal dependencies
      run: 'python -m pip install --quiet --upgrade pip

        # Install only the packages required by the monitoring module

        pip install --quiet opentelemetry-api 2>/dev/null || true

        '
    - name: Run AAIS scorer + emit coherence observation
      id: aais
      run: 'python scripts/ci/aais_v4_scorer.py --json --output /tmp/aais_result.json
        --ci

        SCORE=$(python -c "import json; d=json.load(open(''/tmp/aais_result.json''));
        print(d[''composite''])")

        GRADE=$(python -c "import json; d=json.load(open(''/tmp/aais_result.json''));
        print(d[''grade''])")

        echo "score=${SCORE}" >> "$GITHUB_OUTPUT"

        echo "grade=${GRADE}" >> "$GITHUB_OUTPUT"

        echo "AAIS composite: ${SCORE}/100 (${GRADE})"

        '
    - name: Compute coherence score from AAIS sub-dimensions
      id: coherence
      run: "python - <<'EOF'\nimport json, sys\n\nsys.path.insert(0, \"src\")\ntry:\n\
        \    from codex.monitoring.otel_metrics import compute_coherence, workflow_coherence_score\n\
        \    otel_available = True\nexcept Exception as e:\n    print(f\"OTel import\
        \ skipped: {e}\")\n    otel_available = False\n\ndata = json.load(open(\"\
        /tmp/aais_result.json\"))\n\nactual   = {}\nexpected = {}\nfor pillar in data.get(\"\
        pillars\", []):\n    for sd in pillar.get(\"sub_dimensions\", []):\n     \
        \   key = sd[\"name\"]\n        actual[key]   = \"pass\" if sd[\"score\"]\
        \ >= 80.0 else \"fail\"\n        expected[key] = \"pass\"\n\nif otel_available:\n\
        \    coherence = compute_coherence(actual, expected)\n    workflow_coherence_score.observe(coherence)\n\
        \    print(f\"Coherence score: {coherence:.3f}\")\n    with open(\"/tmp/coherence.txt\"\
        , \"w\") as f:\n        f.write(str(coherence))\nelse:\n    passing  = sum(1\
        \ for v in actual.values() if v == \"pass\")\n    total    = len(actual) or\
        \ 1\n    coherence = passing / total\n    print(f\"Coherence score (computed\
        \ locally): {coherence:.3f}\")\n    with open(\"/tmp/coherence.txt\", \"w\"\
        ) as f:\n        f.write(str(coherence))\nEOF\nCOHERENCE=$(cat /tmp/coherence.txt)\n\
        echo \"coherence=${COHERENCE}\" >> \"$GITHUB_OUTPUT\"\n"
    - name: Build snapshot markdown
      id: snapshot
      run: "python - <<'EOF'\nimport json, datetime, os\n\ndata      = json.load(open(\"\
        /tmp/aais_result.json\"))\nscore     = data[\"composite\"]\ngrade     = data[\"\
        grade\"]\ncoherence = float(open(\"/tmp/coherence.txt\").read().strip())\n\
        ts        = datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%d\
        \ %H:%M UTC\")\n\ncolor = \"\U0001F7E2\" if score >= 99.7 else (\"\U0001F7E1\
        \" if score >= 80 else \"\U0001F534\")\nc_color = \"\U0001F7E2\" if coherence\
        \ >= 0.9 else (\"\U0001F7E1\" if coherence >= 0.7 else \"\U0001F534\")\n\n\
        lines = [\n    f\"## \U0001F4C8 OTel Coherence Snapshot \u2014 {ts}\",\n \
        \   \"\",\n    f\"| Metric | Value | Status |\",\n    f\"|--------|-------|--------|\"\
        ,\n    f\"| AAIS Composite | **{score:.1f} / 100** ({grade}) | {color} {'\u2265\
        \ 99.7 \u2705' if score >= 99.7 else '< 99.7 \u26A0\uFE0F'} |\",\n    f\"\
        | Coherence Score | **{coherence:.3f}** | {c_color} {'\u2265 0.9 \u2705' if\
        \ coherence >= 0.9 else '< 0.9 \u26A0\uFE0F'} |\",\n    \"\",\n    \"<details>\"\
        ,\n    \"<summary>\U0001F4CA Sub-dimension breakdown</summary>\",\n    \"\"\
        ,\n    \"| Sub-dimension | Score | Policy |\",\n    \"|---------------|------:|--------|\"\
        ,\n]\nfor pillar in data.get(\"pillars\", []):\n    for sd in pillar.get(\"\
        sub_dimensions\", []):\n        ok = \"\u2705\" if sd[\"score\"] >= 80.0 else\
        \ \"\u274C\"\n        lines.append(f\"| {sd['name']} | {sd['score']:.1f} |\
        \ {ok} |\")\nlines += [\"\", \"</details>\", \"\"]\n\nif score < 99.7:\n \
        \   lines += [\n        \"> \u26A0\uFE0F **AAIS regression detected** \u2014\
        \ score fell below 99.7 threshold.\",\n        \"> Review the sub-dimension\
        \ breakdown above and apply targeted fixes.\",\n        \"\",\n    ]\n\nmd\
        \ = \"\\n\".join(lines)\nwith open(\"/tmp/snapshot.md\", \"w\") as f:\n  \
        \  f.write(md)\nprint(md)\nEOF\n"
    - name: Write to step summary
      run: cat /tmp/snapshot.md >> "$GITHUB_STEP_SUMMARY"
    - name: Post to PR dashboard (if PR number provided)
      if: github.event.inputs.pr_number != '' || github.event_name == 'schedule'
      env:
        GITHUB_TOKEN: ${{ github.token }}
        GITHUB_REPOSITORY: ${{ github.repository }}
      run: "PR_NUMBER=\"${{ github.event.inputs.pr_number }}\"\n\n# For scheduled\
        \ runs find the most recently updated open PR\nif [ -z \"${PR_NUMBER}\" ];\
        \ then\n  PR_NUMBER=$(python - <<'EOF'\nimport json, urllib.request, os\n\n\
        token = os.environ.get(\"GITHUB_TOKEN\", \"\")\nrepo  = os.environ.get(\"\
        GITHUB_REPOSITORY\", \"Aries-Serpent/_codex_\")\nreq   = urllib.request.Request(\n\
        \    f\"https://api.github.com/repos/{repo}/pulls?state=open&sort=updated&direction=desc&per_page=1\"\
        ,\n    headers={\"Authorization\": f\"Bearer {token}\", \"Accept\": \"application/vnd.github+json\"\
        ,\n             \"X-GitHub-Api-Version\": \"2022-11-28\"},\n)\nimport urllib.error\n\
        try:\n    with urllib.request.urlopen(req, timeout=10) as r:\n        prs\
        \ = json.loads(r.read())\n        print(prs[0][\"number\"] if prs else \"\"\
        )\nexcept Exception:\n    print(\"\")\nEOF\n  )\nfi\n\nif [ -z \"${PR_NUMBER}\"\
        \ ]; then\n  echo \"No open PR found \u2014 skipping dashboard post (results\
        \ written to step summary)\"\n  exit 0\nfi\n\nDETAILS=$(cat /tmp/snapshot.md)\n\
        python scripts/ci/pr_comment_consolidator.py \\\n  --pr-number  \"${PR_NUMBER}\"\
        \ \\\n  --workflow   \"OTel Coherence Snapshot\" \\\n  --status     \"$(awk\
        \ -v s='${{ steps.aais.outputs.score }}' 'BEGIN{print (s+0 >= 80.0) ? \"success\"\
        \ : \"warning\"}')\" \\\n  --summary    \"AAIS ${{ steps.aais.outputs.score\
        \ }}/100 (${{ steps.aais.outputs.grade }}) \xB7 Coherence ${{ steps.coherence.outputs.coherence\
        \ }}\" \\\n  --details    \"${DETAILS}\" \\\n  --run-url    \"${{ github.server_url\
        \ }}/${{ github.repository }}/actions/runs/${{ github.run_id }}\"\n"
    - name: "Enforce AAIS \u2265 MIN_PASSING_SCORE threshold"
      run: "SCORE=\"${{ steps.aais.outputs.score }}\"\npython - <<EOF\nimport sys\n\
        sys.path.insert(0, \"scripts/ci\")\nfrom aais_v4_scorer import MIN_PASSING_SCORE\
        \ as threshold\nscore = float(\"${SCORE}\")\nif score < threshold:\n    print(f\"\
        \u274C AAIS regression: {score:.1f} < {threshold} \u2014 weekly enforcement\
        \ FAILED\")\n    sys.exit(1)\nelse:\n    print(f\"\u2705 AAIS {score:.1f}/100\
        \ \u2265 {threshold} \u2014 weekly enforcement PASSED\")\nEOF\n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}
    timeout-minutes: 30

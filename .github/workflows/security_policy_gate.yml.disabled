name: Security Policy Gate

on:
  pull_request:
    branches: [ "0D_base_", "copilot/integrate-codex-status-template", "main", "master" ]
  workflow_dispatch:

jobs:
  policy-gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - name: Install tooling
        run: |
          python -m pip install --upgrade pip
          pip install bandit detect-secrets pip-audit
      - name: Enforce policy
        run: |
          python scripts/security/enforce_policy.py

name: CI Pass-Rate Gate
on:
  workflow_dispatch: null
  schedule:
  - cron: 0 6 * * *
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  actions: read
  issues: write
jobs:
  pass-rate:
    name: 7-day rolling CI pass-rate check (D6 exit criteria)
    runs-on: ubuntu-latest
    steps:
    - name: Cache Python dependencies (Layer 1)
      uses: actions/cache@v5
      with:
        path: ~/.cache/pip
        key: ${{ runner.os }}-pip-${{ hashFiles('**/requirements*.txt', '**/pyproject.toml')
          }}
        restore-keys: '${{ runner.os }}-pip-

          '
    - uses: actions/checkout@v5
    - name: Compute 7-day pass rate
      id: rate
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
      run: "python3 - <<'PYEOF'\nimport json, os, subprocess, sys\nfrom datetime import\
        \ datetime, timedelta, timezone\n\ntoken = os.environ[\"GH_TOKEN\"]\nrepo\
        \  = os.environ.get(\"GITHUB_REPOSITORY\", \"Aries-Serpent/_codex_\")\nsince\
        \ = (datetime.now(timezone.utc) - timedelta(days=7)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"\
        )\n\ncmd = [\n    \"gh\", \"api\",\n    f\"repos/{repo}/actions/runs\",\n\
        \    \"--paginate\",\n    \"-q\", f'.workflow_runs[] | select(.created_at\
        \ > \"{since}\" and .status == \"completed\") | [.conclusion] | @tsv'\n]\n\
        result = subprocess.run(cmd, capture_output=True, text=True, env={**os.environ})\n\
        lines = [l.strip() for l in result.stdout.splitlines() if l.strip()]\n\ntotal\
        \    = len(lines)\nsuccess  = sum(1 for l in lines if l in (\"success\", \"\
        neutral\"))\nfailures = total - success\nrate_pct = round(success / total\
        \ * 100, 1) if total else 0.0\n\nprint(f\"Total runs (7d): {total}\")\nprint(f\"\
        Success: {success}  Failures: {failures}\")\nprint(f\"Pass rate: {rate_pct}%\"\
        )\n\nwith open(os.environ[\"GITHUB_OUTPUT\"], \"a\") as f:\n    f.write(f\"\
        rate={rate_pct}\\n\")\n    f.write(f\"total={total}\\n\")\n    f.write(f\"\
        failures={failures}\\n\")\n\n# Write artifact\nos.makedirs(\"reports/ci\"\
        , exist_ok=True)\nreport = {\n    \"generated_at\": datetime.now(timezone.utc).strftime(\"\
        %Y-%m-%dT%H:%M:%SZ\"),\n    \"window_days\": 7,\n    \"total_runs\": total,\n\
        \    \"success_runs\": success,\n    \"failure_runs\": failures,\n    \"pass_rate_pct\"\
        : rate_pct,\n    \"threshold_pct\": 95.0,\n    \"passed\": rate_pct >= 95.0,\n\
        }\nwith open(\"reports/ci/ci_pass_rate_latest.json\", \"w\") as f:\n    json.dump(report,\
        \ f, indent=2)\nprint(json.dumps(report, indent=2))\nPYEOF\n"
    - name: Cache test results (Layer 3)
      uses: actions/cache@v5
      if: always()
      with:
        path: .pytest_cache/
        key: ${{ runner.os }}-pytest-${{ github.sha }}
        restore-keys: '${{ runner.os }}-pytest-

          '
    - name: Upload pass-rate report
      uses: actions/upload-artifact@v5
      with:
        path: reports/ci/ci_pass_rate_latest.json
        name: ci-pass-rate-${{ github.run_id }}
    - name: Gate on 95% threshold
      env:
        RATE: ${{ steps.rate.outputs.rate }}
      run: "python3 -c \"\nimport sys, os\nrate = float(os.environ.get('RATE', '0'))\n\
        print(f'Pass rate: {rate}%  threshold: 95.0%')\nif rate < 95.0:\n    print('::error::7-day\
        \ CI pass rate below 95% \u2014 D6 exit criteria not yet met')\n    sys.exit(1)\n\
        else:\n    print('::notice::\u2705 D6 exit criteria #1 met: 7-day pass rate\
        \ >= 95%')\n\"\n"
    timeout-minutes: 30

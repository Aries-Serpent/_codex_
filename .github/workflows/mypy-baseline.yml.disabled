name: mypy Baseline (Type-Check Anti-Regression)
'on':
  pull_request:
    paths:
    - src/**
    - .mypy_baseline
    - mypy.ini
    - pyproject.toml
    - scripts/ci/mypy_baseline.py
    - .github/workflows/mypy-baseline.yml
  push:
    branches:
    - main
    paths:
    - src/**
    - .mypy_baseline
  workflow_dispatch: null
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
jobs:
  mypy-baseline:
    name: "\U0001F50E mypy Anti-Regression Gate"
    runs-on: ubuntu-latest
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 1
    - name: "\U0001F50D SHA drift diagnostic"
      run: "echo \"### SHA Drift Diagnostic\" >> \"$GITHUB_STEP_SUMMARY\"\necho \"\
        \" >> \"$GITHUB_STEP_SUMMARY\"\necho \"| Source | SHA |\" >> \"$GITHUB_STEP_SUMMARY\"\
        \necho \"|--------|-----|\" >> \"$GITHUB_STEP_SUMMARY\"\necho \"| \\`github.sha\\\
        ` (trigger) | \\`${{ github.sha }}\\` |\" >> \"$GITHUB_STEP_SUMMARY\"\necho\
        \ \"| \\`git log -1\\` (checked out) | \\`$(git log -1 --format=%H)\\` |\"\
        \ >> \"$GITHUB_STEP_SUMMARY\"\necho \"\" >> \"$GITHUB_STEP_SUMMARY\"\nTRIGGER=\"\
        ${{ github.sha }}\"\nCHECKEDOUT=\"$(git log -1 --format=%H)\"\nif [ \"$TRIGGER\"\
        \ != \"$CHECKEDOUT\" ]; then\n  echo \"\u26A0\uFE0F  **SHA drift detected**\
        \ \u2014 CI is running on a GitHub merge-preview\" >> \"$GITHUB_STEP_SUMMARY\"\
        \n  echo \"commit (\\`${CHECKEDOUT:0:12}\\`), not the PR branch HEAD (\\`${TRIGGER:0:12}\\\
        `).\" >> \"$GITHUB_STEP_SUMMARY\"\n  echo \"mypy error counts may differ from\
        \ local runs on the PR branch.\" >> \"$GITHUB_STEP_SUMMARY\"\n  echo \"\"\n\
        \  echo \"\u26A0\uFE0F  SHA drift: trigger=$TRIGGER checkedout=$CHECKEDOUT\"\
        \n  echo \"   (CI is on merge-preview commit \u2014 mypy count may differ\
        \ from local run)\"\nelse\n  echo \"\u2705  No SHA drift: trigger and checked-out\
        \ SHA match.\"\nfi\n"
    - name: Set up Python 3.12
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v3' }}
    - name: Install mypy and stubs in isolated venv
      run: 'python -m venv /tmp/mypy-venv --clear

        /tmp/mypy-venv/bin/pip install --quiet "mypy>=1.8.0" types-PyYAML types-requests

        '
    - name: Run mypy baseline gate
      id: mypy_gate
      run: '/tmp/mypy-venv/bin/python scripts/ci/mypy_baseline.py --require-baseline
        2>&1 | tee /tmp/mypy_output.txt

        echo "exit_code=${PIPESTATUS[0]}" >> "$GITHUB_OUTPUT"

        '
    - name: Post mypy summary
      if: always()
      run: "{\n  echo \"## mypy Anti-Regression Gate\"\n  echo \"\"\n  echo '```'\n\
        \  cat /tmp/mypy_output.txt 2>/dev/null || echo \"No mypy output captured.\"\
        \n  echo '```'\n} >> \"$GITHUB_STEP_SUMMARY\"\n"
    - name: Fail if regression detected
      if: steps.mypy_gate.outputs.exit_code != '0'
      run: 'echo "::error::mypy type-error count exceeds baseline. See summary for
        details."

        exit 1

        '
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    timeout-minutes: 30
  rescue-comment:
    name: Post rescue comment on mypy failure
    runs-on: ubuntu-latest
    needs: mypy-baseline
    if: 'failure() &&

      github.event_name == ''pull_request'' &&

      github.event.pull_request.head.repo.full_name == github.repository

      '
    permissions:
      pull-requests: write
      issues: write
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        fetch-depth: 1
    - name: Post or update rescue comment
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
        REPO: ${{ github.repository }}
        COMMIT_SHA: ${{ github.event.pull_request.head.sha }}
        RUN_ID: ${{ github.run_id }}
        WORKFLOW_NAME: mypy Baseline Gate
        RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{
          github.run_id }}
        BRANCH: ${{ github.head_ref }}
      run: python scripts/ci/post_rescue_comment.py
    timeout-minutes: 30

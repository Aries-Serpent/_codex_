name: GitHub Guru Agent
on:
  pull_request:
    types:
    - opened
    - reopened
    - ready_for_review
    - synchronize
  issues:
    types:
    - opened
    - labeled
  schedule:
  - cron: 0 6 * * *
  workflow_dispatch:
    inputs:
      mode:
        description: 'Run mode: full | pr_only | hygiene | dependency'
        required: false
        default: full
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  issues: write
  pull-requests: write
  checks: write
  actions: read
env:
  SAFE_MODE: 'true'
  OFFLINE_MODE: 'false'
jobs:
  github-guru:
    name: GitHub Guru Agent
    runs-on: ubuntu-latest
    if: ${{ !contains(github.event.head_commit.message, '[skip-guru]') }}
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 1
    - name: Set up Python
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: 3.12.13
        cache-tier: common
        cache-version: ${{ vars.CODEX_CACHE_VERSION || 'v2' }}
    - name: Install dependencies
      run: 'pip install --quiet requests

        '
    - name: Determine run mode
      id: mode
      run: "if [[ \"${{ github.event_name }}\" == \"pull_request\" ]]; then\n  echo\
        \ \"mode=pr_only\" >> \"$GITHUB_OUTPUT\"\n  echo \"entity_id=${{ github.event.pull_request.number\
        \ }}\" >> \"$GITHUB_OUTPUT\"\n  echo \"event_type=pull_request\" >> \"$GITHUB_OUTPUT\"\
        \nelif [[ \"${{ github.event_name }}\" == \"issues\" ]]; then\n  echo \"mode=issue\"\
        \ >> \"$GITHUB_OUTPUT\"\n  echo \"entity_id=${{ github.event.issue.number\
        \ }}\" >> \"$GITHUB_OUTPUT\"\n  echo \"event_type=issues\" >> \"$GITHUB_OUTPUT\"\
        \nelse\n  echo \"mode=${{ github.event.inputs.mode || 'full' }}\" >> \"$GITHUB_OUTPUT\"\
        \n  echo \"entity_id=\" >> \"$GITHUB_OUTPUT\"\n  echo \"event_type=schedule\"\
        \ >> \"$GITHUB_OUTPUT\"\nfi\n"
    - name: Run GitHub Guru Agent
      env:
        GITHUB_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY }}
        GURU_EVENT_TYPE: ${{ steps.mode.outputs.event_type }}
        GURU_ENTITY_ID: ${{ steps.mode.outputs.entity_id }}
        GURU_MODE: ${{ steps.mode.outputs.mode }}
      run: "python3 - << 'PYEOF'\nimport os, sys\nsys.path.insert(0, \".github/agents/github-guru-agent\"\
        )\nfrom main import GitHubGuruAgent\n\nowner, repo = os.environ.get(\"GITHUB_REPOSITORY\"\
        , \"unknown/unknown\").split(\"/\", 1)\nagent = GitHubGuruAgent(\n    owner=owner,\n\
        \    repo=repo,\n    token=os.environ.get(\"GITHUB_TOKEN\", \"\"),\n    safe_mode=True,\n\
        )\nevent_type = os.environ.get(\"GURU_EVENT_TYPE\", \"schedule\")\nentity_id\
        \ = os.environ.get(\"GURU_ENTITY_ID\", \"\")\nevent = {\"event_type\": event_type}\n\
        if entity_id:\n    event[\"entity_id\"] = int(entity_id)\nresult = agent.handle_event(event)\n\
        print(result.get(\"result_md\", \"No output\"))\nsys.exit(0 if result.get(\"\
        success\") else 1)\nPYEOF\n"
    - name: Upload session metrics
      if: always()
      uses: actions/upload-artifact@v5
      with:
        path: audit_artifacts/baselines/github_guru_session_*.json
        retention-days: 30
        if-no-files-found: ignore
        name: github-guru-metrics-${{ github.run_number }}
    timeout-minutes: 30
  rescue-comment:
    name: Post rescue comment on failure
    runs-on: ubuntu-latest
    needs: github-guru
    if: 'failure() &&

      github.event_name == ''pull_request'' &&

      github.event.pull_request.head.repo.full_name == github.repository

      '
    permissions:
      pull-requests: write
      issues: write
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || secrets.GITHUB_TOKEN
          }}
        fetch-depth: 1
    - name: Post or update rescue comment
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
        REPO: ${{ github.repository }}
        COMMIT_SHA: ${{ github.event.pull_request.head.sha }}
        RUN_ID: ${{ github.run_id }}
        WORKFLOW_NAME: GitHub Guru
        RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{
          github.run_id }}
        BRANCH: ${{ github.head_ref }}
      run: python scripts/ci/post_rescue_comment.py
    timeout-minutes: 30

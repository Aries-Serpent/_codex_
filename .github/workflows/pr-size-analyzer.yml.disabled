name: PR Size Analyzer
on:
  pull_request:
    types:
    - opened
    - synchronize
    - reopened
  workflow_call:
    outputs:
      pr_size:
        description: PR size category (small, medium, large, refactor)
        value: ${{ jobs.analyze-size.outputs.pr_size }}
      changed_files_count:
        description: Number of changed files
        value: ${{ jobs.analyze-size.outputs.changed_files_count }}
      validation_strategy:
        description: Recommended validation strategy
        value: ${{ jobs.analyze-size.outputs.validation_strategy }}
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: read
  pull-requests: write
jobs:
  analyze-size:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    outputs:
      pr_size: ${{ steps.analyze.outputs.pr_size }}
      changed_files_count: ${{ steps.analyze.outputs.changed_files_count }}
      validation_strategy: ${{ steps.analyze.outputs.validation_strategy }}
    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 0
    - name: Analyze PR Size
      id: analyze
      run: '# Count changed files between base and head

        # Support both direct PR\

        '
    - name: Report PR Size
      run: 'echo "### PR Size Analysis Results" >> $GITHUB_STEP_SUMMARY

        echo "" >> $GITHUB_STEP_SUMMARY

        echo "**PR Size:** ${{ steps.analyze.outputs.pr_size }}" >> $GITHUB_STEP_SUMMARY

        echo "**Changed Files:** ${{ steps.analyze.outputs.changed_files_count }}"
        >> $GITHUB_STEP_SUMMARY

        echo "**Validation Strategy:** ${{ steps.analyze.outputs.validation_strategy
        }}" >> $GITHUB_STEP_SUMMARY

        echo "" >> $GITHUB_STEP_SUMMARY

        # Also output to job log

        echo "================================"

        echo "PR Size: ${{ steps.analyze.outputs.pr_size }}"

        echo "Changed Files: ${{ steps.analyze.outputs.changed_files_count }}"

        echo "Strategy: ${{ steps.analyze.outputs.validation_strategy }}"

        echo "================================"

        '
    - name: Post to PR Status Dashboard
      if: github.event_name == 'pull_request'
      uses: ./.github/actions/post-pr-summary
      with:
        workflow-name: PR Size Analysis
        status: info
        summary: "${{ steps.analyze.outputs.pr_size }} PR \u2014 ${{ steps.analyze.outputs.changed_files_count\
          \ }} files \u2014 strategy: ${{ steps.analyze.outputs.validation_strategy\
          \ }}"
        details: "| Field | Value |\n|-------|-------|\n| Size Category | `${{ steps.analyze.outputs.pr_size\
          \ }}` (${{ steps.analyze.outputs.changed_files_count }} files) |\n| Validation\
          \ Strategy | ${{ steps.analyze.outputs.validation_strategy }} |\n**Size\
          \ Thresholds:** Small (<20) \u2192 Full validation \xB7 Medium (20-99) \u2192\
          \ Targeted \xB7 Large (100-499) \u2192 Smoke \xB7 Refactor (500+) \u2192\
          \ Import only\n"
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    timeout-minutes: 30
  rescue-comment:
    name: Post rescue comment on failure
    runs-on: ubuntu-latest
    needs: analyze-size
    if: 'failure() &&

      github.event_name == ''pull_request'' &&

      github.event.pull_request.head.repo.full_name == github.repository

      '
    permissions:
      pull-requests: write
      issues: write
    steps:
    - name: Checkout repository
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        fetch-depth: 1
    - name: Post or update rescue comment
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
        PR_NUMBER: ${{ github.event.pull_request.number }}
        REPO: ${{ github.repository }}
        COMMIT_SHA: ${{ github.event.pull_request.head.sha }}
        RUN_ID: ${{ github.run_id }}
        WORKFLOW_NAME: PR Size Analyzer
        RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{
          github.run_id }}
        BRANCH: ${{ github.head_ref }}
      run: python scripts/ci/post_rescue_comment.py
    timeout-minutes: 30

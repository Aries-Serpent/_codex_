name: "\U0001F527 CI Pattern Healer \u2014 Automated Failure Detection & Healing"
on:
  workflow_run:
    workflows:
    - Secrets Baseline Enforcer
    - Workflow Documentation Link Validation
    - Code Quality
    - Security Suite
    types:
    - completed
    branches:
    - main
    - 0D_base_
    - automated/**
    - copilot/**
  schedule:
  - cron: 0 6,18 * * *
  workflow_dispatch:
    inputs:
      pattern_id:
        description: Specific pattern to heal (1-9, or empty for all)
        required: false
        type: string
      dry_run:
        description: Show what would be fixed without applying changes
        required: false
        type: boolean
        default: false
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
permissions:
  contents: write
env:
  PYTHON_VERSION: '3.12'
jobs:
  detect-failures:
    name: Detect and Diagnose CI Failures
    runs-on: ubuntu-latest
    outputs:
      detected_patterns: ${{ steps.detect.outputs.patterns }}
      needs_healing: ${{ steps.detect.outputs.needs_healing }}
    steps:
    - name: Checkout
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 0
    - name: Set up Python with caching
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: ${{ env.PYTHON_VERSION }}

    - name: Install dependencies
      run: 'pip install -q pyyaml ruff

        '
    - name: Detect failing patterns
      id: detect
      continue-on-error: true
      run: "# Run orchestrator in check-only mode with JSON output\npython .github/scripts/ci-autofix-orchestrator.py\
        \ \\\n  --check-only \\\n  --json-output .codex/ci-patterns-detected.json\n\
        \n# Extract pattern info for next step\nif [ -f .codex/ci-patterns-detected.json\
        \ ]; then\n  TOTAL=$(jq '.total_issues' .codex/ci-patterns-detected.json)\n\
        \  AUTO_FIX=$(jq '.auto_fixable' .codex/ci-patterns-detected.json)\n  PATTERNS=$(jq\
        \ -c '.issues | map(.pattern) | unique' .codex/ci-patterns-detected.json)\n\
        \  echo \"patterns=$PATTERNS\" >> \"$GITHUB_OUTPUT\"\n  echo \"needs_healing=$([[\
        \ $TOTAL -gt 0 && $AUTO_FIX -gt 0 ]] && echo true || echo false)\" >> \"$GITHUB_OUTPUT\"\
        \n  echo \"\u2705 Detected $TOTAL issues ($AUTO_FIX auto-fixable)\"\nelse\n\
        \  echo \"patterns=[]\" >> \"$GITHUB_OUTPUT\"\n  echo \"needs_healing=false\"\
        \ >> \"$GITHUB_OUTPUT\"\nfi\n"
    - name: Upload diagnostic report
      if: always()
      uses: actions/upload-artifact@v5
      with:
        path: .codex/ci-patterns-detected.json
        retention-days: 30
        name: ci-patterns-detected-${{ github.run_id }}
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    timeout-minutes: 30
  heal-patterns:
    name: Apply Automated Fixes
    needs: detect-failures
    if: needs.detect-failures.outputs.needs_healing == 'true'
    runs-on: ubuntu-latest
    steps:
    - name: Checkout
      uses: actions/checkout@v5
      with:
        persist-credentials: false
        fetch-depth: 0
        token: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
    - name: Set up Python with caching
      uses: ./.github/actions/setup-python-cached
      with:
        python-version: ${{ env.PYTHON_VERSION }}

    - name: Install dependencies
      run: 'pip install -q pyyaml ruff

        '
    - name: Apply automated fixes
      run: "DRY_RUN=\"${{ github.event.inputs.dry_run == 'true' && '--dry-run' ||\
        \ '' }}\"\npython .github/scripts/ci-autofix-orchestrator.py $DRY_RUN \\\n\
        \  --json-output .codex/ci-patterns-fixed.json\n\necho \"::group::Fix Report\"\
        \njq '.' .codex/ci-patterns-fixed.json || true\necho \"::endgroup::\"\n"
    - name: Configure Git
      run: 'git config user.name "copilot-swe-agent[bot]"

        git config user.email "198982749+Copilot@users.noreply.github.com"

        '
    - name: Commit fixes (if not dry-run)
      if: github.event.inputs.dry_run != 'true'
      run: "if ! git diff --quiet; then\n  git add .\n  if ! git diff --cached --quiet;\
        \ then\n    git commit -m \"fix(ci): auto-heal detected CI failure patterns\
        \ [skip ci]\" \\\n      -m \"- Applied automated fixes for detected patterns\"\
        \ \\\n      -m \"- Patterns healed per orchestrator diagnostics\" \\\n   \
        \   -m \"- This commit resolves recurrent CI issues\"\n    git push\n  fi\n\
        fi\n"
    - name: Upload fix report
      if: always()
      uses: actions/upload-artifact@v5
      with:
        path: .codex/ci-patterns-fixed.json
        retention-days: 30
        name: ci-patterns-fixed-${{ github.run_id }}
    env:
      GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
        }}
    timeout-minutes: 30
  post-heal-validation:
    name: Validate Healed State
    needs:
    - detect-failures
    - heal-patterns
    if: always()
    runs-on: ubuntu-latest
    steps:
    - name: Checkout
      uses: actions/checkout@v5
      with:
        persist-credentials: false
    - name: Download detection report
      uses: actions/download-artifact@v5
      with:
        path: .codex/
        name: ci-patterns-detected-${{ github.run_id }}
    - name: Download fix report
      if: needs.heal-patterns.result == 'success'
      uses: actions/download-artifact@v5
      with:
        path: .codex/
        name: ci-patterns-fixed-${{ github.run_id }}
      continue-on-error: true
    - name: Generate summary
      run: "echo \"## \U0001F527 CI Pattern Healing Report\" >> $GITHUB_STEP_SUMMARY\n\
        echo \"\" >> $GITHUB_STEP_SUMMARY\n\nif [ -f .codex/ci-patterns-detected.json\
        \ ]; then\n  echo \"### Detection Results\" >> $GITHUB_STEP_SUMMARY\njq -r\
        \ '.issues[] | \"- Pattern \\(.pattern): \\(.message) \"' \\\n  .codex/ci-patterns-detected.json\
        \ >> $GITHUB_STEP_SUMMARY || true\nfi\n\nif [ -f .codex/ci-patterns-fixed.json\
        \ ]; then\n  echo \"\" >> $GITHUB_STEP_SUMMARY\n  echo \"### Fixes Applied\"\
        \ >> $GITHUB_STEP_SUMMARY\n  jq -r \".fixes_applied\" .codex/ci-patterns-fixed.json\
        \ | \\\n  xargs -I {} echo \"- {} fixes applied\" >> $GITHUB_STEP_SUMMARY\
        \ || true\nfi\n"
      env:
        GH_TOKEN: ${{ secrets.CODEX_MASTER_KEY || secrets.CODEX_BACKUP_KEY || github.token
          }}
    timeout-minutes: 30

[mutmut]
source_paths = agents/agent_memory.py
pytest_add_cli_args_test_selection = tests/agents/test_30pct_final.py::test_agent_memory_basics -v --tb=short --no-cov
test_time_multiplier = 3.0
test_time_base = 5.0
timeout = 30
mutation_types = keyword,operator,string,number,literal,dict,set,list,index

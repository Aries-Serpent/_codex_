      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "args": ["scripts/autonomous/mcp_server.py"],
      "env": {
        "CODEX_CLI_API_URL": "http://127.0.0.1:8765",
        "CODEX_MCP_ORIGIN": "http://localhost:5173",

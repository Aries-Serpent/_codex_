{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Codex: debug current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Codex: debug CDX context tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "--confcutdir=tests/archive",
        "-o",
        "addopts=--strict-markers --import-mode=importlib",
        "-q",
        "tests/archive/test_cdx_context.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

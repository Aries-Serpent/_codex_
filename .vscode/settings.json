{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/src"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "ruff.lint.args": [
    "--config=${workspaceFolder}/pyproject.toml"
  ],
  "ruff.format.args": [
    "--config=${workspaceFolder}/pyproject.toml"
  ],
  "terminal.integrated.env.linux": {
    "CODEX_CLI_API_URL": "http://127.0.0.1:8765",
    "PATH": "${env:HOME}/.local/bin:${env:PATH}",
    "PYTHONPATH": "${workspaceFolder}/src"
  },
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "--confcutdir=tests/archive",
    "-o",
    "addopts=--strict-markers --import-mode=importlib",
    "tests/archive/test_cdx_context.py",
    "tests/archive/test_cdx_preflight.py",
    "tests/archive/test_cdx_review.py",
    "tests/archive/test_cdx_adapter.py",
    "tests/archive/test_cdx_sqlite_archive.py"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "black-formatter.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.rulers": [
      100
    ]
  },
  "files.insertFinalNewline": true
}

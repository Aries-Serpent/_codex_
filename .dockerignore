# Reduce build context per Docker guidance.
# Generated for Docker Set A: minimal image + CI.

# VCS and repo metadata
.git
.github
.gitignore
.gitattributes

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
site/

# Virtual environments
.venv
.venv/
.venv*/
venv
env

# Tool caches
.pytest_cache/
.nox/
.tox/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Project-specific outputs and logs
.codex/
artifacts/
reports/
logs/
outputs/
docs/_build/
documentation/_build/

# Data / experiments
Data/
data/
datasets/
temp/

# Tests and docs (not needed in runtime image)
docs/
tests/
noxfile.py

# OS cruft
.DS_Store
Thumbs.db

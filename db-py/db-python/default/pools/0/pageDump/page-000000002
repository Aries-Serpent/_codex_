    python scripts/cognitive/continuation_chain.py \
        --post-to-discussion \
        --repo Aries-Serpent/_codex_ \
        --discussion-number 3673

    # Control which DB and manifest to read:
    python scripts/cognitive/continuation_chain.py \
        --db ~/.codex/cli_history.db \
        --manifest CODEX_MANIFEST.json


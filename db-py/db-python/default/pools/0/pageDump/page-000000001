        ...     {"id": "train_loop", "evidence_files": ["loop.py"], "found_patterns": ["epoch"], ...}
        ... ]
        >>> cfg = {"capability_map": {"overrides": {"training-engine": ["train", "train_loop"]}}}
        >>> result = apply_overrides(caps, cfg)

        </div>

        <div id="graph"></div>

        <script>
        const data = ;

        // Create D3 visualization
        const width = 1160;
        const height = 600;

        const svg = d3.select("#graph")
            .append("svg")
            .attr("width", width)
            .attr("height", height);

        // Simple node visualization
        const nodes = svg.selectAll("circle")
            .data(data)

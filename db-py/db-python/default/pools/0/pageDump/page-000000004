---------------------------------
    python scripts/ci/pr_comment_consolidator.py \
        --pr-number  "${{ github.event.pull_request.number }}" \
        --workflow   "Semgrep Security Scan" \
        --status     "success" \
        --summary    "No security issues found" \
        --details    "Scanned 1 243 files; 0 findings."


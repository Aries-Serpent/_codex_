L-CACHE] \u26a0\ufe0f  Warning: Failed to pre-download model: {e}\")\n    print(\"[MODEL-CACHE] Tests will download model on-demand (may add 2-5 min to first test)\")\n    import traceback\n    traceback.print_exc()\n    sys.exit(0)  # Don't fail workflow - model will be downloaded during tests\nPYTHON_SCRIPT\n \nCACHE_END=$(date +%s)\nCACHE_DURATION=$((CACHE_END - CACHE_START))\n \necho \"\"\necho \"[MODEL-CACHE] Disk space after model download:\"\ndf -h / | tail -1 | awk '{print \"  Available: \" $4 \", Used: \" $3 \", Size: \" $2}'\n \necho \"\"\necho \"[MODEL-CACHE] Model cache contents:\"\nls -lh \"$CACHE_DIR\" 2>/dev/null | head -10 || echo \"[MODEL-CACHE] Cache directory is empty (will download during tests)\"\n \necho \"[MODEL-CACHE] Model pre-download completed in ${CACHE_DURATION}s (or skipped with warning)\"\n",

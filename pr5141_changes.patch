veragerc scopes coverage to src/codex/rag only,\n# preventing the global .coveragerc `source=src` from diluting the line-rate.\n# (S235 fix: on main branch `--cov=src` was measuring all of src/ with only\n# RAG tests running \u2192 5 % line-rate; this config isolates the RAG module.)\n \necho \"[TEST-RUN] ========== Starting Test Execution ==========\"\nTEST_START=$(date +%s)\nTEST_START_ISO=$(date -u +'%Y-%m-%d %H:%M:%S UTC')\necho \"[TEST-RUN] Start time: $TEST_START_ISO\"\necho \"\"\n \n# Run tests with comprehensive output\nif timeout 3300 \"$PYTHON_BIN\" -m pytest tests/test_rag_*.py tests/rag/ \\\n  -v \\\n  --tb=short \\\n  --timeout=300 \\\n  --timeout-method=signal \\\n  --cov=src/codex/rag \\\n  --cov-config=tests/rag/.coveragerc \\\n  --cov-report=xml \\\n  --cov-report=html \\\n  --cov-report=term-missing 2>&1 | tee /tmp/test_output.log; then\n  TEST_EXIT=0\n  TEST_STATUS=\"PASSED\"\n  echo \"[TEST-RUN] \u2705 Tests PASSED\"\nelse\n  TEST_EXIT=$?\n  TEST_STATUS=\"FAILED\"\n  echo \"[TEST-RUN] \u274c Tests FAILED with exit code $TEST_EXIT\"\nfi\nTEST_END=$(date +%s)\nTEST_END_ISO=$(date -u +'%Y-%m-%d %H:%M:%S UTC')\nTEST_DURATION=$((TEST_END - TEST_START))\nTEST_DURATION_MIN=$((TEST_DURATION / 60))\nTEST_DURATION_SEC=$((TEST_DURATION % 60))\n \necho \"\"\necho \"[TEST-RUN] ========== Test Execution Summary ==========\"\necho \"[TEST-RUN] End time: $TEST_END_ISO\"\necho \"[TEST-RUN] Duration: ${TEST_DURATION_MIN}m ${TEST_DURATION_SEC}s\"\necho \"[TEST-RUN] Status: $TEST_STATUS\"\necho \"\"\n \n# Analyze test output for patterns\nif grep -q \"FAILED\" /tmp/test_output.log; then\n  FAILED_COUNT=$(grep -c \"^FAILED\" /tmp/test_output.log)\n  echo \"[TEST-RUN] Failed tests: $FAILED_COUNT\"\nfi\n \nif grep -q \"passed\" /tmp/test_output.log; then\n  # Extract summary line\n  grep \"passed\" /tmp/test_output.log | tail -1 | sed 's/^/[TEST-RUN] /'\nfi\n \necho \"\"\necho \"[TEST-RUN] ========== Artifact Verification ==========\"\n \nif [ -f coverage.xml ]; then\n
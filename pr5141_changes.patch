00\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nif (existingComment) {\n  // Idempotent: skip if same marker already present (same alert count)\n  if (existingComment.body.includes(QUALITY_MARKER)) {\n    console.log(`Quality section for SHA ${headShort} already up-to-date \u2014 skipping.`);\n    return;\n  }\n  // Remove any previous quality section (different alert count) and re-append.\n  // Regex matches the exact marker format: <!-- ci-code-quality:{sha12}:{N} -->\n  // {12} is intentional: headShort is always sha.slice(0,12) \u2014 exactly 12 hex chars.\n  const withoutOldQuality = existingComment.body.replace(\n    /\\n\\n---\\n\\n<!-- ci-code-quality:[a-f0-9]{12}:\\d+ -->[^]*$/,\n    ''\n  );\n  const updated = (withoutOldQuality.trimEnd() + qualitySection).slice(0, 65536);\n  await github.rest.issues.updateComment({\n    owner, repo, comment_id: existingComment.id, body: updated,\n  });\n  console.log(`\u2705 Appended/updated ${alerts.length} code scanning alert(s) in rescue comment for SHA ${headShort}.`);\n} else {\n  // No rescue comment yet (CI passed but quality issues found) \u2014 create standalone\n  const standaloneBody = [\n    rescueMarker,\n    `## \ud83d\udd35 Code Quality Findings \u2014 @copilot Fix Required`,\n    ``,\n    `**Branch:** \\`${context.payload.workflow_run.head_branch}\\` | **Commit:** \\`${headSha}\\``,\n    ``,\n    `@copilot Code scanning found **${alerts.length} alert(s)** on commit \\`${headShort}\\` that must be resolved before this PR can merge.`,\n    ``,\n    `<details><summary>\ud83d\udccb Steps to resolve</summary>`,\n    ``,\n    `1. Load \\`.codex/CODEBASE_AGENCY_POLICY.md\\` (\u00a70 \u2014 fix ALL issues found)`,\n    `2. Review each alert linked below and apply the minimal fix`,\n    `3. Push the fix and confirm t
}\"\n\n# \u2500\u2500 Dedup guard: skip if ANY @copilot rescue/escalation/healing comment\n# was posted < 30 min ago \u2014 unified across all three posting workflows\n# (ci-rescue.yml, iterative-self-healing-ci.yml, copilot-iterative-self-healing.yml).\n# Previously each workflow only checked its own marker, allowing all three\n# to fire simultaneously for the same failure and each summon the agent\n# independently.  The shared check ensures the first poster wins and the\n# others are silenced for the 30-minute cooldown window.\nESCALATION_MARKER=\"<!-- copilot-escalation:${PR_NUMBER} -->\"\nJQ_EXPR='[.comments[] | select(.body | test(\"<!-- (ci-rescue-sha|copilot-escalation|copilot-healing):\"))] | last | .createdAt // empty'\nLAST_ESC=$(gh pr view \"$PR_NUMBER\" --repo Aries-Serpent/_codex_ \\\n  --json comments --jq \"$JQ_EXPR\" \\\n  2>/dev/null || echo \"\")\nif [ -n \"$LAST_ESC\" ]; then\n  NOW_TS=$(date +%s)\n  LAST_TS=$(date -d \"${LAST_ESC}\" +%s 2>/dev/null || echo \"0\")\n  ELAPSED=$(( NOW_TS - LAST_TS ))\n  if [ \"$ELAPSED\" -lt 1800 ]; then\n    echo \"::notice::Skipping copilot-escalation \u2014 a rescue/escalation/healing comment was already posted ${ELAPSED}s ago (< 30 min cooldown)\"\n    echo \"### \u23ed\ufe0f Copilot Escalation Skipped (cooldown \u2014 shared marker)\" >> \"$GITHUB_STEP_SUMMARY\"\n    echo \"An @copilot escalation was already posted ${ELAPSED}s ago. Cooldown: 1800s.\" >> \"$GITHUB_STEP_SUMMARY\"\n    exit 0\n  fi\nfi\n\n# Build structured @copilot prompt per proposal \u00a76 (Phase 8 P3: includes cross-PR correlation)\ncat > \"${RUNNER_TEMP}/copilot_escalation.txt\" <<COPILOT_EOF\n<!-- copilot-escalation:${PR_NUMBER} -->\n## \ud83e\udd16 Copilot Self-Healing Escalation\n\nAuto-fix patterns exhausted for this failure. Requesting Copilot Coding Agent assistance.\n\n@copilot Fix the failing CI workflow \"${WORKFLOW_NAME}\" (run #${RUN_ID}).\n\n**Context:**\n- Workflow: \\`${WORKFLOW_NAME}\\`\n- Failed run: [${RUN_ID}](${RUN_URL})\n
OUR_AGO=$(date -u -d '1 hour ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \\\n  || date -u -v-1H +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \\\n  || echo \"\")\nif [ -n \"$ONE_HOUR_AGO\" ] && [ -n \"$HEAD_BRANCH\" ]; then\n  RECENT=$(gh api \\\n    \"/repos/${GITHUB_REPOSITORY}/actions/workflows/iterative-self-healing-ci.yml/runs?branch=${HEAD_BRANCH}&per_page=50&created=>=${ONE_HOUR_AGO}\" \\\n    --jq '.total_count' 2>/dev/null || echo \"0\")\n  if [ \"$RECENT\" -ge \"$MAX_PER_HOUR\" ]; then\n    echo \"::warning::Self-healing run cap reached: ${RECENT} runs in the last hour on ${HEAD_BRANCH} (max ${MAX_PER_HOUR}). Skipping to break cascade (issue #3860 SELF_HEALING_001).\"\n    echo \"skip=true\" >> \"$GITHUB_OUTPUT\"\n    echo \"### \ud83d\uded1 Cascade Brake Activated\" >> \"$GITHUB_STEP_SUMMARY\"\n    echo \"Run cap: **${RECENT}** healer runs in the past hour on \\`${HEAD_BRANCH}\\` (max ${MAX_PER_HOUR}).\" >> \"$GITHUB_STEP_SUMMARY\"\n    echo \"Skipping this run to break self-healing cascade (SELF_HEALING_001).\" >> \"$GITHUB_STEP_SUMMARY\"\n    echo \"See: [issue #3860](https://github.com/${GITHUB_REPOSITORY}/issues/3860)\" >> \"$GITHUB_STEP_SUMMARY\"\n    exit 0\n  fi\nfi\necho \"skip=false\" >> \"$GITHUB_OUTPUT\"\n",

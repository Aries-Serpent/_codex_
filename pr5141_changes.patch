+            "script": "const [owner, repo] = process.env.REPO.split('/');\nconst dryRun        = process.env.DRY_RUN === 'true';\nconst mode          = process.env.MODE;\nconst highVolumeThreshold = parseInt(process.env.HIGH_VOLUME_THRESHOLD || '10', 10);\nconst configuredMaxPasses = parseInt(process.env.HIGH_VOLUME_MAX_PASSES || '6', 10);\nconst passDelayMs = parseInt(process.env.PASS_DELAY_MS || '12000', 10);\nconst activeAgentHint = (process.env.ACTIVE_AGENT_HINT || '').toLowerCase();\n\n// \u2500\u2500 Helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// ALWAYS-ON: Copilot is mandated to approve on behalf of the human admin.\n// No opt-in labels or PR body checkboxes are required.\nasync function isEnabled(_prNum) {\n  return true;\n}\n\nasync function getHeadSha(prNum) {\n  const { data: pr } = await github.rest.pulls.get({\n    owner, repo, pull_number: parseInt(prNum),\n  });\n  return pr.head.sha;\n}\n\nasync function listActionRequiredRuns(headSha) {\n  let allRuns = [], page = 1;\n  while (true) {\n    const { data } = await github.rest.actions.listWorkflowRunsForRepo({\n      owner, repo, status: 'action_required',\n      head_sha: headSha, per_page: 100, page,\n    });\n    allRuns = allRuns.concat(data.workflow_runs);\n    if (data.workflow_runs.length < 100) break;\n    page++;\n  }\n  return allRuns;\n}\n\nasync function approvePR(prNum, headSha) {\n  core.info(`\\n\u2500\u2500 PR #${prNum} @ ${headSha.slice(0,12)} \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500`);\n\n  // Enumerate action_required runs for this SHA\n  let allRuns = await listActionRequiredRuns(headSha);\n\n  core.info(`   Found ${allRuns.length} run(s) with status=action_required`);\n  if (allRuns.length === 0) {\n    core.info('   Nothing to approve.');\n    return { prNum, headSha, approved: 0, skipped: 0, errors: 0, results: [] };\n  }\n\n  let approved = 0, skipped = 0, errors = 0;\n  const results = [];\n\n  const activeCopilotSession = activeAgentHint === 'requested' || activeAgentHint === 'in_progress';\n  const maxPasses = (allRuns.length >= highVolumeThreshold || activeCopilotSession)\n    ? Math.max(2, configuredMaxPasses)\n    : 1;\n  if (maxPasses > 1) {\n    if (activeCopilotSession) {\n      core.info(`   Active Copilot agent session detected (${activeAgentHint}). Running up to ${maxPasses} approval passes.`);\n    } else {\n      core.info(`   High-volume queue detected (>=${highVolumeThreshold}). Running up to ${maxPasses} approval passes.`);\n    }\n  }\n\n  const processedRunIds = new Set();\n  for (let pass = 1; pass <= maxPasses; pass++) {\n    if (pass > 1) {\n      await new Promise(resolve => setTimeout(resolve, passDelayMs));\n      allRuns = await listActionRequiredRuns(headSha);\n      core.info(`   Pass ${pass}/${maxPasses}: found ${allRuns.length} remaining action_required run(s).`);\n      if (allRuns.length === 0) break;\n    }\n\n    for (const run of allRuns) {\n      if (processedRunIds.has(run.id)) continue;\n      processedRunIds.add(run.id);\n\n      const label = `${run.name || run.workflow_id} (run #${run.id})`;\n      if (dryRun) {\n        core.info(`[DRY] Would approve: ${label}`);\n        results.push({ label, status: '\ud83d\udd0d dry-run' });\n        approved++;\n        continue;\n      }\n      try {\n        await github.rest.actions.approveWorkflowRun({ owner, repo, run_id: run.id });\n        core.info(`\u2705 Approved: ${label}`);\n        results.push({ label, status: '\u2705 approved' });\n        approved++;\n      } catch (e) {\n        if (e.status === 422 || e.status === 409) {\n          core.info(`\u23ed\ufe0f  Already processed: ${label}`);\n          results.push({ label, status: '\u23ed\ufe0f already processed' });\n          skipped++;\n        } else if (e.message && e.message.includes('not from a fork pull request')) {\n          // Same-repo PRs: approveWorkflowRun may return this message.\n          // Fallback: re-run the workflow run via REST using the same token.\n          core.info(`\ud83d\udd04 Same-repo PR \u2014 using REST rerun fallback for: ${label}`);\n          try {\n            await github.request('POST /repos/{owner}/{repo}/actions/runs/{run_id}/rerun', {\n              owner,\n              repo,\n              run_id: run.id,\n            });\n            core.info(`\u2705 REST rerun requested: ${label}`);\n            results.push({ label, status: '\u2705 rerun (same-repo)' });\n            approved++;\n          } catch (rerunErr) {\n            core.info(`\u23ed\ufe0f  REST rerun skipped (may already be approved): ${label}`);\n            results.push({ label, status: '\u23ed\ufe0f rerun skipped' });\n            skipped++;\n          }\n        } else {\n          core.warning(`\u274c Failed to approve ${label}: ${e.message}`);\n          results.push({ label, status: `\u274c error: ${e.message}` });\n          errors++;\n        }\n      }\n    }\n  }\n  return { prNum, headSha, approved, skipped, errors, results };\n}\n\n// \u2500\u2500 Build target list \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet targets = [];  // [{prNum, headSha}]\nif (mode === 'schedule') {\n  const prNums = process.env.PR_LIST.trim().split(/\\s+/).filter(Boolean);\n  core.info(`\u23f0 Schedule sweep (always-on): ${prNums.length} open PR(s) \u2014 ${prNums.join(', ')}`);\n  for (const prNum of prNums) {\n    // For schedule, label presence already confir
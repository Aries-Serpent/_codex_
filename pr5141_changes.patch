+            "script": "// Missed-trigger guard (S221 AfterMath fix):\n// When Copilot reacts \ud83d\udc40 to a rescue comment but no session starts\n// (e.g., a push invalidates the queued session before it can begin),\n// session-done PATH A never fires. This step fires on every push and\n// independently scans for unanswered rescue comments.\nconst dryRun = (process.env.DRY_RUN || 'false') === 'true';\n\n// S144 fix: If this push was made by a Copilot agent bot, the session\n// is actively running. The session will post \"Resolved at SHA\" when it\n// finishes. Firing a retrigger mid-session creates competing sessions.\n// Human approval is pre-granted via COPILOT_AGENT_AUTH_ENABLED=true and\n// \ud83d\udcb0 Cost Proposal Approved \u2014 sessions start immediately, no gate needed.\nconst COPILOT_PUSH_ACTORS = new Set([\n  'copilot-swe-agent[bot]', 'github-copilot[bot]', 'copilot[bot]',\n]);\nif (COPILOT_PUSH_ACTORS.has(context.actor)) {\n  core.info(`Push actor is Copilot agent (${context.actor}) \u2014 session is active. Skipping missed-trigger guard to avoid competing retriggers. Pre-approval: COPILOT_AGENT_AUTH_ENABLED=true.`);\n  return;\n}\n\n// Find the open PR for this branch\nlet prNumber = parseInt(process.env.PR_NUMBER || '0', 10);\nif (!prNumber) {\n  try {\n    const branchName = context.ref_name\n        || (context.payload.ref || '').replace('refs/heads/', '')\n        || '';\n    const prs = await github.rest.pulls.list({\n      owner: context.repo.owner,\n      repo: context.repo.repo,\n      state: 'open',\n      head: `${context.repo.owner}:${branchName}`,\n      per_page: 1,\n    });\n    prNumber = prs.data[0]?.number || 0;\n  } catch(e) {\n    core.info(`Could not find open PR: ${e.message}`);\n    return;\n  }\n}\nif (!prNumber) {\n  core.info('No open PR found for this push \u2014 skipping missed-trigger guard.');\n  return;\n}\n\n// S226 fix: use GraphQL `last: 100` to get the NEWEST 100 comments.\n// The prior REST issues.listComments(per_page: 30) returned the OLDEST\n// 30 comments (ascending order), causing dedup to miss retrigger markers\n// and Copilot \"Fixed in\" responses that accumulated in newer comments.\n// This caused the guard to re-post the same retrigger on every push.\nlet comments = [];\ntry {\n  const gql = await github.graphql(\n    `query($owner: String!, $repo: String!, $pr: Int!) {\n      repository(owner: $owner, name: $repo) {\n        pullRequest(number: $pr) {\n          comments(last: 100) {\n            nodes {\n              databaseId\n              createdAt\n              url\n              body\n              author { login }\n            }\n          }\n        }\n      }\n    }`,\n    {\n      owner: context.repo.owner,\n      repo:  context.repo.repo,\n      pr:    prNumber,\n    }\n  );\n  comments = gql?.repository?.pullRequest?.comments?.nodes || [];\n} catch(e) {\n  core.info(`Could not fetch PR comments: ${e.message}`);\n  return;\n}\n\n// Find unanswered rescue comments.\n// Unified marker format (S294): <!-- ci-rescue-sha:{pr_number}:{sha12} -->\n//   All workflows now use this single canonical format.\n//   Posted by scripts/ci/post_rescue_comment.py \u2014 called by every\n//   rescue-comment job via actions/checkout@v7 + python step.\n//   SHA-scoped: multiple workflows failing on the same commit APPEND\n//   to the same comment rather than posting new threads.\n//\n// Legacy formats (still recognised for backward compat with older comments):\n//   <!-- ci-rescue:NNN -->              (pre-S294 PR-scoped)\n//   <!-- ci-rescue:NNN:sha12chars -->    (pre-S294 SHA-scoped)\n//\n// An \"answered\" rescue comment already has:\n//   (a) a <!-- session-done-retrigger --> dedup marker for its rescue ID, OR\n//   (b) a Copilot agent reply containing resolution language after it.\n// Matches unified and all legacy formats:\n//   <!-- ci-rescue-sha:3854:abc123def456 --> (S294 canonical \u2014 validate.yml et al)\n//   <!-- ci-rescue:3854 -->                  (legacy PR-scoped)\n//   <!-- ci-rescue:3854:abc123def456 -->      (legacy SHA-scoped)\nconst rescueMarkerRe   = /<!--\\s*ci-rescue(?:-sha)?:\\d+(?::[0-9a-f]+)?\\s*-->/;\nconst retriggerMarkerRe = /<!--\\s*session-done-retrigger\\s*-->/;\n// Only match actual Copilot agent logins \u2014 NOT github-actions[bot], which\n// posts the rescue comments themselves (matching it gave false-positive hasResponse).\nconst COPILOT_AGENT_LOGINS = new Set([\n  'copilot-swe-agent[bot]', 'github-copilot[bot]', 'copilot[bot]', 'copilot',\n]);\n\n// S239 fix: find the LATEST rescue comment regardless of previous retriggers.\n// The old approach (retriggerMarkers set) permanently blocked re-triggering\n// the same rescue ID \u2014 even when GitHub silently dropped the queued session\n// after a new commit was pushed. Now we let hasResponse and the\n// Copilot-acted-after-retrigger check handle deduplication correctly.\nlet latestRescue = null;\nfor (const c of comments) {\n  const body = c.body || '';\n  if (rescueMarkerRe.test(body)) {\n    // Extract rescue ID from PR-scoped, SHA-scoped, or -sha-suffixed marker.\n    const markerMatch = body.match(/<!--\\s*ci-rescue(?:-sha)?:(\\d+(?::[0-9a-f]+)?)\\s*-->/);\n    const rescueId = markerMatch ? markerMatch[1] : String(c.databaseId);\n    // Always update latestRescue \u2014 we want the LAST rescue comment in the list.\n    latestRescue = { id: rescueId, commentId: c.databaseId, url: c.url || '', createdAt: c.createdAt || null, body };\n  }\n}\n\nif (!latestRescue) {\n  core.info('No rescue comments found \u2014 missed-trigger guard: nothing to do.');\n  return;\n}\n\n// S244 dedup: if the latest rescue comment is an RCA comment (Channel B,\n// SHA-scoped) that already contains a direct @copilot invocation, the RCA\n// itself IS the trigger \u2014 no additional retrigger is needed.\n// Allow a retrigger only if the RCA is older than 45 minutes AND still has\n// no Copilot response (session was permanently dropped by GitHub).\nconst rcaHasCopilotCall = /@copilot(?:\\+[a-z0-9.\\-]+)?/i.test(latestRescue.body);\nif (rcaHasCopilotCall) {\n  // createdAt is now populated by the GraphQL query (was missing before this fix,\n  // so ageMs was always Infinity and the grace period never triggered).\n  const createdAt = latestRescue.createdAt ? new Date(latestRescue.createdAt) : null;\n  const ageMs = createdAt ? Date.now() - createdAt.getTime() : Infinity;\n  const GRACE_MS = 45 * 60 * 1000; // 45 minutes\n  if (ageMs < GRACE_MS) {\n    core.info(\n      `Latest rescue comment already invokes @copilot directly and is only ` +\n      `${Math.round(ageMs / 60000)} min old \u2014 deferring retrigger (RCA is still live).`\n    );\n    return;\n  }\n  core.info(\n    `Latest rescue comment invokes @copilot but is ${Math.round(ageMs / 60000)} min old ` +\n    `(>${Math.round(GRACE_MS / 60000)} min grace period) \u2014 checking if session responded.`\n  );\n}\n\n// Check if there is a Copilot agent response AFTER the rescue comment that\n// explicitly resolves it. Accept both \"X in SHA\" and \"X at SHA\" forms since\n// Copilot responses vary between \"Fixed in <commit>\" and \"Fixed at <commit>\".\n// Using COPILOT_AGENT_LOGINS avoids false-positives from github-actions[bot]\n// CI update comments that are not resolution responses.\nconst rescueIndex = comments.findIndex(c => c.databaseId === latestRescue.commentId);\nconst hasResponse = rescueIndex >= 0 && comments.slice(rescueIndex + 1).some(c => {\n  const login = c.author?.login || '';\n  const body  = (c.body || '').toLowerCase();\n  return (\n    COPILOT_AGENT_LOGINS.has(login) &&\n    (\n      body.includes('fixed in')    || body.includes('fixed at')    ||\n      body.includes('addressed in') || body.includes('addressed at') ||\n      body.includes('resolved in')  || body.includes('resolved at')\n    )\n  );\n});\n\nif (hasResponse) {\n  core.info(`Rescue comment ${latestRescue.id} already has a Copilot resolution response \u2014 skipping.`);\n  return;\n}\n\n// S221-R1: Commit-resolution check.\n// If a Copilot-agent commit was pushed to this PR branch AFTER the rescue\n// comment was created, a session ran and addressed the issue.  Skip the\n// retrigger to avoid waking a new session for an already-resolved problem.\n// This closes the gap where Copilot pushes a fix commit but the closing\n// comment uses language not covered by the \"fixed in/at\" regex above.\nif (latestRescue.createdAt) {\n  let prCommits = [];\n  try {\n    const commitsResp = await github.rest.pulls.listCommits({\n      owner: context.repo.owner,\n      repo:  context.repo.repo,\n      pull_number: prNumber,\n      per_page: 30,\n    });\n    prCommits = commitsResp.data || [];\n  } catch(e) {\n    core.info(`Could not fetch PR commits for commit-resolution check: ${e.message}`);\n  }\n  const rescueCreatedAt = new Date(latestRescue.createdAt);\n  const resolvedByCommit = prCommits.some(c => {\n    // Check both the GitHub author login and the git committer date.\n    const authorLogin    = c.author?.login    || '';\n    const committerLogin = c.committer?.login || '';\n    const committedAt    = c.commit?.committer?.date\n      ? new Date(c.commit.committer.date) : null;\n    return (\n      (COPILOT_AGENT_LOGINS.has(authorLogin) || COPILOT_AGENT_LOGINS.has(committerLogin)) &&\n      committedAt !== null &&\n      committedAt > rescueCreatedAt\n    );\n  });\n  if (resolvedByCommit) {\n    core.info(\n      `Rescue ${latestRescue.id}: a Copilot-agent commit was pushed after ` +\n      `${latestRescue.createdAt} \u2014 treating as resolved, skipping retrigger.`\n    );\n    return;\n  }\n}\n\n// Dedup: if a retrigger was already posted for this rescue, only skip posting\n// ANOTHER retrigger if Copilot has taken some action (posted any comment) after\n// that retrigger. If Copilot has NOT acted after the retrigger, the queued\n// session was silently dropped (e.g. a new commit push invalidated it), so we\n// allow a re-fire. This prevents the \"permanently blocked\" bug where a single\n// retrigger post caused the guard to never fire again for the same rescue.\nconst commentsAfterRescue = rescueIndex >= 0 ? comments.slice(rescueIndex + 1) : [];\nconst retriggersForRescue = commentsAfterRescue.filter(c => {\n  const body = c.body || '';\n  return retriggerMarkerRe.test(body) && body.includes(`rescue \\`${latestRescue.id}\\``);\n});\n\nif (retriggersForRescue.length > 0) {\n  const lastRetrigger = retriggersForRescue[retriggersForRescue.length - 1];\n  const lastRetriggerDbId = lastRetrigger.databaseId;\n  const lastRetriggerIndex = comments.findIndex(c => c.databaseId === lastRetriggerDbId);\n  // Check if any Copilot agent comment appeared AFTER the last retrigger.\n  // If yes, Copilot is actively handling it \u2014 don't spam another retrigger.\n  const copilotActedAfterRetrigger = lastRetriggerIndex >= 0 &&\n    comments.slice(lastRetriggerIndex + 1).some(c =>\n      COPILOT_AGENT_LOGINS.has(c.author?.login || '')\n    );\n  if (copilotActedAfterRetrigger) {\n    core.info(`Retrigger already posted for rescue ${latestRescue.id} and Copilot has acted since \u2014 not re-triggering.`);\n    return;\n  }\n  // S144 fix: Safety cap \u2014 if \u22653 retriggers already posted for this rescue ID,\n  // halt to prevent infinite loops. The pre-approval (COPILOT_AGENT_AUTH_ENABLED=true,\n  // \ud83d\udcb0 Cost Proposal Approved) is in effect; operator review needed if sessions\n  // are still not starting after 3 retriggers.\n  if (retriggersForRescue.length >= 3) {\n    core.warning(`Safety cap: ${retriggersForRescue.length} retriggers already posted for rescue ${latestRescue.id} \u2014 halting. Pre-approval is active; operator review needed if sessions are not starting.`);\n    return;\n  }\n  // No Copilot action after the retrigger \u2014 session was silently dropped.\n  core.info(`Previous retrigger for rescue ${latestRescue.id} had no Copilot action \u2014 re-firing (session was dropped).`);\n}\n\n// Post re-tr
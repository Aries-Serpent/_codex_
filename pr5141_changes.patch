ough ALL PR comments to find the existing upsert marker.\n# PRs with >100 comments require pagination; a single page=1&per_page=100\n# would miss comments on later pages, silently creating a duplicate.\n# Cap at MAX_PAGES to prevent unbounded API calls on very large PRs.\nEXISTING_ID=\"\"\nPAGE=1\nMAX_PAGES=50\nwhile [ -z \"${EXISTING_ID}\" ] && [ \"${PAGE}\" -le \"${MAX_PAGES}\" ]; do\n  BATCH=$(gh api \\\n    \"/repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments?per_page=100&page=${PAGE}\" \\\n    --jq \".[] | select(.body | contains(\\\"${MARKER}\\\")) | .id\" \\\n    2>/dev/null || echo \"\")\n  if [ -n \"${BATCH}\" ]; then\n    EXISTING_ID=$(echo \"${BATCH}\" | head -1)\n    break\n  fi\n  # Stop if the last page returned fewer than 100 entries (no more pages).\n  COUNT=$(gh api \\\n    \"/repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments?per_page=100&page=${PAGE}\" \\\n    --jq 'length' 2>/dev/null || echo \"0\")\n  [ \"${COUNT}\" -lt 100 ] && break\n  PAGE=$((PAGE + 1))\ndone\nif [ -z \"${EXISTING_ID}\" ] && [ \"${PAGE}\" -gt \"${MAX_PAGES}\" ]; then\n  echo \"\u26a0\ufe0f  Reached max page limit (${MAX_PAGES}) searching for existing prompt comment; will create new.\"\nfi\n\nif [ -n \"${EXISTING_ID}\" ]; then\n  # Update in-place; surface error if PATCH fails so CI shows failure.\n  gh api --method PATCH \\\n    \"/repos/${GITHUB_REPOSITORY}/issues/comments/${EXISTING_ID}\" \\\n    --field \"body=@${BODY_FILE}\" \\\n    || { echo \"\u274c Failed to update comment #${EXISTING_ID}\"; exit 1; }\n  echo \"\u2705 Updated existing @copilot prompt (comment #${EXISTING_ID}) on PR #${PR_NUMBER}\"\n  echo \"### \u2705 @copilot prompt updated on PR #${PR_NUMBER} (comment #${EXISTING_ID})\" >> \"$GITHUB_STEP_SUMMARY\"\nelse\n  gh pr comment \"${PR_NUMBER}\" \\\n    --repo \"${{ github.repository }}\" \\\n    --body-file \"${BODY_FILE}\"\n  echo \"\u2705 Posted @copilot self-healing prompt on PR #${PR_NUMBER}\"\n  echo \"### \u2705 @copilot prompt posted on PR 
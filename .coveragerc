[run]
branch = True
parallel = True
source = src
omit =
    */__init__.py
    */tests/*
    */.venv/*
    */site-packages/*

[report]
show_missing = True
skip_empty = True
# Note: fail_under removed - use pyproject.toml [tool.coverage.report] as single source of truth
precision = 2
skip_covered = True
exclude_also =
    pragma: no cover
    raise NotImplementedError

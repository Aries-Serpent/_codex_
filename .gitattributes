# Git attributes for _codex_ repository
# See: https://git-scm.com/docs/gitattributes

# Default behavior: normalize line endings to LF on checkin, convert to native on checkout
* text=auto eol=lf

# Windows-specific files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code files
*.py text diff=python
*.pyx text diff=python
*.pyi text diff=python
*.js text
*.ts text
*.jsx text
*.tsx text
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text
*.conf text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf

# Documentation
*.md text diff=markdown
*.rst text
*.txt text
*.adoc text

# Append-only CI accountability files — use union merge to prevent conflicts
# when the nightly main sweep and feature branches both prepend new entries.
docs/accountability/AGENT_ACCOUNTABILITY_REPORT.md merge=union
.codex/aftermath/pda_iterations.jsonl merge=union

# Configuration
Dockerfile text
docker-compose*.yml text
*.dockerignore text
Makefile text
*.mk text

# Binary files (mark as binary to prevent diff attempts)
*.pkl binary
*.pt binary
*.pth binary
*.safetensors binary
*.onnx binary
*.pb binary
*.h5 binary
*.hdf5 binary
*.npz binary
*.npy binary
*.parquet binary
*.arrow binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.7z binary
*.rar binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Media
*.mp4 binary
*.mov binary
*.avi binary
*.mp3 binary
*.wav binary

# Linguist language detection overrides
*.ipynb linguist-documentation
*.md linguist-detectable=true
*.yaml linguist-language=YAML
*.yml linguist-language=YAML
docs/** linguist-documentation
examples/** linguist-documentation
tests/** linguist-vendored=false
*.min.js linguist-generated=true
*.min.css linguist-generated=true

# Vendored dependencies (exclude from language statistics)
**/node_modules/** linguist-vendored
**/vendor/** linguist-vendored
**/.venv/** linguist-vendored
**/venv/** linguist-vendored

# Generated files (exclude from diffs and language statistics)
*.lock linguist-generated=true
*.pyc linguist-generated=true
**/__pycache__/** linguist-generated=true
*.egg-info/** linguist-generated=true
build/** linguist-generated=true
dist/** linguist-generated=true
*.cache/** linguist-generated=true
.mypy_cache/** linguist-generated=true
.pytest_cache/** linguist-generated=true
.ruff_cache/** linguist-generated=true
htmlcov/** linguist-generated=true
.coverage linguist-generated=true

# HAR cache files — stored as regular files (no LFS required for small demo HARs)
# Recorded by: .github/workflows/har-capture.yml (Playwright walkthrough)

# Export-ignore (files excluded from export archives)
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
examples/ export-ignore
*.md export-ignore
.editorconfig export-ignore
.pre-commit-config.yaml export-ignore

# Auto-generated metadata files — keep the current branch's version on merge (merge=ours)
# These files are written exclusively by scheduled CI workflows.
# During a 0D_base_ → main merge, main's version is always newer (daily commits land there);
# merge=ours keeps main's copy and discards any stale version from 0D_base_, preventing conflicts.
.codex/agent_context.json                        merge=ours linguist-generated=true
.codex/cognitive_brain/metadata.json             merge=ours linguist-generated=true
.codex/cognitive_brain/workflow_patterns.jsonl   merge=ours linguist-generated=true
.codex/embeddings/codex_index_meta.json          merge=ours linguist-generated=true
docs/admin/GITHUB_VARIABLES_MASTER_GUIDE.md      merge=ours linguist-generated=true
docs/admin/variable_audit_latest.md              merge=ours linguist-generated=true

    "security": {
      "type": "object",
      "description": "Security and secret-masking status",
      "properties": {
        "masking_applied": { 
          "type": "boolean",
          "description": "Whether secret masking was applied to this report"
        },
        "redactions_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of redactions performed"
        },
        "threat_model_version": {
          "type": "string",
          "description": "Version of threat model applied"
        },
        "notes": { 
          "type": "string",
          "description": "Additional security notes or warnings"
        }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "description": "Open questions and answers tracking",
      "items": {
        "type": "object",
        "required": ["id", "category", "priority", "owner", "asked_utc", "status", "question"],
        "properties": {
          "id": { 
            "type": "string",
            "pattern": "^Q-[0-9]{3,}$",
            "description": "Unique question identifier"
          },
          "category": { 
            "type": "string",
            "enum": ["technical", "process", "architecture", "security", "performance", "compliance", "other"],
            "description": "Question category"
          },
          "priority": { 
            "type": "string", 
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "Priority level (P0=Critical, P3=Low)"
          },
          "owner": { 
            "type": "string",
            "description": "Person responsible for answering"
          },
          "asked_utc": { 
            "type": "string", 
            "format": "date-time",
            "description": "When question was raised"
          },
          "status": { 
            "type": "string", 
            "enum": ["Open", "In Review", "Answered", "Deferred"],
            "description": "Current status"
          },
          "answered_utc": { 
            "type": "string", 
            "format": "date-time",
            "description": "When question was answered"
          },
          "question": { 
            "type": "string",
            "description": "Full question text"
          },
          "answer": { 
            "type": "string",
            "description": "Answer or resolution"
          },
          "confidence": { 
            "type": "integer", 
            "minimum": 1, 
            "maximum": 5,
            "description": "Confidence in answer"
          },
          "links": {
            "type": "object",
            "properties": {
              "capability_ids": { "type": "array", "items": { "type": "string" } },
              "finding_ids": { "type": "array", "items": { "type": "string" } },
              "patch_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "description": "Decision log for traceability",
      "items": {
        "type": "object",
        "required": ["id", "title", "context", "chosen", "owner", "date_utc"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-[0-9]{3,}$",
            "description": "Unique decision identifier"
          },
          "title": { 
            "type": "string",
            "description": "Decision title"
          },

2026-01-04T02:29:46.0099273Z             print(f"   ✓ Confidence: {profile_match.confidence:.1%}")
2026-01-04T02:29:46.0100005Z             print(f"   ✓ Reason: {profile_match.reason}")
2026-01-04T02:29:46.0100511Z             
2026-01-04T02:29:46.0100856Z             # Interactive confirmation

2026-01-04T02:29:47.4687572Z                   
2026-01-04T02:29:47.4687876Z               supported_formats = {'.wav', '.mp3', '.flac', '.ogg', '.m4a', '.mp4'}
2026-01-04T02:29:47.4688243Z               
2026-01-04T02:29:47.4688444Z               # Single file
2026-01-04T02:29:47.4688687Z               if path.is_file():
2026-01-04T02:29:47.4688984Z                   if path.suffix.lower() in supported_formats:
2026-01-04T02:29:47.4689303Z                       return [path]
2026-01-04T02:29:47.4689558Z                   else:
2026-01-04T02:29:47.4690022Z                       raise ValueError(f"Unsupported format: {path.suffix}")
2026-01-04T02:29:47.4690373Z                       
2026-01-04T02:29:47.4690610Z               # Directory - recursive scan
2026-01-04T02:29:47.4690907Z               elif path.is_dir():
2026-01-04T02:29:47.4691170Z                   files = []
2026-01-04T02:29:47.4691430Z                   for ext in supported_formats:
2026-01-04T02:29:47.4692079Z                       files.extend(path.rglob(f"*{ext}"))
2026-01-04T02:29:47.4692395Z                   return sorted(files)
2026-01-04T02:29:47.4692654Z                   
2026-01-04T02:29:47.4692854Z               return []

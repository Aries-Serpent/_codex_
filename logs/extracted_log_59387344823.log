2026-01-04T02:24:17.6264339Z                   "rating": review["rating"],  # 1-5 stars
2026-01-04T02:24:17.6264658Z                   "feedback": review["feedback"],
2026-01-04T02:24:17.6264971Z                   "approved": review["rating"] >= 3,
2026-01-04T02:24:17.6265298Z                   "reviewed_at": datetime.now().isoformat()
2026-01-04T02:24:17.6265593Z               }
2026-01-04T02:24:17.6265787Z               
2026-01-04T02:24:17.6266021Z               contribution["reviews"].append(review_entry)
2026-01-04T02:24:17.6266324Z               
2026-01-04T02:24:17.6266538Z               # Check if ready for publication
2026-01-04T02:24:17.6266845Z               if len(contribution["reviews"]) >= 3:
2026-01-04T02:24:17.6267231Z                   avg_rating = np.mean([r["rating"] for r in contribution["reviews"]])
2026-01-04T02:24:17.6267617Z                   if avg_rating >= 3.5:
2026-01-04T02:24:17.6267920Z                       self._publish_pattern(contribution)
2026-01-04T02:24:17.6268338Z                       
2026-01-04T02:24:17.6268562Z               return {
2026-01-04T02:24:17.6268805Z                   "contribution_id": contribution_id,
2026-01-04T02:24:17.6269153Z                   "total_reviews": len(contribution["reviews"]),
2026-01-04T02:24:17.6269592Z                   "average_rating": avg_rating if len(contribution["reviews"]) >= 3 else None,
2026-01-04T02:24:17.6270015Z                   "status": contribution["status"]
2026-01-04T02:24:17.6270294Z               }
2026-01-04T02:24:17.6270491Z               
2026-01-04T02:24:17.6270776Z           def get_public_pattern_library(self) -> List[Dict[str, Any]]:
2026-01-04T02:24:17.6271151Z               """Get all published patterns"""

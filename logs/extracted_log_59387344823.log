2026-01-04T02:29:47.4752090Z       ### 2. Intelligent Audio Analyzer
2026-01-04T02:29:47.4752481Z       
2026-01-04T02:29:47.4752733Z       **File**: `src/analysis/intelligent_analyzer.py` (12.8KB)
2026-01-04T02:29:47.4753069Z       
2026-01-04T02:29:47.4753266Z       **AI-Powered Analysis**:
2026-01-04T02:29:47.4753508Z       ```python
2026-01-04T02:29:47.4753732Z       class IntelligentAudioAnalyzer:
2026-01-04T02:29:47.4754088Z           """AI-powered audio analysis for optimal profile selection"""
2026-01-04T02:29:47.4754433Z           
2026-01-04T02:29:47.4754694Z           def analyze_file(self, file_path: Path) -> AudioAnalysis:
2026-01-04T02:29:47.4755060Z               """Comprehensive audio analysis"""
2026-01-04T02:29:47.4755354Z               # Load audio
2026-01-04T02:29:47.4755665Z               audio, sr = librosa.load(str(file_path), sr=None, mono=True)
2026-01-04T02:29:47.4756009Z               
2026-01-04T02:29:47.4756214Z               # Extract features
2026-01-04T02:29:47.4756542Z               features = self._extract_comprehensive_features(audio, sr)
2026-01-04T02:29:47.4756892Z               
2026-01-04T02:29:47.4757091Z               # Classify content
2026-01-04T02:29:47.4757532Z               content_type = self._classify_content(audio, sr, features)
2026-01-04T02:29:47.4757869Z               
2026-01-04T02:29:47.4758070Z               # Detect problems
2026-01-04T02:29:47.4758377Z               problems = self._detect_problems(audio, sr, features)
2026-01-04T02:29:47.4758699Z               
2026-01-04T02:29:47.4758904Z               # Calculate quality score
2026-01-04T02:29:47.4759267Z               quality_score = self._calculate_quality_score(features, problems)
2026-01-04T02:29:47.4759633Z               
2026-01-04T02:29:47.4759837Z               return AudioAnalysis(
2026-01-04T02:29:47.4760110Z                   file_path=file_path,
2026-01-04T02:29:47.4760393Z                   duration=len(audio) / sr,
2026-01-04T02:29:47.4760678Z                   sample_rate=sr,
2026-01-04T02:29:47.4760946Z                   content_type=content_type,
2026-01-04T02:29:47.4761233Z                   features=features,
2026-01-04T02:29:47.4761505Z                   problems=problems,
2026-01-04T02:29:47.4761892Z                   quality_score=quality_score,
2026-01-04T02:29:47.4762205Z                   metadata=self._extract_metadata(file_path)
2026-01-04T02:29:47.4762503Z               )
2026-01-04T02:29:47.4762694Z               
2026-01-04T02:29:47.4762893Z           def _classify_content(
2026-01-04T02:29:47.4763141Z               self,
2026-01-04T02:29:47.4763351Z               audio: np.ndarray,
2026-01-04T02:29:47.4763596Z               sr: int,
2026-01-04T02:29:47.4763822Z               features: Dict[str, Any]
2026-01-04T02:29:47.4764078Z           ) -> str:
2026-01-04T02:29:47.4764305Z               """Classify audio content type"""
2026-01-04T02:29:47.4764608Z               # Extract classification features
2026-01-04T02:29:47.4764909Z               zcr_mean = np.mean(features['zcr'])
2026-01-04T02:29:47.4765298Z               spectral_centroid_mean = np.mean(features['spectral_centroid'])
2026-01-04T02:29:47.4765681Z               tempo = features['tempo']
2026-01-04T02:29:47.4765948Z               
2026-01-04T02:29:47.4766160Z               # Decision tree classification
2026-01-04T02:29:47.4766482Z               if zcr_mean > 0.15 and spectral_centroid_mean > 3000:
2026-01-04T02:29:47.4766806Z                   return "speech"
2026-01-04T02:29:47.4767104Z               elif tempo > 80 and features['has_strong_beat']:
2026-01-04T02:29:47.4767415Z                   return "music"
2026-01-04T02:29:47.4767669Z               elif zcr_mean < 0.05:
2026-01-04T02:29:47.4767931Z                   return "ambient"
2026-01-04T02:29:47.4768175Z               else:
2026-01-04T02:29:47.4768378Z                   return "mixed"
2026-01-04T02:29:47.4768607Z                   
2026-01-04T02:29:47.4768820Z           def _detect_problems(
2026-01-04T02:29:47.4769059Z               self,
2026-01-04T02:29:47.4769267Z               audio: np.ndarray,
2026-01-04T02:29:47.4769631Z               sr: int,
2026-01-04T02:29:47.4769861Z               features: Dict[str, Any]
2026-01-04T02:29:47.4770132Z           ) -> List[str]:
2026-01-04T02:29:47.4770376Z               """Detect audio problems"""
2026-01-04T02:29:47.4770650Z               problems = []
2026-01-04T02:29:47.4770875Z               
2026-01-04T02:29:47.4771075Z               # Check for clipping
2026-01-04T02:29:47.4771344Z               if np.max(np.abs(audio)) > 0.99:
2026-01-04T02:29:47.4771753Z                   problems.append("clipping")
2026-01-04T02:29:47.4772034Z                   
2026-01-04T02:29:47.4772248Z               # Check for low SNR (noisy)
2026-01-04T02:29:47.4772533Z               snr = self._calculate_snr(audio)
2026-01-04T02:29:47.4772807Z               if snr < 20:
2026-01-04T02:29:47.4773058Z                   problems.append("high_noise")
2026-01-04T02:29:47.4773335Z                   
2026-01-04T02:29:47.4773549Z               # Check for hum (50/60 Hz)
2026-01-04T02:29:47.4773839Z               if self._detect_hum(audio, sr):
2026-01-04T02:29:47.4774142Z                   problems.append("electrical_hum")
2026-01-04T02:29:47.4774620Z                   
2026-01-04T02:29:47.4774837Z               # Check for excessive reverb
2026-01-04T02:29:47.4775135Z               if self._detect_reverb(audio, sr) > 0.7:
2026-01-04T02:29:47.4775457Z                   problems.append("excessive_reverb")
2026-01-04T02:29:47.4775746Z                   
2026-01-04T02:29:47.4775966Z               # Check for silence/low volume
2026-01-04T02:29:47.4776259Z               rms = np.sqrt(np.mean(audio**2))
2026-01-04T02:29:47.4776546Z               if rms < 0.01:
2026-01-04T02:29:47.4776806Z                   problems.append("low_volume")
2026-01-04T02:29:47.4777082Z                   
2026-01-04T02:29:47.4777284Z               return problems
2026-01-04T02:29:47.4777522Z               
2026-01-04T02:29:47.4777725Z           def select_profile(
2026-01-04T02:29:47.4777961Z               self,
2026-01-04T02:29:47.4778183Z               analysis: AudioAnalysis,
2026-01-04T02:29:47.4778461Z               aggressive: bool = False
2026-01-04T02:29:47.4778744Z           ) -> ProfileMatch:
2026-01-04T02:29:47.4779044Z               """Select optimal cleaning profile based on analysis"""
2026-01-04T02:29:47.4779397Z               # Load all available profiles
2026-01-04T02:29:47.4779691Z               profiles = self._load_all_profiles()
2026-01-04T02:29:47.4779972Z               
2026-01-04T02:29:47.4780175Z               # Score each profile
2026-01-04T02:29:47.4780429Z               scores = []
2026-01-04T02:29:47.4780667Z               for profile in profiles:
2026-01-04T02:29:47.4781021Z                   score = self._score_profile_match(analysis, profile, aggressive)
2026-01-04T02:29:47.4781411Z                   scores.append((score, profile))
2026-01-04T02:29:47.4781841Z                   
2026-01-04T02:29:47.4782187Z               # Sort by score
2026-01-04T02:29:47.4782483Z               scores.sort(reverse=True, key=lambda x: x[0])
2026-01-04T02:29:47.4782785Z               
2026-01-04T02:29:47.4783000Z               best_score, best_profile = scores[0]
2026-01-04T02:29:47.4783290Z               
2026-01-04T02:29:47.4783499Z               # Generate explanation
2026-01-04T02:29:47.4783852Z               reason = self._explain_profile_selection(analysis, best_profile)
2026-01-04T02:29:47.4784209Z               
2026-01-04T02:29:47.4784404Z               # Get alternatives
2026-01-04T02:29:47.4784659Z               alternatives = [
2026-01-04T02:29:47.4784906Z                   ProfileMatch(
2026-01-04T02:29:47.4785159Z                       profile=profile,
2026-01-04T02:29:47.4785432Z                       confidence=score,
2026-01-04T02:29:47.4785778Z                       reason=self._explain_profile_selection(analysis, profile)
2026-01-04T02:29:47.4786120Z                   )
2026-01-04T02:29:47.4786383Z                   for score, profile in scores[1:4]  # Top 3 alternatives
2026-01-04T02:29:47.4786704Z               ]
2026-01-04T02:29:47.4787031Z               
2026-01-04T02:29:47.4787244Z               return ProfileMatch(
2026-01-04T02:29:47.4787520Z                   profile=best_profile,
2026-01-04T02:29:47.4787806Z                   confidence=best_score,
2026-01-04T02:29:47.4788079Z                   reason=reason,
2026-01-04T02:29:47.4788342Z                   alternatives=alternatives
2026-01-04T02:29:47.4788611Z               )
2026-01-04T02:29:47.4788796Z               
2026-01-04T02:29:47.4789001Z           def _score_profile_match(
2026-01-04T02:29:47.4789255Z               self,
2026-01-04T02:29:47.4789471Z               analysis: AudioAnalysis,
2026-01-04T02:29:47.4789757Z               profile: ProcessingProfile,
2026-01-04T02:29:47.4790040Z               aggressive: bool
2026-01-04T02:29:47.4790279Z           ) -> float:
2026-01-04T02:29:47.4790534Z               """Score how well a profile matches the audio"""
2026-01-04T02:29:47.4790845Z               score = 0.0
2026-01-04T02:29:47.4791067Z               
2026-01-04T02:29:47.4791286Z               # Content type match (40% weight)
2026-01-04T02:29:47.4791875Z               if profile.content_type == analysis.content_type:
2026-01-04T02:29:47.4792204Z                   score += 0.4
2026-01-04T02:29:47.4792470Z               elif profile.content_type == "general":
2026-01-04T02:29:47.4792770Z                   score += 0.2
2026-01-04T02:29:47.4792998Z                   
2026-01-04T02:29:47.4793215Z               # Problem coverage (40% weight)
2026-01-04T02:29:47.4793515Z               problems_covered = sum(
2026-01-04T02:29:47.4793810Z                   1 for problem in analysis.problems
2026-01-04T02:29:47.4794142Z                   if problem in profile.handles_problems
2026-01-04T02:29:47.4794434Z               )
2026-01-04T02:29:47.4794648Z               if analysis.problems:
2026-01-04T02:29:47.4794978Z                   score += 0.4 * (problems_covered / len(analysis.problems))
2026-01-04T02:29:47.4795316Z               else:
2026-01-04T02:29:47.4795570Z                   score += 0.4  # No problems = any profile works
2026-01-04T02:29:47.4795876Z                   
2026-01-04T02:29:47.4796100Z               # Aggressive match (10% weight)
2026-01-04T02:29:47.4796410Z               if aggressive and profile.is_aggressive:
2026-01-04T02:29:47.4796710Z                   score += 0.1
2026-01-04T02:29:47.4796996Z               elif not aggressive and not profile.is_aggressive:
2026-01-04T02:29:47.4797316Z                   score += 0.1
2026-01-04T02:29:47.4797545Z                   
2026-01-04T02:29:47.4797770Z               # Feature compatibility (10% weight)
2026-01-04T02:29:47.4798122Z               feature_match = self._calculate_feature_compatibility(
2026-01-04T02:29:47.4798466Z                   analysis.features,
2026-01-04T02:29:47.4798743Z                   profile.expected_features
2026-01-04T02:29:47.4799015Z               )
2026-01-04T02:29:47.4799224Z               score += 0.1 * feature_match
2026-01-04T02:29:47.4799488Z               
2026-01-04T02:29:47.4799689Z               return score
2026-01-04T02:29:47.4799912Z       ```
2026-01-04T02:29:47.4800094Z       
2026-01-04T02:29:47.4800291Z       **Intelligence Features**:
2026-01-04T02:29:47.4800676Z       - ✅ Content classification (speech/music/mixed)
2026-01-04T02:29:47.4801036Z       - ✅ Problem detection (7 types)
2026-01-04T02:29:47.4801345Z       - ✅ SNR calculation
2026-01-04T02:29:47.4801722Z       - ✅ Hum detection (50/60 Hz)
2026-01-04T02:29:47.4802018Z       - ✅ Reverb detection
2026-01-04T02:29:47.4802301Z       - ✅ Clipping detection
2026-01-04T02:29:47.4802599Z       - ✅ Profile scoring with explanation
2026-01-04T02:29:47.4802869Z       
2026-01-04T02:29:47.4803045Z       ---
2026-01-04T02:29:47.4803229Z       
2026-01-04T02:29:47.4803431Z       ### 3. Adaptive Processing Engine
2026-01-04T02:29:47.4803696Z       
2026-01-04T02:29:47.4803919Z       **File**: `src/core/adaptive_processor.py` (14.6KB)
2026-01-04T02:29:47.4804221Z       
2026-01-04T02:29:47.4804557Z       **Smart Processing with Quality Feedback**:
2026-01-04T02:29:47.4804853Z       ```python
2026-01-04T02:29:47.4805084Z       class AdaptiveAudioProcessor:
2026-01-04T02:29:47.4805444Z           """Adaptive processor that adjusts based on quality feedback"""
2026-01-04T02:29:47.4805800Z           
2026-01-04T02:29:47.4805992Z           def process_file(
2026-01-04T02:29:47.4806224Z               self,
2026-01-04T02:29:47.4806431Z               input_path: Path,
2026-01-04T02:29:47.4806699Z               profile: ProcessingProfile,
2026-01-04T02:29:47.4806998Z               output_dir: Optional[str] = None,
2026-01-04T02:29:47.4807322Z               progress_callback: Optional[Callable] = None,
2026-01-04T02:29:47.4807645Z               max_iterations: int = 3
2026-01-04T02:29:47.4822265Z           ) -> ProcessingResult:
2026-01-04T02:29:47.4822705Z               """
2026-01-04T02:29:47.4822984Z               Process file with adaptive quality refinement
2026-01-04T02:29:47.4823407Z               Will try up to max_iterations to achieve quality target
2026-01-04T02:29:47.4823750Z               """
2026-01-04T02:29:47.4824153Z               # Load audio
2026-01-04T02:29:47.4824482Z               audio, sr = librosa.load(str(input_path), sr=None, mono=True)
2026-01-04T02:29:47.4824839Z               
2026-01-04T02:29:47.4825057Z               best_result = None
2026-01-04T02:29:47.4825317Z               best_quality = 0.0
2026-01-04T02:29:47.4825555Z               
2026-01-04T02:29:47.4825790Z               for iteration in range(max_iterations):
2026-01-04T02:29:47.4826130Z                   # Adjust parameters based on iteration
2026-01-04T02:29:47.4826469Z                   adjusted_params = self._adjust_parameters(
2026-01-04T02:29:47.4826795Z                       profile.parameters,
2026-01-04T02:29:47.4827083Z                       iteration,
2026-01-04T02:29:47.4827331Z                       best_quality
2026-01-04T02:29:47.4827580Z                   )
2026-01-04T02:29:47.4827782Z                   
2026-01-04T02:29:47.4827992Z                   # Process
2026-01-04T02:29:47.4828287Z                   processed_audio = self._apply_processing_chain(
2026-01-04T02:29:47.4828618Z                       audio,
2026-01-04T02:29:47.4828853Z                       sr,
2026-01-04T02:29:47.4829090Z                       adjusted_params,
2026-01-04T02:29:47.4829367Z                       progress_callback
2026-01-04T02:29:47.4829630Z                   )
2026-01-04T02:29:47.4829832Z                   
2026-01-04T02:29:47.4830039Z                   # Quick quality check
2026-01-04T02:29:47.4830387Z                   quality = self._quick_quality_check(audio, processed_audio)
2026-01-04T02:29:47.4830750Z                   
2026-01-04T02:29:47.4830978Z                   if quality > best_quality:
2026-01-04T02:29:47.4831278Z                       best_result = processed_audio
2026-01-04T02:29:47.4831720Z                       best_quality = quality
2026-01-04T02:29:47.4831999Z                       
2026-01-04T02:29:47.4832245Z                   # Stop if quality is good enough
2026-01-04T02:29:47.4832540Z                   if quality >= 8.5:
2026-01-04T02:29:47.4832808Z                       break
2026-01-04T02:29:47.4833035Z                       
2026-01-04T02:29:47.4833264Z               # Save best result
2026-01-04T02:29:47.4833611Z               output_path = self._generate_output_path(input_path, output_dir)
2026-01-04T02:29:47.4834014Z               sf.write(output_path, best_result, sr)
2026-01-04T02:29:47.4834304Z               
2026-01-04T02:29:47.4834527Z               return ProcessingResult(
2026-01-04T02:29:47.4834802Z                   success=True,
2026-01-04T02:29:47.4835114Z                   output_path=output_path,
2026-01-04T02:29:47.4835418Z                   quality_score=best_quality,
2026-01-04T02:29:47.4835722Z                   iterations=iteration + 1,
2026-01-04T02:29:47.4836046Z                   processing_time=time.time() - start_time
2026-01-04T02:29:47.4836354Z               )
2026-01-04T02:29:47.4836677Z               
2026-01-04T02:29:47.4836897Z           def _apply_processing_chain(
2026-01-04T02:29:47.4837168Z               self,
2026-01-04T02:29:47.4837394Z               audio: np.ndarray,
2026-01-04T02:29:47.4837643Z               sr: int,
2026-01-04T02:29:47.4837877Z               params: Dict[str, Any],
2026-01-04T02:29:47.4838165Z               callback: Optional[Callable]
2026-01-04T02:29:47.4838454Z           ) -> np.ndarray:
2026-01-04T02:29:47.4838717Z               """Apply complete processing chain"""
2026-01-04T02:29:47.4839024Z               total_steps = 6
2026-01-04T02:29:47.4839270Z               current_step = 0
2026-01-04T02:29:47.4839509Z               
2026-01-04T02:29:47.4839722Z               def update_progress():
2026-01-04T02:29:47.4839999Z                   nonlocal current_step
2026-01-04T02:29:47.4840280Z                   current_step += 1
2026-01-04T02:29:47.4840540Z                   if callback:
2026-01-04T02:29:47.4840817Z                       callback(current_step, total_steps)
2026-01-04T02:29:47.4841115Z                       
2026-01-04T02:29:47.4841333Z               # Step 1: Trim silence
2026-01-04T02:29:47.4841869Z               if params.get('trim_silence', True):
2026-01-04T02:29:47.4842253Z                   audio = self._trim_silence(audio, params['silence_threshold'])
2026-01-04T02:29:47.4842625Z               update_progress()
2026-01-04T02:29:47.4842865Z               
2026-01-04T02:29:47.4843076Z               # Step 2: Noise reduction
2026-01-04T02:29:47.4843384Z               if params.get('noise_reduction', True):
2026-01-04T02:29:47.4843699Z                   audio = self._reduce_noise(
2026-01-04T02:29:47.4843979Z                       audio,
2026-01-04T02:29:47.4844209Z                       sr,
2026-01-04T02:29:47.4844461Z                       method=params['noise_method'],
2026-01-04T02:29:47.4844788Z                       strength=params['noise_strength']
2026-01-04T02:29:47.4845076Z                   )
2026-01-04T02:29:47.4845296Z               update_progress()
2026-01-04T02:29:47.4845537Z               
2026-01-04T02:29:47.4845778Z               # Step 3: High-pass filter (remove rumble)
2026-01-04T02:29:47.4846120Z               if params.get('highpass_filter', True):
2026-01-04T02:29:47.4846493Z                   audio = self._highpass_filter(audio, sr, params['hp_cutoff'])
2026-01-04T02:29:47.4846860Z               update_progress()
2026-01-04T02:29:47.4847097Z               
2026-01-04T02:29:47.4847314Z               # Step 4: Compression (dynamic range)
2026-01-04T02:29:47.4847629Z               if params.get('compression', False):
2026-01-04T02:29:47.4847943Z                   audio = self._compress_dynamics(
2026-01-04T02:29:47.4848225Z                       audio,
2026-01-04T02:29:47.4848494Z                       threshold=params['comp_threshold'],
2026-01-04T02:29:47.4848814Z                       ratio=params['comp_ratio']
2026-01-04T02:29:47.4849088Z                   )
2026-01-04T02:29:47.4849301Z               update_progress()
2026-01-04T02:29:47.4849541Z               
2026-01-04T02:29:47.4849740Z               # Step 5: EQ
2026-01-04T02:29:47.4849992Z               if params.get('eq', False):
2026-01-04T02:29:47.4850325Z                   audio = self._apply_eq(audio, sr, params['eq_bands'])
2026-01-04T02:29:47.4850665Z               update_progress()
2026-01-04T02:29:47.4850902Z               
2026-01-04T02:29:47.4851102Z               # Step 6: Normalize
2026-01-04T02:29:47.4851418Z               audio = self._normalize(audio, params['target_level'])
2026-01-04T02:29:47.4851860Z               update_progress()
2026-01-04T02:29:47.4852094Z               
2026-01-04T02:29:47.4852296Z               return audio
2026-01-04T02:29:47.4852518Z               
2026-01-04T02:29:47.4852723Z           def _adjust_parameters(
2026-01-04T02:29:47.4852971Z               self,
2026-01-04T02:29:47.4853204Z               base_params: Dict[str, Any],
2026-01-04T02:29:47.4853490Z               iteration: int,
2026-01-04T02:29:47.4853881Z               previous_quality: float
2026-01-04T02:29:47.4854162Z           ) -> Dict[str, Any]:
2026-01-04T02:29:47.4854472Z               """Adaptively adjust parameters based on iteration"""
2026-01-04T02:29:47.4854821Z               params = base_params.copy()
2026-01-04T02:29:47.4855094Z               
2026-01-04T02:29:47.4855293Z               if iteration == 0:
2026-01-04T02:29:47.4855572Z                   # First pass - use base parameters
2026-01-04T02:29:47.4855874Z                   return params
2026-01-04T02:29:47.4856108Z                   
2026-01-04T02:29:47.4856328Z               elif iteration == 1:
2026-01-04T02:29:47.4856638Z                   # Second pass - more aggressive if quality was low
2026-01-04T02:29:47.4856980Z                   if previous_quality < 7.0:
2026-01-04T02:29:47.4857362Z                       params['noise_strength'] = min(1.0, params['noise_strength'] * 1.3)
2026-01-04T02:29:47.4857793Z                       params['hp_cutoff'] = params['hp_cutoff'] * 1.2
2026-01-04T02:29:47.4858108Z                       
2026-01-04T02:29:47.4858335Z               elif iteration == 2:
2026-01-04T02:29:47.4858770Z                   # Third pass - different approach if still not good
2026-01-04T02:29:47.4859111Z                   if previous_quality < 7.5:
2026-01-04T02:29:47.4859472Z                       params['noise_method'] = 'wiener'  # Try different algorithm
2026-01-04T02:29:47.4859878Z                       params['compression'] = True  # Add compression
2026-01-04T02:29:47.4860190Z                       
2026-01-04T02:29:47.4860410Z               return params
2026-01-04T02:29:47.4860645Z       ```
2026-01-04T02:29:47.4860824Z       
2026-01-04T02:29:47.4861021Z       **Adaptive Features**:
2026-01-04T02:29:47.4861455Z       - ✅ Iterative refinement (up to 3 passes)

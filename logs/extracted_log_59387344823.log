2026-01-04T02:29:46.0206559Z 
2026-01-04T02:29:46.0206660Z ### 3. Adaptive Processing Engine
2026-01-04T02:29:46.0206845Z 
2026-01-04T02:29:46.0206972Z **File**: `src/core/adaptive_processor.py` (14.6KB)
2026-01-04T02:29:46.0207243Z 
2026-01-04T02:29:46.0207359Z **Smart Processing with Quality Feedback**:
2026-01-04T02:29:46.0207649Z ```python
2026-01-04T02:29:46.0207998Z class AdaptiveAudioProcessor:
2026-01-04T02:29:46.0208362Z     """Adaptive processor that adjusts based on quality feedback"""
2026-01-04T02:29:46.0208729Z     
2026-01-04T02:29:46.0208920Z     def process_file(
2026-01-04T02:29:46.0209143Z         self,
2026-01-04T02:29:46.0209353Z         input_path: Path,
2026-01-04T02:29:46.0209611Z         profile: ProcessingProfile,
2026-01-04T02:29:46.0209902Z         output_dir: Optional[str] = None,
2026-01-04T02:29:46.0210227Z         progress_callback: Optional[Callable] = None,
2026-01-04T02:29:46.0210557Z         max_iterations: int = 3
2026-01-04T02:29:46.0210822Z     ) -> ProcessingResult:
2026-01-04T02:29:46.0211053Z         """
2026-01-04T02:29:46.0211289Z         Process file with adaptive quality refinement
2026-01-04T02:29:46.0211859Z         Will try up to max_iterations to achieve quality target
2026-01-04T02:29:46.0212198Z         """
2026-01-04T02:29:46.0212393Z         # Load audio
2026-01-04T02:29:46.0212701Z         audio, sr = librosa.load(str(input_path), sr=None, mono=True)
2026-01-04T02:29:46.0213052Z         
2026-01-04T02:29:46.0213377Z         best_result = None
2026-01-04T02:29:46.0213612Z         best_quality = 0.0
2026-01-04T02:29:46.0213841Z         
2026-01-04T02:29:46.0214060Z         for iteration in range(max_iterations):
2026-01-04T02:29:46.0214382Z             # Adjust parameters based on iteration
2026-01-04T02:29:46.0214715Z             adjusted_params = self._adjust_parameters(
2026-01-04T02:29:46.0215034Z                 profile.parameters,
2026-01-04T02:29:46.0215303Z                 iteration,
2026-01-04T02:29:46.0215540Z                 best_quality
2026-01-04T02:29:46.0215776Z             )
2026-01-04T02:29:46.0215969Z             
2026-01-04T02:29:46.0216166Z             # Process
2026-01-04T02:29:46.0216434Z             processed_audio = self._apply_processing_chain(
2026-01-04T02:29:46.0216756Z                 audio,
2026-01-04T02:29:46.0216971Z                 sr,
2026-01-04T02:29:46.0217193Z                 adjusted_params,
2026-01-04T02:29:46.0217452Z                 progress_callback
2026-01-04T02:29:46.0217706Z             )
2026-01-04T02:29:46.0217911Z             
2026-01-04T02:29:46.0218114Z             # Quick quality check
2026-01-04T02:29:46.0218448Z             quality = self._quick_quality_check(audio, processed_audio)
2026-01-04T02:29:46.0218796Z             
2026-01-04T02:29:46.0219009Z             if quality > best_quality:
2026-01-04T02:29:46.0219300Z                 best_result = processed_audio
2026-01-04T02:29:46.0219591Z                 best_quality = quality
2026-01-04T02:29:46.0219852Z                 
2026-01-04T02:29:46.0220078Z             # Stop if quality is good enough
2026-01-04T02:29:46.0220365Z             if quality >= 8.5:
2026-01-04T02:29:46.0220608Z                 break
2026-01-04T02:29:46.0220823Z                 
2026-01-04T02:29:46.0221033Z         # Save best result
2026-01-04T02:29:46.0221362Z         output_path = self._generate_output_path(input_path, output_dir)
2026-01-04T02:29:46.0221941Z         sf.write(output_path, best_result, sr)
2026-01-04T02:29:46.0222235Z         
2026-01-04T02:29:46.0222451Z         return ProcessingResult(
2026-01-04T02:29:46.0222716Z             success=True,
2026-01-04T02:29:46.0222967Z             output_path=output_path,
2026-01-04T02:29:46.0223252Z             quality_score=best_quality,
2026-01-04T02:29:46.0223541Z             iterations=iteration + 1,
2026-01-04T02:29:46.0223846Z             processing_time=time.time() - start_time
2026-01-04T02:29:46.0224140Z         )
2026-01-04T02:29:46.0224325Z         
2026-01-04T02:29:46.0224530Z     def _apply_processing_chain(
2026-01-04T02:29:46.0224789Z         self,
2026-01-04T02:29:46.0224996Z         audio: np.ndarray,
2026-01-04T02:29:46.0225229Z         sr: int,
2026-01-04T02:29:46.0225448Z         params: Dict[str, Any],
2026-01-04T02:29:46.0225710Z         callback: Optional[Callable]
2026-01-04T02:29:46.0225989Z     ) -> np.ndarray:
2026-01-04T02:29:46.0226351Z         """Apply complete processing chain"""
2026-01-04T02:29:46.0226649Z         total_steps = 6
2026-01-04T02:29:46.0226882Z         current_step = 0
2026-01-04T02:29:46.0227111Z         
2026-01-04T02:29:46.0227312Z         def update_progress():
2026-01-04T02:29:46.0227570Z             nonlocal current_step
2026-01-04T02:29:46.0227834Z             current_step += 1
2026-01-04T02:29:46.0228083Z             if callback:
2026-01-04T02:29:46.0228334Z                 callback(current_step, total_steps)
2026-01-04T02:29:46.0228626Z                 
2026-01-04T02:29:46.0228842Z         # Step 1: Trim silence
2026-01-04T02:29:46.0229111Z         if params.get('trim_silence', True):
2026-01-04T02:29:46.0229481Z             audio = self._trim_silence(audio, params['silence_threshold'])
2026-01-04T02:29:46.0229849Z         update_progress()
2026-01-04T02:29:46.0230078Z         
2026-01-04T02:29:46.0230277Z         # Step 2: Noise reduction
2026-01-04T02:29:46.0230558Z         if params.get('noise_reduction', True):
2026-01-04T02:29:46.0230878Z             audio = self._reduce_noise(
2026-01-04T02:29:46.0231154Z                 audio,
2026-01-04T02:29:46.0231489Z                 sr,
2026-01-04T02:29:46.0231983Z                 method=params['noise_method'],
2026-01-04T02:29:46.0232310Z                 strength=params['noise_strength']
2026-01-04T02:29:46.0232599Z             )
2026-01-04T02:29:46.0232805Z         update_progress()
2026-01-04T02:29:46.0233026Z         
2026-01-04T02:29:46.0233249Z         # Step 3: High-pass filter (remove rumble)
2026-01-04T02:29:46.0233580Z         if params.get('highpass_filter', True):
2026-01-04T02:29:46.0233960Z             audio = self._highpass_filter(audio, sr, params['hp_cutoff'])
2026-01-04T02:29:46.0234327Z         update_progress()
2026-01-04T02:29:46.0234552Z         
2026-01-04T02:29:46.0234769Z         # Step 4: Compression (dynamic range)
2026-01-04T02:29:46.0235079Z         if params.get('compression', False):
2026-01-04T02:29:46.0235377Z             audio = self._compress_dynamics(
2026-01-04T02:29:46.0235662Z                 audio,
2026-01-04T02:29:46.0235910Z                 threshold=params['comp_threshold'],
2026-01-04T02:29:46.0236233Z                 ratio=params['comp_ratio']
2026-01-04T02:29:46.0236504Z             )
2026-01-04T02:29:46.0236707Z         update_progress()
2026-01-04T02:29:46.0236929Z         
2026-01-04T02:29:46.0237118Z         # Step 5: EQ
2026-01-04T02:29:46.0237344Z         if params.get('eq', False):
2026-01-04T02:29:46.0237671Z             audio = self._apply_eq(audio, sr, params['eq_bands'])
2026-01-04T02:29:46.0238007Z         update_progress()
2026-01-04T02:29:46.0238233Z         
2026-01-04T02:29:46.0238429Z         # Step 6: Normalize
2026-01-04T02:29:46.0238733Z         audio = self._normalize(audio, params['target_level'])
2026-01-04T02:29:46.0239071Z         update_progress()
2026-01-04T02:29:46.0239303Z         
2026-01-04T02:29:46.0239490Z         return audio
2026-01-04T02:29:46.0239700Z         
2026-01-04T02:29:46.0239901Z     def _adjust_parameters(
2026-01-04T02:29:46.0240141Z         self,
2026-01-04T02:29:46.0240357Z         base_params: Dict[str, Any],
2026-01-04T02:29:46.0240637Z         iteration: int,
2026-01-04T02:29:46.0240875Z         previous_quality: float
2026-01-04T02:29:46.0241128Z     ) -> Dict[str, Any]:
2026-01-04T02:29:46.0241418Z         """Adaptively adjust parameters based on iteration"""
2026-01-04T02:29:46.0241977Z         params = base_params.copy()
2026-01-04T02:29:46.0242246Z         
2026-01-04T02:29:46.0242447Z         if iteration == 0:
2026-01-04T02:29:46.0242715Z             # First pass - use base parameters
2026-01-04T02:29:46.0243014Z             return params
2026-01-04T02:29:46.0243242Z             
2026-01-04T02:29:46.0243443Z         elif iteration == 1:
2026-01-04T02:29:46.0243742Z             # Second pass - more aggressive if quality was low
2026-01-04T02:29:46.0244082Z             if previous_quality < 7.0:
2026-01-04T02:29:46.0244463Z                 params['noise_strength'] = min(1.0, params['noise_strength'] * 1.3)
2026-01-04T02:29:46.0245030Z                 params['hp_cutoff'] = params['hp_cutoff'] * 1.2
2026-01-04T02:29:46.0245360Z                 
2026-01-04T02:29:46.0245582Z         elif iteration == 2:
2026-01-04T02:29:46.0245883Z             # Third pass - different approach if still not good
2026-01-04T02:29:46.0246224Z             if previous_quality < 7.5:
2026-01-04T02:29:46.0246579Z                 params['noise_method'] = 'wiener'  # Try different algorithm
2026-01-04T02:29:46.0246986Z                 params['compression'] = True  # Add compression
2026-01-04T02:29:46.0247301Z                 
2026-01-04T02:29:46.0247513Z         return params
2026-01-04T02:29:46.0247733Z ```
2026-01-04T02:29:46.0247835Z 
2026-01-04T02:29:46.0247931Z **Adaptive Features**:
2026-01-04T02:29:46.0248259Z - ✅ Iterative refinement (up to 3 passes)
2026-01-04T02:29:46.0248608Z - ✅ Quality-based parameter adjustment
2026-01-04T02:29:46.0248930Z - ✅ Multi-step processing chain
2026-01-04T02:29:46.0249231Z - ✅ Real-time progress feedback
2026-01-04T02:29:46.0249539Z - ✅ Automatic best result selection
2026-01-04T02:29:46.0249732Z 

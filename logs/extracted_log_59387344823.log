2026-01-04T02:29:47.4863777Z       ### 4. User-Friendly CLI
2026-01-04T02:29:47.4864014Z       
2026-01-04T02:29:47.4864221Z       **File**: `src/cli/smart_cli.py` (9.4KB)
2026-01-04T02:29:47.4864498Z       
2026-01-04T02:29:47.4864694Z       **Simple Command Interface**:
2026-01-04T02:29:47.4864952Z       ```python
2026-01-04T02:29:47.4865165Z       #!/usr/bin/env python3
2026-01-04T02:29:47.4865398Z       """
2026-01-04T02:29:47.4865608Z       Smart CLI for one-command audio tuning
2026-01-04T02:29:47.4865884Z       """
2026-01-04T02:29:47.4866065Z       
2026-01-04T02:29:47.4866256Z       import argparse
2026-01-04T02:29:47.4866468Z       import sys
2026-01-04T02:29:47.4866689Z       from pathlib import Path
2026-01-04T02:29:47.4867020Z       from src.workflow.auto_tune_workflow import AutoTuneWorkflow
2026-01-04T02:29:47.4867370Z       
2026-01-04T02:29:47.4867561Z       def main():
2026-01-04T02:29:47.4867800Z           parser = argparse.ArgumentParser(
2026-01-04T02:29:47.4868355Z               description="🎵 Intelligent Audio Auto-Tune - Perfect your audio with one command",
2026-01-04T02:29:47.4868883Z               formatter_class=argparse.RawDescriptionHelpFormatter,
2026-01-04T02:29:47.4869236Z               epilog="""
2026-01-04T02:29:47.4869459Z       Examples:
2026-01-04T02:29:47.4869672Z         # Process single file
2026-01-04T02:29:47.4869934Z         audio-tune /path/to/audio.mp3
2026-01-04T02:29:47.4870197Z         
2026-01-04T02:29:47.4870400Z         # Process entire directory
2026-01-04T02:29:47.4870677Z         audio-tune /path/to/audio_folder/
2026-01-04T02:29:47.4870946Z         
2026-01-04T02:29:47.4871132Z         # With preview
2026-01-04T02:29:47.4871363Z         audio-tune audio.wav --preview
2026-01-04T02:29:47.4871730Z         
2026-01-04T02:29:47.4871929Z         # Aggressive cleaning
2026-01-04T02:29:47.4872345Z         audio-tune noisy_recording.mp3 --aggressive
2026-01-04T02:29:47.4872648Z         
2026-01-04T02:29:47.4872850Z         # Interactive mode
2026-01-04T02:29:47.4873110Z         audio-tune podcast.wav --interactive
2026-01-04T02:29:47.4873394Z         
2026-01-04T02:29:47.4873579Z         # Learn from feedback
2026-01-04T02:29:47.4873858Z         audio-tune audio.mp3 --learn-from-feedback
2026-01-04T02:29:47.4874155Z               """
2026-01-04T02:29:47.4874354Z           )
2026-01-04T02:29:47.4874534Z           
2026-01-04T02:29:47.4874727Z           parser.add_argument(
2026-01-04T02:29:47.4874968Z               'path',
2026-01-04T02:29:47.4875183Z               type=str,
2026-01-04T02:29:47.4875430Z               help='Path to audio file or directory'
2026-01-04T02:29:47.4875719Z           )
2026-01-04T02:29:47.4875902Z           
2026-01-04T02:29:47.4876098Z           parser.add_argument(
2026-01-04T02:29:47.4876347Z               '--output', '-o',
2026-01-04T02:29:47.4876594Z               type=str,
2026-01-04T02:29:47.4876822Z               default=None,
2026-01-04T02:29:47.4877095Z               help='Output directory (default: same as input)'
2026-01-04T02:29:47.4877572Z           )
2026-01-04T02:29:47.4877753Z           
2026-01-04T02:29:47.4877948Z           parser.add_argument(
2026-01-04T02:29:47.4878203Z               '--preview', '-p',
2026-01-04T02:29:47.4878462Z               action='store_true',
2026-01-04T02:29:47.4878774Z               help='Generate 10-second preview before processing'
2026-01-04T02:29:47.4879099Z           )
2026-01-04T02:29:47.4879275Z           
2026-01-04T02:29:47.4879469Z           parser.add_argument(
2026-01-04T02:29:47.4879721Z               '--aggressive', '-a',
2026-01-04T02:29:47.4879986Z               action='store_true',
2026-01-04T02:29:47.4880310Z               help='Use more aggressive cleaning (for very noisy audio)'
2026-01-04T02:29:47.4880648Z           )
2026-01-04T02:29:47.4880830Z           
2026-01-04T02:29:47.4881025Z           parser.add_argument(
2026-01-04T02:29:47.4881277Z               '--interactive', '-i',
2026-01-04T02:29:47.4881547Z               action='store_true',
2026-01-04T02:29:47.4881958Z               help='Interactive mode (asks for confirmation)'
2026-01-04T02:29:47.4882265Z           )
2026-01-04T02:29:47.4882446Z           
2026-01-04T02:29:47.4882638Z           parser.add_argument(
2026-01-04T02:29:47.4882891Z               '--learn-from-feedback',
2026-01-04T02:29:47.4883168Z               action='store_true',
2026-01-04T02:29:47.4883478Z               help='Enable cognitive brain learning from this session'
2026-01-04T02:29:47.4883808Z           )
2026-01-04T02:29:47.4883991Z           
2026-01-04T02:29:47.4884186Z           parser.add_argument(
2026-01-04T02:29:47.4884430Z               '--no-cognitive',
2026-01-04T02:29:47.4884683Z               action='store_true',
2026-01-04T02:29:47.4884972Z               help='Disable cognitive brain integration'
2026-01-04T02:29:47.4885265Z           )
2026-01-04T02:29:47.4885443Z           
2026-01-04T02:29:47.4885650Z           args = parser.parse_args()
2026-01-04T02:29:47.4885910Z           
2026-01-04T02:29:47.4886113Z           # Initialize workflow
2026-01-04T02:29:47.4886372Z           workflow = AutoTuneWorkflow(
2026-01-04T02:29:47.4886664Z               cognitive_mode=not args.no_cognitive
2026-01-04T02:29:47.4886948Z           )
2026-01-04T02:29:47.4887130Z           
2026-01-04T02:29:47.4887365Z           print("🎵" * 30)
2026-01-04T02:29:47.4887630Z           print("   INTELLIGENT AUDIO AUTO-TUNE")
2026-01-04T02:29:47.4887957Z           print("🎵" * 30)
2026-01-04T02:29:47.4888183Z           print()
2026-01-04T02:29:47.4888384Z           
2026-01-04T02:29:47.4888569Z           # Process
2026-01-04T02:29:47.4888798Z           result = workflow.process_path(
2026-01-04T02:29:47.4889089Z               input_path=args.path,
2026-01-04T02:29:47.4889367Z               output_dir=args.output,
2026-01-04T02:29:47.4889649Z               preview=args.preview,
2026-01-04T02:29:47.4890047Z               aggressive=args.aggressive,
2026-01-04T02:29:47.4890343Z               interactive=args.interactive
2026-01-04T02:29:47.4890623Z           )
2026-01-04T02:29:47.4890805Z           
2026-01-04T02:29:47.4891001Z           # Display results
2026-01-04T02:29:47.4891237Z           print("\n" + "="*60)
2026-01-04T02:29:47.4891494Z           print("PROCESSING COMPLETE")
2026-01-04T02:29:47.4891874Z           print("="*60)
2026-01-04T02:29:47.4892089Z           
2026-01-04T02:29:47.4892286Z           if result.success:
2026-01-04T02:29:47.4892686Z               print(f"✅ Successfully processed {result.total_files} file(s)")
2026-01-04T02:29:47.4893113Z               print(f"   Success rate: {result.success_rate:.1%}")
2026-01-04T02:29:47.4893565Z               print(f"   Average quality improvement: {result.avg_improvement:.1f}/10")
2026-01-04T02:29:47.4894005Z               print(f"   Total time: {result.total_time:.1f}s")
2026-01-04T02:29:47.4894357Z               print(f"   Output location: {result.output_dir}")
2026-01-04T02:29:47.4894676Z           else:
2026-01-04T02:29:47.4894979Z               print(f"❌ Processing failed: {result.error}")
2026-01-04T02:29:47.4895482Z               sys.exit(1)
2026-01-04T02:29:47.4895714Z               
2026-01-04T02:29:47.4895925Z       if __name__ == "__main__":
2026-01-04T02:29:47.4896170Z           main()
2026-01-04T02:29:47.4896370Z       ```

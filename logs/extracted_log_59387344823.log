2026-01-04T02:27:09.9263906Z ```python
2026-01-04T02:27:09.9264204Z class NoiseReduction:
2026-01-04T02:27:09.9264551Z     """Advanced noise reduction with multiple algorithms"""
2026-01-04T02:27:09.9264882Z     
2026-01-04T02:27:09.9265071Z     def __init__(self):
2026-01-04T02:27:09.9265305Z         self.algorithms = {
2026-01-04T02:27:09.9265589Z             'spectral_gating': self._spectral_gating,
2026-01-04T02:27:09.9265920Z             'wiener': self._wiener_filter,
2026-01-04T02:27:09.9266242Z             'deep_learning': self._dl_noise_reduction
2026-01-04T02:27:09.9266538Z         }
2026-01-04T02:27:09.9266728Z         
2026-01-04T02:27:09.9267095Z     def reduce_noise(
2026-01-04T02:27:09.9267317Z         self,
2026-01-04T02:27:09.9267530Z         audio: np.ndarray,
2026-01-04T02:27:09.9267771Z         sr: int,
2026-01-04T02:27:09.9268004Z         method: str = 'spectral_gating',
2026-01-04T02:27:09.9268285Z         **kwargs
2026-01-04T02:27:09.9268496Z     ) -> np.ndarray:
2026-01-04T02:27:09.9268734Z         """Apply noise reduction"""
2026-01-04T02:27:09.9269030Z         if method not in self.algorithms:
2026-01-04T02:27:09.9269363Z             raise ValueError(f"Unknown method: {method}")
2026-01-04T02:27:09.9269671Z             
2026-01-04T02:27:09.9269930Z         return self.algorithms[method](audio, sr, **kwargs)
2026-01-04T02:27:09.9270252Z         
2026-01-04T02:27:09.9270452Z     def _spectral_gating(
2026-01-04T02:27:09.9270683Z         self,
2026-01-04T02:27:09.9270894Z         audio: np.ndarray,
2026-01-04T02:27:09.9271126Z         sr: int,
2026-01-04T02:27:09.9271380Z         threshold_db: float = -40,
2026-01-04T02:27:09.9271791Z         **kwargs
2026-01-04T02:27:09.9272005Z     ) -> np.ndarray:
2026-01-04T02:27:09.9272258Z         """Spectral gating noise reduction"""
2026-01-04T02:27:09.9272701Z         # Convert to frequency domain
2026-01-04T02:27:09.9272991Z         D = librosa.stft(audio)
2026-01-04T02:27:09.9273280Z         magnitude, phase = librosa.magphase(D)
2026-01-04T02:27:09.9273564Z         
2026-01-04T02:27:09.9273792Z         # Estimate noise profile from quiet sections
2026-01-04T02:27:09.9274167Z         noise_profile = self._estimate_noise_profile(magnitude)
2026-01-04T02:27:09.9274502Z         
2026-01-04T02:27:09.9274699Z         # Create gate mask
2026-01-04T02:27:09.9275049Z         mask = magnitude > (noise_profile * self._db_to_linear(threshold_db))
2026-01-04T02:27:09.9275429Z         
2026-01-04T02:27:09.9275637Z         # Apply mask with smoothing
2026-01-04T02:27:09.9275930Z         smoothed_mask = self._smooth_mask(mask)
2026-01-04T02:27:09.9276220Z         
2026-01-04T02:27:09.9276414Z         # Reconstruct
2026-01-04T02:27:09.9276684Z         D_filtered = magnitude * smoothed_mask * phase
2026-01-04T02:27:09.9277019Z         return librosa.istft(D_filtered)
2026-01-04T02:27:09.9277298Z ```

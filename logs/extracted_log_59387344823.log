2026-01-04T02:29:46.0157123Z 
2026-01-04T02:29:46.0157239Z ### 2. Intelligent Audio Analyzer
2026-01-04T02:29:46.0157417Z 
2026-01-04T02:29:46.0157570Z **File**: `src/analysis/intelligent_analyzer.py` (12.8KB)
2026-01-04T02:29:46.0157944Z 
2026-01-04T02:29:46.0158046Z **AI-Powered Analysis**:
2026-01-04T02:29:46.0158278Z ```python
2026-01-04T02:29:46.0158494Z class IntelligentAudioAnalyzer:
2026-01-04T02:29:46.0158839Z     """AI-powered audio analysis for optimal profile selection"""
2026-01-04T02:29:46.0159182Z     
2026-01-04T02:29:46.0159447Z     def analyze_file(self, file_path: Path) -> AudioAnalysis:
2026-01-04T02:29:46.0159813Z         """Comprehensive audio analysis"""
2026-01-04T02:29:46.0160101Z         # Load audio
2026-01-04T02:29:46.0160400Z         audio, sr = librosa.load(str(file_path), sr=None, mono=True)
2026-01-04T02:29:46.0160742Z         
2026-01-04T02:29:46.0160941Z         # Extract features
2026-01-04T02:29:46.0161260Z         features = self._extract_comprehensive_features(audio, sr)
2026-01-04T02:29:46.0161774Z         
2026-01-04T02:29:46.0161990Z         # Classify content
2026-01-04T02:29:46.0162300Z         content_type = self._classify_content(audio, sr, features)
2026-01-04T02:29:46.0162642Z         
2026-01-04T02:29:46.0162840Z         # Detect problems
2026-01-04T02:29:46.0163138Z         problems = self._detect_problems(audio, sr, features)
2026-01-04T02:29:46.0163467Z         
2026-01-04T02:29:46.0163667Z         # Calculate quality score
2026-01-04T02:29:46.0164028Z         quality_score = self._calculate_quality_score(features, problems)
2026-01-04T02:29:46.0164401Z         
2026-01-04T02:29:46.0164605Z         return AudioAnalysis(
2026-01-04T02:29:46.0164866Z             file_path=file_path,
2026-01-04T02:29:46.0165135Z             duration=len(audio) / sr,
2026-01-04T02:29:46.0165410Z             sample_rate=sr,
2026-01-04T02:29:46.0165674Z             content_type=content_type,
2026-01-04T02:29:46.0165958Z             features=features,
2026-01-04T02:29:46.0166213Z             problems=problems,
2026-01-04T02:29:46.0166479Z             quality_score=quality_score,
2026-01-04T02:29:46.0166795Z             metadata=self._extract_metadata(file_path)
2026-01-04T02:29:46.0167107Z         )
2026-01-04T02:29:46.0167292Z         
2026-01-04T02:29:46.0167481Z     def _classify_content(
2026-01-04T02:29:46.0167717Z         self,
2026-01-04T02:29:46.0167923Z         audio: np.ndarray,
2026-01-04T02:29:46.0168154Z         sr: int,
2026-01-04T02:29:46.0168372Z         features: Dict[str, Any]
2026-01-04T02:29:46.0168625Z     ) -> str:
2026-01-04T02:29:46.0168844Z         """Classify audio content type"""
2026-01-04T02:29:46.0169144Z         # Extract classification features
2026-01-04T02:29:46.0169449Z         zcr_mean = np.mean(features['zcr'])
2026-01-04T02:29:46.0169834Z         spectral_centroid_mean = np.mean(features['spectral_centroid'])
2026-01-04T02:29:46.0170219Z         tempo = features['tempo']
2026-01-04T02:29:46.0170470Z         
2026-01-04T02:29:46.0170675Z         # Decision tree classification
2026-01-04T02:29:46.0171126Z         if zcr_mean > 0.15 and spectral_centroid_mean > 3000:
2026-01-04T02:29:46.0171462Z             return "speech"
2026-01-04T02:29:46.0171936Z         elif tempo > 80 and features['has_strong_beat']:
2026-01-04T02:29:46.0172259Z             return "music"
2026-01-04T02:29:46.0172500Z         elif zcr_mean < 0.05:
2026-01-04T02:29:46.0172751Z             return "ambient"
2026-01-04T02:29:46.0172989Z         else:
2026-01-04T02:29:46.0173191Z             return "mixed"
2026-01-04T02:29:46.0173413Z             
2026-01-04T02:29:46.0173618Z     def _detect_problems(
2026-01-04T02:29:46.0173847Z         self,
2026-01-04T02:29:46.0174050Z         audio: np.ndarray,
2026-01-04T02:29:46.0174282Z         sr: int,
2026-01-04T02:29:46.0174499Z         features: Dict[str, Any]
2026-01-04T02:29:46.0174752Z     ) -> List[str]:
2026-01-04T02:29:46.0174985Z         """Detect audio problems"""
2026-01-04T02:29:46.0175259Z         problems = []
2026-01-04T02:29:46.0175478Z         
2026-01-04T02:29:46.0175669Z         # Check for clipping
2026-01-04T02:29:46.0175936Z         if np.max(np.abs(audio)) > 0.99:
2026-01-04T02:29:46.0176238Z             problems.append("clipping")
2026-01-04T02:29:46.0176645Z             
2026-01-04T02:29:46.0176856Z         # Check for low SNR (noisy)
2026-01-04T02:29:46.0177144Z         snr = self._calculate_snr(audio)
2026-01-04T02:29:46.0177421Z         if snr < 20:
2026-01-04T02:29:46.0177658Z             problems.append("high_noise")
2026-01-04T02:29:46.0177936Z             
2026-01-04T02:29:46.0178142Z         # Check for hum (50/60 Hz)
2026-01-04T02:29:46.0178414Z         if self._detect_hum(audio, sr):
2026-01-04T02:29:46.0178714Z             problems.append("electrical_hum")
2026-01-04T02:29:46.0178999Z             
2026-01-04T02:29:46.0179207Z         # Check for excessive reverb
2026-01-04T02:29:46.0179499Z         if self._detect_reverb(audio, sr) > 0.7:
2026-01-04T02:29:46.0179816Z             problems.append("excessive_reverb")
2026-01-04T02:29:46.0180103Z             
2026-01-04T02:29:46.0180319Z         # Check for silence/low volume
2026-01-04T02:29:46.0180608Z         rms = np.sqrt(np.mean(audio**2))
2026-01-04T02:29:46.0180893Z         if rms < 0.01:
2026-01-04T02:29:46.0181139Z             problems.append("low_volume")
2026-01-04T02:29:46.0181414Z             
2026-01-04T02:29:46.0181776Z         return problems
2026-01-04T02:29:46.0182004Z         
2026-01-04T02:29:46.0182199Z     def select_profile(
2026-01-04T02:29:46.0182416Z         self,
2026-01-04T02:29:46.0182627Z         analysis: AudioAnalysis,
2026-01-04T02:29:46.0182893Z         aggressive: bool = False
2026-01-04T02:29:46.0183155Z     ) -> ProfileMatch:
2026-01-04T02:29:46.0183443Z         """Select optimal cleaning profile based on analysis"""
2026-01-04T02:29:46.0183796Z         # Load all available profiles
2026-01-04T02:29:46.0184086Z         profiles = self._load_all_profiles()
2026-01-04T02:29:46.0184367Z         
2026-01-04T02:29:46.0184563Z         # Score each profile
2026-01-04T02:29:46.0184806Z         scores = []
2026-01-04T02:29:46.0185032Z         for profile in profiles:
2026-01-04T02:29:46.0185377Z             score = self._score_profile_match(analysis, profile, aggressive)
2026-01-04T02:29:46.0185782Z             scores.append((score, profile))
2026-01-04T02:29:46.0186059Z             
2026-01-04T02:29:46.0186251Z         # Sort by score
2026-01-04T02:29:46.0186516Z         scores.sort(reverse=True, key=lambda x: x[0])
2026-01-04T02:29:46.0186824Z         
2026-01-04T02:29:46.0187033Z         best_score, best_profile = scores[0]
2026-01-04T02:29:46.0187308Z         
2026-01-04T02:29:46.0187510Z         # Generate explanation
2026-01-04T02:29:46.0187853Z         reason = self._explain_profile_selection(analysis, best_profile)
2026-01-04T02:29:46.0188213Z         
2026-01-04T02:29:46.0188404Z         # Get alternatives
2026-01-04T02:29:46.0188648Z         alternatives = [
2026-01-04T02:29:46.0188887Z             ProfileMatch(
2026-01-04T02:29:46.0189128Z                 profile=profile,
2026-01-04T02:29:46.0189577Z                 confidence=score,
2026-01-04T02:29:46.0189923Z                 reason=self._explain_profile_selection(analysis, profile)
2026-01-04T02:29:46.0190279Z             )
2026-01-04T02:29:46.0190549Z             for score, profile in scores[1:4]  # Top 3 alternatives
2026-01-04T02:29:46.0190881Z         ]
2026-01-04T02:29:46.0191061Z         
2026-01-04T02:29:46.0191262Z         return ProfileMatch(
2026-01-04T02:29:46.0191520Z             profile=best_profile,
2026-01-04T02:29:46.0191979Z             confidence=best_score,
2026-01-04T02:29:46.0192253Z             reason=reason,
2026-01-04T02:29:46.0192503Z             alternatives=alternatives
2026-01-04T02:29:46.0192770Z         )
2026-01-04T02:29:46.0192948Z         
2026-01-04T02:29:46.0193146Z     def _score_profile_match(
2026-01-04T02:29:46.0193391Z         self,
2026-01-04T02:29:46.0193601Z         analysis: AudioAnalysis,
2026-01-04T02:29:46.0193873Z         profile: ProcessingProfile,
2026-01-04T02:29:46.0194148Z         aggressive: bool
2026-01-04T02:29:46.0194386Z     ) -> float:
2026-01-04T02:29:46.0194639Z         """Score how well a profile matches the audio"""
2026-01-04T02:29:46.0195072Z         score = 0.0
2026-01-04T02:29:46.0195279Z         
2026-01-04T02:29:46.0195483Z         # Content type match (40% weight)
2026-01-04T02:29:46.0195817Z         if profile.content_type == analysis.content_type:
2026-01-04T02:29:46.0196141Z             score += 0.4
2026-01-04T02:29:46.0196392Z         elif profile.content_type == "general":
2026-01-04T02:29:46.0196694Z             score += 0.2
2026-01-04T02:29:46.0196911Z             
2026-01-04T02:29:46.0197118Z         # Problem coverage (40% weight)
2026-01-04T02:29:46.0197406Z         problems_covered = sum(
2026-01-04T02:29:46.0197688Z             1 for problem in analysis.problems
2026-01-04T02:29:46.0198014Z             if problem in profile.handles_problems
2026-01-04T02:29:46.0198307Z         )
2026-01-04T02:29:46.0198510Z         if analysis.problems:
2026-01-04T02:29:46.0198840Z             score += 0.4 * (problems_covered / len(analysis.problems))
2026-01-04T02:29:46.0199180Z         else:
2026-01-04T02:29:46.0199425Z             score += 0.4  # No problems = any profile works
2026-01-04T02:29:46.0199730Z             
2026-01-04T02:29:46.0199951Z         # Aggressive match (10% weight)
2026-01-04T02:29:46.0200267Z         if aggressive and profile.is_aggressive:
2026-01-04T02:29:46.0200571Z             score += 0.1
2026-01-04T02:29:46.0200859Z         elif not aggressive and not profile.is_aggressive:
2026-01-04T02:29:46.0201187Z             score += 0.1
2026-01-04T02:29:46.0201412Z             
2026-01-04T02:29:46.0201792Z         # Feature compatibility (10% weight)
2026-01-04T02:29:46.0202159Z         feature_match = self._calculate_feature_compatibility(
2026-01-04T02:29:46.0202513Z             analysis.features,
2026-01-04T02:29:46.0202784Z             profile.expected_features
2026-01-04T02:29:46.0203057Z         )
2026-01-04T02:29:46.0203259Z         score += 0.1 * feature_match
2026-01-04T02:29:46.0203523Z         
2026-01-04T02:29:46.0203717Z         return score
2026-01-04T02:29:46.0203925Z ```
2026-01-04T02:29:46.0204038Z 
2026-01-04T02:29:46.0204133Z **Intelligence Features**:
2026-01-04T02:29:46.0204482Z - ✅ Content classification (speech/music/mixed)
2026-01-04T02:29:46.0204836Z - ✅ Problem detection (7 types)
2026-01-04T02:29:46.0205121Z - ✅ SNR calculation
2026-01-04T02:29:46.0205377Z - ✅ Hum detection (50/60 Hz)
2026-01-04T02:29:46.0205654Z - ✅ Reverb detection
2026-01-04T02:29:46.0205903Z - ✅ Clipping detection
2026-01-04T02:29:46.0206179Z - ✅ Profile scoring with explanation
2026-01-04T02:29:46.0206374Z 

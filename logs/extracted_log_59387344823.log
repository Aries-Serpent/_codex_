2026-01-04T02:27:09.9189379Z class AudioProcessor:
2026-01-04T02:27:09.9189964Z     """Production-grade audio processor with streaming support"""
2026-01-04T02:27:09.9190539Z     
2026-01-04T02:27:09.9190885Z     def __init__(self, config: AudioConfig):
2026-01-04T02:27:09.9191388Z         self.config = config
2026-01-04T02:27:09.9192005Z         self.effects_chain = EffectsChain()
2026-01-04T02:27:09.9192527Z         self.validator = AudioValidator()
2026-01-04T02:27:09.9192984Z         
2026-01-04T02:27:09.9193294Z     def process_file(
2026-01-04T02:27:09.9193651Z         self,
2026-01-04T02:27:09.9194002Z         input_path: Path,
2026-01-04T02:27:09.9194410Z         output_path: Path,
2026-01-04T02:27:09.9194845Z         profile: ProcessingProfile,
2026-01-04T02:27:09.9195347Z         callback: Optional[Callable] = None
2026-01-04T02:27:09.9195853Z     ) -> ProcessingResult:
2026-01-04T02:27:09.9196327Z         """Process audio file with progress tracking"""
2026-01-04T02:27:09.9196849Z         try:
2026-01-04T02:27:09.9197183Z             # Validate input
2026-01-04T02:27:09.9197657Z             self.validator.validate_file(input_path)
2026-01-04T02:27:09.9198171Z             
2026-01-04T02:27:09.9198535Z             # Load with streaming for large files
2026-01-04T02:27:09.9199125Z             with StreamingAudioLoader(input_path) as loader:
2026-01-04T02:27:09.9199701Z                 chunks = []
2026-01-04T02:27:09.9200153Z                 total_chunks = loader.get_chunk_count()
2026-01-04T02:27:09.9200654Z                 
2026-01-04T02:27:09.9201028Z                 for i, chunk in enumerate(loader):
2026-01-04T02:27:09.9201895Z                     # Process chunk
2026-01-04T02:27:09.9202462Z                     processed = self._process_chunk(chunk, profile)
2026-01-04T02:27:09.9203060Z                     chunks.append(processed)
2026-01-04T02:27:09.9203530Z                     
2026-01-04T02:27:09.9203903Z                     # Progress callback
2026-01-04T02:27:09.9204375Z                     if callback:
2026-01-04T02:27:09.9204836Z                         callback(i + 1, total_chunks)
2026-01-04T02:27:09.9205329Z                         
2026-01-04T02:27:09.9205718Z             # Combine chunks
2026-01-04T02:27:09.9206170Z             final_audio = np.concatenate(chunks)
2026-01-04T02:27:09.9206658Z             
2026-01-04T02:27:09.9206987Z             # Save with metadata
2026-01-04T02:27:09.9207575Z             self._save_with_metadata(final_audio, output_path, profile)
2026-01-04T02:27:09.9208185Z             
2026-01-04T02:27:09.9208539Z             return ProcessingResult(
2026-01-04T02:27:09.9209014Z                 success=True,
2026-01-04T02:27:09.9209453Z                 output_path=output_path,
2026-01-04T02:27:09.9210166Z                 processing_time=time.time() - start_time,
2026-01-04T02:27:09.9210828Z                 quality_score=self._calculate_quality(final_audio)
2026-01-04T02:27:09.9211759Z             )
2026-01-04T02:27:09.9212160Z             
2026-01-04T02:27:09.9212501Z         except Exception as e:
2026-01-04T02:27:09.9213019Z             logger.error(f"Processing failed: {e}")
2026-01-04T02:27:09.9213467Z             return ProcessingResult(success=False, error=str(e))
2026-01-04T02:27:09.9213804Z             
2026-01-04T02:27:09.9214010Z     def _process_chunk(
2026-01-04T02:27:09.9214240Z         self,
2026-01-04T02:27:09.9214465Z         audio: np.ndarray,
2026-01-04T02:27:09.9214728Z         profile: ProcessingProfile
2026-01-04T02:27:09.9214999Z     ) -> np.ndarray:
2026-01-04T02:27:09.9215257Z         """Apply effects chain to audio chunk"""
2026-01-04T02:27:09.9215581Z         # Apply effects in order
2026-01-04T02:27:09.9215859Z         for effect in profile.effects:
2026-01-04T02:27:09.9216203Z             audio = self.effects_chain.apply(audio, effect)
2026-01-04T02:27:09.9216525Z             
2026-01-04T02:27:09.9216724Z         return audio
2026-01-04T02:27:09.9216937Z ```

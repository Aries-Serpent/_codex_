2026-01-04T02:25:03.8184178Z     12.         
2026-01-04T02:25:03.8184428Z     13.         # If no profiles found, create a default one
2026-01-04T02:25:03.8184753Z     14.         if not self.profiles:
2026-01-04T02:25:03.8185081Z     15.             self._create_default_profile(profiles_folder)
2026-01-04T02:25:03.8185469Z     16.             self.profiles = self.load_profiles(profiles_folder)
2026-01-04T02:25:03.8185804Z     17.         
2026-01-04T02:25:03.8186101Z     18.         self.kmeans = KMeans(n_clusters=max(1, len(self.profiles)))
2026-01-04T02:25:03.8186485Z     19.         self.fit_clusterer()
2026-01-04T02:25:03.8186748Z     20. 
2026-01-04T02:25:03.8186980Z     21.     def _create_default_profile(self, folder):
2026-01-04T02:25:03.8187517Z     22.         """Create a default profile if none exists"""
2026-01-04T02:25:03.8187843Z     23.         default_profile = {
2026-01-04T02:25:03.8188139Z     24.             "name": "Standard Podcast Cleaning",
2026-01-04T02:25:03.8188443Z     25.             "features": {
2026-01-04T02:25:03.8188699Z     26.                 "pitch": 120.0,
2026-01-04T02:25:03.8189002Z     27.                 "spectral_centroid": 2500.0,
2026-01-04T02:25:03.8189301Z     28.                 "rms": 0.05,
2026-01-04T02:25:03.8189563Z     29.                 "zcr": 0.1
2026-01-04T02:25:03.8189812Z     30.             },
2026-01-04T02:25:03.8190042Z     31.             "cleaning_params": {
2026-01-04T02:25:03.8190330Z     32.                 "trim_silence": True,
2026-01-04T02:25:03.8190819Z     33.                 "hp_freq": 80,
2026-01-04T02:25:03.8191280Z     34.                 "normalize_level": 0.9,
2026-01-04T02:25:03.8192008Z     35.                 "noise_gate_threshold": 0.01
2026-01-04T02:25:03.8192495Z     36.             }
2026-01-04T02:25:03.8192922Z     37.         }
2026-01-04T02:25:03.8193207Z     38.         
2026-01-04T02:25:03.8193506Z     39.         profile_path = os.path.join(folder, "default_profile.json")
2026-01-04T02:25:03.8194171Z     40.         with open(profile_path, 'w', encoding='utf-8') as f:
2026-01-04T02:25:03.8194830Z     41.             json.dump(default_profile, f, indent=2)
2026-01-04T02:25:03.8195451Z     42.             print(f"Created default profile: {profile_path}")
2026-01-04T02:25:03.8195990Z     43. 
2026-01-04T02:25:03.8196325Z     44.     def load_profiles(self, folder):
2026-01-04T02:25:03.8196811Z     45.         profiles = []
2026-01-04T02:25:03.8197219Z     46.         try:
2026-01-04T02:25:03.8197635Z     47.             for file in os.listdir(folder):
2026-01-04T02:25:03.8198156Z     48.                 if file.endswith('.json'):
2026-01-04T02:25:03.8198643Z     49.                     try:
2026-01-04T02:25:03.8199136Z     50.                         with open(os.path.join(folder, file)) as fp:
2026-01-04T02:25:03.8199763Z     51.                             profiles.append(json.load(fp))
2026-01-04T02:25:03.8200345Z     52.                     except Exception as e:
2026-01-04T02:25:03.8200943Z     53.                         print(f"Error loading profile {file}: {e}")
2026-01-04T02:25:03.8201484Z     54.         except Exception as e:
2026-01-04T02:25:03.8202264Z     55.             print(f"Error accessing profiles directory {folder}: {e}")
2026-01-04T02:25:03.8202747Z     56.         
2026-01-04T02:25:03.8203088Z     57.         return profiles
2026-01-04T02:25:03.8203399Z     58. 
2026-01-04T02:25:03.8203760Z     59.     def fit_clusterer(self):
2026-01-04T02:25:03.8204183Z     60.         if self.profiles:
2026-01-04T02:25:03.8204746Z     61.             feature_vectors = [self.profile_to_vector(p) for p in self.profiles]
2026-01-04T02:25:03.8205191Z     62.             self.kmeans.fit(feature_vectors)
2026-01-04T02:25:03.8205492Z     63. 
2026-01-04T02:25:03.8205712Z     64.     def profile_to_vector(self, profile):
2026-01-04T02:25:03.8206029Z     65.         feats = profile['features']
2026-01-04T02:25:03.8206521Z     66.         return np.array([
2026-01-04T02:25:03.8206951Z     67.             feats['pitch'],
2026-01-04T02:25:03.8207392Z     68.             feats['spectral_centroid'],
2026-01-04T02:25:03.8207883Z     69.             feats['rms'],
2026-01-04T02:25:03.8208296Z     70.             feats['zcr']
2026-01-04T02:25:03.8208693Z     71.         ])
2026-01-04T02:25:03.8209005Z     72. 
2026-01-04T02:25:03.8209334Z     73.     def match_profile(self, features):
2026-01-04T02:25:03.8209819Z     74.         feat_vector = np.array([
2026-01-04T02:25:03.8210280Z     75.             features['pitch'],
2026-01-04T02:25:03.8210756Z     76.             features['spectral_centroid'],
2026-01-04T02:25:03.8211270Z     77.             features['rms'],
2026-01-04T02:25:03.8211905Z     78.             features['zcr']
2026-01-04T02:25:03.8212596Z     79.         ]).reshape(1, -1)
2026-01-04T02:25:03.8213094Z     80.         label = self.kmeans.predict(feat_vector)[0]
2026-01-04T02:25:03.8213656Z     81.         return self.profiles[label]
2026-01-04T02:25:03.8214115Z     82.

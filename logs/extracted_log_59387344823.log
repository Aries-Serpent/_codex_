2026-01-04T02:29:46.0250134Z ### 4. User-Friendly CLI
2026-01-04T02:29:46.0250286Z 
2026-01-04T02:29:46.0250398Z **File**: `src/cli/smart_cli.py` (9.4KB)
2026-01-04T02:29:46.0250595Z 
2026-01-04T02:29:46.0250699Z **Simple Command Interface**:
2026-01-04T02:29:46.0250946Z ```python
2026-01-04T02:29:46.0251146Z #!/usr/bin/env python3
2026-01-04T02:29:46.0251357Z """
2026-01-04T02:29:46.0251565Z Smart CLI for one-command audio tuning
2026-01-04T02:29:46.0252076Z """
2026-01-04T02:29:46.0252181Z 
2026-01-04T02:29:46.0252267Z import argparse
2026-01-04T02:29:46.0252480Z import sys
2026-01-04T02:29:46.0252688Z from pathlib import Path
2026-01-04T02:29:46.0253007Z from src.workflow.auto_tune_workflow import AutoTuneWorkflow
2026-01-04T02:29:46.0253278Z 
2026-01-04T02:29:46.0253363Z def main():
2026-01-04T02:29:46.0253580Z     parser = argparse.ArgumentParser(
2026-01-04T02:29:46.0254133Z         description="🎵 Intelligent Audio Auto-Tune - Perfect your audio with one command",
2026-01-04T02:29:46.0254663Z         formatter_class=argparse.RawDescriptionHelpFormatter,
2026-01-04T02:29:46.0255010Z         epilog="""
2026-01-04T02:29:46.0255219Z Examples:
2026-01-04T02:29:46.0255423Z   # Process single file
2026-01-04T02:29:46.0255665Z   audio-tune /path/to/audio.mp3
2026-01-04T02:29:46.0255913Z   
2026-01-04T02:29:46.0256104Z   # Process entire directory
2026-01-04T02:29:46.0256365Z   audio-tune /path/to/audio_folder/
2026-01-04T02:29:46.0256626Z   
2026-01-04T02:29:46.0256808Z   # With preview
2026-01-04T02:29:46.0257037Z   audio-tune audio.wav --preview
2026-01-04T02:29:46.0257294Z   
2026-01-04T02:29:46.0257490Z   # Aggressive cleaning
2026-01-04T02:29:46.0257748Z   audio-tune noisy_recording.mp3 --aggressive
2026-01-04T02:29:46.0258045Z   
2026-01-04T02:29:46.0258230Z   # Interactive mode
2026-01-04T02:29:46.0258472Z   audio-tune podcast.wav --interactive
2026-01-04T02:29:46.0258752Z   
2026-01-04T02:29:46.0258943Z   # Learn from feedback
2026-01-04T02:29:46.0259207Z   audio-tune audio.mp3 --learn-from-feedback
2026-01-04T02:29:46.0259494Z         """
2026-01-04T02:29:46.0259675Z     )
2026-01-04T02:29:46.0259858Z     
2026-01-04T02:29:46.0260052Z     parser.add_argument(
2026-01-04T02:29:46.0260283Z         'path',
2026-01-04T02:29:46.0260490Z         type=str,
2026-01-04T02:29:46.0260727Z         help='Path to audio file or directory'
2026-01-04T02:29:46.0261016Z     )
2026-01-04T02:29:46.0261190Z     
2026-01-04T02:29:46.0261383Z     parser.add_argument(
2026-01-04T02:29:46.0261733Z         '--output', '-o',
2026-01-04T02:29:46.0261969Z         type=str,
2026-01-04T02:29:46.0262178Z         default=None,
2026-01-04T02:29:46.0262444Z         help='Output directory (default: same as input)'
2026-01-04T02:29:46.0262751Z     )
2026-01-04T02:29:46.0262930Z     
2026-01-04T02:29:46.0263115Z     parser.add_argument(
2026-01-04T02:29:46.0263358Z         '--preview', '-p',
2026-01-04T02:29:46.0263741Z         action='store_true',
2026-01-04T02:29:46.0264051Z         help='Generate 10-second preview before processing'
2026-01-04T02:29:46.0264380Z     )
2026-01-04T02:29:46.0264559Z     
2026-01-04T02:29:46.0264748Z     parser.add_argument(
2026-01-04T02:29:46.0264984Z         '--aggressive', '-a',
2026-01-04T02:29:46.0265240Z         action='store_true',
2026-01-04T02:29:46.0265556Z         help='Use more aggressive cleaning (for very noisy audio)'
2026-01-04T02:29:46.0265900Z     )
2026-01-04T02:29:46.0266078Z     
2026-01-04T02:29:46.0266267Z     parser.add_argument(
2026-01-04T02:29:46.0266508Z         '--interactive', '-i',
2026-01-04T02:29:46.0266761Z         action='store_true',
2026-01-04T02:29:46.0267049Z         help='Interactive mode (asks for confirmation)'
2026-01-04T02:29:46.0267363Z     )
2026-01-04T02:29:46.0267542Z     
2026-01-04T02:29:46.0267730Z     parser.add_argument(
2026-01-04T02:29:46.0267981Z         '--learn-from-feedback',
2026-01-04T02:29:46.0268254Z         action='store_true',
2026-01-04T02:29:46.0268562Z         help='Enable cognitive brain learning from this session'
2026-01-04T02:29:46.0269019Z     )
2026-01-04T02:29:46.0269201Z     
2026-01-04T02:29:46.0269393Z     parser.add_argument(
2026-01-04T02:29:46.0269630Z         '--no-cognitive',
2026-01-04T02:29:46.0269863Z         action='store_true',
2026-01-04T02:29:46.0270143Z         help='Disable cognitive brain integration'
2026-01-04T02:29:46.0270438Z     )
2026-01-04T02:29:46.0270617Z     
2026-01-04T02:29:46.0270817Z     args = parser.parse_args()
2026-01-04T02:29:46.0271063Z     
2026-01-04T02:29:46.0271255Z     # Initialize workflow
2026-01-04T02:29:46.0271502Z     workflow = AutoTuneWorkflow(
2026-01-04T02:29:46.0272059Z         cognitive_mode=not args.no_cognitive
2026-01-04T02:29:46.0272345Z     )
2026-01-04T02:29:46.0272524Z     
2026-01-04T02:29:46.0272758Z     print("🎵" * 30)
2026-01-04T02:29:46.0273015Z     print("   INTELLIGENT AUDIO AUTO-TUNE")
2026-01-04T02:29:46.0273342Z     print("🎵" * 30)
2026-01-04T02:29:46.0273557Z     print()
2026-01-04T02:29:46.0273739Z     
2026-01-04T02:29:46.0273927Z     # Process
2026-01-04T02:29:46.0274146Z     result = workflow.process_path(
2026-01-04T02:29:46.0274430Z         input_path=args.path,
2026-01-04T02:29:46.0274696Z         output_dir=args.output,
2026-01-04T02:29:46.0274962Z         preview=args.preview,
2026-01-04T02:29:46.0275226Z         aggressive=args.aggressive,
2026-01-04T02:29:46.0275502Z         interactive=args.interactive
2026-01-04T02:29:46.0275769Z     )
2026-01-04T02:29:46.0275961Z     
2026-01-04T02:29:46.0276149Z     # Display results
2026-01-04T02:29:46.0276377Z     print("\n" + "="*60)
2026-01-04T02:29:46.0276623Z     print("PROCESSING COMPLETE")
2026-01-04T02:29:46.0276884Z     print("="*60)
2026-01-04T02:29:46.0277092Z     
2026-01-04T02:29:46.0277276Z     if result.success:
2026-01-04T02:29:46.0277662Z         print(f"✅ Successfully processed {result.total_files} file(s)")
2026-01-04T02:29:46.0278092Z         print(f"   Success rate: {result.success_rate:.1%}")
2026-01-04T02:29:46.0278538Z         print(f"   Average quality improvement: {result.avg_improvement:.1f}/10")
2026-01-04T02:29:46.0278990Z         print(f"   Total time: {result.total_time:.1f}s")
2026-01-04T02:29:46.0279350Z         print(f"   Output location: {result.output_dir}")
2026-01-04T02:29:46.0279660Z     else:
2026-01-04T02:29:46.0279946Z         print(f"❌ Processing failed: {result.error}")
2026-01-04T02:29:46.0280252Z         sys.exit(1)
2026-01-04T02:29:46.0280460Z         
2026-01-04T02:29:46.0280658Z if __name__ == "__main__":
2026-01-04T02:29:46.0280895Z     main()
2026-01-04T02:29:46.0281082Z ```

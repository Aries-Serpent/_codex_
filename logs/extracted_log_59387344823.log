2026-01-04T02:29:46.0147991Z                 profile=profile_match.profile,
2026-01-04T02:29:46.0148298Z                 validation=validation,
2026-01-04T02:29:46.0148624Z                 processing_time=processed.processing_time
2026-01-04T02:29:46.0148935Z             )
2026-01-04T02:29:46.0149131Z             
2026-01-04T02:29:46.0149351Z         except Exception as e:

2026-01-04T02:27:09.9236144Z         self.profiles = self._load_profiles(profiles_dir)
2026-01-04T02:27:09.9236489Z         self.model = self._train_model()
2026-01-04T02:27:09.9236791Z         self.scaler = StandardScaler()
2026-01-04T02:27:09.9237068Z         
2026-01-04T02:27:09.9237271Z     def auto_select_profile(
2026-01-04T02:27:09.9237516Z         self,
2026-01-04T02:27:09.9237731Z         features: AudioFeatures,
2026-01-04T02:27:09.9238002Z         return_confidence: bool = True
2026-01-04T02:27:09.9238283Z     ) -> ProfileMatch:
2026-01-04T02:27:09.9238574Z         """Auto-select best profile with confidence score"""
2026-01-04T02:27:09.9238906Z         # Normalize features
2026-01-04T02:27:09.9239207Z         feature_vector = self._features_to_vector(features)
2026-01-04T02:27:09.9239594Z         normalized = self.scaler.transform([feature_vector])
2026-01-04T02:27:09.9239921Z         
2026-01-04T02:27:09.9240119Z         # Predict cluster
2026-01-04T02:27:09.9240400Z         cluster_id = self.model.predict(normalized)[0]
2026-01-04T02:27:09.9240712Z         
2026-01-04T02:27:09.9241048Z         # Get probability distribution
2026-01-04T02:27:09.9241474Z         probabilities = self.model.predict_proba(normalized)[0]
2026-01-04T02:27:09.9241966Z         confidence = probabilities[cluster_id]
2026-01-04T02:27:09.9242408Z         
2026-01-04T02:27:09.9242604Z         # Get profile
2026-01-04T02:27:09.9242855Z         profile = self.profiles[cluster_id]
2026-01-04T02:27:09.9243127Z         
2026-01-04T02:27:09.9243352Z         # Alternative suggestions if confidence low
2026-01-04T02:27:09.9243809Z         alternatives = []
2026-01-04T02:27:09.9244062Z         if confidence < 0.7:
2026-01-04T02:27:09.9248401Z             top_3_indices = np.argsort(probabilities)[-3:][::-1]
2026-01-04T02:27:09.9248790Z             alternatives = [
2026-01-04T02:27:09.9249060Z                 ProfileMatch(
2026-01-04T02:27:09.9249358Z                     profile=self.profiles[idx],
2026-01-04T02:27:09.9249684Z                     confidence=probabilities[idx],
2026-01-04T02:27:09.9250068Z                     reason=self._explain_match(features, self.profiles[idx])
2026-01-04T02:27:09.9250422Z                 )
2026-01-04T02:27:09.9250683Z                 for idx in top_3_indices[1:]  # Skip top match
2026-01-04T02:27:09.9250995Z             ]
2026-01-04T02:27:09.9251192Z             
2026-01-04T02:27:09.9251404Z         return ProfileMatch(
2026-01-04T02:27:09.9251832Z             profile=profile,
2026-01-04T02:27:09.9252090Z             confidence=confidence,
2026-01-04T02:27:09.9252379Z             alternatives=alternatives,
2026-01-04T02:27:09.9252722Z             reason=self._explain_match(features, profile)
2026-01-04T02:27:09.9253254Z         )
2026-01-04T02:27:09.9253445Z         
2026-01-04T02:27:09.9253645Z     def _explain_match(
2026-01-04T02:27:09.9253873Z         self,
2026-01-04T02:27:09.9254091Z         features: AudioFeatures,
2026-01-04T02:27:09.9254366Z         profile: ProcessingProfile
2026-01-04T02:27:09.9254635Z     ) -> str:
2026-01-04T02:27:09.9254898Z         """Generate human-readable explanation using SHAP"""
2026-01-04T02:27:09.9255248Z         # Use SHAP values for explanation
2026-01-04T02:27:09.9255594Z         explainer = shap.TreeExplainer(self.model)
2026-01-04T02:27:09.9255967Z         feature_vector = self._features_to_vector(features)
2026-01-04T02:27:09.9256365Z         shap_values = explainer.shap_values([feature_vector])
2026-01-04T02:27:09.9256699Z         
2026-01-04T02:27:09.9256912Z         # Get top 3 contributing features
2026-01-04T02:27:09.9257307Z         top_features = np.argsort(np.abs(shap_values[0]))[-3:][::-1]
2026-01-04T02:27:09.9257654Z         
2026-01-04T02:27:09.9257920Z         explanation = f"Matched to '{profile.name}' because:\n"
2026-01-04T02:27:09.9258279Z         for idx in top_features:
2026-01-04T02:27:09.9258577Z             feature_name = self.feature_names[idx]
2026-01-04T02:27:09.9258906Z             contribution = shap_values[0][idx]
2026-01-04T02:27:09.9259300Z             explanation += f"- {feature_name}: {contribution:.2f} influence\n"
2026-01-04T02:27:09.9259674Z             
2026-01-04T02:27:09.9259878Z         return explanation
2026-01-04T02:27:09.9260114Z ```
2026-01-04T02:27:09.9260224Z 
2026-01-04T02:27:09.9260314Z **Key Enhancements**:

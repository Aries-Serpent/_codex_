2026-01-04T02:25:04.6948143Z     1. import numpy as np
2026-01-04T02:25:04.6948511Z     2. from scipy.signal import butter, sosfilt
2026-01-04T02:25:04.6948888Z     3. from .quick_trim import quick_trim
2026-01-04T02:25:04.6949168Z     4. 
2026-01-04T02:25:04.6949376Z     5. class GodLevelCleaner:
2026-01-04T02:25:04.6949644Z     6.     def __init__(self):
2026-01-04T02:25:04.6949917Z     7.         pass
2026-01-04T02:25:04.6950129Z     8. 
2026-01-04T02:25:04.6950352Z     9.     def process_audio(self, y, sr, params):
2026-01-04T02:25:04.6950709Z     10.         if params.get("trim_silence", True):
2026-01-04T02:25:04.6951019Z     11.             y = quick_trim(y)
2026-01-04T02:25:04.6951274Z     12. 
2026-01-04T02:25:04.6951549Z     13.         y = self.highpass_filter(y, sr, params.get("hp_freq", 80))
2026-01-04T02:25:04.6952256Z     14.         y = self.normalize(y, params.get("normalize_level", 0.9))
2026-01-04T02:25:04.6952695Z     15.         y = self.noise_gate(y, params.get("noise_gate_threshold", 0.01))
2026-01-04T02:25:04.6953050Z     16. 
2026-01-04T02:25:04.6953240Z     17.         return y
2026-01-04T02:25:04.6953460Z     18. 
2026-01-04T02:25:04.6953686Z     19.     def highpass_filter(self, y, sr, cutoff=80):
2026-01-04T02:25:04.6954084Z     20.         sos = butter(4, cutoff, btype='highpass', fs=sr, output='sos')
2026-01-04T02:25:04.6954464Z     21.         return sosfilt(sos, y)
2026-01-04T02:25:04.6954728Z     22. 
2026-01-04T02:25:04.6954941Z     23.     def normalize(self, y, peak=0.9):
2026-01-04T02:25:04.6955255Z     24.         max_amp = np.max(np.abs(y))
2026-01-04T02:25:04.6955543Z     25.         if max_amp == 0:
2026-01-04T02:25:04.6955798Z     26.             return y
2026-01-04T02:25:04.6956056Z     27.         return (y / max_amp) * peak
2026-01-04T02:25:04.6956323Z     28. 
2026-01-04T02:25:04.6956531Z     29.     def noise_gate(self, y, threshold):
2026-01-04T02:25:04.6972199Z     30.         y[np.abs(y) < threshold] = 0
2026-01-04T02:25:04.6972529Z     31.         return y
2026-01-04T02:25:04.6972766Z     32.

2026-01-04T02:29:46.0150066Z             return FileProcessingResult(
2026-01-04T02:29:46.0150356Z                 success=False,
2026-01-04T02:29:46.0150617Z                 input_path=file_path,
2026-01-04T02:29:46.0150896Z                 error=str(e)
2026-01-04T02:29:46.0151134Z             )
2026-01-04T02:29:46.0151325Z             
2026-01-04T02:29:46.0151579Z     def _print_progress(self, current: int, total: int):
2026-01-04T02:29:46.0152173Z         """Print processing progress"""
2026-01-04T02:29:46.0152475Z         percent = (current / total) * 100
2026-01-04T02:29:46.0152934Z         bar_length = 40
2026-01-04T02:29:46.0153203Z         filled = int(bar_length * current / total)
2026-01-04T02:29:46.0153617Z         bar = '█' * filled + '░' * (bar_length - filled)
2026-01-04T02:29:46.0153978Z         print(f"\r   [{bar}] {percent:.1f}%", end='', flush=True)
2026-01-04T02:29:46.0154319Z         if current == total:
2026-01-04T02:29:46.0154584Z             print()  # New line when complete
2026-01-04T02:29:46.0154862Z ```

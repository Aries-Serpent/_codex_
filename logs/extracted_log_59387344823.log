2026-01-04T02:29:46.0077341Z     def _discover_audio_files(self, input_path: str) -> List[Path]:
2026-01-04T02:29:46.0077874Z         """Discover all audio files from input path"""
2026-01-04T02:29:46.0078207Z         path = Path(input_path).resolve()
2026-01-04T02:29:46.0078482Z         
2026-01-04T02:29:46.0078674Z         # Validation
2026-01-04T02:29:46.0078905Z         if not path.exists():
2026-01-04T02:29:46.0079235Z             raise FileNotFoundError(f"Path does not exist: {path}")
2026-01-04T02:29:46.0079573Z             
2026-01-04T02:29:46.0079871Z         supported_formats = {'.wav', '.mp3', '.flac', '.ogg', '.m4a', '.mp4'}
2026-01-04T02:29:46.0080245Z         
2026-01-04T02:29:46.0080436Z         # Single file
2026-01-04T02:29:46.0080660Z         if path.is_file():
2026-01-04T02:29:46.0080945Z             if path.suffix.lower() in supported_formats:
2026-01-04T02:29:46.0081266Z                 return [path]
2026-01-04T02:29:46.0081507Z             else:
2026-01-04T02:29:46.0082133Z                 raise ValueError(f"Unsupported format: {path.suffix}")
2026-01-04T02:29:46.0082699Z                 
2026-01-04T02:29:46.0082940Z         # Directory - recursive scan
2026-01-04T02:29:46.0083222Z         elif path.is_dir():
2026-01-04T02:29:46.0083458Z             files = []
2026-01-04T02:29:46.0083697Z             for ext in supported_formats:
2026-01-04T02:29:46.0084005Z                 files.extend(path.rglob(f"*{ext}"))
2026-01-04T02:29:46.0084310Z             return sorted(files)
2026-01-04T02:29:46.0084555Z             
2026-01-04T02:29:46.0084745Z         return []
2026-01-04T02:29:46.0084944Z         

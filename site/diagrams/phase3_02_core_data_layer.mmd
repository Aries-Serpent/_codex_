    style LOADER fill:#533483,color:#fff
    style MODEL_REG fill:#457b9d,color:#fff
    style RAG_STORE fill:#1a1a2e,color:#e0e0e0
    style CKPT fill:#665c84,color:#fff
    style PERSIST fill:#2d6a4f,color:#fff
    style ACCESS fill:#4a4e69,color:#fff

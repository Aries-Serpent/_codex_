    style DEVELOP fill:#16213e,color:#e0e0e0
    style REGISTER fill:#0f3460,color:#e0e0e0
    style VERSION fill:#4a4e69,color:#fff
    style INSTALL fill:#2d6a4f,color:#fff
    style DISCOVER fill:#533483,color:#fff
    style INVOKE fill:#1b4332,color:#fff
    style ERROR fill:#e63946,color:#fff
    style MONITOR fill:#457b9d,color:#fff
    style OUTPUT fill:#1b4332,color:#fff

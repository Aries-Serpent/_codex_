{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aries-Serpent/_codex_/configs/schemas/deep_research_bundle.schema.json",
  "title": "Evidence-Grounded Deep Research Bundle",
  "type": "object",
  "required": [
    "research_id",
    "schema_version",
    "brief",
    "capability",
    "query_ledger",
    "sources",
    "evidence",
    "claims",
    "datasets",
    "contradictions",
    "objective_matrix",
    "verification",
    "azimuth",
    "checkpoint",
    "status",
    "report"
  ],
  "properties": {
    "research_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "brief": {
      "type": "object",
      "required": ["title", "objectives", "execution_lanes"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "scope": {"type": "string"},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "jurisdictions": {"type": "array", "items": {"type": "string"}},
        "time_period": {"type": ["string", "null"]},
        "terminology": {"type": "object", "additionalProperties": {"type": "string"}},
        "hypotheses": {"type": "object"},
        "execution_lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "owner", "mode", "depends_on", "scope", "evidence_contract", "completion_gate"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "mode": {"enum": ["parallel", "dependent", "aggregator"]},
              "depends_on": {"type": "array", "items": {"type": "string"}},
              "scope": {"type": "string", "minLength": 1},
              "evidence_contract": {"type": "string", "minLength": 1},
              "completion_gate": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "question", "acceptance_criteria", "synonyms", "applicable"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "parent_id": {"type": ["string", "null"]},
              "question": {"type": "string", "minLength": 1},
              "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
              "synonyms": {"type": "array", "items": {"type": "string"}},
              "applicable": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": ["web_retrieval_available", "fresh_web_research", "retrieval_completed", "provider_binding", "limitations"],
      "properties": {
        "web_retrieval_available": {"type": "boolean"},
        "fresh_web_research": {"type": "boolean"},
        "retrieval_completed": {"type": "boolean"},
        "provider_binding": {"type": "string"},
        "budgets": {
          "type": "object",
          "required": ["max_search_calls", "max_sources", "max_retries", "deadline_seconds", "finalization_reserve_fraction", "max_provider_cost", "max_results_per_query"],
          "properties": {
            "max_search_calls": {"type": "integer", "minimum": 0},
            "max_sources": {"type": "integer", "minimum": 0},
            "max_retries": {"type": "integer", "minimum": 0},
            "deadline_seconds": {"type": "number", "exclusiveMinimum": 0},
            "finalization_reserve_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "max_provider_cost": {"type": ["number", "null"], "minimum": 0},
            "max_results_per_query": {"type": "integer", "minimum": 1}
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "query_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "execution_id", "objective_id", "query", "kind", "status", "attempted"],
        "properties": {
          "id": {"type": "string"},
          "execution_id": {"type": "string"},
          "objective_id": {"type": "string"},
          "query": {"type": "string"},
          "kind": {"enum": ["supporting", "hypothesis", "disconfirmation"]},
          "status": {"enum": ["planned", "pending", "completed", "partial", "failed", "skipped"]},
          "attempted": {"type": "boolean"},
          "result_count": {"type": "integer", "minimum": 0},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "locator", "evidence_role", "source_type", "access_outcome", "content_sha256", "query_ids", "objective_ids", "relationships", "author", "license", "access_constraints", "retrieval_provenance", "browser_diagnostics"],
        "properties": {
          "id": {"type": "string"},
          "requested_url": {"type": ["string", "null"]},
          "final_url": {"type": ["string", "null"]},
          "canonical_url": {"type": ["string", "null"]},
          "locator": {"type": "string", "minLength": 1},
          "evidence_role": {"enum": ["current", "historical", "archive", "unknown"]},
          "title": {"type": ["string", "null"]},
          "author": {"type": ["string", "null"]},
          "publisher": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "retrieved_at": {"type": ["string", "null"]},
          "source_type": {"enum": ["web", "supplied"]},
          "access_outcome": {"type": "string"},
          "access_error": {"type": ["string", "null"]},
          "content_sha256": {"type": ["string", "null"]},
          "content": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]},
          "access_constraints": {"type": ["string", "null"]},
          "query_ids": {"type": "array", "items": {"type": "string"}},
          "objective_ids": {"type": "array", "items": {"type": "string"}},
          "relationships": {"type": "array", "items": {"type": "object"}},
          "retrieval_provenance": {"type": "object"},
          "browser_diagnostics": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "objective_id", "claim_id", "source_ids", "locator", "quote", "kind", "value", "unit", "denominator", "population", "geography", "timeframe"],
        "properties": {
          "id": {"type": "string"},
          "objective_id": {"type": "string"},
          "claim_id": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "locator": {"type": "object", "required": ["kind", "line", "label"]},
          "quote": {"type": "string", "minLength": 1, "maxLength": 1000},
          "kind": {"enum": ["observation", "interpretation", "measurement"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "denominator": {"type": ["string", "null"]},
          "population": {"type": ["string", "null"]},
          "geography": {"type": ["string", "null"]},
          "timeframe": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "claims": {"type": "array", "items": {"type": "object", "required": ["id", "objective_id", "text", "evidence_ids"]}},
    "datasets": {"type": "array", "items": {"type": "object", "required": ["dataset_id", "sha256", "measurement_status", "observed"]}},
    "contradictions": {"type": "array", "items": {"type": "object", "required": ["id", "claim_ids", "evidence_ids", "status"]}},
    "objective_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "status", "rationale", "evidence_ids", "claim_ids"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["answered", "partially_answered", "unresolved", "not_applicable"]},
          "rationale": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "claim_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verification": {"type": "object", "required": ["mode", "findings", "claims_checked", "citations_resolved"]},
    "azimuth": {
      "type": "object",
      "required": ["model", "sequence", "status", "phases", "canonical_truth_statement", "repo_mutations_performed", "archived_source_ids"],
      "properties": {
        "model": {"const": "AZIMUTH"},
        "sequence": {
          "const": ["A", "Z", "I", "M", "U", "T", "H"]
        },
        "status": {"enum": ["completed", "partial"]},
        "phases": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["id", "name", "status", "evidence_ids", "notes"],
            "properties": {
              "id": {"enum": ["A", "Z", "I", "M", "U", "T", "H"]},
              "name": {"type": "string"},
              "status": {"enum": ["completed", "partial", "incomplete", "not_assessed"]},
              "evidence_ids": {"type": "array", "items": {"type": "string"}},
              "notes": {"type": "string"},
              "lanes": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        },
        "canonical_truth_statement": {"type": "string", "minLength": 1},
        "repo_mutations_performed": {"const": false},
        "archived_source_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "parent_id", "payload_sha256", "research_id", "completed_query_ids", "query_ledger", "sources", "evidence", "claims", "datasets", "objective_matrix", "status"]
    },
    "status": {"enum": ["complete", "incomplete"]},
    "report": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Allowlist Schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference"
    },
    "allowlisted_vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rationale", "expiry_date"],
        "properties": {
          "id": { "type": "string", "minLength": 4 },
          "rationale": { "type": "string", "minLength": 8 },
          "expiry_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO-8601 date (UTC) YYYY-MM-DD"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["allowlisted_vulnerabilities"],
  "additionalProperties": false
}

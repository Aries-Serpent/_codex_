# syntax=docker/dockerfile:1.7
# GPU runtime image aligned with the hardened CPU Dockerfile

# Build-time metadata (optional; pass via --build-arg)
ARG VERSION="0.0.0"
ARG VCS_REF="unknown"
ARG BUILD_DATE="unknown"
ARG VCS_URL="https://github.com/Aries-Serpent/_codex_"
# GPU-specific build args
ARG INSTALL_TORCH_GPU="0"
ARG TORCH_WHEEL=""
ARG TORCH_VERSION="2.4.0"
ARG TORCHVISION_VERSION="0.19.0"

FROM python:3.14-slim AS builder

ARG VERSION
ARG VCS_REF
ARG BUILD_DATE
ARG VCS_URL

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN python -m pip install --upgrade pip setuptools wheel build

COPY pyproject.toml ./
COPY MANIFEST.in ./
COPY requirements/ ./requirements/
COPY uv.lock ./uv.lock
COPY . .

RUN python -m build --wheel --no-isolation --outdir /tmp/dist

FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04 AS runtime

ARG VERSION
ARG VCS_REF
ARG BUILD_DATE
ARG VCS_URL
ARG INSTALL_TORCH_GPU
ARG TORCH_WHEEL
ARG TORCH_VERSION
ARG TORCHVISION_VERSION

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:${PATH}"

# Install Python runtime, health check tooling, and entrypoint dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    python3 \
    python3-venv \
    python3-pip \
    python3-distutils \
    tini \
 && rm -rf /var/lib/apt/lists/*

# Create the virtual environment within the CUDA base image so binaries and wheels match
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip setuptools wheel

# OCI labels for provenance/metadata
LABEL org.opencontainers.image.title="codex-gpu" \
      org.opencontainers.image.description="Aries-Serpent _codex_ GPU runtime image" \
      org.opencontainers.image.url="${VCS_URL}" \
      org.opencontainers.image.source="${VCS_URL}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Aries-Serpent" \
      org.opencontainers.image.base.name="nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04"

# Non-root runtime user
RUN groupadd --gid 1000 appuser && useradd --uid 1000 --gid appuser -m appuser

WORKDIR /app

COPY requirements/ ./requirements/
COPY uv.lock ./uv.lock
COPY pyproject.toml ./

# GPU-specific setup: Conditionally install CUDA-enabled PyTorch
# Base image provides CUDA 12.2.2 runtime, we use compatible PyTorch wheels (CUDA 12.1)
# Set INSTALL_TORCH_GPU=1 to enable GPU PyTorch installation
# Optionally specify custom wheel via TORCH_WHEEL build arg
RUN if [ "$INSTALL_TORCH_GPU" = "1" ]; then \
      if [ -n "$TORCH_WHEEL" ]; then \
        echo "Installing custom PyTorch: $TORCH_WHEEL"; \
        /opt/venv/bin/pip install --no-cache-dir $TORCH_WHEEL; \
      else \
        echo "Installing default CUDA 12.1 PyTorch ${TORCH_VERSION}"; \
        /opt/venv/bin/pip install --no-cache-dir \
          torch==${TORCH_VERSION} --index-url https://download.pytorch.org/whl/cu121 \
       && /opt/venv/bin/pip install --no-cache-dir \
          torchvision==${TORCHVISION_VERSION} --index-url https://download.pytorch.org/whl/cu121; \
      fi; \
    else \
      echo "Skipping GPU PyTorch install (INSTALL_TORCH_GPU not set to 1)"; \
    fi

# Install application dependencies
# Using CUDA 12.2 compatible wheels (matching base image nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04)
RUN if [ -f "requirements/docker.txt" ]; then \
      /opt/venv/bin/pip install -r requirements/docker.txt; \
    elif [ -f "requirements/base.txt" ]; then \
      # Skip torch from base.txt if GPU version was installed above
      if [ "$INSTALL_TORCH_GPU" = "1" ]; then \
        python3 -c "import re; \
with open('requirements/base.txt') as f, open('/tmp/base_no_torch.txt', 'w') as out: \
    for line in f: \
        if not re.match(r'^\s*torch(\W|$)', line): \
            out.write(line)" || cp requirements/base.txt /tmp/base_no_torch.txt; \
        /opt/venv/bin/pip install -r /tmp/base_no_torch.txt; \
      else \
        /opt/venv/bin/pip install -r requirements/base.txt; \
      fi; \
    fi

COPY --from=builder /tmp/dist /tmp/dist
COPY --from=builder /app/configs /app/configs
COPY --from=builder /app/hydra /app/hydra
COPY --from=builder /app/src /app/src
COPY docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

RUN /opt/venv/bin/pip install --no-deps /tmp/dist/*.whl \
 && rm -rf /tmp/dist

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || curl -fsS http://localhost:8000/ || exit 1

USER appuser

ENV APP_MODULE="src.codex.api.app:app"
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["uvicorn", "src.codex.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]

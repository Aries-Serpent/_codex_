# Bandit Configuration for _codex_ Repository
# Security Analysis Suppressions and Documentation
#
# This file documents intentional security patterns that are safe in context
# and suppresses false-positive warnings from Bandit security scanner.
#
# Generated: 2026-01-03
# Last Updated: 2026-01-03
# Maintainer: Cognitive Brain Team

[bandit]
# Exclude test files and third-party code from security scans
exclude_dirs = [
    '/tests/',
    '/test/',
    '/.venv/',
    '/venv/',
    '/build/',
    '/dist/',
    '/.pytest_cache/',
    '/.hypothesis/',
]

# Test files are allowed to use assert statements (B101)
# This is standard practice for pytest
skips = ['B101']

[bandit.B404]
# B404: Import of subprocess module
# JUSTIFICATION: Required for CLI operations, git commands, and system integration
# MITIGATION: All subprocess calls use explicit arguments, no shell=True unless necessary
# RISK: LOW - Controlled execution environment with input validation

[bandit.B603]
# B603: subprocess without shell equals true
# JUSTIFICATION: Safe subprocess usage with explicit argument lists
# MITIGATION: Arguments are validated and never include user input directly
# RISK: LOW - No shell injection vector

[bandit.B607]
# B607: Starting a process with a partial executable path
# JUSTIFICATION: Using standard system utilities (git, python, pytest)
# MITIGATION: Utilities are from trusted system PATH
# RISK: LOW - Standard development tools in controlled environment

[bandit.B608]
# B608: Possible SQL injection
# JUSTIFICATION: SQL queries use parameterized statements or SQLite API properly
# MITIGATION: No direct string concatenation for SQL queries
# RISK: LOW - SQLite with prepared statements

[bandit.B113]
# B113: Request without timeout
# JUSTIFICATION: Internal network calls or mocked requests in tests
# MITIGATION: Production code uses timeout parameters
# RISK: LOW - Test environment or internal services
# TODO: Add timeouts to all production HTTP calls in Phase 8.9

[bandit.B301]
# B301: Pickle usage
# JUSTIFICATION: Used for model serialization with trusted data only
# MITIGATION: Pickle files are from internal training, never from external sources
# RISK: LOW - No untrusted pickle deserialization
# TODO: Consider switching to safer formats (JSON, MessagePack) in Phase 8.10

[bandit.B605]
# B605: Starting a process with a shell
# JUSTIFICATION: Limited use for complex shell operations
# MITIGATION: All shell commands are hardcoded, no user input interpolation
# RISK: MEDIUM - Marked for refactoring in Phase 8.9
# TODO: Refactor to use subprocess with explicit arguments

[bandit.B324]
# B324: Weak cryptographic hash (MD5, SHA1)
# JUSTIFICATION: Used for checksums and cache keys, not for security
# MITIGATION: Not used for password hashing or cryptographic signatures
# RISK: LOW - No security-critical usage

[bandit.B303]
# B303: Use of insecure MD5/SHA1
# JUSTIFICATION: Used for file integrity checks and deterministic IDs
# MITIGATION: Not used for authentication or security-critical operations
# RISK: LOW - Cache key generation only

[bandit.B506]
# B506: yaml.load() without Loader
# JUSTIFICATION: YAML files are from trusted repository sources
# MITIGATION: Moving to yaml.safe_load() in all production code
# RISK: LOW - Configuration files are version-controlled
# TODO: Complete migration to yaml.safe_load() in Phase 8.9

# Test-specific suppressions
[bandit.assert_used]
# Allow assert in test files - standard pytest practice
# Tests are in /tests/ directory which is excluded above

# Documentation for security patterns
# =====================================
#
# 1. SUBPROCESS USAGE (B404, B603, B607, B605)
#    - Location: agents/brain_cli.py, scripts/, docker/
#    - Purpose: Git operations, build automation, CI/CD
#    - Safety: No user input in commands, explicit argument lists
#    - Future: Consider replacing with native Python libraries where possible
#
# 2. HTTP TIMEOUTS (B113)
#    - Location: agents/api_patterns.py, tests/
#    - Purpose: API calls, test fixtures
#    - Safety: Internal network only, test environment
#    - Future: Add configurable timeouts in Phase 8.9
#
# 3. PICKLE USAGE (B301)
#    - Location: agents/transfer_learning.py, agents/pattern_recognizer.py
#    - Purpose: Model checkpoints, trained embeddings
#    - Safety: Files from internal training only
#    - Future: Migrate to JSON/MessagePack in Phase 8.10
#
# 4. WEAK HASHING (B303, B324)
#    - Location: agents/phase8_8_meta_learning.py, various
#    - Purpose: Cache keys, deterministic IDs, checksums
#    - Safety: Not used for authentication or crypto
#    - Future: No change needed - appropriate for use case
#
# 5. YAML LOADING (B506)
#    - Location: configs/, .github/workflows/
#    - Purpose: Configuration management
#    - Safety: Files are version-controlled, trusted sources
#    - Future: Complete yaml.safe_load() migration in Phase 8.9
#
# Security Review Schedule
# ========================
# - Phase 8.9: Address TODO items (timeouts, shell commands, YAML)
# - Phase 8.10: Migrate from pickle to safer serialization
# - Phase 9.0: Comprehensive security audit before production
#
# Contact: @mbaetiong for security questions

# Bandit Security Configuration for _codex_ Repository
# ======================================================
# Format: YAML — pass explicitly with: bandit -r src/ --configfile .bandit
#   (Note: when bandit auto-discovers .bandit via --ini, it uses INI format.
#    This file uses YAML and MUST be passed via --configfile, not --ini.)
# Last Updated: 2026-02-28
# Maintainer: @mbaetiong
#
# Strategy:
#   - Config-level skips for rules that are pervasive, well-understood, and
#     safe across the entire codebase.
#   - Inline `# nosec BXXX` comments on individual lines that need per-site
#     justification (medium/high issues, or low issues in non-test production
#     code that deviate from the broad pattern).
#
# Rule reference: https://bandit.readthedocs.io/en/latest/plugins/index.html

skips:
  # B101 – assert statements
  #   Asserts are standard pytest idiom in all test files under src/*/tests/.
  #   Production code does not rely on asserts for control flow.
  - B101

  # B110 – try/except/pass
  #   Intentional optional-import and feature-probe pattern used throughout
  #   the codebase to provide graceful degradation (torch, psutil, mlflow, etc.).
  #   Every occurrence is a deliberate fallback, not swallowed errors.
  - B110

  # B112 – try/except/continue
  #   Same pattern as B110: iteration fallback for optional batch items.
  - B112

  # B311 – standard pseudo-random generators
  #   Used exclusively for non-cryptographic purposes: dataset shuffling,
  #   train/val splitting, random sampling for evaluation. Secrets and
  #   authentication tokens use the `secrets` module.
  - B311

  # B403 – import of pickle module
  #   Pickle is used for ML model checkpoint serialization from trusted,
  #   internally-generated files only. No untrusted pickle deserialization.
  - B403

  # B404 – import of subprocess module
  #   Required for git operations, build automation, and CI/CD scripts.
  #   All subprocess calls use explicit argument lists (no shell=True).
  - B404

  # B603 – subprocess without shell=True
  #   All subprocess invocations use explicit argument lists. No user input
  #   is interpolated. shell=False (the default) is used everywhere.
  - B603

  # B607 – starting process with partial executable path
  #   Uses standard system utilities (git, python, pytest) resolved via PATH.
  #   The execution environment is a controlled CI/CD or developer machine.
  - B607

  # B310 – urlopen scheme audit
  #   All urllib.request.urlopen() calls in scripts/ target the GitHub REST
  #   API at the hardcoded base URL https://api.github.com. No user-supplied
  #   URLs are accepted; the scheme is always https and the host is constant.
  - B310

exclude_dirs:
  - .venv
  - venv
  - build
  - dist
  - .pytest_cache
  - .hypothesis
  - node_modules
  - src/codex_ml/ast/tests
  - src/restore_pipeline/tests

# Security Pattern Documentation
# ================================
#
# MEDIUM issues are suppressed inline with # nosec comments that include the
# rule ID. Each suppression documents the specific justification at the call
# site. Run `bandit -r src/ --severity-level medium` to verify zero remaining
# medium/high issues.
#
# LOW issues not covered by the skips above are suppressed inline:
#   B104 – bind to all interfaces: intentional server listen address
#   B105/B106/B107 – hardcoded password FP: ML tokenizer special tokens
#                    (e.g. [PAD], [UNK], [BOS]) and internal test fixtures
#   B405 – xml.etree: trusted internal XML (no external input)
#   B608 – SQL injection: parameterised queries with SQLite/psycopg3
#   B614 – unsafe torch.load: weights_only=True is set (safe variant)
#   B310 – urlopen schemes: validated/curated domains only
#
# Security Review Schedule
# ========================
#   - Quarterly: re-run bandit --severity-level medium; must remain at 0
#   - Phase 9.0: comprehensive security audit before production release
#
# Contact: @mbaetiong for security questions

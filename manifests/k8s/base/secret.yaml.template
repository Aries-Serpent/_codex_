# Kubernetes Secret Template
# 
# This is a template file. DO NOT commit actual secrets.
# To use:
# 1. Copy this file: cp secret.yaml.template secret.yaml
# 2. Replace placeholder values with actual secrets
# 3. Apply: kubectl apply -f secret.yaml
# 4. Add secret.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: codex-ml-secrets
  labels:
    app: codex-ml
type: Opaque
stringData:
  # Model Registry Credentials (if using remote registry)
  MODEL_REGISTRY_TOKEN: "your-token-here"
  
  # MLflow Tracking (if using remote MLflow)
  MLFLOW_TRACKING_URI: "http://mlflow-server:5000"
  MLFLOW_TRACKING_TOKEN: "your-mlflow-token-here"
  
  # API Keys (if needed for external services)
  API_KEY: "your-api-key-here"
  
  # Database Credentials (if needed)
  DATABASE_URL: "postgresql://user:password@host:5432/dbname"

{
  "agent_query_rules": {
    "allow_raw_sql_for_agents": false,
    "deterministic_output": true,
    "primary_interface": "mcp_tools",
    "require_json_response": true
  },
  "allowed_exceptions_file": "docs-data/allowed-source-exceptions.json",
  "candidate_extensions": [
    ".md",
    ".mdx",
    ".markdown",
    ".txt",
    ".rst",
    ".yaml",
    ".yml",
    ".toml",
    ".json",
    ".jsonl"
  ],
  "canonical_dir": "docs-data",
  "enforcement": {
    "default_mode": "strict",
    "fail_on_broken_relationships": true,
    "fail_on_invalid_jsonl": true,
    "fail_on_restricted_path_prose": true,
    "fail_on_stale_generated_indexes": true,
    "fail_on_unmanaged_candidates": false
  },
  "exempted_paths": [
    ".codex/**",
    ".accountability_entry.txt",
    ".changelog_entry.txt"
  ],
  "generated_dir": "docs-data/generated",
  "ignored_paths": [
    ".git/**",
    ".venv/**",
    "venv/**",
    "node_modules/**",
    "vendor/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "target/**",
    ".next/**",
    "__pycache__/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**"
  ],
  "legacy_source_paths": [
    "docs/**",
    "planning/**",
    "architecture/**",
    "specs/**",
    ".codex/**"
  ],
  "machine_readable_only_paths": [
    "docs-data/**"
  ],
  "required_ingestion": {
    "allowed_states": [
      "requires_ingestion",
      "exempted",
      "ignored",
      "generated",
      "canonical",
      "covered"
    ],
    "default": "requires_ingestion"
  },
  "restricted_paths": [
    "docs-data/**"
  ],
  "schema_version": "1.0.0",
  "schemas_dir": "docs-data/schemas"
}
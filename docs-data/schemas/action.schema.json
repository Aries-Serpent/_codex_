{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///docs-data/schemas/action.schema.json",
  "title": "ActionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "schema_version",
    "title",
    "status",
    "action_type",
    "source_trace",
    "discovered_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^act_[a-f0-9]{12,}$"
    },
    "type": {
      "const": "action"
    },
    "schema_version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "blocked",
        "completed"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "action_type": {
      "enum": [
        "open task",
        "blocked task",
        "completed task",
        "migration task",
        "validation task",
        "cleanup task"
      ]
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "discovered",
        "converted_to_jsonl",
        "validated",
        "covered"
      ]
    },
    "source_trace": {
      "$ref": "./reference.schema.json#/$defs/source_trace"
    },
    "discovered_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
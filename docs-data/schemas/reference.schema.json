{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-data/schemas/reference.schema.json",
  "title": "ReferenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "schema_version", "ref_type", "label", "target", "source_trace", "discovered_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^ref_[a-f0-9]{12,}$"},
    "type": {"const": "reference"},
    "schema_version": {"type": "string"},
    "ref_type": {"enum": ["file", "url", "issue", "workflow", "path", "unknown"]},
    "label": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "document_id": {"type": ["string", "null"]},
    "lifecycle_status": {"enum": ["discovered", "validated", "covered"]},
    "source_trace": {"$ref": "#/$defs/source_trace"},
    "discovered_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path"],
      "properties": {
        "source_path": {"type": "string"},
        "source_line_start": {"type": ["integer", "null"], "minimum": 1},
        "source_line_end": {"type": ["integer", "null"], "minimum": 1},
        "source_sha1": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_type"],
      "properties": {
        "id": {"type": "string"},
        "entity_type": {"enum": ["document", "section", "block", "action", "decision", "requirement", "reference", "file"]}
      }
    }
  }
}

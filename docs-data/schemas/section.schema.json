{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///docs-data/schemas/section.schema.json",
  "title": "SectionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "schema_version",
    "document_id",
    "heading",
    "level",
    "source_trace",
    "discovered_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sec_[a-f0-9]{12,}$"
    },
    "type": {
      "const": "section"
    },
    "schema_version": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "parent_section_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "heading": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "lifecycle_status": {
      "enum": [
        "discovered",
        "classified",
        "converted_to_jsonl",
        "validated",
        "covered"
      ]
    },
    "source_trace": {
      "$ref": "./reference.schema.json#/$defs/source_trace"
    },
    "discovered_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}